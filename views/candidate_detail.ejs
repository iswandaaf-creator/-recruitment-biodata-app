<!DOCTYPE html>
<html lang="id">
<head>
  <!-- Security: Masking Address Bar agar direktori internal tidak terekspos -->
  <script>
    (function() {
      try {
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, document.title, '/');
        }
      } catch (e) {}
    })();
  </script>


  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail & Interview Note - <%= candidate.nama_lengkap %></title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --kov-emerald: #059669;
      --kov-slate-900: #0f172a;
      --kov-slate-800: #1e293b;
      --kov-border: #e2e8f0;
    }
    * {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    body { background-color: #f8fafc; color: #1e293b; }
    .card {
      border: 1px solid var(--kov-border);
      border-radius: 14px;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
      margin-bottom: 1.5rem;
      background: #ffffff;
    }
    .card-header {
      background-color: #ffffff;
      border-bottom: 1px solid var(--kov-border);
      font-weight: 700;
      color: #0f172a;
      padding: 1rem 1.25rem;
    }
    .top-navbar {
      background: #0f172a;
      border-bottom: 1px solid #1e293b;
      padding: 0.75rem 1.5rem;
    }
  </style>
</head>
<body>

  <!-- Top Bar -->
  <nav class="top-navbar shadow-sm">
    <div class="container-fluid px-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
      <a class="btn btn-outline-light btn-sm fw-semibold" href="/admin">
        <i class="fas fa-arrow-left me-1"></i> Kembali ke Dashboard
      </a>
      <div class="d-flex align-items-center gap-2">
        <% if (typeof user !== 'undefined' && user) { %>
          <span class="text-white-50 me-2 small">
            <i class="fas fa-circle-user me-1 text-light"></i><%= user.nama || user.username %>
          </span>
          <% if (user.role === 'superadmin' || user.role === 'admin') { %>
            <a href="/admin/users" class="btn btn-warning btn-sm fw-semibold me-1">
              <i class="fas fa-users-gear me-1"></i>Kelola User
            </a>
          <% } %>
        <% } %>
        <a href="/api/export/pdf/<%= candidate.id %>" target="_blank" class="btn btn-danger btn-sm fw-semibold">
          <i class="fas fa-file-pdf me-1"></i>Download 5-Page PDF
        </a>
        <a href="/admin/logout" onclick="sessionStorage.clear();" class="btn btn-outline-light btn-sm fw-semibold ms-2">
          <i class="fas fa-arrow-right-from-bracket me-1"></i>Logout
        </a>
      </div>
    </div>
  </nav>

  <div class="container py-4">

    <% if (typeof is_duplicate !== 'undefined' && is_duplicate && typeof duplicates !== 'undefined' && duplicates.length > 1) { %>
      <!-- Anti-Redundancy Warning Banner -->
      <div class="alert alert-warning border-2 border-warning shadow-sm mb-4">
        <div class="d-flex align-items-start">
          <i class="fas fa-exclamation-triangle fa-2x text-warning me-3 mt-1"></i>
          <div class="w-100">
            <h5 class="alert-heading fw-bold mb-1">
              ⚠️ Peringatan Anti-Redundansi Data: Pelamar Berulang (<%= duplicates.length %>x Mengisi Form)
            </h5>
            <p class="mb-2 text-dark">
              Kandidat ini terdeteksi telah mengisi formulir biodata sebanyak <strong><%= duplicates.length %> kali</strong> dengan Nomor KTP, Email, No. HP, atau Nama yang sama.
            </p>
            <div class="p-2 bg-white bg-opacity-75 rounded border border-warning-subtle">
              <div class="fw-bold small text-secondary mb-1">Riwayat Sesi Pengisian Form Pelamar Ini:</div>
              <div class="d-flex flex-wrap gap-2">
                <% duplicates.forEach(dup => { %>
                  <a href="/admin/candidate/<%= dup.id %>" class="btn btn-sm <%= dup.id === candidate.id ? 'btn-warning fw-bold border-dark' : 'btn-outline-secondary' %> py-1 px-2 text-start">
                    <i class="fas <%= dup.id === candidate.id ? 'fa-check-circle' : 'fa-history' %> me-1"></i>
                    ID #<%= dup.id %> (<%= formatDate(dup.created_at) %>)
                    <span class="badge bg-dark bg-opacity-75 ms-1"><%= dup.kesimpulan_status || 'Belum Diproses' %></span>
                    <% if (dup.id === candidate.id) { %> <span class="badge bg-danger ms-1">Sedang Dibuka</span> <% } %>
                  </a>
                <% }); %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Candidate Main Header Card -->
    <div class="card">
      <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
          <div class="d-flex align-items-center gap-3">
            <% if (candidate.foto_kandidat) { %>
              <div class="position-relative">
                <img src="<%= candidate.foto_kandidat %>" class="rounded border shadow-sm" style="width: 85px; height: 110px; object-fit: cover;">
                <span class="badge bg-dark position-absolute bottom-0 start-50 translate-middle-x mb-1 opacity-75" style="font-size: 9px;">Pasfoto 3x4</span>
              </div>
            <% } else { %>
              <div class="rounded bg-light border d-flex flex-column align-items-center justify-content-center text-muted" style="width: 85px; height: 110px;">
                <i class="fas fa-camera fa-2x mb-1 opacity-50"></i>
                <span style="font-size: 10px;">Tanpa Foto</span>
              </div>
            <% } %>
            <div>
              <h3 class="fw-bold mb-1"><%= candidate.nama_lengkap %></h3>
              <div class="text-muted fs-6 mb-2">
                <span class="me-3"><i class="fas fa-briefcase me-1 text-primary"></i><strong>Posisi:</strong> <%= candidate.posisi_dilamar %></span>
                <span class="me-3"><i class="fas fa-envelope me-1 text-primary"></i><%= candidate.email %></span>
                <span><i class="fas fa-phone me-1 text-primary"></i><%= candidate.no_hp %></span>
              </div>
              <div class="small text-secondary">
                Submitted at: <%= formatDate(candidate.created_at, true) %> | Ref ID: #<%= candidate.id %>
              </div>
            </div>
          </div>
          <div>
            <% const statusClass = candidate.kesimpulan_status === 'Diterima' ? 'bg-success' : candidate.kesimpulan_status === 'Dipertimbangkan' ? 'bg-warning text-dark' : candidate.kesimpulan_status === 'Ditolak' ? 'bg-danger' : 'bg-secondary'; %>
            <span class="badge <%= statusClass %> fs-6 px-3 py-2">
              Status: <%= candidate.kesimpulan_status || 'Belum Diproses' %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- FORM DIISI OLEH PEWAWANCARA & KESIMPULAN (PAGE 5 EDITOR) -->
    <div class="card border-primary border-2">
      <div class="card-header bg-primary text-white py-3">
        <h5 class="mb-0 fw-bold"><i class="fas fa-user-check me-2"></i>Form Pewawancara & Kesimpulan Rekrutmen (Halaman 5 PDF)</h5>
      </div>
      <div class="card-body">
        <form action="/admin/candidate/<%= candidate.id %>/interview" method="POST">
          
          <h6 class="fw-bold text-primary mb-3">1. Catatan Wawancara 1</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-8">
              <label class="form-label">Catatan Wawancara</label>
              <textarea class="form-control" name="cw1_catatan" rows="3" placeholder="Hasil interview / performa kandidat..."><%= cw1.catatan || '' %></textarea>
            </div>
            <div class="col-md-4">
              <div class="mb-2">
                <label class="form-label">Nama Pewawancara</label>
                <input type="text" class="form-control form-control-sm" name="cw1_nama" value="<%= cw1.nama || '' %>">
              </div>
              <div class="mb-2">
                <label class="form-label">Jabatan</label>
                <input type="text" class="form-control form-control-sm" name="cw1_jabatan" value="<%= cw1.jabatan || '' %>">
              </div>
              <div>
                <label class="form-label">Tanggal</label>
                <input type="date" class="form-control form-control-sm" name="cw1_tanggal" value="<%= cw1.tanggal || '' %>">
              </div>
            </div>
          </div>

          <h6 class="fw-bold text-primary mb-3">2. Catatan Wawancara 2 (Opsional)</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-8">
              <label class="form-label">Catatan Wawancara</label>
              <textarea class="form-control" name="cw2_catatan" rows="3" placeholder="Hasil interview 2..."><%= cw2.catatan || '' %></textarea>
            </div>
            <div class="col-md-4">
              <div class="mb-2">
                <label class="form-label">Nama Pewawancara</label>
                <input type="text" class="form-control form-control-sm" name="cw2_nama" value="<%= cw2.nama || '' %>">
              </div>
              <div class="mb-2">
                <label class="form-label">Jabatan</label>
                <input type="text" class="form-control form-control-sm" name="cw2_jabatan" value="<%= cw2.jabatan || '' %>">
              </div>
              <div>
                <label class="form-label">Tanggal</label>
                <input type="date" class="form-control form-control-sm" name="cw2_tanggal" value="<%= cw2.tanggal || '' %>">
              </div>
            </div>
          </div>

          <h6 class="fw-bold text-primary mb-3">3. Catatan Wawancara 3 (Opsional)</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-8">
              <label class="form-label">Catatan Wawancara</label>
              <textarea class="form-control" name="cw3_catatan" rows="3" placeholder="Hasil interview 3..."><%= cw3.catatan || '' %></textarea>
            </div>
            <div class="col-md-4">
              <div class="mb-2">
                <label class="form-label">Nama Pewawancara</label>
                <input type="text" class="form-control form-control-sm" name="cw3_nama" value="<%= cw3.nama || '' %>">
              </div>
              <div class="mb-2">
                <label class="form-label">Jabatan</label>
                <input type="text" class="form-control form-control-sm" name="cw3_jabatan" value="<%= cw3.jabatan || '' %>">
              </div>
              <div>
                <label class="form-label">Tanggal</label>
                <input type="date" class="form-control form-control-sm" name="cw3_tanggal" value="<%= cw3.tanggal || '' %>">
              </div>
            </div>
          </div>

          <hr class="my-4">

          <h6 class="fw-bold text-primary mb-3"><i class="fas fa-id-card-clip me-2"></i>4. Data Kepegawaian & Finansial HR</h6>
          <div class="row g-3 mb-4 p-3 bg-light rounded border">
            <div class="col-md-4">
              <label class="form-label fw-bold">Nomor KK (Kartu Keluarga)</label>
              <input type="text" class="form-control form-control-sm" name="nomor_kk" value="<%= candidate.nomor_kk || '' %>" placeholder="16 digit Nomor KK">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">No. Rekening Bank</label>
              <input type="text" class="form-control form-control-sm" name="no_rekening" value="<%= candidate.no_rekening || '' %>" placeholder="Bank & No. Rekening">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Gaji Pokok</label>
              <input type="text" class="form-control form-control-sm" name="gaji_pokok" value="<%= candidate.gaji_pokok || '' %>" placeholder="Nominal Gaji Pokok">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Produktivitas / Evaluasi</label>
              <input type="text" class="form-control form-control-sm" name="produktivitas" value="<%= candidate.produktivitas || '' %>" placeholder="Skor / Keterangan produktivitas">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Tanggal Join</label>
              <input type="date" class="form-control form-control-sm" name="tgl_join" value="<%= candidate.tgl_join || '' %>">
            </div>
            <div class="col-md-4">
              <label class="form-label fw-bold">Tanggal Resign</label>
              <input type="date" class="form-control form-control-sm" name="tgl_resign" value="<%= candidate.tgl_resign || '' %>">
            </div>
          </div>

          <h6 class="fw-bold text-primary mb-3">5. Kesimpulan Akhir HR</h6>
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label class="form-label fw-bold">Keputusan Rekrutmen <span class="text-danger">*</span></label>
              <select class="form-select" name="kesimpulan_status" required>
                <option value="" <%= !candidate.kesimpulan_status ? 'selected' : '' %>>-- Pilih Status --</option>
                <option value="Diterima" <%= candidate.kesimpulan_status === 'Diterima' ? 'selected' : '' %>>Diterima</option>
                <option value="Dipertimbangkan" <%= candidate.kesimpulan_status === 'Dipertimbangkan' ? 'selected' : '' %>>Dipertimbangkan</option>
                <option value="Ditolak" <%= candidate.kesimpulan_status === 'Ditolak' ? 'selected' : '' %>>Ditolak</option>
              </select>
            </div>
            <div class="col-md-8">
              <label class="form-label">Catatan Tambahan Kesimpulan</label>
              <input type="text" class="form-control" name="kesimpulan_catatan" value="<%= candidate.kesimpulan_catatan || '' %>" placeholder="Keterangan gaji disetujui, tanggal masuk, atau alasan penolakan...">
            </div>
          </div>

          <div class="text-end">
            <button type="submit" class="btn btn-primary px-4">
              <i class="fas fa-save me-1"></i>Simpan Catatan & Data HR
            </button>
          </div>

        </form>
      </div>
    </div>

    <!-- SUMMARY OF CANDIDATE SUBMISSION DATA -->
    <div class="card">
      <div class="card-header">
        <i class="fas fa-address-card me-2"></i>Ringkasan Biodata Pelamar
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-4"><strong>Nama Lengkap:</strong> <%= candidate.nama_lengkap %></div>
          <div class="col-md-4"><strong>Nama Panggilan:</strong> <%= candidate.nama_panggilan || '-' %></div>
          <div class="col-md-4"><strong>Jenis Kelamin:</strong> <%= candidate.jenis_kelamin %></div>
          <div class="col-md-4"><strong>TTL:</strong> <%= candidate.tempat_lahir %>, <%= formatDate(candidate.tanggal_lahir) %></div>
          <div class="col-md-4"><strong>No KTP:</strong> <%= candidate.nomor_ktp || '-' %></div>
          <div class="col-md-4"><strong>Nomor KK:</strong> <%= candidate.nomor_kk || '-' %></div>
          <div class="col-md-4"><strong>No Rekening:</strong> <%= candidate.no_rekening || '-' %></div>
          <div class="col-md-4"><strong>Status Nikah:</strong> <%= candidate.status_perkawinan %></div>
          <div class="col-md-4"><strong>Gaji Pokok:</strong> <%= candidate.gaji_pokok || '-' %></div>
          <div class="col-md-4"><strong>Produktivitas:</strong> <%= candidate.produktivitas || '-' %></div>
          <div class="col-md-4"><strong>Tgl Join:</strong> <%= formatDate(candidate.tgl_join) %></div>
          <div class="col-md-4"><strong>Tgl Resign:</strong> <%= formatDate(candidate.tgl_resign) %></div>
          <div class="col-md-6"><strong>Alamat KTP:</strong> <%= candidate.alamat_ktp %> (<%= candidate.kota_ktp %>)</div>
          <div class="col-md-6"><strong>Alamat Domisili:</strong> <%= candidate.alamat_domisili %> (<%= candidate.kota_domisili %>)</div>
          <div class="col-md-6"><strong>Alasan Rekrutmen:</strong> <%= candidate.alasan_rekrutmen || '-' %></div>
          <div class="col-md-6"><strong>Minat / Passion:</strong> <%= candidate.minat_passion || '-' %></div>
          <div class="col-md-6"><strong>Perkiraan Join:</strong> <%= candidate.perkiraan_bergabung || '-' %></div>
          <div class="col-md-6"><strong>Gaji Diharapkan:</strong> <%= candidate.gaji_diharapkan || '-' %></div>
        </div>
      </div>
    </div>

  </div>

  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
