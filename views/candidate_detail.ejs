<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail &amp; Interview Note - <%= candidate.nama_lengkap %></title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css" rel="stylesheet">
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'hr', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Minimalist Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <a class="btn-kov-secondary btn-kov-sm" href="/admin">
            <i class="fas fa-arrow-left"></i> <span class="d-none d-sm-inline">Kembali</span>
          </a>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Detail Pelamar</h1>
            <span class="text-muted d-none d-md-inline" style="font-size: 0.85rem;">/ <%= candidate.nama_lengkap %></span>
          </div>
        </div>
        <div class="kov-topbar-right d-flex align-items-center gap-2">
          <!-- KOV Dual-Theme Switcher -->
          <button type="button" class="kov-theme-toggle" onclick="toggleKovTheme()" title="Ganti Mode Gelap / Terang">
            <i class="fas fa-moon kov-theme-icon"></i>
          </button>
          <a href="/api/export/pdf/<%= candidate.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-danger btn-kov-sm">
            <i class="fas fa-file-pdf"></i> <span class="d-none d-sm-inline">PDF 5 Halaman</span>
          </a>
          <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
            <form action="/admin/candidate/delete/<%= candidate.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus berkas pelamar <%= candidate.nama_lengkap %> secara permanen?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn-kov-outline btn-kov-sm text-danger border-danger" title="Hapus Berkas Pelamar" aria-label="Hapus Berkas Pelamar <%= candidate.nama_lengkap %>">
                <i class="fas fa-trash-can"></i> <span class="d-none d-sm-inline">Hapus</span>
              </button>
            </form>
          <% } %>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

    <% if (typeof is_duplicate !== 'undefined' && is_duplicate && typeof duplicates !== 'undefined' && duplicates.length > 1) { %>
      <!-- Anti-Redundancy Warning Banner -->
      <div class="alert alert-warning border border-warning shadow-xs rounded-4 mb-4">
        <div class="d-flex align-items-start gap-3">
          <i class="fas fa-triangle-exclamation fa-2x text-warning mt-1"></i>
          <div class="w-100">
            <h6 class="alert-heading fw-bold mb-1">
              Peringatan Data Duplikat: Pelamar Ini Mengisi Form <%= duplicates.length %>x
            </h6>
            <p class="small mb-2 text-dark">
              Kandidat ini terdeteksi memiliki riwayat pengisian formulir lebih dari satu kali dengan kesamaan NIK, Email, No. HP, atau Nama.
            </p>
            <div class="p-2 bg-white rounded-3 border border-warning-subtle">
              <div class="fw-bold small text-secondary mb-1">Riwayat Sesi Pengisian Form Pelamar Ini:</div>
              <div class="d-flex flex-wrap gap-2">
                <% duplicates.forEach(dup => { %>
                  <a href="/admin/candidate/<%= dup.id %>" class="btn btn-sm <%= dup.id === candidate.id ? 'btn-warning fw-bold border-dark' : 'btn-outline-secondary' %> py-1 px-2 text-start rounded-pill">
                    <i class="fas <%= dup.id === candidate.id ? 'fa-check-circle' : 'fa-history' %> me-1"></i>
                    ID #<%= dup.id %> (<%= formatDate(dup.created_at) %>)
                    <span class="badge bg-dark bg-opacity-75 ms-1"><%= dup.kesimpulan_status || 'Belum Diproses' %></span>
                    <% if (dup.id === candidate.id) { %> <span class="badge bg-danger ms-1">Sedang Dibuka</span> <% } %>
                  </a>
                <% }); %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Candidate Main Header Card -->
    <div class="kov-card mb-4">
      <div class="kov-card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
          <div class="d-flex align-items-center gap-3.5 flex-wrap">
            <% if (candidate.foto_kandidat) { %>
              <div class="position-relative">
                <img src="<%= candidate.foto_kandidat %>" class="rounded-3 border shadow-xs" style="width: 85px; height: 110px; object-fit: cover;">
                <span class="badge bg-dark position-absolute bottom-0 start-50 translate-middle-x mb-1 opacity-75" style="font-size: 9px;">Pasfoto 3x4</span>
              </div>
            <% } else { %>
              <div class="rounded-3 bg-light border d-flex flex-column align-items-center justify-content-center text-muted" style="width: 85px; height: 110px;">
                <i class="fas fa-camera fa-2x mb-1 opacity-50"></i>
                <span style="font-size: 10px;">Tanpa Foto</span>
              </div>
            <% } %>
            <div>
              <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <h3 class="fw-bold mb-0 text-dark"><%= candidate.nama_lengkap %></h3>
                <% 
                  const dLow = (candidate.divisi || 'operasional').toLowerCase();
                  let divCls = 'bg-secondary';
                  if (dLow.includes('kitchen')) divCls = 'bg-warning-subtle text-warning-emphasis border border-warning';
                  else if (dLow.includes('barista')) divCls = 'bg-amber-subtle text-amber-emphasis border';
                  else if (dLow.includes('hr')) divCls = 'bg-primary-subtle text-primary border';
                  else if (dLow.includes('teknisi')) divCls = 'bg-info-subtle text-info border';
                  else if (dLow.includes('fat') || dLow.includes('finance')) divCls = 'bg-success-subtle text-success border';
                  else if (dLow.includes('it')) divCls = 'bg-dark text-info border border-info';
                  else divCls = 'bg-success-subtle text-success border';
                %>
                <span class="badge <%= divCls %> px-2 py-1"><i class="fas fa-layer-group me-1"></i>Divisi: <%= candidate.divisi || 'Operasional' %></span>
                <button type="button" class="btn-kov-outline btn-kov-sm" style="padding: 2px 8px; font-size: 0.75rem;" data-bs-toggle="modal" data-bs-target="#modalChangeDivisi">
                  <i class="fas fa-pen"></i> Ubah Divisi
                </button>
              </div>
              <div class="text-muted small mb-2 d-flex flex-wrap gap-3">
                <span><i class="fas fa-briefcase text-primary me-1"></i><strong>Posisi:</strong> <%= candidate.posisi_dilamar %></span>
                <span><i class="fas fa-envelope text-primary me-1"></i><%= candidate.email %></span>
                <span><i class="fas fa-phone text-primary me-1"></i><%= candidate.no_hp %></span>
              </div>
              <div class="small text-secondary">
                Submitted: <%= formatDate(candidate.created_at, true) %> &bull; Ref ID: #<%= candidate.id %>
              </div>
            </div>
          </div>
          <div>
            <% 
              const statusName = candidate.kesimpulan_status || 'Belum Diproses';
              let pillClass = 'pill-warning';
              if (statusName === 'Diterima') pillClass = 'pill-success';
              else if (statusName === 'Dipertimbangkan') pillClass = 'pill-warning';
              else if (statusName === 'Ditolak') pillClass = 'pill-danger';
            %>
            <span class="status-pill-modern <%= pillClass %>" style="padding: 6px 14px; font-size: 0.85rem;">
              <span class="status-dot-pulse"></span>
              Status: <%= statusName %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- CATATAN & EVALUASI REVIEWER DIVISI -->
    <div class="kov-card mb-4" style="border-left: 4px solid var(--kov-blue);">
      <div class="kov-card-header">
        <h5 class="kov-card-title">
          <i class="fas fa-comments text-primary"></i>
          <span>Catatan &amp; Evaluasi Reviewer Divisi (<%= (typeof reviews !== 'undefined' ? reviews.length : 0) %>)</span>
        </h5>
        <a href="/reviewer/candidate/<%= candidate.id %>" class="btn-kov-primary btn-kov-sm">
          <i class="fas fa-pen-to-square"></i> Beri Catatan Sebagai Reviewer
        </a>
      </div>
      <div class="kov-card-body">
        <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
          <div class="row g-3">
            <% reviews.forEach(r => { 
              let rekBadge = 'pill-slate';
              if ((r.rekomendasi || '').includes('Direkomendasikan Lolos')) rekBadge = 'pill-success';
              else if ((r.rekomendasi || '').includes('Dipertimbangkan')) rekBadge = 'pill-warning';
              else if ((r.rekomendasi || '').includes('Tidak')) rekBadge = 'pill-danger';
            %>
              <div class="col-md-6">
                <div class="p-3 bg-light rounded-3 border h-100">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                      <strong class="text-dark"><%= r.reviewer_name || r.reviewer_username %></strong>
                      <span class="badge bg-white text-dark border ms-1 small">Divisi: <%= r.divisi || '-' %></span>
                    </div>
                    <span class="status-pill-modern <%= rekBadge %>" style="font-size: 0.72rem;">
                      <span class="status-dot-pulse"></span> <%= r.rekomendasi || 'Catatan' %>
                    </span>
                  </div>
                  <p class="small text-dark mb-2 bg-white p-2.5 rounded-3 border" style="white-space: pre-line;"><%= r.catatan %></p>
                  <div class="small text-muted" style="font-size: 0.72rem;">
                    <i class="fas fa-clock me-1"></i><%= formatDate(r.created_at, true) %> (@<%= r.reviewer_username %>)
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-muted small py-2">
            <i class="fas fa-info-circle me-1 text-info"></i>Belum ada catatan evaluasi dari user/reviewer divisi untuk kandidat ini.
          </div>
        <% } %>
      </div>
    </div>

    <!-- FORM DIISI OLEH PEWAWANCARA & KESIMPULAN -->
    <div class="kov-card mb-4" style="border-top: 3px solid var(--kov-primary-500);">
      <div class="kov-card-header">
        <h5 class="kov-card-title">
          <i class="fas fa-user-check text-success"></i>
          <span>Form Pewawancara &amp; Kesimpulan Rekrutmen (Halaman 5 PDF)</span>
        </h5>
      </div>
      <div class="kov-card-body">
        <form action="/admin/candidate/<%= candidate.id %>/interview" method="POST" data-kov-loading>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          
          <h6 class="fw-bold text-dark mb-3"><i class="fas fa-user-pen me-2 text-primary"></i>1. Catatan Wawancara 1</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-8">
              <label for="cw1_catatan" class="kov-label">Catatan Wawancara 1</label>
              <textarea id="cw1_catatan" class="form-control" name="cw1_catatan" rows="3" placeholder="Hasil interview / performa kandidat..."><%= cw1.catatan || '' %></textarea>
            </div>
            <div class="col-md-4">
              <div class="mb-2">
                <label for="cw1_nama" class="kov-label">Nama Pewawancara 1</label>
                <input id="cw1_nama" type="text" class="form-control form-control-sm" name="cw1_nama" value="<%= cw1.nama || '' %>">
              </div>
              <div class="mb-2">
                <label for="cw1_jabatan" class="kov-label">Jabatan</label>
                <input id="cw1_jabatan" type="text" class="form-control form-control-sm" name="cw1_jabatan" value="<%= cw1.jabatan || '' %>">
              </div>
              <div>
                <label for="cw1_tanggal" class="kov-label">Tanggal</label>
                <input id="cw1_tanggal" type="date" class="form-control form-control-sm" name="cw1_tanggal" value="<%= cw1.tanggal || '' %>">
              </div>
            </div>
          </div>

          <!-- Collapsible Accordions for Optional Interviews 2 & 3 -->
          <div class="accordion mb-4" id="accordionInterview">
            <!-- Wawancara 2 (Opsional) -->
            <div class="accordion-item border rounded-3 overflow-hidden mb-3">
              <h2 class="accordion-header" id="headingCw2">
                <button class="accordion-button <%= (cw2 && (cw2.catatan || cw2.nama)) ? '' : 'collapsed' %> fw-bold py-2.5 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCw2" aria-expanded="<%= (cw2 && (cw2.catatan || cw2.nama)) ? 'true' : 'false' %>" aria-controls="collapseCw2">
                  <i class="fas fa-user-pen me-2 text-primary"></i>2. Catatan Wawancara 2 (Opsional)
                  <% if (cw2 && (cw2.catatan || cw2.nama)) { %>
                    <span class="badge bg-success ms-2">Terisi</span>
                  <% } %>
                </button>
              </h2>
              <div id="collapseCw2" class="accordion-collapse collapse <%= (cw2 && (cw2.catatan || cw2.nama)) ? 'show' : '' %>" aria-labelledby="headingCw2" data-bs-parent="#accordionInterview">
                <div class="accordion-body p-3">
                  <div class="row g-3">
                    <div class="col-md-8">
                      <label for="cw2_catatan" class="kov-label">Catatan Wawancara 2</label>
                      <textarea id="cw2_catatan" class="form-control" name="cw2_catatan" rows="3" placeholder="Hasil interview 2..."><%= cw2.catatan || '' %></textarea>
                    </div>
                    <div class="col-md-4">
                      <div class="mb-2">
                        <label for="cw2_nama" class="kov-label">Nama Pewawancara 2</label>
                        <input id="cw2_nama" type="text" class="form-control form-control-sm" name="cw2_nama" value="<%= cw2.nama || '' %>">
                      </div>
                      <div class="mb-2">
                        <label for="cw2_jabatan" class="kov-label">Jabatan</label>
                        <input id="cw2_jabatan" type="text" class="form-control form-control-sm" name="cw2_jabatan" value="<%= cw2.jabatan || '' %>">
                      </div>
                      <div>
                        <label for="cw2_tanggal" class="kov-label">Tanggal</label>
                        <input id="cw2_tanggal" type="date" class="form-control form-control-sm" name="cw2_tanggal" value="<%= cw2.tanggal || '' %>">
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Wawancara 3 (Opsional) -->
            <div class="accordion-item border rounded-3 overflow-hidden">
              <h2 class="accordion-header" id="headingCw3">
                <button class="accordion-button <%= (cw3 && (cw3.catatan || cw3.nama)) ? '' : 'collapsed' %> fw-bold py-2.5 px-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapseCw3" aria-expanded="<%= (cw3 && (cw3.catatan || cw3.nama)) ? 'true' : 'false' %>" aria-controls="collapseCw3">
                  <i class="fas fa-user-pen me-2 text-primary"></i>3. Catatan Wawancara 3 (Opsional)
                  <% if (cw3 && (cw3.catatan || cw3.nama)) { %>
                    <span class="badge bg-success ms-2">Terisi</span>
                  <% } %>
                </button>
              </h2>
              <div id="collapseCw3" class="accordion-collapse collapse <%= (cw3 && (cw3.catatan || cw3.nama)) ? 'show' : '' %>" aria-labelledby="headingCw3" data-bs-parent="#accordionInterview">
                <div class="accordion-body p-3">
                  <div class="row g-3">
                    <div class="col-md-8">
                      <label for="cw3_catatan" class="kov-label">Catatan Wawancara 3</label>
                      <textarea id="cw3_catatan" class="form-control" name="cw3_catatan" rows="3" placeholder="Hasil interview 3..."><%= cw3.catatan || '' %></textarea>
                    </div>
                    <div class="col-md-4">
                      <div class="mb-2">
                        <label for="cw3_nama" class="kov-label">Nama Pewawancara 3</label>
                        <input id="cw3_nama" type="text" class="form-control form-control-sm" name="cw3_nama" value="<%= cw3.nama || '' %>">
                      </div>
                      <div class="mb-2">
                        <label for="cw3_jabatan" class="kov-label">Jabatan</label>
                        <input id="cw3_jabatan" type="text" class="form-control form-control-sm" name="cw3_jabatan" value="<%= cw3.jabatan || '' %>">
                      </div>
                      <div>
                        <label for="cw3_tanggal" class="kov-label">Tanggal</label>
                        <input id="cw3_tanggal" type="date" class="form-control form-control-sm" name="cw3_tanggal" value="<%= cw3.tanggal || '' %>">
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <hr class="my-4">

          <h6 class="fw-bold text-dark mb-3"><i class="fas fa-id-card-clip me-2 text-primary"></i>4. Data Kepegawaian &amp; Finansial HR</h6>
          <div class="row g-3 mb-4 p-3 bg-light rounded-3 border">
            <div class="col-md-4">
              <label for="nomor_kk" class="kov-label">Nomor KK (Kartu Keluarga)</label>
              <input type="text" id="nomor_kk" class="form-control form-control-sm" name="nomor_kk" value="<%= candidate.nomor_kk || '' %>" placeholder="16 digit Nomor KK">
            </div>
            <div class="col-md-4">
              <label for="no_rekening" class="kov-label">No. Rekening Bank</label>
              <input type="text" id="no_rekening" class="form-control form-control-sm" name="no_rekening" value="<%= candidate.no_rekening || '' %>" placeholder="Bank &amp; No. Rekening">
            </div>
            <div class="col-md-4">
              <label for="gaji_pokok" class="kov-label">Gaji Pokok</label>
              <input type="text" id="gaji_pokok" class="form-control form-control-sm" name="gaji_pokok" value="<%= candidate.gaji_pokok || '' %>" placeholder="Nominal Gaji Pokok">
            </div>
            <div class="col-md-4">
              <label for="produktivitas" class="kov-label">Produktivitas / Evaluasi</label>
              <input type="text" id="produktivitas" class="form-control form-control-sm" name="produktivitas" value="<%= candidate.produktivitas || '' %>" placeholder="Skor / Keterangan produktivitas">
            </div>
            <div class="col-md-4">
              <label for="tgl_join" class="kov-label">Tanggal Join</label>
              <input type="date" id="tgl_join" class="form-control form-control-sm" name="tgl_join" value="<%= candidate.tgl_join || '' %>">
            </div>
            <div class="col-md-4">
              <label for="tgl_resign" class="kov-label">Tanggal Resign</label>
              <input type="date" id="tgl_resign" class="form-control form-control-sm" name="tgl_resign" value="<%= candidate.tgl_resign || '' %>">
            </div>
          </div>

          <h6 class="fw-bold text-dark mb-3"><i class="fas fa-clipboard-check me-2 text-primary"></i>5. Kesimpulan Akhir HR</h6>
          <div class="row g-3 mb-4">
            <div class="col-md-4">
              <label for="kesimpulan_status" class="kov-label">Keputusan Rekrutmen <span class="text-danger">*</span></label>
              <select id="kesimpulan_status" class="form-select" name="kesimpulan_status" required>
                <option value="Belum Diproses" <%= (!candidate.kesimpulan_status || candidate.kesimpulan_status === 'Belum Diproses') ? 'selected' : '' %>>Belum Diproses (Pending Review)</option>
                <option value="Diterima" <%= candidate.kesimpulan_status === 'Diterima' ? 'selected' : '' %>>Diterima</option>
                <option value="Dipertimbangkan" <%= candidate.kesimpulan_status === 'Dipertimbangkan' ? 'selected' : '' %>>Dipertimbangkan</option>
                <option value="Ditolak" <%= candidate.kesimpulan_status === 'Ditolak' ? 'selected' : '' %>>Ditolak</option>
              </select>
            </div>
            <div class="col-md-8">
              <label for="kesimpulan_catatan" class="kov-label">Catatan Tambahan Kesimpulan</label>
              <input type="text" id="kesimpulan_catatan" class="form-control" name="kesimpulan_catatan" value="<%= candidate.kesimpulan_catatan || '' %>" placeholder="Keterangan gaji disetujui, tanggal masuk, atau alasan penolakan...">
            </div>
          </div>

          <div class="text-end">
            <button type="submit" class="btn-kov-primary" data-loading-text="Menyimpan Evaluasi HR...">
              <i class="fas fa-save"></i> Simpan Catatan &amp; Data HR
            </button>
          </div>

        </form>
      </div>
    </div>

    <!-- SUMMARY OF CANDIDATE SUBMISSION DATA -->
    <div class="kov-card">
      <div class="kov-card-header">
        <h5 class="kov-card-title">
          <i class="fas fa-address-card text-muted"></i>
          <span>Ringkasan Biodata Pelamar</span>
        </h5>
      </div>
      <div class="kov-card-body">
        <div class="row g-3 small">
          <div class="col-md-4"><strong>Nama Lengkap:</strong> <%= candidate.nama_lengkap %></div>
          <div class="col-md-4"><strong>Nama Panggilan:</strong> <%= candidate.nama_panggilan || '-' %></div>
          <div class="col-md-4"><strong>Jenis Kelamin:</strong> <%= candidate.jenis_kelamin %></div>
          <div class="col-md-4"><strong>TTL:</strong> <%= candidate.tempat_lahir %>, <%= formatDate(candidate.tanggal_lahir) %></div>
          <div class="col-md-4"><strong>No KTP:</strong> <%= candidate.nomor_ktp || '-' %></div>
          <div class="col-md-4"><strong>Nomor KK:</strong> <%= candidate.nomor_kk || '-' %></div>
          <div class="col-md-4"><strong>No Rekening:</strong> <%= candidate.no_rekening || '-' %></div>
          <div class="col-md-4"><strong>Status Nikah:</strong> <%= candidate.status_perkawinan %></div>
          <div class="col-md-4"><strong>Gaji Pokok:</strong> <%= candidate.gaji_pokok || '-' %></div>
          <div class="col-md-4"><strong>Produktivitas:</strong> <%= candidate.produktivitas || '-' %></div>
          <div class="col-md-4"><strong>Tgl Join:</strong> <%= formatDate(candidate.tgl_join) %></div>
          <div class="col-md-4"><strong>Tgl Resign:</strong> <%= formatDate(candidate.tgl_resign) %></div>
          <div class="col-md-6"><strong>Alamat KTP:</strong> <%= candidate.alamat_ktp %> (<%= candidate.kota_ktp %>)</div>
          <div class="col-md-6"><strong>Alamat Domisili:</strong> <%= candidate.alamat_domisili %> (<%= candidate.kota_domisili %>)</div>
          <div class="col-md-6"><strong>Alasan Rekrutmen:</strong> <%= candidate.alasan_rekrutmen || '-' %></div>
          <div class="col-md-6"><strong>Minat / Passion:</strong> <%= candidate.minat_passion || '-' %></div>
          <div class="col-md-6"><strong>Perkiraan Join:</strong> <%= candidate.perkiraan_bergabung || '-' %></div>
          <div class="col-md-6"><strong>Gaji Diharapkan:</strong> <%= candidate.gaji_diharapkan || '-' %></div>
        </div>
      </div>
    </div>
      </main>
    </div>
  </div>

  <!-- Modal Ubah Divisi Pelamar -->
  <div class="modal fade" id="modalChangeDivisi" tabindex="-1" aria-labelledby="modalChangeDivisiLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4">
        <form action="/admin/candidate/<%= candidate.id %>/update-division" method="POST" data-kov-loading>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="modal-header bg-slate-900 text-white rounded-top-4" style="background-color: var(--kov-slate-900);">
            <h5 class="modal-title fw-bold" id="modalChangeDivisiLabel">
              <i class="fas fa-layer-group text-warning me-2"></i>Ubah Divisi Pelamar
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body p-4">
            <p class="small text-muted mb-3">
              Pilih divisi tujuan untuk pelamar <strong><%= candidate.nama_lengkap %></strong>. Pelamar akan otomatis muncul di Portal Reviewer divisi yang dipilih.
            </p>
            <div class="mb-3">
              <label class="kov-label">Pilih Divisi Lowongan <span class="text-danger">*</span></label>
              <% const divsList = ['Kitchen', 'Barista', 'Operasional', 'HR', 'Teknisi', 'FAT', 'IT']; %>
              <select class="form-select" name="divisi" required>
                <% divsList.forEach(div => { %>
                  <option value="<%= div %>" <%= (candidate.divisi && candidate.divisi.toLowerCase() === div.toLowerCase()) ? 'selected' : '' %>>
                    <%= div === 'FAT' ? 'FAT (Finance, Akunting, Tax)' : div %>
                  </option>
                <% }); %>
              </select>
            </div>
          </div>
          <div class="modal-footer bg-light py-2">
            <button type="button" class="btn-kov-secondary btn-kov-sm" data-bs-dismiss="modal">Batal</button>
            <button type="submit" class="btn-kov-primary btn-kov-sm" data-loading-text="Menyimpan Divisi...">
              <i class="fas fa-save"></i> Simpan Divisi Baru
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
