<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Purchase Order - <%= po.no_po || ('PO/KOV/' + po.id) %></title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css" rel="stylesheet">
  <style>
    .po-paper {
      background-color: #ffffff;
      padding: 2.25rem;
      border-radius: var(--kov-radius-lg);
      border: 1px solid var(--kov-border);
      box-shadow: var(--kov-shadow-md);
    }
    .card-box {
      border: 1px solid var(--kov-border);
      border-radius: var(--kov-radius-md);
      padding: 1rem 1.25rem;
      height: 100%;
      background: var(--kov-slate-50);
    }
    .card-box-header {
      font-weight: 700;
      font-size: 0.8rem;
      color: var(--kov-primary-700);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 0.75rem;
      border-bottom: 1px solid var(--kov-slate-200);
      padding-bottom: 0.4rem;
    }

    /* Constrained Brand Logo to prevent overflow/overlap */
    .brand-badge-logo {
      width: 54px;
      height: 54px;
      min-width: 54px;
      max-width: 54px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--kov-border, #e2e8f0);
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
    }
    .brand-badge-logo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Dark Mode Overrides */
    [data-theme="dark"] .po-paper {
      background-color: #140727 !important;
      border-color: #3a2251 !important;
    }
    [data-theme="dark"] .card-box {
      background: #1a0b33 !important;
      border-color: #3a2251 !important;
    }
    [data-theme="dark"] .card-box-header {
      border-bottom-color: #3a2251 !important;
      color: #34d399 !important;
    }
    [data-theme="dark"] .text-dark {
      color: #f8fafc !important;
    }
    [data-theme="dark"] .bg-light {
      background-color: #1a0b33 !important;
      border-color: #3a2251 !important;
    }
    [data-theme="dark"] .brand-badge-logo {
      border-color: #3a2251 !important;
      background: #1a0b33 !important;
    }
    [data-theme="dark"] .border-bottom {
      border-color: #3a2251 !important;
    }
    [data-theme="dark"] hr {
      border-color: #3a2251 !important;
    }
  </style>
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'po', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Minimalist Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <a class="btn-kov-secondary btn-kov-sm" href="/admin/operasional/po">
            <i class="fas fa-arrow-left"></i> <span class="d-none d-sm-inline">Kembali</span>
          </a>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Detail PO</h1>
            <span class="text-muted d-none d-md-inline" style="font-size: 0.85rem;">/ <%= po.no_po || ('PO/KOV/' + po.id) %></span>
          </div>
        </div>
        <div class="kov-topbar-right d-flex align-items-center gap-2">
          <!-- Coinbase Dual-Theme Switcher -->
          <button type="button" class="kov-theme-toggle" onclick="toggleKovTheme()" title="Ganti Mode Gelap / Terang (Coinbase Theme)">
            <i class="fas fa-moon kov-theme-icon"></i>
          </button>
          <a href="/admin/it?highlight=<%= encodeURIComponent(po.no_po || '') %>" class="btn-kov-secondary btn-kov-sm text-primary" title="Lihat di Rekap Belanja IT">
            <i class="fas fa-receipt text-success"></i> <span class="d-none d-sm-inline">Rekap IT</span>
          </a>
          <a href="/admin/operasional/po/create?copy_from=<%= po.id %>" class="btn-kov-secondary btn-kov-sm text-primary" title="Duplikat PO ini sebagai PO Baru">
            <i class="fas fa-copy"></i> <span class="d-none d-sm-inline">Duplikat PO</span>
          </a>
          <a href="/api/operasional/po/export/pdf/<%= po.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-danger btn-kov-sm">
            <i class="fas fa-file-pdf"></i> <span class="d-none d-sm-inline">Download PDF PO</span>
          </a>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

      <!-- Integration Status Banner -->
      <div class="alert alert-success d-flex align-items-center justify-content-between p-2.5 px-3 mb-3 rounded-3 border-0 bg-success-subtle text-success small shadow-sm">
        <div class="d-flex align-items-center gap-2">
          <i class="fas fa-circle-check fs-6 text-success"></i>
          <div>
            <strong>Tersinkron ke Rekap IT:</strong> Dokumen PO ini otomatis tercatat di data pembelanjaan IT.
          </div>
        </div>
        <a href="/admin/it?highlight=<%= encodeURIComponent(po.no_po || '') %>" class="btn btn-sm btn-success rounded-pill px-3 py-1 text-white fw-semibold" style="font-size: 0.75rem;">
          <i class="fas fa-arrow-up-right-from-square me-1"></i>Buka Rekap IT
        </a>
      </div>
    
    <div class="po-paper mb-4">
      <!-- Header Section -->
      <div class="row align-items-top mb-4 border-bottom pb-4">
        <div class="col-md-6 mb-3 mb-md-0">
          <div class="d-flex align-items-center gap-3 mb-2">
            <div class="brand-badge-logo">
              <img src="/logo_kov_2.jpg" alt="KOV Logo">
            </div>
            <div>
              <h4 class="fw-bold mb-0 text-dark">KOV GROUP / KOV KOFFIE</h4>
              <div class="small text-muted">Finance, Accounting &amp; Procurement</div>
            </div>
          </div>
          <div class="text-secondary small">Jl. Sultan Agung No.135, Kaliwiru, Kec. Candisari, Kota Semarang, Jawa Tengah 50232</div>
          <div class="small text-success fw-semibold"><i class="fab fa-instagram me-1"></i>IG : KOV KOFFIE</div>
        </div>
        <div class="col-md-6 text-md-end">
          <h2 class="fw-bold text-success mb-1" style="color: var(--kov-primary-600) !important;">PURCHASE ORDER</h2>
          <div class="fw-bold text-dark">No. PO : <%= po.no_po || ('PO/KOV/' + po.id) %></div>
          <div class="text-secondary small">Tanggal : <%= formatDate(po.tanggal_po) %></div>
          <div class="mt-2 d-flex justify-content-md-end align-items-center gap-2">
            <% 
              const sLow = (po.status_po || '').toLowerCase();
              let sPill = 'pill-success';
              if (sLow.includes('tolak') || sLow.includes('batal')) sPill = 'pill-danger';
              else if (sLow.includes('pending') || sLow.includes('review')) sPill = 'pill-warning';
              else if (sLow.includes('selesai')) sPill = 'pill-primary';
            %>
            <span class="status-pill-modern <%= sPill %>" style="font-size: 0.8rem;">
              <span class="status-dot-pulse"></span> <%= po.status_po || 'Reguler / Approved' %>
            </span>
            <div class="dropdown d-inline-block">
              <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="border-radius: 20px; font-size: 0.75rem; padding: 2px 10px;">
                <i class="fas fa-pen-to-square me-1"></i>Status PO
              </button>
              <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                <li>
                  <form action="/api/operasional/po/status/<%= po.id %>" method="POST" class="p-1">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input type="hidden" name="status_po" value="Reguler / Approved">
                    <button type="submit" class="dropdown-item rounded-2 small text-success py-1.5"><i class="fas fa-check-circle me-2"></i>Setujui (Approved)</button>
                  </form>
                </li>
                <li>
                  <form action="/api/operasional/po/status/<%= po.id %>" method="POST" class="p-1">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input type="hidden" name="status_po" value="Pending / Review">
                    <button type="submit" class="dropdown-item rounded-2 small text-warning py-1.5"><i class="fas fa-clock me-2"></i>Pending Review</button>
                  </form>
                </li>
                <li>
                  <form action="/api/operasional/po/status/<%= po.id %>" method="POST" class="p-1">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input type="hidden" name="status_po" value="Selesai / Terkirim">
                    <button type="submit" class="dropdown-item rounded-2 small text-primary py-1.5"><i class="fas fa-box-check me-2"></i>Selesai / Terkirim</button>
                  </form>
                </li>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                  <form action="/api/operasional/po/status/<%= po.id %>" method="POST" class="p-1">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <input type="hidden" name="status_po" value="Ditolak / Dibatalkan">
                    <button type="submit" class="dropdown-item rounded-2 small text-danger py-1.5"><i class="fas fa-times-circle me-2"></i>Tolak (Rejected)</button>
                  </form>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- Vendor & Shipping Details -->
      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <div class="card-box">
            <div class="card-box-header"><i class="fas fa-truck-field me-1"></i>Penyedia / Vendor (TO)</div>
            <div class="d-flex mb-1.5"><div class="fw-bold text-secondary small" style="width: 35%;">Nama Vendor:</div><div class="fw-bold text-dark small" style="width: 65%;"><%= po.vendor_nama || '-' %></div></div>
            <div class="d-flex mb-1.5"><div class="fw-bold text-secondary small" style="width: 35%;">Nama Dagang:</div><div class="small" style="width: 65%;"><%= po.vendor_nama_dagang || '-' %></div></div>
            <div class="d-flex mb-1.5"><div class="fw-bold text-secondary small" style="width: 35%;">Perihal:</div><div class="small" style="width: 65%;"><%= po.perihal || '-' %></div></div>
            <div class="d-flex"><div class="fw-bold text-secondary small" style="width: 35%;">Unit Kerja:</div><div class="fw-bold text-dark small" style="width: 65%;"><%= po.unit_kerja || '-' %></div></div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="card-box">
            <div class="card-box-header"><i class="fas fa-location-dot me-1"></i>Detail Pengiriman &amp; Pembayaran</div>
            <div class="d-flex mb-1.5"><div class="fw-bold text-secondary small" style="width: 35%;">Lokasi Kirim:</div><div class="small" style="width: 65%;"><%= po.lokasi_kirim || '-' %></div></div>
            <div class="d-flex mb-1.5"><div class="fw-bold text-secondary small" style="width: 35%;">Tgl Kirim:</div><div class="small" style="width: 65%;"><%= po.tgl_pengiriman ? formatDate(po.tgl_pengiriman) : '-' %></div></div>
            <div class="d-flex mb-1.5"><div class="fw-bold text-secondary small" style="width: 35%;">Termin Bayar:</div><div class="small" style="width: 65%;"><%= po.termin_bayar || '-' %></div></div>
            <div class="d-flex"><div class="fw-bold text-secondary small" style="width: 35%;">Mata Uang:</div><div class="small" style="width: 65%;"><%= po.mata_uang || 'IDR (Rupiah)' %></div></div>
          </div>
        </div>
      </div>

      <!-- Items Table -->
      <div class="table-responsive-modern mb-4">
        <table class="kov-table">
          <thead>
            <tr>
              <th class="ps-3" style="width: 50px;">NO</th>
              <th style="width: 50%;">KODE &amp; SPESIFIKASI DETAIL BARANG</th>
              <th class="text-center" style="width: 12%;">QTY</th>
              <th class="text-end" style="width: 18%;">HARGA SATUAN</th>
              <th class="text-end pe-3" style="width: 20%;">TOTAL HARGA</th>
            </tr>
          </thead>
          <tbody>
            <% 
              const items = typeof po.items === 'object' ? po.items : JSON.parse(po.items_json || '[]');
              if (items.length === 0) {
            %>
              <tr><td colspan="5" class="text-center text-muted py-4">Tidak ada barang dalam PO ini.</td></tr>
            <% } else { %>
              <% items.forEach((item, idx) => { %>
                <tr>
                  <td class="ps-3 fw-bold text-muted"><%= idx + 1 %></td>
                  <td>
                    <div class="fw-bold text-dark"><%= item.nama_kode || item.nama_barang || '-' %></div>
                    <div class="small text-muted"><%= item.spesifikasi || '-' %></div>
                  </td>
                  <td class="text-center fw-bold"><%= item.qty || 1 %> <%= item.satuan || 'PCS' %></td>
                  <td class="text-end">Rp <%= Number(item.harga_satuan || 0).toLocaleString('id-ID') %></td>
                  <td class="text-end pe-3 fw-bold text-dark">Rp <%= Number(item.total_harga || (item.qty * item.harga_satuan) || 0).toLocaleString('id-ID') %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>

      <!-- Financial Totals Block -->
      <div class="row justify-content-end mb-4">
        <div class="col-md-5">
          <div class="p-3 bg-light rounded-3 border">
            <div class="d-flex justify-content-between mb-2 small">
              <span class="fw-bold text-secondary">Subtotal:</span>
              <span class="fw-bold text-dark">Rp <%= Number(po.subtotal || 0).toLocaleString('id-ID') %></span>
            </div>
            <div class="d-flex justify-content-between mb-2 text-muted small">
              <span>PPN (<%= po.ppn_persen || 0 %>%):</span>
              <span>Rp <%= Number(po.ppn_nominal || 0).toLocaleString('id-ID') %></span>
            </div>
            <% if (po.diskon_nominal > 0) { %>
            <div class="d-flex justify-content-between mb-2 text-muted small">
              <span>Diskon:</span>
              <span>- Rp <%= Number(po.diskon_nominal || 0).toLocaleString('id-ID') %></span>
            </div>
            <% } %>
            <hr class="my-2">
            <div class="d-flex justify-content-between fs-5 fw-bold text-success">
              <span>TOTAL NETTO:</span>
              <span>Rp <%= Number(po.total_netto || po.subtotal || 0).toLocaleString('id-ID') %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Syarat & Ketentuan -->
      <div class="p-3 bg-light rounded-3 border mb-4">
        <h6 class="fw-bold text-dark mb-1 small"><i class="fas fa-file-contract text-primary me-1"></i>Syarat &amp; Ketentuan Pengadaan:</h6>
        <div class="small text-muted style-pre-line"><%= po.catatan_syarat || '-' %></div>
      </div>

      <!-- Signatures Block -->
      <div class="row text-center pt-3 g-3">
        <div class="col-md-4">
          <div class="fw-bold text-secondary small mb-2">Dibuat Oleh,</div>
          <div style="height: 60px;" class="d-flex align-items-center justify-content-center">
            <% if (po.signature_dibuat) { %>
              <img src="<%= po.signature_dibuat %>" style="max-height: 55px;" alt="TTD">
            <% } else { %>
              <span class="status-pill-modern pill-success" style="font-size: 0.75rem;">[ SIGNED DIGITAL ]</span>
            <% } %>
          </div>
          <div class="fw-bold text-dark mt-2"><%= po.dibuat_oleh_nama || 'ISWANDA ADITYA F.' %></div>
          <div class="small text-muted"><%= po.dibuat_oleh_jabatan || 'Procurement / Staff IT' %></div>
        </div>

        <div class="col-md-4">
          <div class="fw-bold text-secondary small mb-2">Disetujui Oleh,</div>
          <div style="height: 60px;" class="d-flex align-items-center justify-content-center">
            <span class="status-pill-modern pill-success" style="font-size: 0.8rem;">[ APPROVED ]</span>
          </div>
          <div class="fw-bold text-dark mt-2"><%= po.disetujui_oleh_nama || 'KEN' %></div>
          <div class="small text-muted"><%= po.disetujui_oleh_jabatan || 'Finance Manager' %></div>
        </div>

        <div class="col-md-4">
          <div class="fw-bold text-secondary small mb-2">Konfirmasi Vendor,</div>
          <div style="height: 60px;" class="d-flex align-items-center justify-content-center">
            <span class="text-muted fst-italic small">[ Stamp &amp; Sign ]</span>
          </div>
          <div class="fw-bold text-dark mt-2"><%= po.vendor_konfirmasi_nama || po.vendor_nama || 'PT AGRES INFO TEKNOLOGI' %></div>
          <div class="small text-muted"><%= po.vendor_konfirmasi_jabatan || 'Perwakilan Resmi' %></div>
        </div>
      </div>
    </div>

  </main>
    </div>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
