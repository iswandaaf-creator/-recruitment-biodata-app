                        </span>
                        <% if (isLolos) { %>
                          <div><span class="status-pill-modern pill-success" style="font-size: 0.7rem; padding: 2px 8px;"><span class="status-dot-pulse"></span> Lolos</span></div>
                        <% } else if (isHold) { %>
                          <div><span class="status-pill-modern pill-warning" style="font-size: 0.7rem; padding: 2px 8px;"><span class="status-dot-pulse"></span> Dipertimbangkan</span></div>
                        <% } else { %>
                          <div><span class="status-pill-modern pill-danger" style="font-size: 0.7rem; padding: 2px 8px;"><span class="status-dot-pulse"></span> Tidak Sesuai</span></div>
