<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Reviewer Pelamar - KOV Management Portal</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261029c" rel="stylesheet">
  <style>
    /* Reviewer Specific Dribbble Enhancements */
    .filter-btn {
      font-size: 0.8rem;
      font-weight: 600;
      border-radius: var(--kov-radius-pill);
      padding: 0.45rem 1rem;
      border: 1px solid var(--kov-slate-200);
      background: #ffffff;
      color: var(--kov-slate-600);
      cursor: pointer;
      transition: var(--kov-transition);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
    }
    .filter-btn:hover, .filter-btn.active {
      background: var(--dd-primary, #166534) !important;
      border-color: var(--dd-primary, #166534) !important;
      color: #ffffff !important;
      box-shadow: none !important;
    }
    .dd-folder-card:focus {
      outline: 3px solid rgba(255, 255, 255, 0.6);
      outline-offset: 2px;
    }
    .reviewer-grid-card {
      background: #ffffff;
      border-radius: 14px;
      padding: 16px 18px;
      border: 1px solid rgba(226, 232, 240, 0.75);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 100%;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    }
    .reviewer-grid-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(90, 96, 234, 0.08);
      border-color: rgba(90, 96, 234, 0.35);
    }
    [data-theme="dark"] .reviewer-grid-card {
      background: #181c2f;
      border-color: rgba(255, 255, 255, 0.08);
    }
  </style>
</head>
<body>

  <%
    const totalKandidat = (candidates || []).length;
    const belumDireview = (candidates || []).filter(c => !c.review_count || c.review_count === 0).length;
    const sudahDireview = (candidates || []).filter(c => c.review_count && c.review_count > 0).length;
    const direkomendasikan = (candidates || []).filter(c => (c.latest_rekomendasi || '').includes('Direkomendasikan Lolos') || (c.kesimpulan_status === 'Diterima')).length;
    const dipertimbangkan = (candidates || []).filter(c => (c.latest_rekomendasi || '').includes('Dipertimbangkan') || (c.kesimpulan_status === 'Dipertimbangkan')).length;
    const reviewPercent = totalKandidat > 0 ? Math.round((sudahDireview / totalKandidat) * 100) : 0;

    // Division Candidate Counts
    const baristaCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('barista')).length;
    const opsCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('operasional') || (c.divisi || '').toLowerCase().includes('staff') || (c.divisi || '').toLowerCase().includes('kasir')).length;
    const kitchenCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('kitchen') || (c.divisi || '').toLowerCase().includes('cook') || (c.divisi || '').toLowerCase().includes('pastry')).length;
    const teknisiCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('teknisi') || (c.divisi || '').toLowerCase().includes('maintenance') || (c.divisi || '').toLowerCase().includes('listrik')).length;
    const itCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('it') || (c.divisi || '').toLowerCase().includes('developer') || (c.divisi || '').toLowerCase().includes('support') || (c.divisi || '').toLowerCase().includes('tech')).length;
    const fatCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('fat') || (c.divisi || '').toLowerCase().includes('finance') || (c.divisi || '').toLowerCase().includes('akunting') || (c.divisi || '').toLowerCase().includes('tax')).length;
    const hrCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('hr') || (c.divisi || '').toLowerCase().includes('personalia') || (c.divisi || '').toLowerCase().includes('ga')).length;
  %>

  <div class="dd-layout-root kov-app-shell">

    <!-- 1. Deep Midnight Navy Sidebar Navigation (Pane 1) -->
    <%- include('partials/sidebar', { active: 'reviewer', user: typeof user !== 'undefined' ? user : null }) %>

    <!-- 2. Main Center Workspace Canvas (Pane 2) -->
    <main class="dd-main-canvas kov-main-content dd-theme" id="mainCanvas">

      <!-- Top Search & View Action Bar (Dribbble Signature - Symmetrical 46px Row) -->
      <div class="dd-topbar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="dd-search-container">
            <i class="fas fa-magnifying-glass dd-search-icon"></i>
            <input type="text" class="dd-search-input" id="searchInput" placeholder="Cari nama pelamar, posisi, kontak, atau nomor berkas..." aria-label="Cari nama pelamar" onkeyup="filterTable()">
          </div>
        </div>

        <div class="dd-topbar-actions">
          <button type="button" class="btn-topbar-action d-none d-sm-inline-flex" onclick="filterByStatusPill('BELUM')" title="Saring hanya pelamar yang belum direview">
            <i class="fas fa-clock text-warning"></i>
            <span>Perlu Tindakan (<%= belumDireview %>)</span>
          </button>
          <a href="/api/export/excel" class="btn-drive-upload" title="Export Rekap Pelamar ke Excel">
            <i class="fas fa-file-excel"></i>
            <span>Export Excel</span>
          </a>
        </div>
      </div>

      <div class="dd-body-content">

        <!-- Executive Command Header (Taste-Skill Framed Sheet) -->
        <div class="dd-hero-banner">
          <div class="dd-hero-content">
            <div class="d-flex align-items-center gap-2 mb-1">
              <span class="badge py-1 px-2" style="background: rgba(22, 101, 52, 0.1); color: #166534; border: 1px solid rgba(22, 101, 52, 0.22); border-radius: 6px; font-weight: 700; font-size: 11px;">
                EVALUASI PELAMAR
              </span>
              <span class="text-muted small">&bull;</span>
              <span class="text-muted small">Portal Penilai Divisi</span>
            </div>
            <h2 class="dd-hero-title">
              Portal Reviewer Divisi: <%= (typeof user !== 'undefined' && user && (user.nama || user.username)) ? (user.nama || user.username) : 'Staff Reviewer' %>
            </h2>
            <p class="dd-hero-subtitle">
              Berikan penilaian teknis kualifikasi, catatan wawancara, dan verifikasi kelolosan kandidat divisi Anda secara terpusat.
            </p>
            <div class="d-flex align-items-center gap-2 flex-wrap mb-2">
              <span class="small fw-semibold text-secondary" style="font-size: 0.78rem;">Divisi Penugasan:</span>
              <% if (allowedDivisions && allowedDivisions.length > 0) { %>
                <% allowedDivisions.forEach(div => { %>
                  <span class="status-pill-modern pill-success" style="font-size: 0.72rem; padding: 3px 10px;">
                    <span class="status-dot-pulse"></span> <%= div %>
                  </span>
                <% }); %>
              <% } else { %>
                <span class="status-pill-modern pill-warning" style="font-size: 0.72rem;">
                  <span class="status-dot-pulse"></span> Belum ada divisi spesifik
                </span>
              <% } %>
            </div>
            <div class="d-flex align-items-center gap-2 flex-nowrap overflow-x-auto pt-1">
              <button type="button" class="btn-dd-hero text-nowrap" onclick="filterByStatusPill('BELUM')">
                <i class="fas fa-pen-to-square me-1.5"></i> Mulai Review Berkas (<%= belumDireview %>)
              </button>
              <a href="/api/export/excel" class="btn-kov-outline btn-sm text-nowrap" style="font-size: 0.82rem; padding: 7px 14px;">
                <i class="fas fa-file-excel text-success me-1.5"></i> Export Rekap Excel
              </a>
            </div>
          </div>
          <div class="dd-hero-illustration d-none d-lg-flex align-items-center justify-content-center pe-3" style="opacity: 0.9;">
            <svg width="140" height="110" viewBox="0 0 140 110" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="20" y="18" width="88" height="82" rx="6" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1.5" />
              <rect x="32" y="8" width="88" height="82" rx="6" fill="#ffffff" stroke="#166534" stroke-width="1.5" />
              <line x1="45" y1="22" x2="78" y2="22" stroke="#166534" stroke-width="2" stroke-linecap="round" />
              <line x1="45" y1="32" x2="105" y2="32" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" />
              <line x1="45" y1="42" x2="95" y2="42" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" />
              <circle cx="50" cy="58" r="5" fill="#166534" fill-opacity="0.12" stroke="#166534" stroke-width="1.5" />
              <path d="M48 58L50 60L53 56" stroke="#166534" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              <line x1="62" y1="58" x2="105" y2="58" stroke="#64748b" stroke-width="1.5" stroke-linecap="round" />
              <circle cx="50" cy="72" r="5" fill="#f8fafc" stroke="#94a3b8" stroke-width="1.5" />
              <line x1="62" y1="72" x2="90" y2="72" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </div>
        </div>

        <!-- Alert Notification if any -->
        <% if (typeof success !== 'undefined' && success) { %>
          <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 shadow-xs" role="alert">
            <i class="fas fa-circle-check me-2"></i> <%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 shadow-xs" role="alert">
            <i class="fas fa-circle-exclamation me-2"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <!-- Executive KPI Metric Strip (Taste-Skill Framed Sheet) -->
        <div class="row g-2 mb-3">
          <div class="col-6 col-lg-3">
            <div class="coinbase-kpi-card h-100" onclick="filterByStatusPill('ALL')" role="button" style="cursor: pointer;" title="Tampilkan semua berkas penugasan">
              <div class="w-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="bento-metric-title">Total Penugasan</span>
                  <div class="kov-metric-icon-box text-primary"><i class="fas fa-clipboard-list"></i></div>
                </div>
                <div class="bento-metric-value text-primary"><%= totalKandidat %></div>
                <div class="bento-metric-sub">Sesuai divisi reviewer</div>
              </div>
            </div>
          </div>

          <div class="col-6 col-lg-3">
            <div class="coinbase-kpi-card h-100" onclick="filterByStatusPill('BELUM')" role="button" style="cursor: pointer;" title="Saring berkas belum direview">
              <div class="w-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="bento-metric-title text-warning">Belum Direview</span>
                  <div class="kov-metric-icon-box text-warning" style="color: var(--kov-amber) !important;"><i class="fas fa-clock"></i></div>
                </div>
                <div class="bento-metric-value text-warning" style="color: var(--kov-amber) !important;"><%= belumDireview %></div>
                <div class="bento-metric-sub">Perlu scoring &amp; evaluasi</div>
              </div>
            </div>
          </div>

          <div class="col-6 col-lg-3">
            <div class="coinbase-kpi-card h-100" onclick="filterByStatusPill('SUDAH')" role="button" style="cursor: pointer;" title="Saring berkas sudah direview">
              <div class="w-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="bento-metric-title text-success">Sudah Direview</span>
                  <div class="kov-metric-icon-box text-success" style="color: var(--kov-primary-600) !important;"><i class="fas fa-circle-check"></i></div>
                </div>
                <div class="bento-metric-value" style="color: var(--kov-primary-600);"><%= sudahDireview %></div>
                <div class="bento-metric-sub">Telah diberi rekomendasi</div>
              </div>
            </div>
          </div>

          <div class="col-6 col-lg-3">
            <div class="coinbase-kpi-card h-100" role="button" style="cursor: pointer;">
              <div class="w-100">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="bento-metric-title text-info">Tingkat Progres</span>
                  <div class="kov-metric-icon-box text-info" style="color: #0284c7 !important;"><i class="fas fa-chart-pie"></i></div>
                </div>
                <div class="bento-metric-value text-info" style="color: #0284c7 !important;">
                  <%= totalKandidat > 0 ? Math.round((sudahDireview / totalKandidat) * 100) : 0 %>%
                </div>
                <div class="bento-metric-sub">Penyelesaian review divisi</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Kategori Divisi (Vibrant Folder Cards - 8 Symmetrical Cards) -->
        <div class="dd-section-header">
          <div class="d-flex align-items-center gap-2">
            <h3 class="dd-section-title">Kategori Divisi</h3>
            <span class="badge rounded-pill" style="background: rgba(90, 96, 234, 0.12); color: var(--dd-primary, #5a60ea); font-size: 0.76rem; font-weight: 700; padding: 4px 10px;">8 Divisi Lengkap</span>
          </div>
          <a href="javascript:void(0)" onclick="filterByDivisiQuick('all')" class="dd-view-all-link" id="btnViewAllDivisions" title="Reset filter dan tampilkan seluruh pelamar">
            <span>Tampilkan Semua</span> <i class="fas fa-rotate-left ms-1" style="font-size: 0.72rem;"></i>
          </a>
        </div>

        <div class="dd-folders-grid" id="foldersGrid">
          <!-- 1. Barista (Coral Red) -->
          <div class="dd-folder-card dd-folder-coral folder-coral" data-divisi="barista" onclick="filterByDivisiQuick('barista')" title="Filter Divisi Barista" role="button" tabindex="0">
            <div class="dd-folder-top">
              <div class="dd-folder-icon"><i class="fas fa-mug-hot"></i></div>
              <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
            </div>
            <div class="dd-folder-body">
              <h4 class="dd-folder-name">Barista &amp; Cafe</h4>
              <div class="dd-avatar-group">
                <span class="dd-avatar-chip">B1</span>
                <span class="dd-avatar-chip">B2</span>
                <span class="dd-avatar-chip dd-avatar-chip-more">+<%= baristaCount %></span>
              </div>
            </div>
            <div class="dd-folder-footer">
              <span class="dd-file-count"><i class="far fa-folder"></i> <%= baristaCount %> Berkas</span>
              <span class="dd-file-weight"><i class="fas fa-mug-hot"></i> Barista</span>
            </div>
          </div>

          <!-- 2. Operasional Outlet (Royal Blue) -->
          <div class="dd-folder-card dd-folder-royal folder-blue" data-divisi="operasional" onclick="filterByDivisiQuick('operasional')" title="Filter Divisi Operasional" role="button" tabindex="0">
            <div class="dd-folder-top">
              <div class="dd-folder-icon"><i class="fas fa-briefcase"></i></div>
              <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
            </div>
            <div class="dd-folder-body">
              <h4 class="dd-folder-name">Operasional Outlet</h4>
              <div class="dd-avatar-group">
                <span class="dd-avatar-chip">OF</span>
                <span class="dd-avatar-chip">HR</span>
                <span class="dd-avatar-chip dd-avatar-chip-more">+<%= opsCount %></span>
              </div>
            </div>
            <div class="dd-folder-footer">
              <span class="dd-file-count"><i class="far fa-folder"></i> <%= opsCount %> Berkas</span>
              <span class="dd-file-weight"><i class="fas fa-briefcase"></i> Outlet</span>
            </div>
          </div>

          <!-- 3. Kitchen & Pastry (Amber Gold) -->
          <div class="dd-folder-card dd-folder-amber folder-amber" data-divisi="kitchen" onclick="filterByDivisiQuick('kitchen')" title="Filter Divisi Kitchen" role="button" tabindex="0">
            <div class="dd-folder-top">
              <div class="dd-folder-icon"><i class="fas fa-utensils"></i></div>
              <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
            </div>
            <div class="dd-folder-body">
              <h4 class="dd-folder-name">Kitchen &amp; Pastry</h4>
              <div class="dd-avatar-group">
                <span class="dd-avatar-chip">K1</span>
                <span class="dd-avatar-chip">K2</span>
                <span class="dd-avatar-chip dd-avatar-chip-more">+<%= kitchenCount %></span>
              </div>
            </div>
            <div class="dd-folder-footer">
              <span class="dd-file-count"><i class="far fa-folder"></i> <%= kitchenCount %> Berkas</span>
              <span class="dd-file-weight"><i class="fas fa-utensils"></i> Kitchen</span>
            </div>
          </div>

          <!-- 4. Teknisi & ME (Cyan Teal) -->
          <div class="dd-folder-card dd-folder-cyan folder-cyan" data-divisi="teknisi" onclick="filterByDivisiQuick('teknisi')" title="Filter Divisi Teknisi & ME" role="button" tabindex="0">
            <div class="dd-folder-top">
              <div class="dd-folder-icon"><i class="fas fa-wrench"></i></div>
              <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
            </div>
            <div class="dd-folder-body">
              <h4 class="dd-folder-name">Teknisi &amp; ME</h4>
              <div class="dd-avatar-group">
                <span class="dd-avatar-chip">TK</span>
                <span class="dd-avatar-chip">ME</span>
                <span class="dd-avatar-chip dd-avatar-chip-more">+<%= teknisiCount %></span>
              </div>
            </div>
            <div class="dd-folder-footer">
              <span class="dd-file-count"><i class="far fa-folder"></i> <%= teknisiCount %> Berkas</span>
              <span class="dd-file-weight"><i class="fas fa-wrench"></i> Teknisi</span>
            </div>
          </div>

          <!-- 5. IT & Systems (Violet Purple) -->
          <div class="dd-folder-card dd-folder-violet folder-violet" data-divisi="it" onclick="filterByDivisiQuick('it')" title="Filter Divisi IT & Sistem" role="button" tabindex="0">
            <div class="dd-folder-top">
              <div class="dd-folder-icon"><i class="fas fa-laptop-code"></i></div>
              <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
            </div>
            <div class="dd-folder-body">
              <h4 class="dd-folder-name">IT &amp; Systems</h4>
              <div class="dd-avatar-group">
                <span class="dd-avatar-chip">IT</span>
                <span class="dd-avatar-chip">DV</span>
                <span class="dd-avatar-chip dd-avatar-chip-more">+<%= itCount %></span>
              </div>
            </div>
            <div class="dd-folder-footer">
              <span class="dd-file-count"><i class="far fa-folder"></i> <%= itCount %> Berkas</span>
              <span class="dd-file-weight"><i class="fas fa-laptop-code"></i> IT Dept</span>
            </div>
          </div>

          <!-- 6. FAT / Finance & Tax (Emerald Mint) -->
          <div class="dd-folder-card dd-folder-emerald folder-emerald" data-divisi="fat" onclick="filterByDivisiQuick('fat')" title="Filter Divisi FAT / Finance" role="button" tabindex="0">
            <div class="dd-folder-top">
              <div class="dd-folder-icon"><i class="fas fa-file-invoice-dollar"></i></div>
              <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
            </div>
            <div class="dd-folder-body">
              <h4 class="dd-folder-name">FAT (Finance)</h4>
              <div class="dd-avatar-group">
                <span class="dd-avatar-chip">FA</span>
                <span class="dd-avatar-chip">TX</span>
                <span class="dd-avatar-chip dd-avatar-chip-more">+<%= fatCount %></span>
              </div>
            </div>
            <div class="dd-folder-footer">
              <span class="dd-file-count"><i class="far fa-folder"></i> <%= fatCount %> Berkas</span>
              <span class="dd-file-weight"><i class="fas fa-file-invoice-dollar"></i> Finance</span>
            </div>
          </div>

          <!-- 7. HR & GA (Rose Crimson) -->
          <div class="dd-folder-card dd-folder-rose folder-rose" data-divisi="hr" onclick="filterByDivisiQuick('hr')" title="Filter Divisi HR & GA" role="button" tabindex="0">
            <div class="dd-folder-top">
              <div class="dd-folder-icon"><i class="fas fa-user-tie"></i></div>
              <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
            </div>
            <div class="dd-folder-body">
              <h4 class="dd-folder-name">HR &amp; GA</h4>
              <div class="dd-avatar-group">
                <span class="dd-avatar-chip">HR</span>
                <span class="dd-avatar-chip">GA</span>
                <span class="dd-avatar-chip dd-avatar-chip-more">+<%= hrCount %></span>
              </div>
            </div>
            <div class="dd-folder-footer">
              <span class="dd-file-count"><i class="far fa-folder"></i> <%= hrCount %> Berkas</span>
              <span class="dd-file-weight"><i class="fas fa-user-tie"></i> HRGA</span>
            </div>
          </div>

          <!-- 8. Semua Pelamar (Midnight Indigo) -->
          <div class="dd-folder-card dd-folder-indigo folder-indigo active" data-divisi="all" onclick="filterByDivisiQuick('all')" title="Tampilkan Seluruh Pelamar" role="button" tabindex="0">
            <div class="dd-folder-top">
              <div class="dd-folder-icon"><i class="fas fa-users-viewfinder"></i></div>
              <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
            </div>
            <div class="dd-folder-body">
              <h4 class="dd-folder-name">Semua Kandidat</h4>
              <div class="dd-avatar-group">
                <span class="dd-avatar-chip">KV</span>
                <span class="dd-avatar-chip">ALL</span>
                <span class="dd-avatar-chip dd-avatar-chip-more">+<%= totalKandidat %></span>
              </div>
            </div>
            <div class="dd-folder-footer">
              <span class="dd-file-count"><i class="far fa-folder-open"></i> <%= totalKandidat %> Berkas</span>
              <span class="dd-file-weight"><i class="fas fa-circle-check"></i> Terverifikasi</span>
            </div>
          </div>
        </div>

        <!-- Recent Candidates Section (Modern Botanical / Dribbble High-Contrast) -->
        <div class="dd-section-header mt-4">
          <div class="d-flex align-items-center gap-2">
            <h3 class="dd-section-title">Daftar Berkas Pelamar</h3>
            <span class="badge rounded-pill bg-light text-dark border px-2.5 py-1" id="candidateCountBadge" style="font-size: 0.75rem; font-weight: 700;">
              <%= totalKandidat %> Berkas
            </span>
          </div>

          <!-- Segmented Filter Pills -->
          <div class="d-flex align-items-center gap-1.5 flex-wrap">
            <button type="button" class="filter-btn active" data-filter="ALL" onclick="setStatusFilter('ALL', this)">
              Semua (<%= totalKandidat %>)
            </button>
            <button type="button" class="filter-btn" data-filter="BELUM" onclick="setStatusFilter('BELUM', this)">
              <i class="fas fa-clock text-warning"></i> Belum Direview (<%= belumDireview %>)
            </button>
            <button type="button" class="filter-btn" data-filter="SUDAH" onclick="setStatusFilter('SUDAH', this)">
              <i class="fas fa-check text-success"></i> Sudah Direview (<%= sudahDireview %>)
            </button>
            <button type="button" class="filter-btn" data-filter="LOLOS" onclick="setStatusFilter('LOLOS', this)">
              <i class="fas fa-circle-check text-primary"></i> Direkomendasikan (<%= direkomendasikan %>)
            </button>
            <button type="button" class="filter-btn" data-filter="HOLD" onclick="setStatusFilter('HOLD', this)">
              <i class="fas fa-hourglass-half text-warning"></i> Dipertimbangkan (<%= dipertimbangkan %>)
            </button>
          </div>
        </div>

        <!-- Active Calendar Date Filter Alert Chip -->
        <div id="activeDateBadgeWrap" class="d-none pt-2 pb-1">
          <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.8rem; font-weight: 700;">
            <i class="far fa-calendar-check"></i>
            <span id="activeDateBadgeText">Filter Tanggal: 26 Oktober 2026</span>
            <button type="button" onclick="clearCalDateFilter()" class="btn-close ms-1" style="font-size: 0.6rem; cursor: pointer;" aria-label="Hapus Filter Tanggal" title="Hapus Filter Tanggal"></button>
          </div>
        </div>
        <select id="divisionFilter" class="d-none">
          <option value="ALL">Semua</option>
          <option value="barista">Barista</option>
          <option value="operasional">Operasional</option>
          <option value="kitchen">Kitchen</option>
          <option value="teknisi">Teknisi</option>
          <option value="it">IT</option>
          <option value="fat">FAT</option>
          <option value="hr">HR</option>
        </select>

        <!-- VIEW MODE 1: GRID VIEW -->
        <div id="candidatesGridView" class="row g-3 mb-4">
          <% if (candidates.length === 0) { %>
            <div class="col-12 text-center py-5">
              <i class="fas fa-folder-open fa-3x text-secondary opacity-50 mb-3"></i>
              <h5 class="fw-bold text-dark">Belum Ada Pelamar Masuk</h5>
              <p class="small text-muted mb-0">Saat ini belum ada berkas pelamar untuk divisi penugasan Anda.</p>
            </div>
          <% } %>

          <% candidates.forEach(c => {
            const dLow = (c.divisi || 'operasional').toLowerCase();
            const hasReview = c.review_count && c.review_count > 0;
            const isLolos = (c.latest_rekomendasi || '').includes('Direkomendasikan Lolos') || (c.kesimpulan_status === 'Diterima');
            const isHold = (c.latest_rekomendasi || '').includes('Dipertimbangkan') || (c.kesimpulan_status === 'Dipertimbangkan');
          %>
            <div class="col-md-6 col-xl-4 candidate-grid-item"
                 data-id="<%= c.id %>"
                 data-name="<%= (c.nama_lengkap || '').toLowerCase() %>"
                 data-posisi="<%= (c.posisi_dilamar || '').toLowerCase() %>"
                 data-divisi="<%= dLow %>"
                 data-hasreview="<%= hasReview ? 'true' : 'false' %>"
                 data-isrecommended="<%= isLolos ? 'true' : 'false' %>"
                 data-ishold="<%= isHold ? 'true' : 'false' %>"
                 data-date="<%= c.created_at ? new Date(c.created_at).getTime() : 0 %>">
              <div class="reviewer-grid-card shadow-xs">
                <div>
                  <div class="d-flex align-items-start justify-content-between gap-2 mb-3">
                    <div class="d-flex align-items-center gap-2.5">
                      <% if (c.foto_kandidat) { %>
                        <img src="<%= c.foto_kandidat %>" class="rounded-circle border shadow-xs flex-shrink-0" style="width: 44px; height: 44px; object-fit: cover;">
                      <% } else { %>
                        <div class="user-avatar-initials flex-shrink-0" style="width: 44px; height: 44px; font-size: 1rem;">
                          <%= c.nama_lengkap ? c.nama_lengkap.charAt(0).toUpperCase() : 'P' %>
                        </div>
                      <% } %>
                      <div>
                        <h6 class="fw-bold text-dark mb-0 leading-tight"><%= c.nama_lengkap %></h6>
                        <span class="text-muted" style="font-size: 0.74rem;">
                          <i class="far fa-clock me-1"></i><%= formatDate(c.created_at, true) %>
                        </span>
                      </div>
                    </div>
                    <span class="badge bg-light text-dark border px-2 py-1" style="font-size: 0.72rem; font-weight: 700;">
                      #<%= c.id %>
                    </span>
                  </div>

                  <div class="mb-2.5">
                    <div class="small fw-semibold text-dark"><i class="fas fa-briefcase text-muted me-1.5"></i><%= c.posisi_dilamar %></div>
