                        </div>
                      </div>
                    </td>
                    <td>
                      <div class="mb-1"><span class="badge bg-light text-dark border px-2 py-1"><%= c.divisi || 'Operasional' %></span></div>
                      <div class="small fw-semibold text-dark"><%= c.posisi_dilamar %></div>
