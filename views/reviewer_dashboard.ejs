<!DOCTYPE html>
<html lang="id">
<head>
  <!-- Security: Masking Address Bar agar direktori internal tidak terekspos -->
  <script>
    (function() {
      try {
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, document.title, '/');
        }
      } catch (e) {}
    })();
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Reviewer Pelamar - KOV Management Portal</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --kov-emerald: #059669;
      --kov-slate-900: #0f172a;
      --kov-slate-800: #1e293b;
      --kov-border: #e2e8f0;
      --kov-primary: #2563eb;
    }
    * {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    body { background-color: #f8fafc; color: #1e293b; min-height: 100vh; }
    .top-navbar {
      background: #0f172a;
      border-bottom: 1px solid #1e293b;
      padding: 0.75rem 1.5rem;
    }
    .metric-card {
      background: #ffffff;
      border: 1px solid var(--kov-border);
      border-radius: 14px;
      padding: 1.25rem;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
      transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .metric-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.07);
    }
    .metric-title {
      font-size: 0.8rem;
      font-weight: 600;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .metric-value {
      font-size: 1.85rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
      margin-top: 0.25rem;
    }
    .metric-icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }
    .card-table {
      background: #ffffff;
      border: 1px solid var(--kov-border);
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 1px 3px 0 rgba(0,0,0,0.04);
    }
    .div-badge {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.25rem 0.55rem;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .div-kitchen { background: #ffedd5; color: #c2410c; border: 1px solid #fed7aa; }
    .div-barista { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .div-operasional { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
    .div-hr { background: #f3e8ff; color: #7e22ce; border: 1px solid #e9d5ff; }
    .div-teknisi { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
    .div-fat { background: #ede9fe; color: #5b21b6; border: 1px solid #ddd6fe; }
    .div-it { background: #cffafe; color: #0e7490; border: 1px solid #a5f3fc; }

    .filter-btn {
      font-size: 0.825rem;
      font-weight: 600;
      border-radius: 8px;
      padding: 0.4rem 0.85rem;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      color: #475569;
      cursor: pointer;
      transition: all 0.15s;
    }
    .filter-btn:hover, .filter-btn.active {
      background: #0f172a;
      border-color: #0f172a;
      color: #ffffff;
    }
  </style>
</head>
<body>

  <!-- Top Navbar -->
  <nav class="top-navbar shadow-sm">
    <div class="container-fluid px-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
      <div class="d-flex align-items-center gap-2">
        <span class="navbar-brand text-white fw-bold mb-0 fs-5 d-flex align-items-center">
          <i class="fas fa-clipboard-check text-warning me-2"></i>Portal Reviewer Pelamar
        </span>
        <span class="badge bg-warning text-dark fw-bold px-2 py-1 ms-1" style="font-size: 0.75rem;">
          ROLE: USER REVIEWER
        </span>
      </div>

      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% if (user.role === 'superadmin' || user.role === 'admin') { %>
          <a href="/admin" class="btn btn-outline-light btn-sm fw-semibold">
            <i class="fas fa-arrow-left me-1"></i> Dashboard Utama HR
          </a>
          <a href="/admin/users" class="btn btn-warning btn-sm fw-semibold text-dark">
            <i class="fas fa-users-gear me-1"></i> Kelola User
          </a>
        <% } %>

        <div class="d-flex align-items-center text-white px-3 py-1 rounded bg-slate-800" style="background: rgba(255,255,255,0.08); font-size: 0.825rem;">
          <i class="fas fa-circle-user text-warning me-2"></i>
          <span class="fw-semibold"><%= user.nama || user.username %></span>
          <span class="text-white-50 ms-1">(<%= user.role %>)</span>
        </div>

        <a href="/admin/logout" onclick="sessionStorage.clear();" class="btn btn-outline-danger btn-sm text-white border-secondary">
          <i class="fas fa-arrow-right-from-bracket me-1"></i> Logout
        </a>
      </div>
    </div>
  </nav>

  <div class="container-fluid px-4 py-4">

    <!-- Greeting & Assigned Divisions Banner -->
    <div class="card mb-4 border-0 shadow-sm" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: white; border-radius: 14px;">
      <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
          <div>
            <h4 class="fw-bold mb-1">
              <i class="fas fa-user-check text-warning me-2"></i>Selamat Datang, <%= user.nama || user.username %>!
            </h4>
            <p class="text-white-50 mb-2 small">
              Tugas Anda adalah mereview biodata pelamar yang masuk dan memberikan catatan evaluasi teknis untuk divisi yang ditugaskan kepada Anda.
            </p>
            <div class="d-flex align-items-center flex-wrap gap-2 mt-2">
              <span class="small text-white-50 fw-semibold">Divisi Tanggung Jawab Review Anda:</span>
              <% if (allowedDivisions.length > 0) { %>
                <% allowedDivisions.forEach(div => { 
                  const dLow = div.toLowerCase();
                  let cls = 'div-operasional';
                  if (dLow.includes('kitchen')) cls = 'div-kitchen';
                  else if (dLow.includes('barista')) cls = 'div-barista';
                  else if (dLow.includes('hr')) cls = 'div-hr';
                  else if (dLow.includes('teknisi')) cls = 'div-teknisi';
                  else if (dLow.includes('fat') || dLow.includes('finance')) cls = 'div-fat';
                  else if (dLow.includes('it')) cls = 'div-it';
                %>
                  <span class="div-badge <%= cls %>"><i class="fas fa-check-circle me-1"></i><%= div %></span>
                <% }); %>
              <% } else { %>
                <span class="badge bg-warning text-dark"><i class="fas fa-circle-exclamation me-1"></i>Belum ada divisi yang ditempelkan oleh Super Admin</span>
              <% } %>
            </div>
          </div>
          <div class="text-end">
            <span class="badge bg-white bg-opacity-10 border border-light border-opacity-25 p-2 px-3 fs-6">
              <i class="fas fa-layer-group text-warning me-1"></i> Total Pelamar Divisi Anda: <strong><%= candidates.length %></strong>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Alert Notification if any -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- Bento Metric Cards -->
    <% 
      const totalKandidat = candidates.length;
      const belumDireview = candidates.filter(c => !c.review_count || c.review_count === 0).length;
      const sudahDireview = candidates.filter(c => c.review_count && c.review_count > 0).length;
      const direkomendasikan = candidates.filter(c => (c.latest_rekomendasi || '').includes('Direkomendasikan Lolos') || (c.kesimpulan_status === 'Diterima')).length;
    %>
    <div class="row g-3 mb-4">
      <div class="col-md-3 col-6">
        <div class="metric-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="metric-title">Total Berkas Pelamar</div>
              <div class="metric-value text-primary"><%= totalKandidat %></div>
            </div>
            <div class="metric-icon-wrap" style="background: #eff6ff; color: #2563eb;">
              <i class="fas fa-folder-open"></i>
            </div>
          </div>
          <div class="mt-2 text-muted" style="font-size: 0.75rem;">Sesuai divisi yang Anda review</div>
        </div>
      </div>

      <div class="col-md-3 col-6">
        <div class="metric-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="metric-title text-warning">Belum Ada Catatan</div>
              <div class="metric-value text-warning" style="color: #d97706 !important;"><%= belumDireview %></div>
            </div>
            <div class="metric-icon-wrap" style="background: #fffbeb; color: #d97706;">
              <i class="fas fa-clock"></i>
            </div>
          </div>
          <div class="mt-2 text-muted" style="font-size: 0.75rem;">Menunggu review dari Anda</div>
        </div>
      </div>

      <div class="col-md-3 col-6">
        <div class="metric-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="metric-title text-info">Sudah Direview</div>
              <div class="metric-value text-info" style="color: #0284c7 !important;"><%= sudahDireview %></div>
            </div>
            <div class="metric-icon-wrap" style="background: #f0f9ff; color: #0284c7;">
              <i class="fas fa-check-double"></i>
            </div>
          </div>
          <div class="mt-2 text-muted" style="font-size: 0.75rem;">Sudah memiliki catatan evaluasi</div>
        </div>
      </div>

      <div class="col-md-3 col-6">
        <div class="metric-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="metric-title text-success">Direkomendasikan</div>
              <div class="metric-value text-success" style="color: #059669 !important;"><%= direkomendasikan %></div>
            </div>
            <div class="metric-icon-wrap" style="background: #ecfdf5; color: #059669;">
              <i class="fas fa-circle-check"></i>
            </div>
          </div>
          <div class="mt-2 text-muted" style="font-size: 0.75rem;">Dinilai cocok untuk lanjut proses</div>
        </div>
      </div>
    </div>

    <!-- Candidate List Table Card -->
    <div class="card-table">
      <!-- Toolbar & Filters -->
      <div class="p-3 border-bottom bg-white d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
          <!-- Search input -->
          <div class="input-group" style="width: 280px;">
            <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0 ps-0" id="searchInput" placeholder="Cari nama atau posisi..." onkeyup="filterTable()">
          </div>

          <!-- Divisi Filter Dropdown -->
          <% if (allowedDivisions.length > 1) { %>
            <select class="form-select" id="divisionFilter" style="width: 180px;" onchange="filterTable()">
              <option value="ALL">Semua Divisi Anda</option>
              <% allowedDivisions.forEach(div => { %>
                <option value="<%= div.toLowerCase() %>"><%= div %></option>
              <% }); %>
            </select>
          <% } %>
        </div>

        <!-- Filter Status Buttons -->
        <div class="d-flex flex-wrap align-items-center gap-1">
          <button type="button" class="filter-btn active" data-status="ALL" onclick="setStatusFilter('ALL', this)">
            Semua (<%= totalKandidat %>)
          </button>
          <button type="button" class="filter-btn" data-status="BELUM" onclick="setStatusFilter('BELUM', this)">
            <i class="fas fa-clock text-warning me-1"></i>Belum Direview (<%= belumDireview %>)
          </button>
          <button type="button" class="filter-btn" data-status="SUDAH" onclick="setStatusFilter('SUDAH', this)">
            <i class="fas fa-check text-success me-1"></i>Sudah Direview (<%= sudahDireview %>)
          </button>
        </div>
      </div>

      <!-- Table -->
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="candidateReviewTable">
          <thead class="table-light">
            <tr>
              <th class="ps-4" style="width: 60px;">ID</th>
              <th style="min-width: 130px;">Tgl Melamar</th>
              <th style="min-width: 250px;">Nama Pelamar & Kontak</th>
              <th style="min-width: 170px;">Divisi & Posisi</th>
              <th style="min-width: 160px;">Status Catatan Review</th>
              <th style="min-width: 220px;">Catatan Terakhir Reviewer</th>
              <th class="text-center pe-4" style="min-width: 180px;">Aksi</th>
            </tr>
          </thead>
          <tbody id="candidateTableBody">
            <% if (candidates.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <div class="py-4">
                    <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                    <h5 class="fw-bold text-dark">Belum Ada Pelamar Masuk</h5>
                    <p class="small text-muted mb-0">
                      Saat ini belum ada data pelamar yang melamar untuk divisi: <strong><%= allowedDivisions.join(', ') || 'Semua' %></strong>.
                    </p>
                  </div>
                </td>
              </tr>
            <% } %>

            <% candidates.forEach(c => { 
              const dLow = (c.divisi || 'operasional').toLowerCase();
              let cls = 'div-operasional';
              if (dLow.includes('kitchen')) cls = 'div-kitchen';
              else if (dLow.includes('barista')) cls = 'div-barista';
              else if (dLow.includes('hr')) cls = 'div-hr';
              else if (dLow.includes('teknisi')) cls = 'div-teknisi';
              else if (dLow.includes('fat') || dLow.includes('finance')) cls = 'div-fat';
              else if (dLow.includes('it')) cls = 'div-it';

              const hasReview = c.review_count && c.review_count > 0;
            %>
              <tr class="candidate-row"
                  data-name="<%= (c.nama_lengkap || '').toLowerCase() %>"
                  data-posisi="<%= (c.posisi_dilamar || '').toLowerCase() %>"
                  data-divisi="<%= dLow %>"
                  data-hasreview="<%= hasReview ? 'true' : 'false' %>">
                <td class="ps-4 fw-bold text-muted">#<%= c.id %></td>
                <td class="small text-secondary fw-semibold">
                  <%= formatDate(c.created_at, true) %>
                </td>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <% if (c.foto_kandidat) { %>
                      <img src="<%= c.foto_kandidat %>" class="rounded-circle border shadow-sm flex-shrink-0" style="width: 40px; height: 40px; object-fit: cover;">
                    <% } else { %>
                      <div class="rounded-circle d-flex align-items-center justify-content-center text-secondary fw-bold flex-shrink-0" style="width: 40px; height: 40px; font-size: 14px; background: #e2e8f0; color: #475569;">
                        <%= c.nama_lengkap ? c.nama_lengkap.charAt(0).toUpperCase() : 'P' %>
                      </div>
                    <% } %>
                    <div>
                      <div class="fw-bold text-dark"><%= c.nama_lengkap %></div>
                      <div class="text-muted" style="font-size: 0.76rem;">
                        <i class="fas fa-phone me-1"></i><%= c.no_hp || '-' %> | <i class="fas fa-location-dot me-1"></i><%= c.kota_domisili || c.kota_ktp || '-' %>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="mb-1"><span class="div-badge <%= cls %>"><%= c.divisi || 'Operasional' %></span></div>
                  <div class="small fw-semibold text-dark"><%= c.posisi_dilamar %></div>
                </td>
                <td>
                  <% if (hasReview) { %>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1">
                      <i class="fas fa-check-circle me-1"></i><%= c.review_count %> Catatan Review
                    </span>
                    <% if (c.latest_rekomendasi) { %>
                      <div class="mt-1" style="font-size: 0.72rem;">
                        <% if (c.latest_rekomendasi.includes('Direkomendasikan Lolos')) { %>
                          <span class="badge bg-success text-white">Lolos</span>
                        <% } else if (c.latest_rekomendasi.includes('Dipertimbangkan')) { %>
                          <span class="badge bg-warning text-dark">Dipertimbangkan</span>
                        <% } else { %>
                          <span class="badge bg-danger text-white">Tidak Sesuai</span>
                        <% } %>
                      </div>
                    <% } %>
                  <% } else { %>
                    <span class="badge bg-warning bg-opacity-15 text-warning-emphasis border border-warning px-2 py-1">
                      <i class="fas fa-clock me-1"></i>Belum Direview
                    </span>
                  <% } %>
                </td>
                <td>
                  <% if (c.latest_catatan) { %>
                    <div class="small text-dark text-truncate" style="max-width: 250px;" title="<%= c.latest_catatan %>">
                      "<%= c.latest_catatan %>"
                    </div>
                    <div class="text-muted" style="font-size: 0.7rem;">
                      Oleh: <%= c.latest_reviewer_name || 'Reviewer' %> (<%= formatDate(c.latest_review_date) %>)
                    </div>
                  <% } else if (c.catatan_reviewer) { %>
                    <div class="small text-dark text-truncate" style="max-width: 250px;" title="<%= c.catatan_reviewer %>">
                      "<%= c.catatan_reviewer %>"
                    </div>
                  <% } else { %>
                    <span class="text-muted small fst-italic">Belum ada catatan evaluasi</span>
                  <% } %>
                </td>
                <td class="text-center pe-4">
                  <div class="d-inline-flex gap-1">
                    <a href="/reviewer/candidate/<%= c.id %>" class="btn btn-primary btn-sm fw-semibold shadow-sm px-3" title="Buka Detail & Beri Catatan Evaluasi">
                      <i class="fas fa-pen-to-square me-1"></i>Review & Catatan
                    </a>
                    <a href="/api/export/pdf/<%= c.id %>" target="_blank" class="btn btn-outline-danger btn-sm" title="Lihat Berkas PDF 5 Halaman">
                      <i class="fas fa-file-pdf"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    let currentStatusFilter = 'ALL';

    function setStatusFilter(status, btn) {
      currentStatusFilter = status;
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterTable();
    }

    function filterTable() {
      const q = (document.getElementById('searchInput').value || '').toLowerCase().trim();
      const divSelect = document.getElementById('divisionFilter');
      const selectedDiv = divSelect ? divSelect.value : 'ALL';
      const rows = document.querySelectorAll('.candidate-row');

      rows.forEach(r => {
        const name = r.getAttribute('data-name') || '';
        const posisi = r.getAttribute('data-posisi') || '';
        const divisi = r.getAttribute('data-divisi') || '';
        const hasReview = r.getAttribute('data-hasreview') === 'true';

        // Search match
        const matchesSearch = !q || name.includes(q) || posisi.includes(q);

        // Division match
        const matchesDiv = selectedDiv === 'ALL' || divisi.includes(selectedDiv);

        // Status match
        let matchesStatus = true;
        if (currentStatusFilter === 'BELUM') matchesStatus = !hasReview;
        else if (currentStatusFilter === 'SUDAH') matchesStatus = hasReview;

        if (matchesSearch && matchesDiv && matchesStatus) {
          r.style.display = '';
        } else {
          r.style.display = 'none';
        }
      });
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
