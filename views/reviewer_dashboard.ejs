<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portal Reviewer Pelamar - KOV Management Portal</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/figma-ui.css" rel="stylesheet">
  <link href="/assets/css/dribbble-drive.css" rel="stylesheet">
  <style>
    .filter-btn {
      font-size: 0.8rem;
      font-weight: 600;
      border-radius: var(--kov-radius-pill);
      padding: 0.4rem 0.85rem;
      border: 1px solid var(--kov-slate-200);
      background: #ffffff;
      color: var(--kov-slate-600);
      cursor: pointer;
      transition: var(--kov-transition);
      display: inline-flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
    }
    .filter-btn:hover, .filter-btn.active {
      background: var(--kov-slate-900);
      border-color: var(--kov-slate-900);
      color: #ffffff;
    }
  </style>
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'reviewer', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Minimalist Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Portal Reviewer Pelamar</h1>
          </div>
        </div>
        <div class="kov-topbar-right d-flex align-items-center gap-2">
          <!-- Coinbase Dual-Theme Switcher -->
          <button type="button" class="kov-theme-toggle" onclick="toggleKovTheme()" title="Ganti Mode Gelap / Terang (Coinbase Theme)">
            <i class="fas fa-moon kov-theme-icon"></i>
          </button>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

    <!-- Greeting & Assigned Divisions Banner -->
    <div class="kov-card mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: white; border: none;">
      <div class="kov-card-body p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
          <div>
            <h4 class="fw-bold mb-1 d-flex align-items-center gap-2">
              <i class="fas fa-user-check text-warning"></i>
              <span>Selamat Datang, <%= user.nama || user.username %>!</span>
            </h4>
            <p class="text-white-50 mb-2 small">
              Tugas Anda adalah mereview berkas pelamar dan memberikan catatan evaluasi teknis sesuai divisi yang ditugaskan.
            </p>
            <div class="d-flex align-items-center flex-wrap gap-2 mt-2">
              <span class="small text-white-50 fw-semibold">Divisi Penugasan Anda:</span>
              <% if (allowedDivisions.length > 0) { %>
                <% allowedDivisions.forEach(div => { %>
                  <span class="status-pill-modern pill-success" style="font-size: 0.75rem;">
                    <span class="status-dot-pulse"></span> <%= div %>
                  </span>
                <% }); %>
              <% } else { %>
                <span class="status-pill-modern pill-warning">
                  <span class="status-dot-pulse"></span> Belum ada divisi yang ditempelkan
                </span>
              <% } %>
            </div>
          </div>
          <div class="text-end">
            <span class="badge bg-white bg-opacity-10 border border-light border-opacity-25 p-2 px-3 fs-6 rounded-3">
              <i class="fas fa-layer-group text-warning me-1"></i> Total Pelamar Divisi Anda: <strong><%= candidates.length %></strong>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Alert Notification if any -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 shadow-xs" role="alert">
        <i class="fas fa-circle-check me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 shadow-xs" role="alert">
        <i class="fas fa-circle-exclamation me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- Bento Metric Cards -->
    <% 
      const totalKandidat = candidates.length;
      const belumDireview = candidates.filter(c => !c.review_count || c.review_count === 0).length;
      const sudahDireview = candidates.filter(c => c.review_count && c.review_count > 0).length;
      const direkomendasikan = candidates.filter(c => (c.latest_rekomendasi || '').includes('Direkomendasikan Lolos') || (c.kesimpulan_status === 'Diterima')).length;
    %>
    <!-- Bento Metric Cards (Coinbase High-Contrast Sparkline Style) -->
    <div class="bento-grid">
      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title">Total Berkas Pelamar</div>
          <div class="bento-metric-value text-primary"><%= totalKandidat %></div>
          <div class="bento-metric-sub">Sesuai divisi penugasan Anda</div>
        </div>
        <div class="d-flex flex-column align-items-end gap-1">
          <div class="coinbase-ring coinbase-ring-blue">
            <div class="coinbase-ring-inner">
              <i class="fas fa-folder-open"></i>
            </div>
          </div>
          <svg class="cb-sparkline-svg" viewBox="0 0 100 32"><path class="cb-sparkline-path cb-sparkline-blue" d="M2,24 Q25,8 50,18 T98,4"/></svg>
        </div>
      </div>

      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title text-warning">Belum Ada Catatan</div>
          <div class="bento-metric-value text-warning" style="color: var(--kov-amber) !important;"><%= belumDireview %></div>
          <div class="bento-metric-sub">Menunggu review dari Anda</div>
        </div>
        <div class="d-flex flex-column align-items-end gap-1">
          <div class="coinbase-ring coinbase-ring-amber">
            <div class="coinbase-ring-inner">
              <i class="fas fa-clock"></i>
            </div>
          </div>
          <svg class="cb-sparkline-svg" viewBox="0 0 100 32"><path class="cb-sparkline-path cb-sparkline-amber" d="M2,18 Q30,26 55,14 T98,10"/></svg>
        </div>
      </div>

      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title text-info">Sudah Direview</div>
          <div class="bento-metric-value text-info" style="color: #0284c7 !important;"><%= sudahDireview %></div>
          <div class="bento-metric-sub">Memiliki catatan evaluasi</div>
        </div>
        <div class="d-flex flex-column align-items-end gap-1">
          <div class="coinbase-ring coinbase-ring-blue">
            <div class="coinbase-ring-inner" style="color: #0284c7;">
              <i class="fas fa-check-double"></i>
            </div>
          </div>
          <svg class="cb-sparkline-svg" viewBox="0 0 100 32"><path class="cb-sparkline-path cb-sparkline-blue" d="M2,14 Q30,22 60,8 T98,16"/></svg>
        </div>
      </div>

      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title text-success">Direkomendasikan</div>
          <div class="bento-metric-value" style="color: var(--kov-primary-600);"><%= direkomendasikan %></div>
          <div class="bento-metric-sub">Dinilai cocok untuk lanjut proses</div>
        </div>
        <div class="d-flex flex-column align-items-end gap-1">
          <div class="coinbase-ring coinbase-ring-emerald">
            <div class="coinbase-ring-inner">
              <i class="fas fa-circle-check"></i>
            </div>
          </div>
          <svg class="cb-sparkline-svg" viewBox="0 0 100 32"><path class="cb-sparkline-path cb-sparkline-gain" d="M2,28 Q25,12 55,16 T98,2"/></svg>
        </div>
      </div>
    </div>

    <!-- Candidate List Table Card -->
    <div class="kov-card">
      <!-- Toolbar & Filters -->
      <div class="kov-card-header">
        <div class="d-flex flex-wrap align-items-center gap-2 mobile-w-100">
          <!-- Search input -->
          <div class="input-group input-group-sm" style="min-width: 240px;">
            <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
            <input type="text" class="form-control border-start-0" id="searchInput" placeholder="Cari nama atau posisi..." onkeyup="filterTable()">
          </div>

          <!-- Divisi Filter Dropdown -->
          <% if (allowedDivisions.length > 1) { %>
            <select class="form-select form-select-sm" id="divisionFilter" style="min-width: 170px;" onchange="filterTable()">
              <option value="ALL">Semua Divisi Anda</option>
              <% allowedDivisions.forEach(div => { %>
                <option value="<%= div.toLowerCase() %>"><%= div %></option>
              <% }); %>
            </select>
          <% } %>
        </div>

        <!-- Filter Status Buttons -->
        <div class="d-flex flex-wrap align-items-center gap-1.5">
          <button type="button" class="filter-btn active" data-status="ALL" onclick="setStatusFilter('ALL', this)">
            Semua (<%= totalKandidat %>)
          </button>
          <button type="button" class="filter-btn" data-status="BELUM" onclick="setStatusFilter('BELUM', this)">
            <i class="fas fa-clock text-warning"></i> Belum Direview (<%= belumDireview %>)
          </button>
          <button type="button" class="filter-btn" data-status="SUDAH" onclick="setStatusFilter('SUDAH', this)">
            <i class="fas fa-check text-success"></i> Sudah Direview (<%= sudahDireview %>)
          </button>
        </div>
      </div>

      <!-- Modern Table -->
      <div class="table-responsive-modern">
        <table class="kov-table" id="candidateReviewTable">
          <thead>
            <tr>
              <th class="ps-3" style="width: 60px;">ID</th>
              <th style="min-width: 130px;">Tgl Melamar</th>
              <th style="min-width: 250px;">Nama Pelamar &amp; Kontak</th>
              <th style="min-width: 170px;">Divisi &amp; Posisi</th>
              <th style="min-width: 160px;">Status Catatan Review</th>
              <th style="min-width: 220px;">Catatan Terakhir Reviewer</th>
              <th class="text-center pe-3" style="min-width: 170px;">Aksi</th>
            </tr>
          </thead>
          <tbody id="candidateTableBody">
            <% if (candidates.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <div class="py-4">
                    <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                    <h5 class="fw-bold text-dark">Belum Ada Pelamar Masuk</h5>
                    <p class="small text-muted mb-0">
                      Saat ini belum ada data pelamar yang melamar untuk divisi: <strong><%= allowedDivisions.join(', ') || 'Semua' %></strong>.
                    </p>
                  </div>
                </td>
              </tr>
            <% } %>

            <% candidates.forEach(c => { 
              const dLow = (c.divisi || 'operasional').toLowerCase();
              let divBadgeClass = 'bg-light text-dark border';
              if (dLow.includes('kitchen')) divBadgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning';
              else if (dLow.includes('barista')) divBadgeClass = 'bg-amber-subtle text-amber-emphasis border';
              else if (dLow.includes('hr')) divBadgeClass = 'bg-primary-subtle text-primary border';
              else if (dLow.includes('teknisi')) divBadgeClass = 'bg-info-subtle text-info border';
              else if (dLow.includes('fat') || dLow.includes('finance')) divBadgeClass = 'bg-success-subtle text-success border';
              else if (dLow.includes('it')) divBadgeClass = 'bg-dark text-info border border-info';
              else divBadgeClass = 'bg-success-subtle text-success border';

              const hasReview = c.review_count && c.review_count > 0;
            %>
              <tr class="candidate-row"
                  data-name="<%= (c.nama_lengkap || '').toLowerCase() %>"
                  data-posisi="<%= (c.posisi_dilamar || '').toLowerCase() %>"
                  data-divisi="<%= dLow %>"
                  data-hasreview="<%= hasReview ? 'true' : 'false' %>">
                <td class="ps-3 fw-bold text-muted">#<%= c.id %></td>
                <td class="small text-secondary fw-semibold">
                  <%= formatDate(c.created_at, true) %>
                </td>
                <td>
                  <div class="d-flex align-items-center gap-2.5">
                    <% if (c.foto_kandidat) { %>
                      <img src="<%= c.foto_kandidat %>" class="rounded-3 border shadow-xs flex-shrink-0" style="width: 38px; height: 38px; object-fit: cover;">
                    <% } else { %>
                      <div class="user-avatar-initials flex-shrink-0">
                        <%= c.nama_lengkap ? c.nama_lengkap.charAt(0).toUpperCase() : 'P' %>
                      </div>
                    <% } %>
                    <div>
                      <div class="fw-bold text-dark"><%= c.nama_lengkap %></div>
                      <div class="text-muted" style="font-size: 0.76rem;">
                        <i class="fas fa-phone me-1"></i><%= c.no_hp || '-' %> &bull; <%= c.kota_domisili || c.kota_ktp || '-' %>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="mb-1"><span class="badge <%= divBadgeClass %> px-2 py-1"><%= c.divisi || 'Operasional' %></span></div>
                  <div class="small fw-semibold text-dark"><%= c.posisi_dilamar %></div>
                </td>
                <td>
                  <% if (hasReview) { %>
                    <span class="status-pill-modern pill-success mb-1">
                      <span class="status-dot-pulse"></span> <%= c.review_count %> Catatan Review
                    </span>
                    <% if (c.latest_rekomendasi) { %>
                      <div>
                        <% if (c.latest_rekomendasi.includes('Direkomendasikan Lolos')) { %>
                          <span class="status-pill-modern pill-success" style="font-size: 0.7rem; padding: 2px 8px;"><span class="status-dot-pulse"></span> Lolos</span>
                        <% } else if (c.latest_rekomendasi.includes('Dipertimbangkan')) { %>
                          <span class="status-pill-modern pill-warning" style="font-size: 0.7rem; padding: 2px 8px;"><span class="status-dot-pulse"></span> Dipertimbangkan</span>
                        <% } else { %>
                          <span class="status-pill-modern pill-danger" style="font-size: 0.7rem; padding: 2px 8px;"><span class="status-dot-pulse"></span> Tidak Sesuai</span>
                        <% } %>
                      </div>
                    <% } %>
                  <% } else { %>
                    <span class="status-pill-modern pill-warning">
                      <span class="status-dot-pulse"></span> Belum Direview
                    </span>
                  <% } %>
                </td>
                <td>
                  <% if (c.latest_catatan) { %>
                    <div class="small text-dark text-truncate" style="max-width: 240px;" title="<%= c.latest_catatan %>">
                      "<%= c.latest_catatan %>"
                    </div>
                    <div class="text-muted" style="font-size: 0.7rem;">
                      Oleh: <%= c.latest_reviewer_name || 'Reviewer' %> (<%= formatDate(c.latest_review_date) %>)
                    </div>
                  <% } else if (c.catatan_reviewer) { %>
                    <div class="small text-dark text-truncate" style="max-width: 240px;" title="<%= c.catatan_reviewer %>">
                      "<%= c.catatan_reviewer %>"
                    </div>
                  <% } else { %>
                    <span class="text-muted small fst-italic">Belum ada catatan evaluasi</span>
                  <% } %>
                </td>
                <td class="text-center pe-3">
                  <div class="d-inline-flex gap-1.5">
                    <a href="/reviewer/candidate/<%= c.id %>" class="btn-kov-primary btn-kov-sm" title="Buka Detail & Beri Catatan Evaluasi">
                      <i class="fas fa-pen-to-square"></i> Review
                    </a>
                    <a href="/api/export/pdf/<%= c.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-secondary btn-kov-sm text-danger" title="Lihat Berkas PDF 5 Halaman">
                      <i class="fas fa-file-pdf"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
      </main>
    </div>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    let currentStatusFilter = 'ALL';

    function setStatusFilter(status, btn) {
      currentStatusFilter = status;
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterTable();
    }

    function filterTable() {
      const q = (document.getElementById('searchInput').value || '').toLowerCase().trim();
      const divSelect = document.getElementById('divisionFilter');
      const selectedDiv = divSelect ? divSelect.value : 'ALL';
      const rows = document.querySelectorAll('.candidate-row');

      rows.forEach(r => {
        const name = r.getAttribute('data-name') || '';
        const posisi = r.getAttribute('data-posisi') || '';
        const divisi = r.getAttribute('data-divisi') || '';
        const hasReview = r.getAttribute('data-hasreview') === 'true';

        // Search match
        const matchesSearch = !q || name.includes(q) || posisi.includes(q);

        // Division match
        const matchesDiv = selectedDiv === 'ALL' || divisi.includes(selectedDiv);

        // Status match
        let matchesStatus = true;
        if (currentStatusFilter === 'BELUM') matchesStatus = !hasReview;
        else if (currentStatusFilter === 'SUDAH') matchesStatus = hasReview;

        if (matchesSearch && matchesDiv && matchesStatus) {
          r.style.display = '';
        } else {
          r.style.display = 'none';
        }
      });
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
