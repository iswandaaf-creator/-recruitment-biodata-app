                  <div class="mb-3">
                    <% if (hasReview) { %>
                      <span class="status-pill-modern pill-success mb-1" style="font-size: 0.72rem;">
                        <span class="status-dot-pulse"></span> <%= c.review_count %> Catatan Review
                      </span>
                      <% if (isLolos) { %>
                        <span class="status-pill-modern pill-success" style="font-size: 0.7rem; padding: 2px 8px;"><span class="status-dot-pulse"></span> Lolos</span>
