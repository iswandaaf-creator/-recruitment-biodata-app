  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    let currentStatusFilter = 'ALL';
    let currentDivisiFilter = 'ALL';

    function setStatusFilter(status, btn) {
      currentStatusFilter = status;
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      if (btn) {
        btn.classList.add('active');
      } else {
        const matchingBtn = document.querySelector(`.filter-btn[data-filter="${status}"]`);
        if (matchingBtn) matchingBtn.classList.add('active');
      }
      filterTable();
    }

    function filterByStatusPill(status) {
      setStatusFilter(status, null);
      const grid = document.getElementById('candidatesGridView');
      if (grid) {
        grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function filterByDivisiQuick(divisi) {
      currentDivisiFilter = divisi.toLowerCase();
      const divSelect = document.getElementById('divisionFilter');
      if (divSelect) divSelect.value = divisi;

      // Update active state on 8 folder cards
      document.querySelectorAll('.dd-folder-card').forEach(card => {
        if (divisi === 'all' && card.getAttribute('data-divisi') === 'all') {
          card.classList.add('active');
        } else if (card.getAttribute('data-divisi') === divisi.toLowerCase()) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });

      filterTable();
    }

    function filterTable() {
      const q = (document.getElementById('searchInput').value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('.candidate-row');
      const cards = document.querySelectorAll('.candidate-grid-item');
      let visibleCount = 0;

      function checkMatch(name, posisi, divisi, hasReview, isRecommended, isHold) {
        const matchesSearch = !q || name.includes(q) || posisi.includes(q) || divisi.includes(q);
        const matchesDiv = currentDivisiFilter === 'all' || currentDivisiFilter === 'ALL' || divisi.includes(currentDivisiFilter);

        let matchesStatus = true;
        if (currentStatusFilter === 'BELUM') matchesStatus = !hasReview;
        else if (currentStatusFilter === 'SUDAH') matchesStatus = hasReview;
        else if (currentStatusFilter === 'LOLOS') matchesStatus = isRecommended;
        else if (currentStatusFilter === 'HOLD') matchesStatus = isHold;

        return matchesSearch && matchesDiv && matchesStatus;
      }

      // Filter Grid Cards
      cards.forEach(c => {
        const name = c.getAttribute('data-name') || '';
        const posisi = c.getAttribute('data-posisi') || '';
        const divisi = c.getAttribute('data-divisi') || '';
        const hasReview = c.getAttribute('data-hasreview') === 'true';
        const isRec = c.getAttribute('data-isrecommended') === 'true';
        const isHold = c.getAttribute('data-ishold') === 'true';

        if (checkMatch(name, posisi, divisi, hasReview, isRec, isHold)) {
          c.style.display = '';
          visibleCount++;
        } else {
          c.style.display = 'none';
        }
      });

      // Filter Table Rows
      rows.forEach(r => {
        const name = r.getAttribute('data-name') || '';
        const posisi = r.getAttribute('data-posisi') || '';
        const divisi = r.getAttribute('data-divisi') || '';
        const hasReview = r.getAttribute('data-hasreview') === 'true';
        const isRec = r.getAttribute('data-isrecommended') === 'true';
        const isHold = r.getAttribute('data-ishold') === 'true';

        if (checkMatch(name, posisi, divisi, hasReview, isRec, isHold)) {
          r.style.display = '';
        } else {
          r.style.display = 'none';
        }
      });

      const countBadge = document.getElementById('candidateCountBadge');
      if (countBadge) countBadge.textContent = `${visibleCount} Berkas`;
    }

    // View Mode Toggle (Grid vs Spreadsheet)
    function setViewMode(mode) {
      const gridView = document.getElementById('candidatesGridView');
      const listView = document.getElementById('candidatesListView');
      const btnGrid = document.getElementById('btnViewGrid');
      const btnList = document.getElementById('btnViewList');

      if (mode === 'list') {
        if (gridView) gridView.classList.add('d-none');
        if (listView) listView.classList.remove('d-none');
        if (btnGrid) btnGrid.classList.remove('active');
        if (btnList) btnList.classList.add('active');
        localStorage.setItem('reviewer_view_mode', 'list');
      } else {
        if (gridView) gridView.classList.remove('d-none');
        if (listView) listView.classList.add('d-none');
        if (btnGrid) btnGrid.classList.add('active');
        if (btnList) btnList.classList.remove('active');
        localStorage.setItem('reviewer_view_mode', 'grid');
      }
    }

    // Calendar Navigation
    let currentCalMonth = 9; // 0-indexed: 9 = October
    let currentCalYear = 2026;
    const monthNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];

    function prevCalMonth() {
      currentCalMonth--;
      if (currentCalMonth < 0) { currentCalMonth = 11; currentCalYear--; }
      updateCalHeader();
    }

    function nextCalMonth() {
      currentCalMonth++;
      if (currentCalMonth > 11) { currentCalMonth = 0; currentCalYear++; }
      updateCalHeader();
    }

    function updateCalHeader() {
      const el = document.getElementById('calMonthDisplay');
      if (el) el.textContent = monthNames[currentCalMonth] + ' ' + currentCalYear;
    }

    function switchCalPeriod(period) {
      document.querySelectorAll('.dd-period-btn').forEach(b => b.classList.remove('active'));
      const activeBtn = document.getElementById(`calTab${period.charAt(0).toUpperCase() + period.slice(1)}`);
      if (activeBtn) activeBtn.classList.add('active');
    }

    window.setStatusFilter = setStatusFilter;
    window.filterByStatusPill = filterByStatusPill;
    window.filterByDivisiQuick = filterByDivisiQuick;
    window.filterTable = filterTable;
    window.setViewMode = setViewMode;
    window.prevCalMonth = prevCalMonth;
    window.nextCalMonth = nextCalMonth;
    window.switchCalPeriod = switchCalPeriod;

    document.addEventListener('DOMContentLoaded', () => {
      const savedMode = localStorage.getItem('reviewer_view_mode');
      if (savedMode === 'list') {
        setViewMode('list');
      } else {
        setViewMode('grid');
      }
    });
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>