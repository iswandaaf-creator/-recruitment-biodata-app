                      <% } else if (c.catatan_reviewer) { %>
                        <div class="small text-dark text-truncate" style="max-width: 220px;" title="<%= c.catatan_reviewer %>">
                          "<%= c.catatan_reviewer %>"
                        </div>
                      <% } else { %>
                        <span class="text-muted small fst-italic">Belum ada catatan evaluasi</span>
                      <% } %>
                    </td>
                    <td class="text-center pe-3">
                      <div class="d-inline-flex gap-1.5">
                        <a href="/reviewer/candidate/<%= c.id %>" class="btn-kov-primary btn-kov-sm" title="Buka Detail & Beri Catatan Evaluasi">
                          <i class="fas fa-pen-to-square me-1"></i> Review
                        </a>
                        <a href="/api/export/pdf/<%= c.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-secondary btn-kov-sm text-danger" title="Download Biodata PDF">
                          <i class="fas fa-file-pdf"></i>
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </main>

