<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KOV Koffie — Atelier Sistem &amp; Evaluasi Divisi</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261103_atelier" rel="stylesheet">
  <script src="/assets/js/kov-toast.js"></script>
  <script src="/assets/js/kov-theme.js"></script>
</head>
<body>

  <%
    const totalKandidat = (candidates || []).length;
    const belumDireview = (candidates || []).filter(c => !c.review_count || c.review_count === 0).length;
    const sudahDireview = (candidates || []).filter(c => c.review_count && c.review_count > 0).length;
    const direkomendasikan = (candidates || []).filter(c => (c.latest_rekomendasi || '').includes('Direkomendasikan Lolos') || (c.kesimpulan_status === 'Diterima')).length;
    const dipertimbangkan = (candidates || []).filter(c => (c.latest_rekomendasi || '').includes('Dipertimbangkan') || (c.kesimpulan_status === 'Dipertimbangkan')).length;

    const baristaCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('barista')).length;
    const opsCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('operasional') || (c.divisi || '').toLowerCase().includes('staff') || (c.divisi || '').toLowerCase().includes('kasir')).length;
    const kitchenCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('kitchen') || (c.divisi || '').toLowerCase().includes('cook') || (c.divisi || '').toLowerCase().includes('pastry')).length;
    const teknisiCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('teknisi') || (c.divisi || '').toLowerCase().includes('maintenance') || (c.divisi || '').toLowerCase().includes('listrik')).length;
    const itCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('it') || (c.divisi || '').toLowerCase().includes('developer') || (c.divisi || '').toLowerCase().includes('support') || (c.divisi || '').toLowerCase().includes('tech')).length;
    const fatCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('fat') || (c.divisi || '').toLowerCase().includes('finance') || (c.divisi || '').toLowerCase().includes('akunting') || (c.divisi || '').toLowerCase().includes('tax')).length;
    const hrCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('hr') || (c.divisi || '').toLowerCase().includes('personalia') || (c.divisi || '').toLowerCase().includes('ga')).length;

    function maskNik(val) {
      if (!val) return '337401********01';
      const s = String(val).trim();
      if (s.length <= 8) return s;
      return s.slice(0, 6) + '*'.repeat(s.length - 8) + s.slice(-2);
    }
  %>

  <div class="atelier-shell dd-layout-root kov-app-shell">
    <!-- 1. Left Pebble-Sage Sidebar (194px) -->
    <%- include('partials/sidebar', { active: 'reviewer', user: typeof user !== 'undefined' ? user : null }) %>

    <!-- 2. Main System Workspace -->
    <main class="atelier-main dd-main-canvas kov-main-content dd-theme" id="mainCanvas">

      <!-- Top Bar (64px Warm Artisanal Paper #FCFBF9) -->
      <header class="atelier-topbar dd-topbar">
        <div class="d-flex align-items-center gap-2 min-w-0">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <span class="status-pill pill-emerald font-mono-num">Reviewer Divisi</span>
          <span class="d-none d-sm-inline" style="color: var(--ink-muted); font-size: 12px;">/</span>
          <span class="d-none d-sm-inline text-truncate fw-semibold" style="color: var(--ink-body); font-size: 12px;">KOV Semarang Roastery &amp; People</span>
        </div>

        <div class="d-flex align-items-center gap-2 flex-shrink-0">
          <div class="atelier-search-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="flex-shrink-0">
              <path d="M10.8 4.2C14.6 4.1 17.5 7.2 17.3 10.9C17.1 14.7 14 17.4 10.3 17.3C6.6 17.2 3.9 14.1 4.1 10.4C4.3 7.1 7.2 4.3 10.8 4.2Z" fill="#dfece3" stroke="#3f6f56" stroke-width="1.85" stroke-linecap="round"/>
              <path d="M15.6 15.8L20.2 20.1" stroke="#3f6f56" stroke-width="2.1" stroke-linecap="round"/>
            </svg>
            <input type="text" id="searchInput" class="atelier-search-input" placeholder="Cari kandidat, posisi, divisi..." aria-label="Cari nama pelamar" onkeyup="filterTable()">
          </div>

          <button type="button" class="btn-kov-outline" onclick="document.getElementById('bentoWorkspaceGrid').classList.toggle('calendar-collapsed')" title="Sembunyikan / Tampilkan Kalender">
            <svg class="hand-icon" style="width: 16px; height: 16px;" viewBox="0 0 24 24" fill="none">
              <path d="M4.5 7.2C4.5 5.8 5.6 4.8 7 4.8H17.2C18.6 4.8 19.6 5.9 19.5 7.3V18.2C19.4 19.6 18.3 20.5 16.9 20.5H6.8C5.4 20.5 4.4 19.4 4.5 18V7.2Z" fill="#dfece3" stroke="#3f6f56" stroke-width="1.75"/>
              <path d="M8.2 3.2V6.1M15.8 3.4V6.2M4.8 9.6H19.2" stroke="#3f6f56" stroke-width="1.9" stroke-linecap="round"/>
            </svg>
            <span class="d-none d-sm-inline">Kalender</span>
          </button>

          <a href="/api/export/excel" class="btn-kov-primary text-decoration-none" title="Export Rekap Pelamar ke Excel">
            <span>Export Excel</span>
          </a>
        </div>
      </header>

      <!-- Scrollable Workspace Body -->
      <div class="atelier-scroll">

        <% if (typeof success !== 'undefined' && success) { %>
          <div class="kov-paper-card p-3 pigment-celadon" role="alert">
            <strong>Berhasil:</strong> <%= success %>
          </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="kov-paper-card p-3 pigment-mauve" role="alert">
            <strong>Perhatian:</strong> <%= error %>
          </div>
        <% } %>

        <!-- Row 1: Asymmetric Editorial Title Band + 3 Natural Tonal Summary Pills -->
        <section class="editorial-header-band">
          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h1 class="font-display m-0 fw-bold" style="font-size: 1.35rem; color: var(--ink-deep);">
                Antrean Evaluasi Divisi
              </h1>
              <span class="status-pill pill-emerald font-mono-num" id="candidateCountBadge">
                <%= totalKandidat %> Data
              </span>
            </div>
            <p class="m-0 mt-1" style="font-size: 12px; color: var(--ink-body);">
              Berikan penilaian uji praktik, catatan evaluasi teknis, dan rekomendasi kelulusan kandidat divisi Anda.
            </p>
          </div>

          <div class="tonal-summary-strip">
            <div class="tonal-pill-card pigment-terracotta" onclick="filterByStatusPill('ALL')" role="button" tabindex="0">
              <div>
                <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.85;">Antrean Divisi</div>
                <div class="font-display font-mono-num fw-bold mt-0.5" style="font-size: 1.2rem; color: var(--terracotta-ink);"><%= totalKandidat %> Kandidat</div>
              </div>
              <svg class="hand-icon" viewBox="0 0 24 24" fill="none">
                <path d="M12.4 4.5L14.6 9.1L19.6 9.7L15.9 13.1L16.9 18.1L12.3 15.6L7.8 18.2L8.8 13.2L5.1 9.8L10.1 9.1L12.4 4.5Z" fill="#e5d4a7" fill-opacity="0.7"/>
                <path d="M11.9 4.2L14.1 8.8L19.1 9.4L15.4 12.8L16.4 17.8L11.8 15.3L7.3 17.9L8.3 12.9L4.6 9.5L9.6 8.8L11.9 4.2Z" stroke="#9c782b" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
            </div>

            <div class="tonal-pill-card pigment-celadon" onclick="filterByStatusPill('SUDAH')" role="button" tabindex="0">
              <div>
                <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.85;">Sudah Direview</div>
                <div class="font-display font-mono-num fw-bold mt-0.5" style="font-size: 1.2rem; color: var(--celadon-ink);"><%= sudahDireview %> / <%= totalKandidat %></div>
              </div>
              <svg class="hand-icon" viewBox="0 0 24 24" fill="none">
                <path d="M7.5 9.2C7.5 6.8 9.4 5 11.8 5.2C14.2 5.4 15.8 7.3 15.6 9.7C15.4 12.1 13.5 13.8 11.1 13.6C8.8 13.4 7.5 11.5 7.5 9.2Z" fill="#bdd6c5" fill-opacity="0.65"/>
                <path d="M11.2 4.8C13.6 4.7 15.6 6.6 15.5 9C15.4 11.4 13.4 13.2 11 13.2C8.6 13.2 6.8 11.3 6.9 8.9C7 6.6 8.9 4.9 11.2 4.8Z" stroke="#3f6f56" stroke-width="1.85" stroke-linecap="round"/>
                <path d="M4.2 19.6C4.8 16.5 7.6 15.1 11.2 15.1C14.8 15.1 17.5 16.7 18.2 19.7" stroke="#3f6f56" stroke-width="2.05" stroke-linecap="round"/>
              </svg>
            </div>

            <div class="tonal-pill-card pigment-dusk" onclick="filterByStatusPill('BELUM')" role="button" tabindex="0">
              <div>
                <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.85;">Proteksi Data</div>
                <div class="font-display font-mono-num fw-bold mt-0.5" style="font-size: 1.05rem; color: var(--dusk-ink);">NIK Masked</div>
              </div>
              <svg class="hand-icon" viewBox="0 0 24 24" fill="none">
                <path d="M12.4 4.4L19.2 7.2V12.4C19.2 16.6 16.3 19.6 12.4 20.8C8.5 19.6 5.6 16.6 5.6 12.4V7.2L12.4 4.4Z" fill="#ddc3cb" fill-opacity="0.6"/>
                <path d="M12 3.8L18.8 6.6V11.8C18.8 16 15.9 19 12 20.2C8.1 19 5.2 16 5.2 11.8V6.6L12 3.8Z" stroke="#8c4a5b" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M9.4 11.8L11.3 13.7L14.8 9.8" stroke="#8c4a5b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          </div>
        </section>

        <!-- Row 2: Asymmetric 2-Column Workspace -->
        <section class="workspace-asymmetric-grid" id="bentoWorkspaceGrid">

          <!-- Left Column: Main Reviewer Sheet -->
          <div class="kov-paper-card min-w-0">
            <div class="atelier-table-toolbar">
              <div class="d-flex align-items-center gap-1 flex-wrap">
                <button type="button" class="kov-tab-pill filter-btn active" data-filter="ALL" onclick="setStatusFilter('ALL', this)">
                  <span>Semua (<%= totalKandidat %>)</span>
                </button>
                <button type="button" class="kov-tab-pill filter-btn" data-filter="BELUM" onclick="setStatusFilter('BELUM', this)">
                  <span>Belum Direview (<%= belumDireview %>)</span>
                </button>
                <button type="button" class="kov-tab-pill filter-btn" data-filter="SUDAH" onclick="setStatusFilter('SUDAH', this)">
                  <span>Sudah Direview (<%= sudahDireview %>)</span>
                </button>
                <button type="button" class="kov-tab-pill filter-btn" data-filter="LOLOS" onclick="setStatusFilter('LOLOS', this)">
                  <span>Direkomendasikan (<%= direkomendasikan %>)</span>
                </button>
                <button type="button" class="kov-tab-pill filter-btn" data-filter="HOLD" onclick="setStatusFilter('HOLD', this)">
                  <span>Dipertimbangkan (<%= dipertimbangkan %>)</span>
                </button>
              </div>

              <div class="d-flex align-items-center gap-2">
                <div id="activeDateBadgeWrap" class="d-none">
                  <button type="button" onclick="clearCalDateFilter()" class="status-pill pill-ochre border-0" style="cursor: pointer;">
                    <span id="activeDateBadgeText">Tanggal</span> &times;
                  </button>
                </div>

                <select id="divisiSelectReviewer" class="kov-pastel-input" style="height: 32px; padding: 0 11px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;" onchange="filterByDivisiQuick(this.value)">
                  <option value="all" selected>Semua Divisi (<%= totalKandidat %>)</option>
                  <option value="barista">Barista (<%= baristaCount %>)</option>
                  <option value="kitchen">Kitchen (<%= kitchenCount %>)</option>
                  <option value="operasional">Operasional (<%= opsCount %>)</option>
                  <option value="fat">Finance (<%= fatCount %>)</option>
                  <option value="it">IT Systems (<%= itCount %>)</option>
                  <option value="teknisi">Teknisi (<%= teknisiCount %>)</option>
                  <option value="hr">HR &amp; GA (<%= hrCount %>)</option>
                </select>
              </div>
            </div>

            <div class="table-responsive">
              <table class="kov-table" id="reviewerTable">
                <thead>
                  <tr>
                    <th style="width: 28%;">Kandidat &amp; Domisili</th>
                    <th style="width: 25%;">Posisi &amp; Divisi</th>
                    <th style="width: 25%;">NIK (Masked) &amp; Catatan</th>
                    <th style="width: 22%; text-align: right;">Status &amp; Aksi</th>
                  </tr>
                </thead>
                <tbody id="candidateTableBody">
                  <% if (candidates.length === 0) { %>
                    <tr>
                      <td colspan="4" class="text-center py-5" style="color: var(--ink-muted);">
                        Belum ada berkas pelamar untuk divisi penugasan Anda.
                      </td>
                    </tr>
                  <% } %>
                  <%
                    const avatarPalettes = [
                      { bg: '#dfece3', ink: '#2e5943' },
                      { bg: '#e6e9f4', ink: '#3c4a73' },
                      { bg: '#f0e4e8', ink: '#6e3645' },
                      { bg: '#f6eed8', ink: '#6e5219' },
                      { bg: '#f6e5da', ink: '#784124' }
                    ];
                    candidates.forEach((c, idx) => {
                      const cDiv = c.divisi || 'Operasional';
                      const dLow = cDiv.toLowerCase();
                      const hasReview = c.review_count && c.review_count > 0;
                      const isLolos = (c.latest_rekomendasi || '').includes('Direkomendasikan Lolos') || (c.kesimpulan_status === 'Diterima');
                      const isHold = (c.latest_rekomendasi || '').includes('Dipertimbangkan') || (c.kesimpulan_status === 'Dipertimbangkan');
                      const pal = avatarPalettes[idx % avatarPalettes.length];

                      let divPillClass = 'pill-emerald';
                      if (dLow.includes('barista')) divPillClass = 'pill-peach';
                      else if (dLow.includes('kitchen')) divPillClass = 'pill-rose';
                      else if (dLow.includes('fat')) divPillClass = 'pill-ochre';
                      else if (dLow.includes('it') || dLow.includes('operasional')) divPillClass = 'pill-lavender';
                  %>
                    <tr class="candidate-row"
                        data-id="<%= c.id %>"
                        data-name="<%= (c.nama_lengkap || '').toLowerCase() %>"
                        data-posisi="<%= (c.posisi_dilamar || '').toLowerCase() %>"
                        data-divisi="<%= dLow %>"
                        data-hasreview="<%= hasReview ? 'true' : 'false' %>"
                        data-isrecommended="<%= isLolos ? 'true' : 'false' %>"
                        data-ishold="<%= isHold ? 'true' : 'false' %>"
                        data-date="<%= c.created_at ? new Date(c.created_at).getTime() : 0 %>">
                      <td>
                        <div class="d-flex align-items-center gap-3">
                          <div class="rounded-circle font-display fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-size: 12px; background: <%= pal.bg %>; color: <%= pal.ink %>;">
                            <%= c.nama_lengkap ? c.nama_lengkap.charAt(0).toUpperCase() : 'P' %>
                          </div>
                          <div>
                            <div class="font-display fw-bold" style="font-size: 13px; color: var(--ink-deep);"><%= c.nama_lengkap %></div>
                            <div style="font-size: 11px; color: var(--ink-muted);"><%= c.kota_domisili || c.kota_ktp || 'Semarang' %> &bull; <%= formatDate(c.created_at, false) %></div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <div class="d-flex align-items-center gap-1.5 flex-wrap">
                          <span class="fw-semibold" style="font-size: 12px; color: var(--ink-deep);"><%= c.posisi_dilamar || cDiv %></span>
                          <span class="status-pill <%= divPillClass %>" style="font-size: 9.5px; padding: 1px 8px;"><%= cDiv %></span>
                        </div>
                        <div style="font-size: 11px; color: var(--ink-muted); margin-top: 2px;">Berkas #<%= c.id %></div>
                      </td>
                      <td>
                        <div class="font-mono-num fw-semibold" style="font-size: 12px; color: var(--ink-deep);"><%= maskNik(c.nomor_ktp) %></div>
                        <div class="text-truncate" style="font-size: 11px; color: var(--ink-muted); max-width: 210px;">
                          <%= c.latest_catatan || c.catatan_reviewer || 'Belum ada catatan reviewer' %>
                        </div>
                      </td>
                      <td class="text-end">
                        <div class="d-inline-flex align-items-center justify-content-end gap-1.5">
                          <% if (hasReview) { %>
                            <span class="status-pill pill-emerald"><%= c.review_count %> Review</span>
                          <% } else { %>
                            <span class="status-pill pill-ochre">Belum Direview</span>
                          <% } %>
                          <a href="/reviewer/candidate/<%= c.id %>" class="btn-kov-outline text-decoration-none" style="height: 28px; padding: 0 10px; font-size: 11px;">
                            Nilai
                          </a>
                          <button type="button" class="btn-kov-outline" style="height: 28px; padding: 0 8px; font-size: 11px;" onclick="scheduleReviewerMemo(<%= JSON.stringify(c.nama_lengkap || 'Kandidat') %>)" title="Jadwalkan Uji Praktik">
                            + Memo
                          </button>
                          <a href="/api/export/pdf/<%= c.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-outline text-decoration-none" style="height: 28px; padding: 0 8px; font-size: 11px;">
                            PDF
                          </a>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Right Column: Warm Cream Calendar & Memo Pad -->
          <aside class="kov-pad-card dd-right-panel" id="hrRightSidebar">
            <div class="d-flex align-items-center justify-content-between border-bottom" style="border-color: var(--border-organic) !important; padding: 14px 16px;">
              <div class="d-flex align-items-center gap-2">
                <svg class="hand-icon" style="width: 16px; height: 16px;" viewBox="0 0 24 24" fill="none">
                  <path d="M6.5 4.8H17.5C18.5 4.8 19.2 5.6 19.2 6.6V18.4C19.2 19.4 18.4 20.2 17.4 20.2H6.5C5.5 20.2 4.8 19.4 4.8 18.4V6.6C4.8 5.6 5.5 4.8 6.5 4.8Z" fill="#f6eed8" stroke="#9c782b" stroke-width="1.75"/>
                  <path d="M8.5 9.5H15.5M8.5 13H13.5" stroke="#9c782b" stroke-width="1.9" stroke-linecap="round"/>
                </svg>
                <h2 class="font-display m-0 fw-bold" style="font-size: 12px; color: var(--ink-deep);">Kalender &amp; Memo</h2>
              </div>
              <span class="status-pill pill-ochre font-mono-num"><%= belumDireview %> Notif</span>
            </div>

            <div style="padding: 16px; display: flex; flex-direction: column; gap: 16px;">
              <!-- Mini Calendar Grid -->
              <div class="dd-calendar-widget" style="background: var(--bg-paper); border: 1px solid var(--border-organic); border-radius: 12px; padding: 12px;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="font-display fw-bold" style="font-size: 12px; color: var(--ink-deep);" id="calMonthDisplay">Oktober 2026</span>
                  <div class="d-flex align-items-center gap-1">
                    <button type="button" onclick="prevCalPeriod()" class="kov-soft-icon-btn border-0 rounded" style="width: 22px; height: 22px; font-size: 12px;">&lsaquo;</button>
                    <button type="button" onclick="clearCalDateFilter()" class="kov-soft-icon-btn border-0 rounded fw-bold" style="height: 22px; padding: 0 6px; font-size: 10px; color: var(--celadon-stroke);">Semua</button>
                    <button type="button" onclick="nextCalPeriod()" class="kov-soft-icon-btn border-0 rounded" style="width: 22px; height: 22px; font-size: 12px;">&rsaquo;</button>
                  </div>
                </div>
                <div class="dd-calendar-grid font-mono-num" id="calGrid"></div>
              </div>

              <!-- Click-Date Memo Composer -->
              <div class="pigment-celadon" style="padding: 14px; border-radius: 12px; border: 1px solid var(--celadon-border);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span style="font-size: 11px; font-weight: 700; color: var(--celadon-ink);">Catatan Tanggal</span>
                  <span class="font-mono-num fw-bold px-2 py-0.5 rounded-pill" style="font-size: 10px; background: #ffffff; color: var(--celadon-ink);" id="memoActiveDateLabel">24/10/2026</span>
                </div>

                <form id="hrMemoForm" onsubmit="submitHrMemo(event)" novalidate>
                  <div class="mb-2">
                    <input type="text" id="hrMemoTitleInput" placeholder="Tulis jadwal uji praktik..." class="w-100 kov-pastel-input" style="height: 32px; padding: 0 10px; border-radius: 8px; font-size: 12px; border-color: var(--celadon-border);">
                  </div>
                  <div class="row g-1.5 mb-2">
                    <div class="col-6">
                      <select id="hrMemoCatInput" class="w-100 kov-pastel-input" style="height: 28px; padding: 0 8px; border-radius: 8px; font-size: 11px; font-weight: 600; border-color: var(--celadon-border);">
                        <option value="Uji Praktik">Uji Praktik</option>
                        <option value="Interview">Interview</option>
                        <option value="Approval">Approval</option>
                      </select>
                    </div>
                    <div class="col-6">
                      <input type="time" id="hrMemoTimeInput" value="14:00" class="w-100 kov-pastel-input font-mono-num" style="height: 28px; padding: 0 8px; border-radius: 8px; font-size: 11px; border-color: var(--celadon-border);">
                    </div>
                  </div>
                  <input type="hidden" id="hrMemoDateInput" value="2026-10-24">
                  <button type="submit" class="btn-kov-primary w-100" style="height: 32px; font-size: 12px;">
                    <span>+ Simpan ke Kalender</span>
                  </button>
                </form>
              </div>

              <!-- Daftar Agenda -->
              <div>
                <div class="fw-bold mb-2" style="font-size: 11px; color: var(--ink-deep);">Daftar Agenda</div>
                <div id="hrMemoListContainer" style="max-height: 170px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px;"></div>
              </div>
            </div>
          </aside>

        </section>

      </div>
    </main>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    const KOV_CSRF_TOKEN = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
    let currentStatusFilter = 'ALL';
    let currentDivisiFilter = 'all';
    let currentCalYear = 2026;
    let currentCalMonth = 9;
    let activeDateFilter = null;
    const monthNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];

    function scheduleReviewerMemo(name) {
      document.getElementById('bentoWorkspaceGrid')?.classList.remove('calendar-collapsed');
      const input = document.getElementById('hrMemoTitleInput');
      if (input) {
        input.value = 'Uji Praktik — ' + name;
        input.focus();
      }
      if (window.KovToast && typeof window.KovToast.info === 'function') {
        window.KovToast.info('Klik "+ Simpan ke Kalender" di panel kanan.', 'Jadwalkan ' + name);
      }
    }

    function formatDateKey(d) {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function formatDisplayDate(dateKey) {
      if (!dateKey) return '24/10/2026';
      const parts = dateKey.split('-');
      if (parts.length !== 3) return dateKey;
      return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function setStatusFilter(status, btn) {
      currentStatusFilter = status;
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      filterTable();
    }

    function filterByStatusPill(status) {
      const btn = document.querySelector(`.filter-btn[data-filter="${status}"]`);
      setStatusFilter(status, btn);
    }

    function filterByDivisiQuick(div) {
      currentDivisiFilter = (div || 'all').toLowerCase();
      filterTable();
    }

    function filterTable() {
      const q = (document.getElementById('searchInput')?.value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('#candidateTableBody tr.candidate-row');
      let count = 0;

      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const div = (row.getAttribute('data-divisi') || '').toLowerCase();
        const hasRev = row.getAttribute('data-hasreview') === 'true';
        const isRec = row.getAttribute('data-isrecommended') === 'true';
        const isHold = row.getAttribute('data-ishold') === 'true';

        let matchStatus = true;
        if (currentStatusFilter === 'BELUM') matchStatus = !hasRev;
        else if (currentStatusFilter === 'SUDAH') matchStatus = hasRev;
        else if (currentStatusFilter === 'LOLOS') matchStatus = isRec;
        else if (currentStatusFilter === 'HOLD') matchStatus = isHold;

        let matchDiv = currentDivisiFilter === 'all' || div.includes(currentDivisiFilter);
        let matchSearch = !q || text.includes(q);
        let matchDate = true;
        if (activeDateFilter) {
          const ts = parseInt(row.getAttribute('data-date')) || 0;
          matchDate = ts ? (formatDateKey(new Date(ts)) === activeDateFilter) : false;
        }

        if (matchStatus && matchDiv && matchSearch && matchDate) {
          row.style.display = '';
          count++;
        } else {
          row.style.display = 'none';
        }
      });

      const badge = document.getElementById('candidateCountBadge');
      if (badge) badge.textContent = count + ' Data';
    }

    function renderCalendar() {
      const calGrid = document.getElementById('calGrid');
      const headerEl = document.getElementById('calMonthDisplay');
      if (!calGrid) return;
      if (headerEl) headerEl.textContent = `${monthNames[currentCalMonth]} ${currentCalYear}`;

      let html = `
        <div class="dd-cal-weekday">Sn</div><div class="dd-cal-weekday">Sl</div><div class="dd-cal-weekday">Rb</div>
        <div class="dd-cal-weekday">Km</div><div class="dd-cal-weekday">Jm</div><div class="dd-cal-weekday">Sb</div><div class="dd-cal-weekday">Mg</div>
      `;

      const firstDayIdx = (new Date(currentCalYear, currentCalMonth, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(currentCalYear, currentCalMonth + 1, 0).getDate();

      for (let i = 0; i < firstDayIdx; i++) {
        html += `<div class="dd-cal-day cal-day-btn muted"></div>`;
      }
      for (let day = 1; day <= daysInMonth; day++) {
        const curDate = new Date(currentCalYear, currentCalMonth, day);
        const k = formatDateKey(curDate);
        const isActive = (k === activeDateFilter);
        const hasMemo = (hrMemosState || []).some(m => m.tanggal === k);
        let dot = hasMemo ? `<span class="cal-dot" style="background: ${isActive ? '#ffffff' : '#497a61'};"></span>` : '';
        html += `<div class="dd-cal-day cal-day-btn ${isActive ? 'active' : ''}" onclick="selectCalDate('${k}')"><span>${day}</span>${dot}</div>`;
      }
      calGrid.innerHTML = html;
    }

    function selectCalDate(dateKey) {
      activeDateFilter = (activeDateFilter === dateKey) ? null : dateKey;
      const chipWrap = document.getElementById('activeDateBadgeWrap');
      const chipText = document.getElementById('activeDateBadgeText');
      const dateLabel = document.getElementById('memoActiveDateLabel');
      const dateInput = document.getElementById('hrMemoDateInput');

      if (activeDateFilter) {
        const disp = formatDisplayDate(activeDateFilter);
        if (chipWrap && chipText) { chipText.textContent = disp; chipWrap.classList.remove('d-none'); }
        if (dateLabel) dateLabel.textContent = disp;
        if (dateInput) dateInput.value = activeDateFilter;
      } else {
        if (chipWrap) chipWrap.classList.add('d-none');
        if (dateLabel) dateLabel.textContent = '24/10/2026';
      }
      renderCalendar();
      renderHrMemoList();
      filterTable();
    }

    function clearCalDateFilter() {
      activeDateFilter = null;
      document.getElementById('activeDateBadgeWrap')?.classList.add('d-none');
      renderCalendar();
      renderHrMemoList();
      filterTable();
    }

    function prevCalPeriod() {
      currentCalMonth = (currentCalMonth + 11) % 12;
      renderCalendar();
    }
    function nextCalPeriod() {
      currentCalMonth = (currentCalMonth + 1) % 12;
      renderCalendar();
    }

    let hrMemosState = [
      { id: 901, tanggal: '2026-10-24', waktu: '15:30', kategori: 'Uji Praktik', judul: 'Kalibrasi Espresso & Latte Art Budi', selesai: 0 }
    ];

    function loadHrMemos() {
      try {
        const raw = localStorage.getItem('kov_hr_memos_v11');
        if (raw) hrMemosState = JSON.parse(raw);
      } catch (e) {}
      renderHrMemoList();
      if (typeof fetch === 'function') {
        fetch('/api/hr/memos', { headers: { 'Accept': 'application/json' } })
          .then(r => r.ok ? r.json() : null)
          .then(data => {
            if (data && data.ok && Array.isArray(data.memos) && data.memos.length > 0) {
              hrMemosState = data.memos;
              renderHrMemoList();
              renderCalendar();
            }
          }).catch(() => {});
      }
    }

    function renderHrMemoList() {
      const container = document.getElementById('hrMemoListContainer');
      if (!container) return;
      const filtered = activeDateFilter ? hrMemosState.filter(m => m.tanggal === activeDateFilter) : hrMemosState;
      if (!filtered.length) {
        container.innerHTML = `<div class="text-center py-2" style="font-size: 11px; color: var(--ink-muted);">Tidak ada agenda di tanggal ini.</div>`;
        return;
      }
      container.innerHTML = filtered.map(m => `
        <div class="p-2.5 rounded-3 d-flex align-items-start justify-content-between gap-2 ${m.selesai ? 'opacity-50' : ''}" style="background: var(--bg-paper); border: 1px solid var(--border-organic); padding: 9px 11px;">
          <label class="d-flex align-items-start gap-2 flex-grow-1 min-w-0 m-0" style="cursor: pointer;">
            <input type="checkbox" class="mt-1 flex-shrink-0" style="accent-color: #497a61; cursor: pointer;" ${m.selesai ? 'checked' : ''} onchange="toggleHrMemoDone(${m.id})">
            <div class="min-w-0 flex-grow-1">
              <div class="fw-bold ${m.selesai ? 'text-decoration-line-through' : ''}" style="font-size: 11.5px; color: var(--ink-deep); line-height: 1.3;">${m.judul}</div>
              <div class="font-mono-num mt-0.5" style="font-size: 10px; color: var(--ink-muted);">${formatDisplayDate(m.tanggal)} &bull; ${m.waktu || '14:00'} &bull; ${m.kategori}</div>
            </div>
          </label>
          <button type="button" class="border-0 bg-transparent p-0 px-1" style="color: var(--ink-muted); font-size: 12px;" onclick="deleteHrMemo(${m.id})">&times;</button>
        </div>
      `).join('');
    }

    function submitHrMemo(e) {
      if (e) e.preventDefault();
      const titleInput = document.getElementById('hrMemoTitleInput');
      const dateInput = document.getElementById('hrMemoDateInput');
      const timeInput = document.getElementById('hrMemoTimeInput');
      const catInput = document.getElementById('hrMemoCatInput');
      const judul = titleInput ? titleInput.value.trim() : '';
      if (!judul) {
        if (window.KovToast && typeof window.KovToast.triggerError === 'function') {
          window.KovToast.triggerError(titleInput, 'Isi memo wajib ditulis dulu!', 'Belum Lengkap');
        }
        return;
      }
      const payload = {
        tanggal: (dateInput && dateInput.value) ? dateInput.value : '2026-10-24',
        waktu: (timeInput && timeInput.value) ? timeInput.value : '14:00',
        kategori: (catInput && catInput.value) ? catInput.value : 'Uji Praktik',
        judul,
        catatan: '',
        _csrf: KOV_CSRF_TOKEN
      };
      hrMemosState.unshift({ id: Date.now(), ...payload, selesai: 0 });
      try { localStorage.setItem('kov_hr_memos_v11', JSON.stringify(hrMemosState)); } catch (err) {}
      if (titleInput) titleInput.value = '';
      renderHrMemoList();
      renderCalendar();
      if (typeof fetch === 'function') {
        fetch('/api/hr/memos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': KOV_CSRF_TOKEN },
          body: JSON.stringify(payload)
        }).catch(() => {});
      }
      if (window.KovToast && typeof window.KovToast.success === 'function') {
        window.KovToast.success(`Agenda "${judul}" disimpan ke kalender.`, 'Memo Tersimpan');
      }
    }

    function toggleHrMemoDone(id) {
      const item = hrMemosState.find(m => m.id === id);
      if (!item) return;
      item.selesai = item.selesai ? 0 : 1;
      try { localStorage.setItem('kov_hr_memos_v11', JSON.stringify(hrMemosState)); } catch (err) {}
      renderHrMemoList();
      if (typeof fetch === 'function') {
        fetch('/api/hr/memos/' + id + '/toggle', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': KOV_CSRF_TOKEN },
          body: JSON.stringify({ _csrf: KOV_CSRF_TOKEN })
        }).catch(() => {});
      }
    }

    function deleteHrMemo(id) {
      hrMemosState = hrMemosState.filter(m => m.id !== id);
      try { localStorage.setItem('kov_hr_memos_v11', JSON.stringify(hrMemosState)); } catch (err) {}
      renderHrMemoList();
      renderCalendar();
      if (typeof fetch === 'function') {
        fetch('/api/hr/memos/' + id, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': KOV_CSRF_TOKEN },
          body: JSON.stringify({ _csrf: KOV_CSRF_TOKEN })
        }).catch(() => {});
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadHrMemos();
      renderCalendar();
    });
  </script>
  <script src="/idle-timer.js"></script>
</body>
</html>