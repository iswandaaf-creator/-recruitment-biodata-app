<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Buat Purchase Order (PO) Baru — KOV Group</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  
  <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS & FontAwesome -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  
  <!-- Figma Design Token System -->
  <link href="/assets/css/kov-portal.css?v=20261029_kov_v11" rel="stylesheet">
  
  <style>
    body {
      background-color: var(--figma-canvas, #f8fafc);
      color: var(--figma-neutral-800, #4c5b52);
      font-family: var(--figma-font-sans, 'Plus Jakarta Sans', sans-serif);
      -webkit-font-smoothing: antialiased;
    }

    /* Top Glass Navbar */
    .navbar-po-form {
      background: rgba(15, 23, 42, 0.94);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: sticky;
      top: 0;
      z-index: 1020;
    }

    /* Executive Form Banner (Taste-Skill Framed Sheet) */
    .po-header-banner {
      background: #ffffff;
      color: #4c5b52;
      padding: 1.75rem 1.5rem;
      border-radius: 0;
      border-bottom: 1px solid #e2e8f0;
      box-shadow: none;
    }

    /* Framed-Sheet Form Section Cards */
    .card-po-section {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      box-shadow: none;
      margin-bottom: 1.5rem;
      overflow: hidden;
    }
    .card-po-section .card-header {
      background: #f8fafc;
      border-bottom: 1px solid #e2e8f0;
      padding: 1rem 1.25rem;
      font-weight: 700;
      color: #166534;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .section-pill-num {
      width: 24px;
      height: 24px;
      background: rgba(22, 101, 52, 0.12);
      color: #166534;
      border: 1px solid rgba(22, 101, 52, 0.25);
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 0.78rem;
      font-weight: 700;
    }

    .form-label {
      font-weight: 600;
      font-size: 0.85rem;
      color: var(--figma-neutral-700, #334155);
      margin-bottom: 0.35rem;
    }

    .form-control, .form-select {
      border-radius: 8px;
      border: 1px solid #cbd5e1;
      padding: 0.55rem 0.8rem;
      font-size: 0.9rem;
      transition: all 0.15s ease;
    }
    .form-control:focus, .form-select:focus {
      border-color: #059669;
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    }

    .signature-container {
      border: 2px dashed #94a3b8;
      border-radius: 12px;
      background-color: #f8fafc;
      width: 100%;
      height: 160px;
      position: relative;
    }
    canvas {
      width: 100%;
      height: 100%;
      cursor: crosshair;
    }

    .totals-summary-box {
      background: #f8fafc;
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      border: 1px solid #e2e8f0;
    }

    /* Items Table Custom Styling & Fixed Width Sizing */
    .table-items-wrapper {
      overflow-x: auto;
      border-radius: 0;
      background: transparent;
    }
    #itemsTable {
      width: 100%;
      min-width: 960px;
      margin-bottom: 0;
      border-collapse: separate !important;
      border-spacing: 0 8px !important;
    }
    #itemsTable thead th {
      background: #f8fafc !important;
      color: #475569 !important;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 0.65rem 0.5rem !important;
      border: none !important;
      white-space: nowrap;
      vertical-align: middle;
    }
    #itemsTable tbody tr {
      background: #ffffff;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
      border-radius: 10px;
    }
    #itemsTable tbody td {
      padding: 0.5rem 0.45rem !important;
      vertical-align: middle;
      border-top: 1px solid #f1f5f9;
      border-bottom: 1px solid #f1f5f9;
      background: transparent;
    }
    #itemsTable tbody td:first-child {
      border-left: 1px solid #f1f5f9;
      border-top-left-radius: 10px;
      border-bottom-left-radius: 10px;
    }
    #itemsTable tbody td:last-child {
      border-right: 1px solid #f1f5f9;
      border-top-right-radius: 10px;
      border-bottom-right-radius: 10px;
    }

    /* Table Inputs */
    #itemsTable .form-control {
      padding: 0.45rem 0.6rem !important;
      font-size: 0.875rem !important;
      height: 38px;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      color: #384d42 !important;
      background-color: #ffffff;
    }
    #itemsTable .form-control:focus {
      border-color: #059669;
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.15);
    }

    /* Quantity Input: High-Contrast, Visible, No Spinners */
    #itemsTable .item-qty {
      font-weight: 800 !important;
      font-size: 1rem !important;
      color: #064e3b !important;
      background-color: #f0fdf4 !important;
      border: 1.5px solid #10b981 !important;
      text-align: center !important;
      width: 100% !important;
      min-width: 80px !important;
      border-radius: 8px !important;
      box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.05);
    }
    #itemsTable .item-qty:focus {
      border-color: #059669 !important;
      background-color: #ffffff !important;
      box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25) !important;
    }
    #itemsTable .item-qty::-webkit-inner-spin-button,
    #itemsTable .item-qty::-webkit-outer-spin-button {
      -webkit-appearance: none !important;
      margin: 0 !important;
    }

    /* Satuan Input */
    #itemsTable .item-satuan {
      font-weight: 600 !important;
      text-align: center !important;
      color: #334155 !important;
      width: 100% !important;
      min-width: 75px !important;
    }

    /* Harga Satuan */
    #itemsTable .item-harga {
      font-weight: 600 !important;
      text-align: right !important;
      font-family: monospace, sans-serif !important;
      color: #384d42 !important;
      width: 100% !important;
      min-width: 110px !important;
      -moz-appearance: textfield !important;
      appearance: textfield !important;
    }
    #itemsTable .item-harga::-webkit-inner-spin-button,
    #itemsTable .item-harga::-webkit-outer-spin-button {
      -webkit-appearance: none !important;
      margin: 0 !important;
    }

    /* Total Label */
    #itemsTable .item-total-lbl {
      font-size: 0.95rem !important;
      font-weight: 700 !important;
      color: #059669 !important;
      white-space: nowrap;
      padding-right: 0.6rem !important;
    }

    /* Row Number Badge */
    .row-num-badge {
      width: 26px;
      height: 26px;
      background: #f1f5f9;
      color: #475569;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.8rem;
    }

    /* Dark Mode Overrides */
    [data-theme="dark"] .card-po-section {
      background: #fcfbf9 !important;
      border-color: #4c5b52 !important;
      box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.4) !important;
    }
    [data-theme="dark"] .card-po-section .card-header {
      background: #384d42 !important;
      border-bottom-color: #4c5b52 !important;
      color: #34d399 !important;
    }
    [data-theme="dark"] .form-label {
      color: #e2e8f0 !important;
    }
    [data-theme="dark"] .form-control,
    [data-theme="dark"] .form-select {
      background-color: #f5f3ed !important;
      border-color: #4c5b52 !important;
      color: #ffffff !important;
    }
    [data-theme="dark"] .form-control:focus,
    [data-theme="dark"] .form-select:focus {
      border-color: #059669 !important;
      box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.25) !important;
    }
    [data-theme="dark"] #itemsTable thead th {
      background: #384d42 !important;
      color: #94a3b8 !important;
    }
    [data-theme="dark"] #itemsTable tbody tr {
      background: #fcfbf9 !important;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3) !important;
    }
    [data-theme="dark"] #itemsTable tbody td {
      border-color: #4c5b52 !important;
      color: #e2e8f0 !important;
    }
    [data-theme="dark"] #itemsTable .form-control {
      background-color: #f5f3ed !important;
      border-color: #4c5b52 !important;
      color: #ffffff !important;
    }
    [data-theme="dark"] #itemsTable .item-qty {
      color: #34d399 !important;
      background-color: rgba(16, 185, 129, 0.15) !important;
      border-color: #059669 !important;
    }
    [data-theme="dark"] #itemsTable .item-satuan {
      color: #e2e8f0 !important;
    }
    [data-theme="dark"] #itemsTable .item-harga {
      color: #f8fafc !important;
    }
    [data-theme="dark"] .row-num-badge {
      background: #f5f3ed;
      color: #34d399;
    }
    [data-theme="dark"] .totals-summary-box {
      background: #384d42 !important;
      border-color: #4c5b52 !important;
    }
    [data-theme="dark"] .signature-container {
      background-color: #384d42 !important;
      border-color: #4b5563 !important;
    }
  </style>
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'po', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Minimalist Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-sidebar-toggle-btn btn-kov-outline d-inline-flex align-items-center justify-content-center flex-shrink-0" onclick="toggleKovSidebar()" aria-label="Geser / Lipat Navigasi" title="Lipat / Geser Navigasi Sidebar" style="width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border-organic, #d8e2dc); background: var(--bg-paper, #fcfbf9); color: var(--ink-deep, #384d42); cursor: pointer; padding: 0;">
            <svg viewBox="0 0 24 24" fill="none" style="width: 17px; height: 17px;">
              <path d="M4 6H20M4 12H20M4 18H20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </button>
          <a class="btn-kov-secondary btn-kov-sm" href="/admin/operasional/po">
            <i class="fas fa-arrow-left"></i> <span class="d-none d-sm-inline">Kembali</span>
          </a>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Buat Purchase Order (PO)</h1>
            <span class="status-pill-modern pill-success d-none d-sm-inline-flex" style="padding: 2px 8px; font-size: 0.7rem;">
              <span class="status-dot-pulse"></span> Procurement Form
            </span>
          </div>
        </div>
        <div class="kov-topbar-right d-flex align-items-center gap-2">
          <!-- KOV Dual-Theme Switcher -->
          <button type="button" class="kov-theme-toggle" onclick="toggleKovTheme()" title="Ganti Mode Gelap / Terang">
            <i class="fas fa-moon kov-theme-icon"></i>
          </button>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

  <div class="container pb-5" style="max-width: 1040px;">
    <% if (typeof poToCopy !== 'undefined' && poToCopy) { %>
      <div class="alert alert-info border-0 shadow-sm rounded-4 p-3 mb-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
          <i class="fas fa-copy text-primary fs-5"></i>
          <div>
            <strong>Menduplikasi Data PO:</strong> Formulir telah diisi otomatis dari dokumen <strong><%= poToCopy.no_po %></strong> (<%= poToCopy.vendor_nama %>). Nomor PO baru dan tanggal hari ini dibuat otomatis.
          </div>
        </div>
        <a href="/admin/operasional/po/create" class="btn btn-sm btn-outline-secondary rounded-pill px-3 py-1">Reset ke Form Kosong</a>
      </div>
    <% } %>
    <form id="poForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      
      <!-- SECTION 1: HEADER & VENDOR -->
      <div class="card-po-section">
        <div class="card-header">
          <span class="section-pill-num">1</span>
          <span>Header Dokumen & Informasi Vendor (Penyedia)</span>
        </div>
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-md-4">
              <label class="form-label">Nomor PO <span class="text-danger">*</span></label>
              <input type="text" class="form-control fw-bold text-success font-monospace" name="no_po" id="no_po" required readonly>
              <small class="text-muted" style="font-size: 11px;">Nomor PO dibuat otomatis oleh sistem</small>
            </div>
            <div class="col-md-4">
              <label class="form-label">Tanggal PO <span class="text-danger">*</span></label>
              <input type="date" class="form-control" name="tanggal_po" id="tanggal_po" required>
            </div>
            <div class="col-md-4">
              <label class="form-label">Status PO</label>
              <select class="form-select" name="status_po">
                <option value="Reguler / Approved" selected>Reguler / Approved</option>
                <option value="Urgent">Urgent</option>
                <option value="Pending">Pending</option>
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label">Nama Vendor / PT <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="vendor_nama" value="<%= (typeof poToCopy !== 'undefined' && poToCopy && poToCopy.vendor_nama) ? poToCopy.vendor_nama : '' %>" placeholder="Contoh: PT AGRES INFO TEKNOLOGI" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Nama Dagang / Toko</label>
              <input type="text" class="form-control" name="vendor_nama_dagang" value="<%= (typeof poToCopy !== 'undefined' && poToCopy && poToCopy.vendor_nama_dagang) ? poToCopy.vendor_nama_dagang : '' %>" placeholder="Contoh: AGRES.ID / Tokopedia Official">
            </div>
            <div class="col-md-6">
              <label class="form-label">Perihal Pengadaan <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="perihal" value="<%= (typeof poToCopy !== 'undefined' && poToCopy && poToCopy.perihal) ? poToCopy.perihal : '' %>" placeholder="Contoh: Pengadaan Laptop Kasir & Perlengkapan IT" required>
            </div>
            <div class="col-md-6">
              <label class="form-label d-flex justify-content-between">
                <span>Pilih Outlet / Unit Kerja (Master Index)</span>
                <span class="text-primary fw-bold" style="font-size: 11px;"><i class="fas fa-building me-1"></i>Auto-Fill PT &amp; Alamat</span>
              </label>
              <select class="form-select" id="selectCompanyOutlet" onchange="applyCompanyOutlet(this)">
                <option value="">-- Pilih dari Master Perusahaan / Outlet KOV --</option>
                <% if (typeof companies !== 'undefined' && companies && companies.length > 0) { %>
                  <% companies.forEach(function(c) { %>
                    <option value="<%= c.id %>" data-pt="<%= c.nama_perusahaan %>" data-outlet="<%= c.nama_outlet %>" data-alamat="<%= c.alamat %>">
                      <%= c.nama_outlet %> (<%= c.nama_perusahaan %>) <%= c.is_holding === 1 ? '[HOLDING]' : '' %>
                    </option>
                  <% }); %>
                <% } %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label">Unit Kerja / PT Pembeli <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="unit_kerja" id="inputUnitKerja" value="<%= (typeof poToCopy !== 'undefined' && poToCopy && poToCopy.unit_kerja) ? poToCopy.unit_kerja : 'PT Puteri Seruput Indonesia' %>" placeholder="Contoh: PT Puteri Seruput Indonesia / PT Samasta Kopi Indonesia" required>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 2: PENGIRIMAN & PEMBAYARAN -->
      <div class="card-po-section">
        <div class="card-header">
          <span class="section-pill-num">2</span>
          <span>Detail Pengiriman & Ketentuan Pembayaran</span>
        </div>
        <div class="card-body p-4">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label">Lokasi Pengiriman <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="lokasi_kirim" value="<%= (typeof poToCopy !== 'undefined' && poToCopy && poToCopy.lokasi_kirim) ? poToCopy.lokasi_kirim : '' %>" placeholder="Contoh: KOV Koffie, Jl. Sultan Agung No.135, Kaliwiru, Semarang" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Tanggal Estimasi Pengiriman</label>
              <input type="date" class="form-control" name="tgl_pengiriman" id="tgl_pengiriman">
            </div>
            <div class="col-md-6">
              <label class="form-label">Termin Pembayaran <span class="text-danger">*</span></label>
              <input type="text" class="form-control" name="termin_bayar" value="<%= (typeof poToCopy !== 'undefined' && poToCopy && poToCopy.termin_bayar) ? poToCopy.termin_bayar : 'DP 30% / Transfer Bank' %>" placeholder="Contoh: DP 30% / Pelunasan 14 Hari" required>
            </div>
            <div class="col-md-6">
              <label class="form-label">Mata Uang</label>
              <input type="text" class="form-control bg-light" name="mata_uang" value="IDR (Rupiah)" readonly>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 3: TABEL ITEM BARANG (DYNAMIC ROWS) -->
      <div class="card-po-section">
        <div class="card-header d-flex justify-content-between align-items-center">
          <div class="d-flex align-items-center gap-2">
            <span class="section-pill-num">3</span>
            <span>Kode, Spesifikasi & Daftar Barang</span>
          </div>
          <button type="button" class="btn btn-success btn-sm fw-bold rounded-pill px-3" onclick="addItemRow()">
            <i class="fas fa-plus me-1"></i>Tambah Baris
          </button>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive table-items-wrapper">
            <table class="table align-middle mb-0" id="itemsTable">
              <thead>
                <tr>
                  <th style="width: 44px; min-width: 44px;" class="ps-3 text-center">NO</th>
                  <th style="min-width: 220px;">KODE &amp; NAMA BARANG</th>
                  <th style="min-width: 200px;">SPESIFIKASI DETAIL</th>
                  <th style="width: 95px; min-width: 90px;" class="text-center">QTY</th>
                  <th style="width: 95px; min-width: 90px;" class="text-center">SATUAN</th>
                  <th style="width: 145px; min-width: 135px;" class="text-end">HARGA (RP)</th>
                  <th style="width: 145px; min-width: 135px;" class="text-end">TOTAL (RP)</th>
                  <th style="width: 48px; min-width: 48px;" class="text-center pe-3">AKSI</th>
                </tr>
              </thead>
              <tbody id="itemsTbody">
                <!-- Dynamic Rows Inserted Here -->
              </tbody>
            </table>
          </div>
          
          <!-- Datalist Satuan Pilihan Standard -->
          <datalist id="satuanList">
            <option value="PCS"></option>
            <option value="Unit"></option>
            <option value="Box"></option>
            <option value="Set"></option>
            <option value="Paket"></option>
            <option value="Roll"></option>
            <option value="Meter"></option>
            <option value="Kg"></option>
            <option value="Rim"></option>
            <option value="Lembar"></option>
            <option value="Botol"></option>
            <option value="Psg"></option>
          </datalist>
          
          <!-- Summary Totals Block -->
          <div class="p-4 bg-light border-top">
            <div class="row justify-content-end">
              <div class="col-md-6 col-lg-5">
                <div class="totals-summary-box">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-bold">Subtotal:</span>
                    <span class="fw-bold font-monospace" id="lblSubtotal">Rp 0</span>
                    <input type="hidden" name="subtotal" id="inputSubtotal" value="0">
                  </div>
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-bold">PPN (%):</span>
                    <div class="input-group input-group-sm" style="width: 120px;">
                      <input type="number" class="form-control text-end" name="ppn_persen" id="ppn_persen" min="0" max="100" value="<%= (typeof poToCopy !== 'undefined' && poToCopy && poToCopy.ppn_persen != null) ? poToCopy.ppn_persen : 0 %>" onfocus="this.select()">
                      <span class="input-group-text">%</span>
                    </div>
                  </div>
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small">Nominal PPN:</span>
                    <span class="text-muted font-monospace small" id="lblPpnNominal">Rp 0</span>
                    <input type="hidden" name="ppn_nominal" id="inputPpnNominal" value="0">
                  </div>
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-bold">Diskon (Rp):</span>
                    <input type="number" class="form-control form-control-sm text-end" style="width: 140px;" name="diskon_nominal" id="diskon_nominal" min="0" value="<%= (typeof poToCopy !== 'undefined' && poToCopy && poToCopy.diskon_nominal != null) ? poToCopy.diskon_nominal : 0 %>" onfocus="this.select()">
                  </div>
                  <hr class="my-2">
                  <div class="d-flex justify-content-between align-items-center fs-5 fw-bold text-success">
                    <span style="font-size: 0.95rem;">TOTAL NETTO:</span>
                    <span id="lblTotalNetto" class="font-monospace">Rp 0</span>
                    <input type="hidden" name="total_netto" id="inputTotalNetto" value="0">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 4: SYARAT & KETENTUAN -->
      <div class="card-po-section">
        <div class="card-header">
          <span class="section-pill-num">4</span>
          <span>Syarat & Ketentuan Pengadaan</span>
        </div>
        <div class="card-body p-4">
          <div class="mb-0">
            <label class="form-label">Catatan Syarat & Ketentuan</label>
            <textarea class="form-control" name="catatan_syarat" rows="3">Seluruh barang dalam keadaan segel baru dan bergaransi resmi pabrikan.
DENGAN DOWN PAYMENT 30% DAN PELUNASAN JANGKA WAKTU 2 MINGGU.
Pengiriman melampirkan Faktur Pembelian/Invoice resmi dan Berita Acara Serah Terima (BAST).</textarea>
          </div>
        </div>
      </div>

      <!-- SECTION 5: OTORISASI & TANDA TANGAN -->
      <div class="card-po-section">
        <div class="card-header">
          <span class="section-pill-num">5</span>
          <span>Lembar Otorisasi & Tanda Tangan Digital</span>
        </div>
        <div class="card-body p-4">
          <div class="row g-4">
            <div class="col-md-4 border-end">
              <h6 class="fw-bold text-success mb-2 small text-uppercase tracking-wider">Dibuat Oleh (Procurement):</h6>
              <div class="mb-2">
                <label class="form-label small">Nama Staff</label>
                <input type="text" class="form-control form-control-sm" name="dibuat_oleh_nama" value="ISWANDA ADITYA F.">
              </div>
              <div class="mb-2">
                <label class="form-label small">Jabatan</label>
                <input type="text" class="form-control form-control-sm" name="dibuat_oleh_jabatan" value="Procurement / Staff IT">
              </div>
              <label class="form-label small">Tanda Tangan Digital:</label>
              <div class="signature-container">
                <canvas id="sigCanvas"></canvas>
              </div>
              <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill mt-2 float-end" id="btnClearSig">
                <i class="fas fa-eraser me-1"></i>Hapus TTD
              </button>
              <input type="hidden" name="signature_dibuat" id="signature_dibuat">
            </div>

            <div class="col-md-4 border-end">
              <h6 class="fw-bold text-success mb-2 small text-uppercase tracking-wider">Disetujui Oleh (Finance):</h6>
              <div class="mb-2">
                <label class="form-label small">Nama Otorisator</label>
                <input type="text" class="form-control form-control-sm" name="disetujui_oleh_nama" value="KEN">
              </div>
              <div class="mb-2">
                <label class="form-label small">Jabatan</label>
                <input type="text" class="form-control form-control-sm" name="disetujui_oleh_jabatan" value="Finance Manager">
              </div>
              <div class="p-3 bg-light rounded-3 text-center text-muted small mt-4 border">
                <i class="fas fa-check-double text-success me-1"></i>Otorisasi Digital Otomatis Saat Disetujui
              </div>
            </div>

            <div class="col-md-4">
              <h6 class="fw-bold text-success mb-2 small text-uppercase tracking-wider">Konfirmasi Vendor:</h6>
              <div class="mb-2">
                <label class="form-label small">Nama PT Vendor</label>
                <input type="text" class="form-control form-control-sm" name="vendor_konfirmasi_nama" value="PT AGRES INFO TEKNOLOGI">
              </div>
              <div class="mb-2">
                <label class="form-label small">Perwakilan</label>
                <input type="text" class="form-control form-control-sm" name="vendor_konfirmasi_jabatan" value="Perwakilan Resmi">
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="text-center mt-4">
        <button type="submit" class="btn btn-success fw-bold rounded-pill px-5 py-3 shadow" id="btnSubmit" style="background: linear-gradient(135deg, #064e3b 0%, #059669 100%); border: none;">
          <i class="fas fa-paper-plane me-2"></i>Simpan & Terbitkan Purchase Order
        </button>
      </div>

    </form>
  </div>
      </main>
    </div>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    // Auto generate No PO: PO/WHM/MM/YYYY/XXX
    const now = new Date();
    document.getElementById('tanggal_po').valueAsDate = now;
    document.getElementById('tgl_pengiriman').valueAsDate = now;
    const monthRoman = ["I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X", "XI", "XII"][now.getMonth()];
    const randNum = Math.floor(10 + Math.random() * 90);
    document.getElementById('no_po').value = `PO/WHM/${monthRoman}/${now.getFullYear()}/${randNum}`;

    // Dynamic Items Table
    let itemIndex = 0;
    function addItemRow(defaultData = null) {
      itemIndex++;
      const tbody = document.getElementById('itemsTbody');
      const tr = document.createElement('tr');
      tr.id = `row_${itemIndex}`;

      const nameVal = defaultData && defaultData.nama ? defaultData.nama : '';
      const specVal = defaultData && defaultData.spec ? defaultData.spec : '';
      const qtyVal = (defaultData && defaultData.qty != null) ? defaultData.qty : 1;
      const satuanVal = defaultData && defaultData.satuan ? defaultData.satuan : 'PCS';
      const hargaVal = (defaultData && defaultData.harga != null) ? defaultData.harga : 0;

      tr.innerHTML = `
        <td class="text-center row-num ps-3">
          <span class="row-num-badge">${tbody.children.length + 1}</span>
        </td>
        <td>
          <input type="text" class="form-control form-control-sm fw-semibold" name="item_nama_${itemIndex}" value="${nameVal}" placeholder="Nama & Kode Barang" required>
        </td>
        <td>
          <input type="text" class="form-control form-control-sm" name="item_spec_${itemIndex}" value="${specVal}" placeholder="Spesifikasi Detail (opsional)">
        </td>
        <td>
          <input type="text" inputmode="numeric" pattern="[0-9]*" class="form-control form-control-sm item-qty text-center" name="item_qty_${itemIndex}" value="${qtyVal || 1}" placeholder="1" required autocomplete="off">
        </td>
        <td>
          <input type="text" list="satuanList" class="form-control form-control-sm item-satuan text-center" name="item_satuan_${itemIndex}" value="${satuanVal}" placeholder="PCS" required onfocus="this.select()">
        </td>
        <td>
          <input type="number" class="form-control form-control-sm item-harga text-end" name="item_harga_${itemIndex}" min="0" step="1" value="${hargaVal}" required onfocus="this.select()" autocomplete="off">
        </td>
        <td class="text-end fw-bold text-success font-monospace item-total-lbl">Rp 0</td>
        <td class="text-center pe-3">
          <button type="button" class="btn btn-outline-danger btn-sm rounded-circle py-0 px-2" onclick="removeRow(${itemIndex})" title="Hapus baris">
            &times;
          </button>
        </td>
      `;

      tbody.appendChild(tr);

      const qtyInpEl = tr.querySelector('.item-qty');
      if (qtyInpEl) {
        qtyInpEl.value = String(qtyVal || 1);
        qtyInpEl.defaultValue = String(qtyVal || 1);
      }

      attachCalcEvents(tr);
      recalculateAll();
    }

    function removeRow(idx) {
      const tbody = document.getElementById('itemsTbody');
      if (tbody.children.length <= 1) {
        if (window.KovToast && typeof window.KovToast.warning === 'function') {
          window.KovToast.warning('Purchase Order harus memiliki minimal 1 item barang.', 'Perhatian');
        } else {
          alert('Purchase Order harus memiliki minimal 1 item barang.');
        }
        return;
      }
      const row = document.getElementById(`row_${idx}`);
      if (row) {
        row.remove();
        reindexRows();
        recalculateAll();
      }
    }

    function reindexRows() {
      const rows = document.querySelectorAll('#itemsTbody tr');
      rows.forEach((r, index) => {
        const badge = r.querySelector('.row-num-badge');
        if (badge) badge.innerText = index + 1;
      });
    }

    function attachCalcEvents(row) {
      const qtyInp = row.querySelector('.item-qty');
      const hargaInp = row.querySelector('.item-harga');

      function updateRowTotal() {
        const qty = parseFloat(qtyInp.value) || 0;
        const harga = parseFloat(hargaInp.value) || 0;
        const total = qty * harga;
        row.querySelector('.item-total-lbl').innerText = 'Rp ' + total.toLocaleString('id-ID');
        recalculateAll();
      }

      qtyInp.addEventListener('input', (e) => {
        e.target.value = e.target.value.replace(/[^0-9]/g, '');
        updateRowTotal();
      });
      qtyInp.addEventListener('blur', (e) => {
        if (!e.target.value || parseInt(e.target.value) <= 0) {
          e.target.value = '1';
        }
        updateRowTotal();
      });
      hargaInp.addEventListener('input', updateRowTotal);
      updateRowTotal();
    }

    function recalculateAll() {
      let subtotal = 0;
      const rows = document.querySelectorAll('#itemsTbody tr');
      rows.forEach(r => {
        const qty = parseFloat(r.querySelector('.item-qty').value) || 0;
        const harga = parseFloat(r.querySelector('.item-harga').value) || 0;
        subtotal += (qty * harga);
      });

      const ppnPersen = parseFloat(document.getElementById('ppn_persen').value) || 0;
      const ppnNominal = subtotal * (ppnPersen / 100);
      const diskon = parseFloat(document.getElementById('diskon_nominal').value) || 0;
      const totalNetto = Math.max(0, subtotal + ppnNominal - diskon);

      document.getElementById('lblSubtotal').innerText = 'Rp ' + subtotal.toLocaleString('id-ID');
      document.getElementById('inputSubtotal').value = subtotal;

      document.getElementById('lblPpnNominal').innerText = 'Rp ' + Math.round(ppnNominal).toLocaleString('id-ID');
      document.getElementById('inputPpnNominal').value = Math.round(ppnNominal);

      document.getElementById('lblTotalNetto').innerText = 'Rp ' + Math.round(totalNetto).toLocaleString('id-ID');
      document.getElementById('inputTotalNetto').value = Math.round(totalNetto);
    }

    document.getElementById('ppn_persen').addEventListener('input', recalculateAll);
    document.getElementById('diskon_nominal').addEventListener('input', recalculateAll);

    // Initial item rows (Preloaded from poToCopy if duplicating, else 1 clean row)
    <% if (typeof poToCopy !== 'undefined' && poToCopy && poToCopy.items_json) { %>
      try {
        const copiedItems = <%- poToCopy.items_json %>;
        if (Array.isArray(copiedItems) && copiedItems.length > 0) {
          copiedItems.forEach(it => {
            addItemRow({
              nama: it.nama_kode || it.nama || it.nama_barang || '',
              spec: it.spesifikasi || it.spec || '',
              qty: it.qty || 1,
              satuan: it.satuan || 'PCS',
              harga: it.harga_satuan || it.harga || 0
            });
          });
        } else {
          addItemRow();
        }
      } catch (e) {
        addItemRow();
      }
    <% } else { %>
      addItemRow();
    <% } %>

    // Signature Pad with Persistent State
    const canvas = document.getElementById('sigCanvas');
    const ctx = canvas.getContext('2d');
    let isDrawing = false;
    let hasDrawn = false;

    function resizeCanvas() {
      const rect = canvas.parentElement.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      let tempImage = null;
      if (hasDrawn) {
        tempImage = canvas.toDataURL();
      }
      canvas.width = rect.width;
      canvas.height = rect.height;
      ctx.lineWidth = 2.5;
      ctx.lineCap = 'round';
      ctx.strokeStyle = '#064e3b';
      if (tempImage) {
        const img = new Image();
        img.onload = () => ctx.drawImage(img, 0, 0);
        img.src = tempImage;
      }
    }
    window.addEventListener('load', resizeCanvas);
    window.addEventListener('resize', resizeCanvas);

    function getPos(e) {
      const rect = canvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      return { x: clientX - rect.left, y: clientY - rect.top };
    }
    canvas.addEventListener('mousedown', (e) => { isDrawing = true; hasDrawn = true; const p = getPos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); });
    canvas.addEventListener('mousemove', (e) => { if (!isDrawing) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); });
    canvas.addEventListener('mouseup', () => { isDrawing = false; });
    
    canvas.addEventListener('touchstart', (e) => { isDrawing = true; hasDrawn = true; const p = getPos(e); ctx.beginPath(); ctx.moveTo(p.x, p.y); e.preventDefault(); });
    canvas.addEventListener('touchmove', (e) => { if (!isDrawing) return; const p = getPos(e); ctx.lineTo(p.x, p.y); ctx.stroke(); e.preventDefault(); });
    canvas.addEventListener('touchend', () => { isDrawing = false; });

    document.getElementById('btnClearSig').addEventListener('click', () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      hasDrawn = false;
      const sigInput = document.getElementById('signature_dibuat');
      if (sigInput) sigInput.value = '';
    });

    // Master Index Company / Outlet Auto-fill Handler
    function applyCompanyOutlet(sel) {
      const opt = sel.options[sel.selectedIndex];
      if (!opt || !opt.value) return;
      const pt = opt.getAttribute('data-pt');
      const outlet = opt.getAttribute('data-outlet');
      const alamat = opt.getAttribute('data-alamat');

      if (pt) {
        const ptInput = document.getElementById('inputUnitKerja');
        if (ptInput) ptInput.value = pt;
      }
      if (outlet && alamat) {
        const locInput = document.querySelector('input[name="lokasi_kirim"]');
        if (locInput) locInput.value = outlet + ' - ' + alamat;
      }
    }

    // Submit Form
    document.getElementById('poForm').addEventListener('submit', async function(e) {
      e.preventDefault();
      
      const rows = document.querySelectorAll('#itemsTbody tr');
      if (rows.length === 0) {
        KovToast.warning('Harap isi minimal 1 item barang dalam Purchase Order.', 'Item Kosong');
        return;
      }

      const btnSubmit = this.querySelector('button[type="submit"]');
      KovToast.setLoading(btnSubmit, 'Menerbitkan Purchase Order...');

      const items = [];
      rows.forEach(r => {
        items.push({
          nama_kode: r.querySelector('input[name^="item_nama_"]').value,
          spesifikasi: r.querySelector('input[name^="item_spec_"]').value,
          qty: parseFloat(r.querySelector('.item-qty').value) || 1,
          satuan: r.querySelector('input[name^="item_satuan_"]').value,
          harga_satuan: parseFloat(r.querySelector('.item-harga').value) || 0,
          total_harga: (parseFloat(r.querySelector('.item-qty').value) || 1) * (parseFloat(r.querySelector('.item-harga').value) || 0)
        });
      });

      const blankCanvas = document.createElement('canvas');
      blankCanvas.width = canvas.width;
      blankCanvas.height = canvas.height;
      if (canvas.toDataURL() !== blankCanvas.toDataURL()) {
        document.getElementById('signature_dibuat').value = canvas.toDataURL('image/png');
      }

      const formData = new FormData(this);
      const data = Object.fromEntries(formData.entries());
      data.items_json = JSON.stringify(items);

      try {
        const res = await fetch('/api/operasional/po/submit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= csrfToken %>'
          },
          body: JSON.stringify(data)
        });
        const json = await res.json();
        if (json.success) {
          KovToast.approvalFeedback({
            title: 'Purchase Order Terbit!',
            message: 'Dokumen ' + (json.no_po || '') + ' berhasil dibuat & tersinkron ke Rekap IT.',
            duration: 1800,
            onComplete: () => {
              window.location.href = `/admin/operasional/po/detail/${json.id}`;
            }
          });
        } else {
          KovToast.resetLoading(btnSubmit);
          KovToast.error(json.error || 'Terjadi kesalahan sistem', 'Gagal Menerbitkan PO');
        }
      } catch (err) {
        KovToast.resetLoading(btnSubmit);
        KovToast.error('Kesalahan jaringan: ' + err.message, 'Gagal Koneksi');
      }
    });
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
