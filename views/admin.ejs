<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Rekrutmen HR - KOV Portal</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: IBM Plex Sans & IBM Plex Mono (Curated Editorial Anti-Slop) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261029_cila_v8" rel="stylesheet">
  <!-- Dribbble Cloud Drive Design System Extension -->
  
  <!-- Toast & Theme Global Utilities in Head for Immediate Availability -->
  <script src="/assets/js/kov-toast.js"></script>
  <script src="/assets/js/kov-theme.js"></script>
  <style>
    /* Custom page-level enhancements */
    .filter-pill {
      font-size: 0.8rem;
      font-weight: 600;
      padding: 0.4rem 0.85rem;
      border-radius: var(--kov-radius-pill);
      border: 1px solid var(--kov-slate-200);
      background: #ffffff;
      color: var(--kov-slate-600);
      transition: var(--kov-transition);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
    }

    .filter-pill:hover {
      background: var(--kov-slate-100);
      color: var(--kov-slate-900);
      border-color: var(--kov-slate-300);
    }

    .filter-pill.active {
      background: var(--dd-primary, #166534);
      color: #ffffff;
      border-color: var(--dd-primary, #166534);
      box-shadow: none;
    }

    .sortable-header {
      cursor: pointer;
      user-select: none;
      transition: var(--kov-transition);
    }

    .sortable-header:hover {
      background-color: var(--kov-slate-100);
      color: var(--kov-slate-900);
    }

    /* Table row transitions */
    #candidateTableBody tr {
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    /* Topbar Dropdown Polish */
    .kov-notif-dropdown-menu {
      min-width: 320px;
      max-width: 360px;
      border-radius: 14px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
      border: 1px solid #e2e8f0;
      overflow: hidden;
      margin-top: 8px !important;
    }

    [data-theme="dark"] .kov-notif-dropdown-menu {
      background: #0f172a;
      border-color: #1e293b;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    }

    [data-theme="dark"] .kov-notif-dropdown-menu .bg-light {
      background: #1e293b !important;
      color: #f1f5f9 !important;
    }

    .kov-user-dropdown-menu {
      min-width: 230px;
      border-radius: 14px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
      border: 1px solid #e2e8f0;
      margin-top: 8px !important;
    }

    [data-theme="dark"] .kov-user-dropdown-menu {
      background: #0f172a;
      border-color: #1e293b;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    }

    [data-theme="dark"] .kov-user-dropdown-menu .dropdown-item {
      color: #cbd5e1;
    }

    [data-theme="dark"] .kov-user-dropdown-menu .dropdown-item:hover {
      background: #1e293b;
      color: #ffffff;
    }

    .dd-folder-card:focus {
      outline: 3px solid rgba(255, 255, 255, 0.6);
      outline-offset: 2px;
    }
  </style>
</head>
<body>

  <%
    const pendingCandidates = (candidates || []).filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses');
    const pendingCandidateCount = pendingCandidates.length;
    const duplicateCount = (candidates || []).filter(c => c.is_duplicate).length;
    const baristaCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('barista')).length;
    const opsCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('operasional') || (c.divisi || '').toLowerCase().includes('staff') || (c.divisi || '').toLowerCase().includes('kasir')).length;
    const kitchenCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('kitchen') || (c.divisi || '').toLowerCase().includes('cook') || (c.divisi || '').toLowerCase().includes('pastry')).length;
    const teknisiCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('teknisi') || (c.divisi || '').toLowerCase().includes('maintenance') || (c.divisi || '').toLowerCase().includes('listrik')).length;
    const itCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('it') || (c.divisi || '').toLowerCase().includes('developer') || (c.divisi || '').toLowerCase().includes('support') || (c.divisi || '').toLowerCase().includes('tech')).length;
    const fatCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('fat') || (c.divisi || '').toLowerCase().includes('finance') || (c.divisi || '').toLowerCase().includes('akunting') || (c.divisi || '').toLowerCase().includes('tax')).length;
    const hrCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('hr') || (c.divisi || '').toLowerCase().includes('personalia') || (c.divisi || '').toLowerCase().includes('ga')).length;
  %>

  <div class="dd-layout-root kov-app-shell">
    
    <!-- 1. Deep Midnight Navy Sidebar Navigation -->
    <%- include('partials/sidebar', { active: 'hr', user: typeof user !== 'undefined' ? user : null }) %>

    <!-- 2. Main Center Workspace Canvas -->
    <main class="dd-main-canvas kov-main-content dd-theme">

      <!-- Top Search & View Action Bar (Dribbble Signature - Symmetrical 46px Row) -->
      <div class="dd-topbar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="dd-search-container">
            <i class="fas fa-magnifying-glass dd-search-icon"></i>
            <input type="text" class="dd-search-input" id="searchInput" placeholder="Cari nama kandidat, NIK, kontak, posisi, atau nomor rekening..." aria-label="Cari nama pelamar" onkeyup="applyFilterAndSort()">
          </div>
        </div>

        <div class="dd-topbar-actions">
          <div class="d-none d-sm-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-white border text-muted" style="font-size: 0.78rem; font-weight: 600; box-shadow: 0 1px 2px rgba(0,0,0,0.03);">
            <span class="kov-pulse-dot"></span>
            <span style="color: #475569;">Sistem Seleksi Aktif</span>
          </div>
        </div>
      </div>

      <!-- Executive Command Header (Taste-Skill Framed Sheet) -->
      <div class="dd-hero-banner">
        <div class="dd-hero-content">
          <div class="d-flex align-items-center gap-2 mb-1 flex-nowrap overflow-hidden">
            <span class="badge py-1 px-2 kov-hero-badge text-nowrap" style="background: rgba(22, 101, 52, 0.08); color: #166534; border: 1px solid rgba(22, 101, 52, 0.2); border-radius: 6px; font-weight: 700; font-size: 11px;">
              <span class="kov-pulse-dot"></span> KOV MANAGEMENT PORTAL
            </span>
            <span class="text-muted small">&bull;</span>
            <span class="text-muted small fw-medium text-nowrap">Pipeline Rekrutmen Aktif</span>
          </div>
          <h2 class="dd-hero-title">
            Dashboard Rekrutmen HR &mdash; <%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'Administrator HR' %>
          </h2>
          <p class="dd-hero-subtitle">
            Kelola berkas masuk, koordinasi reviewer divisi, dan pantau status kandidat seluruh outlet secara terpusat.
          </p>
        </div>
        <div class="dd-hero-actions d-flex align-items-center gap-2 flex-wrap">
          <button type="button" class="btn-kov-outline btn-sm text-nowrap" id="btnAcakToken" onclick="generateRandomShareLink(false)" title="Hasilkan token formulir baru" style="font-size: 0.82rem; padding: 7px 14px;">
            <i class="fas fa-shuffle me-1.5" id="iconAcak" style="color: var(--dd-primary, #166534);"></i> Acak Token
          </button>
          <a href="/api/export/excel" class="btn-kov-outline btn-sm text-nowrap" style="font-size: 0.82rem; padding: 7px 14px;">
            <i class="fas fa-file-excel text-success me-1.5"></i> Export Rekap Excel
          </a>
          <button type="button" class="btn-dd-hero text-nowrap" id="btnSalinLink" onclick="generateAndCopyShareLink()">
            <i class="fas fa-link me-1.5" id="iconSalin"></i> Salin Link Formulir
          </button>
          <div class="d-none">
            <span id="shareUrl"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/?ref=c-Sysujatg</span>
            <button type="button" id="btnIconCopy" onclick="generateAndCopyShareLink()"><i id="iconCopySmall"></i></button>
          </div>
        </div>
      </div>

      <!-- Executive KPI Metric Strip (Anti-Slop: Type, Not Tiles - Direct Grid Children) -->
      <div class="kov-kpi-row mb-3">
        <div class="coinbase-kpi-card kpi-total active" onclick="filterByStatusCard('all')" role="button" tabindex="0" title="Klik untuk menampilkan seluruh pelamar">
          <span class="bento-metric-title">TOTAL PELAMAR</span>
          <div class="bento-metric-value text-primary"><%= candidates.length %></div>
          <span class="bento-metric-sub">Seluruh berkas masuk</span>
        </div>

        <div class="coinbase-kpi-card kpi-pending" onclick="filterByStatusCard('Belum Diproses')" role="button" tabindex="0" title="Klik untuk menyaring berkas perlu ditinjau">
          <span class="bento-metric-title text-warning">PERLU DITINJAU</span>
          <div class="bento-metric-value text-warning"><%= pendingCandidateCount %></div>
          <span class="bento-metric-sub">Antrean evaluasi HR</span>
        </div>

        <div class="coinbase-kpi-card kpi-accepted" onclick="filterByStatusCard('Diterima')" role="button" tabindex="0" title="Klik untuk menyaring kandidat diterima">
          <span class="bento-metric-title text-success">LULUS SELEKSI</span>
          <div class="bento-metric-value text-success"><%= candidates.filter(c => c.kesimpulan_status === 'Diterima').length %></div>
          <span class="bento-metric-sub">Kandidat diterima kerja</span>
        </div>

        <div class="coinbase-kpi-card kpi-duplicate" onclick="filterByStatusCard('duplicate')" role="button" tabindex="0" title="Klik untuk menyaring indikasi duplikat">
          <span class="bento-metric-title text-danger">DATA GANDA</span>
          <div class="bento-metric-value text-danger"><%= duplicateCount %></div>
          <span class="bento-metric-sub">Terdeteksi NIK/HP ganda</span>
        </div>
      </div>

      <!-- Segmented Division Filter Tabs (Untitled UI / Linear Architecture) -->
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <div class="d-flex align-items-center gap-2">
          <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.05em;">Filter Divisi</span>
          <span class="badge py-0.5 px-2" style="background: rgba(22, 101, 52, 0.08); color: #166534; border: 1px solid rgba(22, 101, 52, 0.2); border-radius: 4px; font-weight: 700; font-size: 10.5px;">8 Divisi</span>
        </div>
        <a href="javascript:void(0)" onclick="filterByDivisiQuick('all')" class="text-decoration-none text-muted small fw-medium" id="btnViewAllDivisions" title="Reset filter dan tampilkan seluruh pelamar">
          <i class="fas fa-rotate-left me-1"></i> Reset Divisi
        </a>
      </div>

      <div class="dd-folders-grid mb-3" id="foldersGrid">
        <!-- 8. Semua Kandidat (Master Midnight Slate) -->
        <div class="dd-folder-card dd-folder-indigo folder-all active" data-divisi="all" onclick="filterByDivisiQuick('all')" title="Tampilkan Semua Berkas Pelamar" role="button" tabindex="0">
          <span class="dd-folder-title">Semua Divisi</span>
          <span class="badge-tab-count"><%= candidates.length %></span>
        </div>

        <!-- 1. Barista (Coral Red) -->
        <div class="dd-folder-card dd-folder-coral folder-coral" data-divisi="barista" onclick="filterByDivisiQuick('barista')" title="Filter Divisi Barista" role="button" tabindex="0">
          <span class="dd-folder-title">Barista</span>
          <span class="badge-tab-count"><%= baristaCount %></span>
        </div>

        <!-- 2. Operasional (Royal Blue) -->
        <div class="dd-folder-card dd-folder-royal folder-blue" data-divisi="operasional" onclick="filterByDivisiQuick('operasional')" title="Filter Divisi Operasional" role="button" tabindex="0">
          <span class="dd-folder-title">Operasional</span>
          <span class="badge-tab-count"><%= opsCount %></span>
        </div>

        <!-- 3. Kitchen (Honey Amber) -->
        <div class="dd-folder-card dd-folder-amber folder-amber" data-divisi="kitchen" onclick="filterByDivisiQuick('kitchen')" title="Filter Divisi Kitchen" role="button" tabindex="0">
          <span class="dd-folder-title">Kitchen</span>
          <span class="badge-tab-count"><%= kitchenCount %></span>
        </div>

        <!-- 4. Teknisi & ME (Aqua Cyan) -->
        <div class="dd-folder-card dd-folder-cyan folder-cyan" data-divisi="teknisi" onclick="filterByDivisiQuick('teknisi')" title="Filter Divisi Teknisi & ME" role="button" tabindex="0">
          <span class="dd-folder-title">Teknisi</span>
          <span class="badge-tab-count"><%= teknisiCount %></span>
        </div>

        <!-- 5. IT & Digital Systems (Neon Violet) -->
        <div class="dd-folder-card dd-folder-violet folder-violet" data-divisi="it" onclick="filterByDivisiQuick('it')" title="Filter Divisi IT Systems" role="button" tabindex="0">
          <span class="dd-folder-title">IT Systems</span>
          <span class="badge-tab-count"><%= itCount %></span>
        </div>

        <!-- 6. FAT - Finance, Accounting & Tax (Jade Emerald) -->
        <div class="dd-folder-card dd-folder-emerald folder-fat" data-divisi="fat" onclick="filterByDivisiQuick('fat')" title="Filter Divisi Finance, Akunting & Tax" role="button" tabindex="0">
          <span class="dd-folder-title">Finance</span>
          <span class="badge-tab-count"><%= fatCount %></span>
        </div>

        <!-- 7. HR & General Affairs (Velvet Rose) -->
        <div class="dd-folder-card dd-folder-rose folder-rose" data-divisi="hr" onclick="filterByDivisiQuick('hr')" title="Filter Divisi HR & Personalia" role="button" tabindex="0">
          <span class="dd-folder-title">HR &amp; GA</span>
          <span class="badge-tab-count"><%= hrCount %></span>
        </div>
      </div>



      <!-- Recent Files / Table Card (Dribbble File List Style) -->
      <div class="kov-table-card">
        <!-- Card Header & Filter Bar -->
        <div class="kov-table-header-box">
          <div class="kov-table-title-group">
            <div class="kov-table-squircle">
              <i class="fas fa-folder-open"></i>
            </div>
            <div>
              <h2 class="kov-table-title">
                <span>Berkas Pelamar Terbaru</span>
                <span class="kov-badge-count"><span id="candidateCount"><%= candidates.length %></span> Data</span>
              </h2>
              <div style="font-size: 0.78rem; color: var(--dd-text-secondary, #64748b); margin-top: 3px;">
                Gunakan filter status dan pencarian data untuk mempermudah seleksi HR.
              </div>
            </div>
          </div>

          <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Divisi Filter (Preserved for test assertions & quick sync) -->
            <div class="kov-select-wrap d-none">
              <i class="fas fa-layer-group kov-select-icon"></i>
              <select class="kov-pill-select" id="divisiSelect" aria-label="Filter berdasarkan Divisi" onchange="applyFilterAndSort()">
                <option value="all" selected>Semua Divisi</option>
                <option value="kitchen">Kitchen</option>
                <option value="barista">Barista</option>
                <option value="operasional">Operasional</option>
                <option value="hr">HR</option>
                <option value="teknisi">Teknisi</option>
                <option value="fat">FAT (Finance)</option>
                <option value="it">IT</option>
              </select>
              <i class="fas fa-chevron-down kov-select-chevron"></i>
            </div>

            <!-- Sort Select -->
            <div class="kov-select-wrap">
              <i class="far fa-calendar-days kov-select-icon"></i>
              <select class="kov-pill-select" id="sortSelect" aria-label="Urutkan daftar pelamar" onchange="applyFilterAndSort()">
                <option value="date-desc" selected>Tanggal (Terbaru)</option>
                <option value="date-asc">Tanggal (Terlama)</option>
                <option value="name-asc">Nama Pelamar (A-Z)</option>
                <option value="name-desc">Nama Pelamar (Z-A)</option>
                <option value="status-asc">Status Rekrutmen (A-Z)</option>
                <option value="status-desc">Status Rekrutmen (Z-A)</option>
              </select>
              <i class="fas fa-chevron-down kov-select-chevron"></i>
            </div>
          </div>
        </div>

        <!-- Status Segmented Pills -->
        <div class="kov-status-filter-bar">
          <span class="small fw-bold text-dark me-1" style="font-size: 0.82rem;">Status:</span>

          <button type="button" class="kov-filter-pill-botanical active" data-filter="all" onclick="setFilter('all', this)">
            Semua (<%= candidates.length %>)
          </button>

          <button type="button" class="kov-filter-pill-botanical" data-filter="Belum Diproses" onclick="setFilter('Belum Diproses', this)">
            <i class="far fa-circle-dot" style="color: #3b82f6;"></i> Belum Diproses (<%= candidates.filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses').length %>)
          </button>

          <button type="button" class="kov-filter-pill-botanical" data-filter="Diterima" onclick="setFilter('Diterima', this)">
            <i class="fas fa-circle-check" style="color: #10b981;"></i> Diterima (<%= candidates.filter(c => c.kesimpulan_status === 'Diterima').length %>)
          </button>

          <button type="button" class="kov-filter-pill-botanical" data-filter="Dipertimbangkan" onclick="setFilter('Dipertimbangkan', this)">
            <i class="fas fa-circle-exclamation" style="color: #f59e0b;"></i> Dipertimbangkan (<%= candidates.filter(c => c.kesimpulan_status === 'Dipertimbangkan').length %>)
          </button>

          <button type="button" class="kov-filter-pill-botanical" data-filter="Ditolak" onclick="setFilter('Ditolak', this)">
            <i class="fas fa-circle-xmark" style="color: #ef4444;"></i> Ditolak (<%= candidates.filter(c => c.kesimpulan_status === 'Ditolak').length %>)
          </button>

          <button type="button" class="kov-filter-pill-botanical warning-pill ms-auto" data-filter="duplicate" onclick="setFilter('duplicate', this)">
            <i class="far fa-clone" style="color: #ea580c;"></i> Duplikat (<%= candidates.filter(c => c.is_duplicate).length %>)
          </button>
        </div>

        <!-- Active Calendar Date Filter Alert Chip -->
        <div id="activeDateBadgeWrap" class="d-none px-3 pt-2 pb-1">
          <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill bg-primary-subtle text-primary border border-primary-subtle" style="font-size: 0.8rem; font-weight: 700;">
            <i class="far fa-calendar-check"></i>
            <span id="activeDateBadgeText">Filter Tanggal: 26 Oktober 2026</span>
            <button type="button" onclick="clearCalDateFilter()" class="btn-close ms-1" style="font-size: 0.6rem; cursor: pointer;" aria-label="Hapus Filter Tanggal" title="Hapus Filter Tanggal"></button>
          </div>
        </div>

        <!-- Legacy Card Rows (Preserved for compatibility, hidden by default) -->
        <div class="dd-files-list d-none mb-3" id="candidateCardsList" style="display: none !important;">
          <% if (candidates.length === 0) { %>
            <div class="text-center py-5 text-muted bg-white rounded-4 border">
              <div class="py-4">
                <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                <h6 class="fw-bold text-dark">Belum Ada Pelamar</h6>
                <p class="small text-muted mb-0">Bagikan tautan form kepada kandidat untuk mulai menerima data.</p>
              </div>
            </div>
          <% } %>
          <% candidates.forEach((c, idx) => { 
            const cDiv = c.divisi || 'Operasional';
            const dLow = cDiv.toLowerCase();
            const rawStatus = (c.kesimpulan_status || 'Belum Diproses').trim();
            let badgeClass = 'dd-badge-pdf', badgeText = 'PDF';
            if (c.foto_kandidat) {
              badgeClass = 'dd-badge-png';
              badgeText = 'PNG';
            } else if (dLow.includes('kitchen') || dLow.includes('cook')) {
              badgeClass = 'dd-badge-zip';
              badgeText = 'ZIP';
            }
            const isSelected = idx === 1; // Row 2 selected in Dribbble Sketch concept
          %>
            <div class="dd-file-card-item dd-file-row <%= isSelected ? 'active selected' : '' %>"
                 data-id="<%= c.id %>"
                 data-date="<%= c.created_at ? new Date(c.created_at).getTime() : 0 %>"
                 data-name="<%= (c.nama_lengkap || '').toLowerCase() %>"
                 data-status="<%= rawStatus %>"
                 data-divisi="<%= dLow %>"
                 data-duplicate="<%= c.is_duplicate ? 'true' : 'false' %>"
                 onclick="selectCandidateCard(this)">
              <div class="d-flex align-items-center gap-3">
                <div class="dd-file-badge <%= badgeClass %>"><%= badgeText %></div>
                <div>
                  <div class="fw-bold" style="font-size: 0.95rem;"><%= c.nama_lengkap %></div>
                  <div class="opacity-75 small"><%= c.posisi_dilamar %> • <%= cDiv %></div>
                </div>
              </div>
              <div class="d-none d-md-flex align-items-center gap-3 small opacity-85">
                <span><i class="far fa-calendar me-1"></i><%= formatDate(c.created_at) %></span>
                <span class="kov-status-badge <%= rawStatus === 'Diterima' ? 'status-diterima' : (rawStatus === 'Belum Diproses' ? 'status-belum' : (rawStatus === 'Dipertimbangkan' ? 'status-dipertimbangkan' : 'status-ditolak')) %>">
                  <%= rawStatus %>
                </span>
              </div>
              <div class="d-flex align-items-center gap-2">
                <a href="/admin/candidate/<%= c.id %>" class="btn-dd-review" onclick="event.stopPropagation()">
                  <i class="fas fa-eye"></i> Review
                </a>
                <a href="/api/export/pdf/<%= c.id %>" class="btn-dd-icon" title="Export PDF Biodata" onclick="event.stopPropagation()">
                  <i class="fas fa-file-pdf"></i>
                </a>
              </div>
            </div>
          <% }) %>
        </div>

        <!-- Modern Untitled UI & Linear Data Table Architecture -->
        <div class="kov-botanical-table-wrap" id="candidateTableView">
          <table class="kov-botanical-table" id="candidateTable">
            <thead>
              <tr>
                <th style="width: 48px; text-align: center;">TIPE</th>
                <th class="sortable-header" role="button" tabindex="0" aria-sort="none" onclick="toggleSort('date')" onkeydown="if(event.key==='Enter'||event.key===' ') { toggleSort('date'); event.preventDefault(); }" style="width: 98px; cursor: pointer;">
                  TANGGAL <i class="fas fa-sort ms-1 opacity-50" id="sortIconDate"></i>
                </th>
                <th class="sortable-header" role="button" tabindex="0" aria-sort="none" onclick="toggleSort('name')" onkeydown="if(event.key==='Enter'||event.key===' ') { toggleSort('name'); event.preventDefault(); }" style="cursor: pointer;">
                  NAMA KANDIDAT <i class="fas fa-sort ms-1 opacity-50" id="sortIconName"></i>
                </th>
                <th style="width: 112px;">POSISI</th>
                <th style="width: 125px;">KONTAK</th>
                <th class="sortable-header" role="button" tabindex="0" aria-sort="none" onclick="toggleSort('status')" onkeydown="if(event.key==='Enter'||event.key===' ') { toggleSort('status'); event.preventDefault(); }" style="width: 114px; cursor: pointer;">
                  STATUS <i class="fas fa-sort ms-1 opacity-50" id="sortIconStatus"></i>
                </th>
                <th style="width: 75px; text-align: center;">DATA</th>
                <th class="text-center" style="width: 135px;">AKSI</th>
              </tr>
            </thead>
            <tbody id="candidateTableBody">
              <% if (candidates.length === 0) { %>
                <tr id="noDataRow">
                  <td colspan="8" class="text-center py-5 text-muted">
                    <div class="py-4">
                      <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                      <h6 class="fw-bold text-dark">Belum Ada Pelamar</h6>
                      <p class="small text-muted mb-0">Bagikan tautan form kepada kandidat untuk mulai menerima data.</p>
                    </div>
                  </td>
                </tr>
              <% } %>
              <% candidates.forEach(c => { 
                const cDiv = c.divisi || 'Operasional';
                const dLow = cDiv.toLowerCase();
                const rawStatus = (c.kesimpulan_status || 'Belum Diproses').trim();
                
                // File Badge Type: PDF / PNG / DOC
                let badgeClass = 'dd-badge-pdf', badgeText = 'PDF';
                if (c.foto_kandidat) {
                  badgeClass = 'dd-badge-png';
                  badgeText = 'PNG';
                } else if (dLow.includes('kitchen') || dLow.includes('cook')) {
                  badgeClass = 'dd-badge-zip';
                  badgeText = 'ZIP';
                }
              %>
                <tr data-id="<%= c.id %>"
                    data-date="<%= c.created_at ? new Date(c.created_at).getTime() : 0 %>"
                    data-name="<%= (c.nama_lengkap || '').toLowerCase() %>"
                    data-status="<%= rawStatus %>"
                    data-divisi="<%= dLow %>"
                    data-duplicate="<%= c.is_duplicate ? 'true' : 'false' %>">
                  <td class="text-center">
                    <div class="dd-file-badge <%= badgeClass %>" title="Format Dokumen: <%= badgeText %>">
                      <%= badgeText %>
                    </div>
                  </td>
                  <td>
                    <div class="kov-table-date"><%= formatDate(c.created_at, false) %></div>
                    <div class="kov-table-time"><%= formatDate(c.created_at, true).split(' ')[1] || '' %> WIB</div>
                  </td>
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      <% if (c.foto_kandidat) { %>
                        <img src="<%= c.foto_kandidat %>" class="rounded-circle border flex-shrink-0" style="width: 30px; height: 30px; object-fit: cover;">
                      <% } else { %>
                        <div class="kov-avatar-monogram">
                          <%= (c.nama_lengkap && c.nama_lengkap.trim()) ? c.nama_lengkap.trim().charAt(0).toUpperCase() : '?' %>
                        </div>
                      <% } %>
                      <div style="min-width: 0; max-width: 150px;">
                        <div class="kov-candidate-name text-truncate" title="<%= c.nama_lengkap || '(Tanpa Nama)' %>">
                          <% if (c.nama_lengkap && c.nama_lengkap.trim()) { %>
                            <%= c.nama_lengkap %>
                          <% } else { %>
                            <span class="text-muted fst-italic" style="font-size: 0.8rem;">(Tanpa Nama)</span>
                          <% } %>
                        </div>
                        <div class="kov-candidate-sub text-truncate">
                          <% if (c.nomor_ktp) { %><span>NIK: <%= c.nomor_ktp %></span><% } %>
                          <% if (c.no_rekening) { %><span class="ms-1 border-start ps-1">Rek: <%= c.no_rekening %></span><% } %>
                        </div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <% if (dLow.includes('barista')) { %>
                      <span class="kov-divisi-pill" style="background: #f8fafc; border-color: #e2e8f0; color: #475569;">
                        <i class="fas fa-mug-hot me-1 text-muted"></i> Barista
                      </span>
                    <% } else if (dLow.includes('kitchen')) { %>
                      <span class="kov-divisi-pill" style="background: #fffbeb; border-color: #fde68a; color: #b45309;">
                        <i class="fas fa-utensils me-1"></i> Kitchen
                      </span>
                    <% } else if (dLow.includes('hr')) { %>
                      <span class="kov-divisi-pill" style="background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8;">
                        <i class="fas fa-user-tie me-1"></i> HR
                      </span>
                    <% } else if (dLow.includes('it')) { %>
                      <span class="kov-divisi-pill" style="background: #f1f5f9; border-color: #cbd5e1; color: #0f172a;">
                        <i class="fas fa-laptop me-1"></i> IT
                      </span>
                    <% } else if (dLow.includes('teknisi')) { %>
                      <span class="kov-divisi-pill" style="background: #ecfeff; border-color: #a5f3fc; color: #0e7490;">
                        <i class="fas fa-wrench me-1"></i> Teknisi
                      </span>
                    <% } else { %>
                      <span class="kov-divisi-pill" style="background: #e6f9f0; border-color: #c9eedc; color: #00a86b;">
                        <i class="fas fa-briefcase me-1"></i> <%= cDiv %>
                      </span>
                    <% } %>
                    <% if (c.posisi_dilamar && c.posisi_dilamar.trim().toLowerCase() !== cDiv.trim().toLowerCase()) { %>
                    <div class="fw-semibold text-dark small mt-0.5 text-truncate" style="max-width: 120px;" title="<%= c.posisi_dilamar %>">
                      <%= c.posisi_dilamar %>
                    </div>
                    <% } %>
                  </td>
                  <td>
                    <div style="max-width: 135px;">
                      <div class="text-truncate font-mono" style="font-size: 11.5px; color: #334155;" title="<%= c.no_hp || '-' %>">
                        <i class="fas fa-phone text-muted me-1" style="font-size: 10px;"></i><%= c.no_hp || '-' %>
                      </div>
                      <div class="text-truncate" style="font-size: 11px; color: #64748b; margin-top: 1px;" title="<%= c.email || '-' %>">
                        <i class="far fa-envelope text-muted me-1" style="font-size: 10px;"></i><%= c.email || '-' %>
                      </div>
                    </div>
                  </td>
                  <td>
                    <% 
                      const statusName = rawStatus;
                      let pillClass = 'pill-warning';
                      if (statusName === 'Diterima') pillClass = 'pill-success';
                      else if (statusName === 'Dipertimbangkan') pillClass = 'pill-warning';
                      else if (statusName === 'Ditolak') pillClass = 'pill-danger';
                      else if (statusName === 'Belum Diproses') pillClass = 'pill-info';
                    %>
                    <span class="status-pill-modern <%= pillClass %>">
                      <span class="status-dot-pulse"></span>
                      <%= statusName %>
                    </span>
                  </td>
                  <td>
                    <% if (c.is_duplicate) { %>
                      <span class="badge bg-warning bg-opacity-25 text-warning-emphasis border border-warning px-2 py-1" title="Terdeteksi mengisi form <%= c.duplicate_count %>x">
                        <i class="fas fa-triangle-exclamation text-danger me-1"></i>Melamar <%= c.duplicate_count %>x
                      </span>
                    <% } else { %>
                      <span class="badge" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #475569; font-size: 0.72rem; font-weight: 600; padding: 3px 8px; border-radius: 6px;">
                        Unik
                      </span>
                    <% } %>
                    <% if (c.share_token) { %>
                      <div class="text-muted font-monospace" style="font-size: 0.7rem; margin-top: 3px;"><%= c.share_token %></div>
                    <% } %>
                    <% if (c.review_count && c.review_count > 0) { %>
                      <div class="mt-1">
                        <span class="badge bg-info-subtle text-info-emphasis border border-info px-2 py-1" style="font-size: 0.7rem;" title="Catatan Reviewer: <%= c.catatan_reviewer || '' %>">
                          <i class="fas fa-comments text-info me-1"></i><%= c.review_count %> Review
                        </span>
                      </div>
                    <% } %>
                  </td>
                  <td class="text-center kov-td-action">
                    <div class="d-inline-flex gap-1.5 align-items-center">
                      <a href="/admin/candidate/<%= c.id %>" class="kov-action-review-btn" title="Review Berkas & Catatan Pewawancara">
                        <i class="fas fa-user-check me-1"></i> Review
                      </a>
                      <a href="/api/export/pdf/<%= c.id %>" target="_blank" rel="noopener noreferrer" class="kov-action-icon-circle text-danger" title="Export PDF Biodata" aria-label="Export PDF Biodata <%= c.nama_lengkap %>">
                        <i class="fas fa-file-pdf"></i>
                      </a>
                      <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                        <form action="/admin/candidate/delete/<%= c.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus berkas pelamar <%= c.nama_lengkap %> secara permanen?');">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="kov-action-icon-circle text-danger border-0 bg-transparent" title="Hapus Berkas Pelamar" aria-label="Hapus Berkas Pelamar <%= c.nama_lengkap %>">
                            <i class="fas fa-trash-can"></i>
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

      </div>

    </main>

    <!-- 3. Right Activity & Utility Panel (Dribbble Signature) -->
    <aside class="dd-right-panel">
      
      <!-- Topbar Controls (Notif, Theme, User Profile) -->
      <div class="dd-profile-header">
        <div class="dd-utility-actions">
          <!-- Notification Bell Dropdown -->
          <div class="dropdown">
            <button type="button" class="dd-icon-btn position-relative" id="notifDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Pusat Notifikasi Rekrutmen" aria-label="Pusat Notifikasi">
              <i class="far fa-bell"></i>
              <% if (pendingCandidateCount > 0 || duplicateCount > 0) { %>
                <span class="dd-notif-dot"></span>
              <% } %>
            </button>
            <div class="dropdown-menu dropdown-menu-end kov-notif-dropdown-menu p-0" aria-labelledby="notifDropdownBtn">
              <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between">
                <span class="fw-bold small text-dark"><i class="fas fa-bell me-1.5 text-success"></i> Notifikasi Rekrutmen</span>
                <span class="badge bg-success bg-opacity-25 text-success border border-success" style="font-size: 0.7rem;"><%= pendingCandidateCount %> Perlu Tindakan</span>
              </div>
              <div class="p-2" style="max-height: 280px; overflow-y: auto;">
                <% if (pendingCandidateCount > 0) { %>
                  <a href="javascript:void(0)" onclick="filterByStatusCard('Belum Diproses')" class="dropdown-item d-flex align-items-start gap-2.5 p-2 rounded-2">
                    <div class="rounded-circle bg-warning bg-opacity-25 text-warning d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.85rem;">
                      <i class="fas fa-clock text-warning"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                      <div class="fw-bold small leading-tight"><%= pendingCandidateCount %> Berkas Perlu Review</div>
                      <div class="text-muted" style="font-size: 0.72rem;">Klik untuk menyaring daftar pelamar belum diproses.</div>
                    </div>
                  </a>
                <% } else { %>
                  <div class="text-center py-3 text-muted small">
                    <i class="fas fa-circle-check text-success fa-2x mb-2 d-block"></i>
                    Seluruh berkas pelamar telah diproses
                  </div>
                <% } %>

                <% if (duplicateCount > 0) { %>
                  <a href="javascript:void(0)" onclick="filterByStatusCard('duplicate')" class="dropdown-item d-flex align-items-start gap-2.5 p-2 rounded-2 mt-1">
                    <div class="rounded-circle bg-danger bg-opacity-25 text-danger d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.85rem;">
                      <i class="fas fa-triangle-exclamation text-danger"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                      <div class="fw-bold small leading-tight"><%= duplicateCount %> Berkas Terindikasi Duplikat</div>
                      <div class="text-muted" style="font-size: 0.72rem;">Klik untuk menyaring pelamar terdeteksi ganda.</div>
                    </div>
                  </a>
                <% } %>
              </div>
              <div class="p-2 bg-light border-top text-center">
                <a href="javascript:void(0)" onclick="filterByStatusCard('all')" class="btn btn-sm btn-link text-success text-decoration-none fw-semibold p-0" style="font-size: 0.75rem;">
                  Tampilkan Semua Pelamar (<%= candidates.length %>)
                </a>
              </div>
            </div>
          </div>

          <!-- Theme Switcher Button -->
          <button type="button" class="dd-icon-btn" onclick="toggleKovTheme()" title="Ganti Mode Gelap / Terang">
            <i class="fas fa-moon kov-theme-icon"></i>
          </button>
        </div>

        <!-- Interactive User Profile Dropdown -->
        <div class="dropdown">
          <div class="dd-user-pill" id="userMenuDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" role="button" title="Menu Pengguna">
            <div class="dd-user-avatar d-flex align-items-center justify-content-center bg-primary text-white fw-bold">
              <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
            </div>
            <div class="d-none d-xl-flex flex-column text-start" style="line-height: 1.2;">
              <span class="dd-user-name" title="<%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'Admin HR' %>"><%= (typeof user !== 'undefined' && user && user.nama) ? (user.nama === 'Administrator HR' ? 'Admin HR' : user.nama) : 'Admin HR' %></span>
              <span class="small text-muted" style="font-size: 0.7rem;"><%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Superadmin' %></span>
            </div>
            <i class="fas fa-chevron-down dd-user-caret"></i>
          </div>
          <div class="dropdown-menu dropdown-menu-end kov-user-dropdown-menu p-2" aria-labelledby="userMenuDropdownBtn">
            <div class="px-3 py-2 border-bottom mb-1">
              <div class="fw-bold text-dark small"><%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'Admin HR' %></div>
              <div class="text-muted" style="font-size: 0.72rem;"><%= (typeof user !== 'undefined' && user && user.username) ? '@' + user.username : '@admin' %> &bull; <span class="badge bg-success bg-opacity-25 text-success"><%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Superadmin' %></span></div>
            </div>
            <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
              <a class="dropdown-item rounded-2 py-1.5 small" href="/admin/users"><i class="fas fa-users-gear me-2 text-primary"></i> Kelola User &amp; Role</a>
            <% } %>
            <a class="dropdown-item rounded-2 py-1.5 small" href="javascript:void(0)" onclick="toggleKovTheme()"><i class="fas fa-moon me-2 text-warning"></i> Ganti Tema (Gelap/Terang)</a>
            <div class="dropdown-divider my-1"></div>
            <a class="dropdown-item rounded-2 py-1.5 small text-danger fw-semibold" href="/admin/logout"><i class="fas fa-arrow-right-from-bracket me-2"></i> Keluar (Logout)</a>
          </div>
        </div>

      </div>

      <!-- Interactive Calendar Widget (Direct Dribbble Design - Dynamic Selection Calendar) -->
      <div class="dd-calendar-widget" id="ddCalendarWidget">
        <div class="dd-calendar-top" onclick="toggleCalCollapse()" style="cursor: pointer;" title="Sembunyikan / Buka Kalender">
          <h4 class="dd-calendar-title">Kalender Seleksi</h4>
          <i class="fas fa-chevron-up text-muted" id="calCollapseIcon" style="font-size: 0.8rem; transition: transform 0.2s;"></i>
        </div>
        <div id="calBodyWrapper">
          <div class="dd-period-toggle">
            <button type="button" class="dd-period-btn" id="calTabWeek" onclick="switchCalPeriod('week', this)">Minggu</button>
            <button type="button" class="dd-period-btn active" id="calTabMonth" onclick="switchCalPeriod('month', this)">Bulan</button>
            <button type="button" class="dd-period-btn" id="calTabYear" onclick="switchCalPeriod('year', this)">Tahun</button>
          </div>
          <div class="dd-month-nav">
            <button type="button" class="dd-nav-arrow-btn" id="btnPrevCalMonth" onclick="prevCalPeriod()" title="Bulan Sebelumnya"><i class="fas fa-chevron-left"></i></button>
            <span class="dd-month-label" id="calMonthDisplay">Oktober 2026</span>
            <button type="button" class="dd-nav-arrow-btn" id="btnNextCalMonth" onclick="nextCalPeriod()" title="Bulan Selanjutnya"><i class="fas fa-chevron-right"></i></button>
          </div>
          <div class="dd-calendar-grid" id="calGrid">
            <!-- Dynamically populated via renderCalendar() -->
          </div>
          <div id="calYearGrid" class="dd-year-grid d-none">
            <!-- Dynamically populated for Year view -->
          </div>
          <div id="calDateFilterNotice" class="d-none mt-2 pt-2 border-top text-center" style="font-size: 0.75rem;">
            <span class="text-primary fw-bold" id="calFilterText">Filter Tanggal Aktif</span>
            <a href="javascript:void(0)" onclick="clearCalDateFilter()" class="ms-2 text-danger text-decoration-none fw-semibold"><i class="fas fa-xmark"></i> Hapus Filter</a>
          </div>
        </div>
      </div>

      <!-- "Your Task" / Tindakan Tertunda Widget -->
      <div class="dd-task-widget">
        <div class="d-flex align-items-center justify-content-between">
          <h4 class="dd-section-title" style="font-size: 1.15rem;">Tindakan Tertunda</h4>
          <a href="javascript:void(0)" onclick="filterByStatusCard('Belum Diproses')" class="dd-view-all-link" style="padding: 4px 10px; font-size: 0.75rem;">
            Lihat Semua <i class="fas fa-chevron-right" style="font-size: 0.6rem;"></i>
          </a>
        </div>
        <div class="dd-task-card" onclick="filterByStatusCard('Belum Diproses')" role="button" tabindex="0" title="Klik untuk memproses berkas kandidat belum direview">
          <div class="dd-task-accent-bar"></div>
          <div class="dd-task-card-header">
            <h5 class="dd-task-title">Review Berkas Kandidat Baru</h5>
            <button type="button" class="dd-row-btn" aria-label="Menu Task" onclick="event.stopPropagation(); filterByStatusCard('Belum Diproses')"><i class="fas fa-ellipsis-vertical"></i></button>
          </div>
          <div class="dd-task-time">
            <i class="far fa-clock"></i> <%= pendingCandidateCount > 0 ? (pendingCandidateCount + ' Berkas Memerlukan Evaluasi') : 'Semua Berkas Terverifikasi' %>
          </div>
          <div class="dd-task-footer">
            <div class="dd-task-avatars">
              <div class="dd-avatar-sm" style="background: #166534; color: #fff;">HR</div>
              <div class="dd-avatar-sm" style="background: #0f766e; color: #fff;">OP</div>
              <span class="small text-muted ms-1" style="font-size: 0.72rem;">Tim Seleksi KOV</span>
            </div>
          </div>
        </div>
      </div>

    </aside>

  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    function getAppBaseUrl() {
      if (window.location && window.location.origin && window.location.origin !== 'null') {
        return window.location.origin;
      }
      return 'https://internal.kovgroups.com';
    }

    function getRandomToken() {
      const chars = '23456789abcdefghjkmnpqrstuvwxyz';
      let result = '';
      for (let i = 0; i < 8; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return 'c-' + result;
    }

    function generateRandomShareLink(shouldCopy = true, showToast = true) {
      const token = getRandomToken();
      const url = getAppBaseUrl() + '/?ref=' + token;
      const shareEl = document.getElementById('shareUrl');
      if (shareEl) {
        shareEl.innerText = url;
        shareEl.classList.add('bg-warning', 'bg-opacity-25');
        setTimeout(() => shareEl.classList.remove('bg-warning', 'bg-opacity-25'), 300);
      }

      const btnAcak = document.getElementById('btnAcakToken');
      if (btnAcak && showToast) {
        if (!btnAcak.getAttribute('data-orig-content')) {
          btnAcak.setAttribute('data-orig-content', btnAcak.innerHTML);
        }
        const origContent = btnAcak.getAttribute('data-orig-content');
        btnAcak.innerHTML = '<i class="fas fa-check me-1 text-success"></i> Token Baru!';
        clearTimeout(btnAcak._timer);
        btnAcak._timer = setTimeout(() => {
          btnAcak.innerHTML = origContent;
        }, 900);
      }

      if (shouldCopy) {
        copyTextWithFeedback(url, 'Tautan formulir rekrutmen berhasil disalin ke clipboard:\n' + url);
      } else if (showToast && window.KovToast && typeof window.KovToast.info === 'function') {
        window.KovToast.info('Token baru aktif: ' + token, 'Token Diperbarui');
      }
      return url;
    }

    function generateAndCopyShareLink() {
      const shareEl = document.getElementById('shareUrl');
      const url = (shareEl && shareEl.innerText.trim() && !shareEl.innerText.includes('Sysujatg')) 
        ? shareEl.innerText.trim() 
        : (getAppBaseUrl() + '/?ref=' + getRandomToken());
      
      if (shareEl) shareEl.innerText = url;
      copyTextWithFeedback(url, 'Tautan formulir rekrutmen berhasil disalin:\n' + url);
    }

    function copyTextWithFeedback(text, successMsg) {
      const btnSalin = document.getElementById('btnSalinLink');
      const iconCopy = document.getElementById('iconCopySmall');
      if (btnSalin && !btnSalin.getAttribute('data-orig-html')) {
        btnSalin.setAttribute('data-orig-html', btnSalin.innerHTML);
      }
      const origSalinText = btnSalin ? btnSalin.getAttribute('data-orig-html') : '';

      function triggerSuccessUI() {
        if (btnSalin) {
          btnSalin.innerHTML = '<i class="fas fa-check me-1"></i> Tersalin!';
          btnSalin.style.background = '#484ec9';
          clearTimeout(btnSalin._timer);
          btnSalin._timer = setTimeout(() => {
            btnSalin.innerHTML = origSalinText;
            btnSalin.style.background = '';
          }, 1500);
        }
        if (iconCopy) {
          iconCopy.className = 'fas fa-check text-success';
          clearTimeout(iconCopy._timer);
          iconCopy._timer = setTimeout(() => {
            iconCopy.className = 'far fa-copy';
          }, 1500);
        }
        if (window.KovToast && typeof window.KovToast.success === 'function') {
          window.KovToast.success(successMsg || 'Berhasil disalin ke clipboard!', 'Tautan Disalin');
        }
      }

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(triggerSuccessUI).catch(() => fallbackClipboardCopy(text, triggerSuccessUI));
      } else {
        fallbackClipboardCopy(text, triggerSuccessUI);
      }
    }

    function fallbackClipboardCopy(text, onSuccess) {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.top = '-9999px';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        const success = document.execCommand('copy');
        document.body.removeChild(ta);
        if (success && onSuccess) onSuccess();
        else if (window.KovToast) window.KovToast.info('Tautan: ' + text, 'Salin Manual');
      } catch (e) {
        if (window.KovToast) window.KovToast.info('Tautan: ' + text, 'Salin Manual');
      }
    }

    // Real-Time Date & Time Clock
    function updateKovLiveClock() {
      const dateEl = document.getElementById('kovLiveDate');
      const timeEl = document.getElementById('kovLiveTime');
      try {
        const now = new Date();
        const dateStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Jakarta' });
        const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }).replace(/\./g, ':') + ' WIB';
        if (dateEl) dateEl.textContent = dateStr;
        if (timeEl) timeEl.textContent = timeStr;
      } catch (e) {
        if (dateEl) dateEl.textContent = '25 Okt 2026';
        if (timeEl) timeEl.textContent = '00:20 WIB';
      }
    }

    let activeFilter = 'all';

    function normalizeStatus(st) {
      if (!st) return 'Belum Diproses';
      const s = String(st).trim().toLowerCase();
      if (s === 'diterima' || s === 'lolos' || s === 'accepted') return 'Diterima';
      if (s === 'dipertimbangkan' || s === 'hold' || s === 'cadangan') return 'Dipertimbangkan';
      if (s === 'ditolak' || s === 'rejected' || s === 'gagal') return 'Ditolak';
      return 'Belum Diproses';
    }

    function setFilter(filterType, btnElem) {
      activeFilter = filterType;

      // Update segmented pills active state
      document.querySelectorAll('.kov-filter-pill-botanical').forEach(btn => {
        btn.classList.remove('active');
      });
      if (btnElem) {
        btnElem.classList.add('active');
      } else {
        const matchingBtn = document.querySelector(`.kov-filter-pill-botanical[data-filter="${filterType}"]`);
        if (matchingBtn) matchingBtn.classList.add('active');
      }

      applyFilterAndSort();
    }

    function filterByStatusCard(status) {
      setFilter(status, null);
      if (window.innerWidth < 768) {
        const tableCard = document.querySelector('.kov-table-card');
        if (tableCard) {
          tableCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    function filterByDivisiQuick(divisi) {
      const select = document.getElementById('divisiSelect');
      if (select) {
        select.value = divisi;
        applyFilterAndSort();
      }
      // Update active highlight state on all 8 folder cards
      document.querySelectorAll('.dd-folder-card').forEach(card => {
        const cDiv = card.getAttribute('data-divisi');
        if (cDiv === divisi) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
      if (window.innerWidth < 768) {
        const tableCard = document.querySelector('.kov-table-card');
        if (tableCard) {
          tableCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    function selectCandidateCard(el) {
      document.querySelectorAll('.dd-file-card-item').forEach(c => c.classList.remove('active', 'selected'));
      if (el) el.classList.add('active', 'selected');
    }

    function toggleSort(type) {
      const select = document.getElementById('sortSelect');
      if (!select) return;
      if (type === 'date') {
        select.value = select.value === 'date-desc' ? 'date-asc' : 'date-desc';
      } else if (type === 'name') {
        select.value = select.value === 'name-asc' ? 'name-desc' : 'name-asc';
      } else if (type === 'status') {
        select.value = select.value === 'status-asc' ? 'status-desc' : 'status-asc';
      }
      applyFilterAndSort();
    }

    function applyFilterAndSort() {
      const searchVal = (document.getElementById('searchInput') ? document.getElementById('searchInput').value : '').toLowerCase().trim();
      const sortVal = document.getElementById('sortSelect') ? document.getElementById('sortSelect').value : 'date-desc';
      const divisiVal = (document.getElementById('divisiSelect') ? document.getElementById('divisiSelect').value : 'all').toLowerCase();
      const tbody = document.getElementById('candidateTableBody');
      if (!tbody) return;

      const rows = Array.from(tbody.querySelectorAll('tr[data-id]'));
      let visibleCount = 0;

      rows.forEach(row => {
        const rowText = row.innerText.toLowerCase();
        const rawStatus = row.getAttribute('data-status') || '';
        const rowNormStatus = normalizeStatus(rawStatus);
        const rowDivisi = (row.getAttribute('data-divisi') || '').toLowerCase();
        const isDuplicate = row.getAttribute('data-duplicate') === 'true';

        let matchesSearch = searchVal === '' || rowText.includes(searchVal);
        let matchesFilter = true;

        if (activeFilter === 'duplicate') {
          matchesFilter = isDuplicate;
        } else if (activeFilter !== 'all') {
          matchesFilter = (rowNormStatus === normalizeStatus(activeFilter));
        }

        let matchesDivisi = (divisiVal === 'all' || rowDivisi.includes(divisiVal));
        let matchesDate = true;
        if (activeDateFilter) {
          const rowTs = parseInt(row.getAttribute('data-date')) || 0;
          if (rowTs) {
            const rd = new Date(rowTs);
            const rk = formatDateKey(rd);
            matchesDate = (rk === activeDateFilter);
          } else {
            matchesDate = false;
          }
        }

        if (matchesSearch && matchesFilter && matchesDivisi && matchesDate) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      // Synchronize Floating Card items in #candidateCardsList
      const cardContainer = document.getElementById('candidateCardsList');
      if (cardContainer) {
        const cards = Array.from(cardContainer.querySelectorAll('.dd-file-card-item'));
        cards.forEach(card => {
          const cardText = card.innerText.toLowerCase();
          const rawStatus = card.getAttribute('data-status') || '';
          const cardNormStatus = normalizeStatus(rawStatus);
          const cardDivisi = (card.getAttribute('data-divisi') || '').toLowerCase();
          const isDuplicate = card.getAttribute('data-duplicate') === 'true';

          let matchesSearch = searchVal === '' || cardText.includes(searchVal);
          let matchesFilter = true;

          if (activeFilter === 'duplicate') {
            matchesFilter = isDuplicate;
          } else if (activeFilter !== 'all') {
            matchesFilter = (cardNormStatus === normalizeStatus(activeFilter));
          }

          let matchesDivisi = (divisiVal === 'all' || cardDivisi.includes(divisiVal));
          let matchesCardDate = true;
          if (activeDateFilter) {
            const cardTs = parseInt(card.getAttribute('data-date')) || 0;
            if (cardTs) {
              const cd = new Date(cardTs);
              const ck = formatDateKey(cd);
              matchesCardDate = (ck === activeDateFilter);
            } else {
              matchesCardDate = false;
            }
          }

          if (matchesSearch && matchesFilter && matchesDivisi && matchesCardDate) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        // Sort Cards
        cards.sort((a, b) => {
          const dateA = parseInt(a.getAttribute('data-date')) || 0;
          const dateB = parseInt(b.getAttribute('data-date')) || 0;
          const nameA = a.getAttribute('data-name') || '';
          const nameB = b.getAttribute('data-name') || '';
          const statusA = a.getAttribute('data-status') || '';
          const statusB = b.getAttribute('data-status') || '';

          if (sortVal === 'date-desc') return dateB - dateA;
          if (sortVal === 'date-asc') return dateA - dateB;
          if (sortVal === 'name-asc') return nameA.localeCompare(nameB);
          if (sortVal === 'name-desc') return nameB.localeCompare(nameA);
          if (sortVal === 'status-asc') return statusA.localeCompare(statusB);
          if (sortVal === 'status-desc') return statusB.localeCompare(statusA);
          return 0;
        });
        cards.forEach(card => cardContainer.appendChild(card));
      }

      const countEl = document.getElementById('candidateCount');
      if (countEl) countEl.innerText = visibleCount;

      // Handle Empty State when filtered to 0
      let emptyRow = document.getElementById('filterEmptyRow');
      if (visibleCount === 0 && rows.length > 0) {
        if (!emptyRow) {
          emptyRow = document.createElement('tr');
          emptyRow.id = 'filterEmptyRow';
          emptyRow.innerHTML = `
            <td colspan="8" class="text-center py-5 text-muted">
              <div class="py-4">
                <i class="fas fa-filter-circle-xmark fa-3x mb-3 text-secondary opacity-50"></i>
                <h6 class="fw-bold text-dark">Tidak Ada Data Pelamar</h6>
                <p class="small text-muted mb-2">Tidak ditemukan berkas pelamar untuk kriteria filter "${activeFilter}".</p>
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 mt-1" onclick="setFilter('all', null)">
                  <i class="fas fa-rotate-left me-1"></i> Tampilkan Semua Pelamar
                </button>
              </div>
            </td>
          `;
          tbody.appendChild(emptyRow);
        } else {
          emptyRow.style.display = '';
        }
      } else {
        if (emptyRow) emptyRow.style.display = 'none';
      }

      // Sorting Logic
      rows.sort((a, b) => {
        const dateA = parseInt(a.getAttribute('data-date')) || 0;
        const dateB = parseInt(b.getAttribute('data-date')) || 0;
        const nameA = a.getAttribute('data-name') || '';
        const nameB = b.getAttribute('data-name') || '';
        const statusA = a.getAttribute('data-status') || '';
        const statusB = b.getAttribute('data-status') || '';

        if (sortVal === 'date-desc') {
          return dateB - dateA;
        } else if (sortVal === 'date-asc') {
          return dateA - dateB;
        } else if (sortVal === 'name-asc') {
          return nameA.localeCompare(nameB);
        } else if (sortVal === 'name-desc') {
          return nameB.localeCompare(nameA);
        } else if (sortVal === 'status-asc') {
          return statusA.localeCompare(statusB);
        } else if (sortVal === 'status-desc') {
          return statusB.localeCompare(statusA);
        }
        return 0;
      });

      rows.forEach(row => tbody.appendChild(row));
    }

    // View toggle handler: Switch between Dribbble Cards and Spreadsheet Table
    function setViewMode(mode) {
      const cardsList = document.getElementById('candidateCardsList');
      const tableView = document.getElementById('candidateTableView');
      const btnGrid = document.getElementById('btnViewGrid');
      const btnList = document.getElementById('btnViewList');
      if (mode === 'grid') {
        if (cardsList) cardsList.style.display = 'block';
        if (tableView) tableView.style.display = 'none';
        if (btnGrid) btnGrid.classList.add('active');
        if (btnList) btnList.classList.remove('active');
      } else {
        if (cardsList) cardsList.style.display = 'none';
        if (tableView) tableView.style.display = 'block';
        if (btnGrid) btnGrid.classList.remove('active');
        if (btnList) btnList.classList.add('active');
      }
    }

    // =========================================================================
    // DYNAMIC SELECTION CALENDAR SYSTEM (Fully Interactive)
    // =========================================================================
    const today = new Date();
    let currentCalYear = 2026; // Match application epoch or current year
    let currentCalMonth = 9;   // October (0-indexed)
    let activeCalPeriod = 'month'; // 'week', 'month', 'year'
    let activeDateFilter = null;   // 'YYYY-MM-DD' or null
    let currentWeekStart = getMondayOfWeek(new Date(2026, 9, 26));

    const monthNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
    const shortMonthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

    function getMondayOfWeek(d) {
      const date = new Date(d);
      const day = (date.getDay() + 6) % 7; // Monday = 0
      date.setDate(date.getDate() - day);
      date.setHours(0, 0, 0, 0);
      return date;
    }

    function formatDateKey(d) {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function formatDisplayDate(dateKey) {
      if (!dateKey) return '';
      const parts = dateKey.split('-');
      if (parts.length !== 3) return dateKey;
      const day = parseInt(parts[2], 10);
      const mIdx = parseInt(parts[1], 10) - 1;
      const year = parts[0];
      return `${day} ${monthNames[mIdx] || ''} ${year}`;
    }

    function getCandidateDateMap() {
      const counts = {};
      const rows = document.querySelectorAll('#candidateTableBody tr[data-date]');
      rows.forEach(r => {
        const ts = parseInt(r.getAttribute('data-date')) || 0;
        if (ts) {
          const d = new Date(ts);
          const k = formatDateKey(d);
          counts[k] = (counts[k] || 0) + 1;
        }
      });
      return counts;
    }

    function renderCalendar() {
      const calGrid = document.getElementById('calGrid');
      const calYearGrid = document.getElementById('calYearGrid');
      const headerEl = document.getElementById('calMonthDisplay');
      if (!calGrid) return;

      const candidateMap = getCandidateDateMap();
      const todayKey = formatDateKey(today);

      if (activeCalPeriod === 'year') {
        if (headerEl) headerEl.textContent = String(currentCalYear);
        calGrid.classList.add('d-none');
        if (calYearGrid) {
          calYearGrid.classList.remove('d-none');
          let yHtml = '';
          for (let m = 0; m < 12; m++) {
            const isSelectedMonth = (m === currentCalMonth);
            let mCount = 0;
            const prefix = `${currentCalYear}-${String(m + 1).padStart(2, '0')}`;
            for (const k in candidateMap) {
              if (k.startsWith(prefix)) mCount += candidateMap[k];
            }
            yHtml += `
              <button type="button" class="dd-year-month-btn ${isSelectedMonth ? 'active' : ''}" onclick="selectCalMonth(${m})">
                <div class="fw-bold">${shortMonthNames[m]}</div>
                <div style="font-size: 0.65rem; opacity: 0.8;">${mCount > 0 ? mCount + ' berkas' : '-'}</div>
              </button>
            `;
          }
          calYearGrid.innerHTML = yHtml;
        }
        return;
      }

      if (calYearGrid) calYearGrid.classList.add('d-none');
      calGrid.classList.remove('d-none');

      if (activeCalPeriod === 'week') {
        const weekEnd = new Date(currentWeekStart);
        weekEnd.setDate(weekEnd.getDate() + 6);
        if (headerEl) {
          headerEl.textContent = `${currentWeekStart.getDate()} ${shortMonthNames[currentWeekStart.getMonth()]} - ${weekEnd.getDate()} ${shortMonthNames[weekEnd.getMonth()]} ${weekEnd.getFullYear()}`;
        }

        let html = `
          <div class="dd-cal-weekday">Sen</div>
          <div class="dd-cal-weekday">Sel</div>
          <div class="dd-cal-weekday">Rab</div>
          <div class="dd-cal-weekday">Kam</div>
          <div class="dd-cal-weekday">Jum</div>
          <div class="dd-cal-weekday">Sab</div>
          <div class="dd-cal-weekday">Min</div>
        `;

        for (let i = 0; i < 7; i++) {
          const d = new Date(currentWeekStart);
          d.setDate(d.getDate() + i);
          const k = formatDateKey(d);
          const isToday = (k === todayKey);
          const isActive = (k === activeDateFilter);
          const count = candidateMap[k] || 0;

          let classes = ['dd-cal-day'];
          if (isToday) classes.push('today');
          if (isActive) classes.push('active');
          if (count > 0) classes.push('has-event');

          let dot = (count > 0) ? `<span class="dd-event-dot ${isActive ? 'dot-white' : 'dd-event-royal'}"></span>` : '';
          html += `<div class="${classes.join(' ')}" onclick="selectCalDate('${k}')" title="${d.getDate()} ${monthNames[d.getMonth()]} ${d.getFullYear()}${count > 0 ? ' (' + count + ' berkas pelamar)' : ''}">${d.getDate()}${dot}</div>`;
        }
        calGrid.innerHTML = html;
        return;
      }

      // Default: Month View
      if (headerEl) {
        headerEl.textContent = `${monthNames[currentCalMonth]} ${currentCalYear}`;
      }

      let html = `
        <div class="dd-cal-weekday">Sen</div>
        <div class="dd-cal-weekday">Sel</div>
        <div class="dd-cal-weekday">Rab</div>
        <div class="dd-cal-weekday">Kam</div>
        <div class="dd-cal-weekday">Jum</div>
        <div class="dd-cal-weekday">Sab</div>
        <div class="dd-cal-weekday">Min</div>
      `;

      const firstDayIdx = (new Date(currentCalYear, currentCalMonth, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(currentCalYear, currentCalMonth + 1, 0).getDate();
      const daysInPrevMonth = new Date(currentCalYear, currentCalMonth, 0).getDate();

      // Trailing previous month days
      for (let i = firstDayIdx - 1; i >= 0; i--) {
        const dayNum = daysInPrevMonth - i;
        const prevDate = new Date(currentCalYear, currentCalMonth - 1, dayNum);
        const k = formatDateKey(prevDate);
        const count = candidateMap[k] || 0;
        let dot = (count > 0) ? `<span class="dd-event-dot dd-event-royal"></span>` : '';
        html += `<div class="dd-cal-day muted" onclick="navToDate('${k}')" title="${dayNum} ${monthNames[prevDate.getMonth()]} ${prevDate.getFullYear()}">${dayNum}${dot}</div>`;
      }

      // Current month days
      for (let day = 1; day <= daysInMonth; day++) {
        const curDate = new Date(currentCalYear, currentCalMonth, day);
        const k = formatDateKey(curDate);
        const isToday = (k === todayKey);
        const isActive = (k === activeDateFilter);
        const count = candidateMap[k] || 0;

        let classes = ['dd-cal-day'];
        if (isToday) classes.push('today');
        if (isActive) classes.push('active');
        if (count > 0) classes.push('has-event');

        let dot = (count > 0) ? `<span class="dd-event-dot ${isActive ? 'dot-white' : 'dd-event-royal'}"></span>` : '';
        html += `<div class="${classes.join(' ')}" onclick="selectCalDate('${k}')" title="${day} ${monthNames[currentCalMonth]} ${currentCalYear}${count > 0 ? ' (' + count + ' berkas pelamar)' : ''}">${day}${dot}</div>`;
      }

      // Leading next month days
      const totalCells = firstDayIdx + daysInMonth;
      const remaining = (7 - (totalCells % 7)) % 7;
      for (let nextDay = 1; nextDay <= remaining; nextDay++) {
        const nextDate = new Date(currentCalYear, currentCalMonth + 1, nextDay);
        const k = formatDateKey(nextDate);
        const count = candidateMap[k] || 0;
        let dot = (count > 0) ? `<span class="dd-event-dot dd-event-royal"></span>` : '';
        html += `<div class="dd-cal-day muted" onclick="navToDate('${k}')" title="${nextDay} ${monthNames[nextDate.getMonth()]} ${nextDate.getFullYear()}">${nextDay}${dot}</div>`;
      }

      calGrid.innerHTML = html;
    }

    function selectCalDate(dateKey) {
      if (activeDateFilter === dateKey) {
        activeDateFilter = null;
      } else {
        activeDateFilter = dateKey;
        const parts = dateKey.split('-');
        if (parts.length === 3) {
          currentCalYear = parseInt(parts[0], 10);
          currentCalMonth = parseInt(parts[1], 10) - 1;
        }
      }
      updateDateFilterUI();
      renderCalendar();
      applyFilterAndSort();
    }

    function navToDate(dateKey) {
      const parts = dateKey.split('-');
      if (parts.length === 3) {
        currentCalYear = parseInt(parts[0], 10);
        currentCalMonth = parseInt(parts[1], 10) - 1;
      }
      selectCalDate(dateKey);
    }

    function selectCalMonth(m) {
      currentCalMonth = m;
      switchCalPeriod('month');
    }

    function clearCalDateFilter() {
      activeDateFilter = null;
      updateDateFilterUI();
      renderCalendar();
      applyFilterAndSort();
    }

    function updateDateFilterUI() {
      const chipWrap = document.getElementById('activeDateBadgeWrap');
      const chipText = document.getElementById('activeDateBadgeText');
      const noticeWrap = document.getElementById('calDateFilterNotice');
      const noticeText = document.getElementById('calFilterText');

      if (activeDateFilter) {
        const label = formatDisplayDate(activeDateFilter);
        if (chipWrap && chipText) {
          chipText.textContent = `Tanggal: ${label}`;
          chipWrap.classList.remove('d-none');
          chipWrap.classList.add('d-flex');
        }
        if (noticeWrap && noticeText) {
          noticeText.textContent = `Filter: ${label}`;
          noticeWrap.classList.remove('d-none');
        }
      } else {
        if (chipWrap) {
          chipWrap.classList.add('d-none');
          chipWrap.classList.remove('d-flex');
        }
        if (noticeWrap) {
          noticeWrap.classList.add('d-none');
        }
      }
    }

    function switchCalPeriod(period, btn) {
      activeCalPeriod = period;
      document.querySelectorAll('.dd-period-btn').forEach(b => b.classList.remove('active'));
      const targetBtn = btn || document.getElementById(`calTab${period.charAt(0).toUpperCase() + period.slice(1)}`);
      if (targetBtn) targetBtn.classList.add('active');
      renderCalendar();
    }

    function prevCalMonth() {
      prevCalPeriod();
    }

    function nextCalMonth() {
      nextCalPeriod();
    }

    function prevCalPeriod() {
      if (activeCalPeriod === 'month') {
        currentCalMonth--;
        if (currentCalMonth < 0) { currentCalMonth = 11; currentCalYear--; }
      } else if (activeCalPeriod === 'week') {
        currentWeekStart.setDate(currentWeekStart.getDate() - 7);
      } else if (activeCalPeriod === 'year') {
        currentCalYear--;
      }
      renderCalendar();
    }

    function nextCalPeriod() {
      if (activeCalPeriod === 'month') {
        currentCalMonth++;
        if (currentCalMonth > 11) { currentCalMonth = 0; currentCalYear++; }
      } else if (activeCalPeriod === 'week') {
        currentWeekStart.setDate(currentWeekStart.getDate() + 7);
      } else if (activeCalPeriod === 'year') {
        currentCalYear++;
      }
      renderCalendar();
    }

    function toggleCalCollapse() {
      const body = document.getElementById('calBodyWrapper');
      const icon = document.getElementById('calCollapseIcon');
      if (body) {
        const isHidden = body.classList.contains('d-none');
        if (isHidden) {
          body.classList.remove('d-none');
          if (icon) icon.style.transform = 'rotate(0deg)';
        } else {
          body.classList.add('d-none');
          if (icon) icon.style.transform = 'rotate(180deg)';
        }
      }
    }

    window.getRandomToken = getRandomToken;
    window.generateRandomShareLink = generateRandomShareLink;
    window.generateAndCopyShareLink = generateAndCopyShareLink;
    window.setFilter = setFilter;
    window.filterByStatusCard = filterByStatusCard;
    window.filterByDivisiQuick = filterByDivisiQuick;
    window.toggleSort = toggleSort;
    window.applyFilterAndSort = applyFilterAndSort;
    window.setViewMode = setViewMode;
    window.switchCalPeriod = switchCalPeriod;
    window.prevCalMonth = prevCalMonth;
    window.nextCalMonth = nextCalMonth;
    window.prevCalPeriod = prevCalPeriod;
    window.nextCalPeriod = nextCalPeriod;
    window.selectCalDate = selectCalDate;
    window.selectCalMonth = selectCalMonth;
    window.clearCalDateFilter = clearCalDateFilter;
    window.toggleCalCollapse = toggleCalCollapse;
    window.renderCalendar = renderCalendar;

    document.addEventListener('DOMContentLoaded', () => {
      renderCalendar();
      updateKovLiveClock();
      setInterval(updateKovLiveClock, 30000);
      try {
        generateRandomShareLink(false, false);
      } catch (e) {
        console.warn('Initial token generation notice:', e);
      }

      document.querySelectorAll('.kov-filter-pill-botanical').forEach(pill => {
        pill.addEventListener('click', function() {
          const filter = this.getAttribute('data-filter');
          if (filter) setFilter(filter, this);
        });
      });

      const btnAcak = document.getElementById('btnAcakToken');
      if (btnAcak) {
        btnAcak.addEventListener('click', function(e) {
          e.preventDefault();
          generateRandomShareLink(false);
        });
      }

      const btnAcakTopbar = document.getElementById('btnAcakTokenTopbar');
      if (btnAcakTopbar) {
        btnAcakTopbar.addEventListener('click', function(e) {
          e.preventDefault();
          generateRandomShareLink(true);
        });
      }

      const btnSalin = document.getElementById('btnSalinLink');
      if (btnSalin) {
        btnSalin.addEventListener('click', function(e) {
          e.preventDefault();
          generateAndCopyShareLink();
        });
      }

      const btnIconCopy = document.getElementById('btnIconCopy');
      if (btnIconCopy) {
        btnIconCopy.addEventListener('click', function(e) {
          e.preventDefault();
          generateAndCopyShareLink();
        });
      }

      applyFilterAndSort();
    });
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
