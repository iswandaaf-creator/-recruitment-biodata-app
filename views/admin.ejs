<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>KOV Koffie — Atelier Sistem &amp; Direktori Kandidat</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261103_atelier" rel="stylesheet">
  <script src="/assets/js/kov-toast.js"></script>
  <script src="/assets/js/kov-theme.js"></script>
</head>
<body>

  <%
    const pendingCandidates = (candidates || []).filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses');
    const pendingCandidateCount = pendingCandidates.length;
    const acceptedCandidateCount = (candidates || []).filter(c => c.kesimpulan_status === 'Diterima').length;
    const duplicateCount = (candidates || []).filter(c => c.is_duplicate).length;
    const baristaCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('barista')).length;
    const opsCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('operasional') || (c.divisi || '').toLowerCase().includes('staff') || (c.divisi || '').toLowerCase().includes('kasir')).length;
    const kitchenCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('kitchen') || (c.divisi || '').toLowerCase().includes('cook') || (c.divisi || '').toLowerCase().includes('pastry')).length;
    const teknisiCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('teknisi') || (c.divisi || '').toLowerCase().includes('maintenance') || (c.divisi || '').toLowerCase().includes('listrik')).length;
    const itCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('it') || (c.divisi || '').toLowerCase().includes('developer') || (c.divisi || '').toLowerCase().includes('support') || (c.divisi || '').toLowerCase().includes('tech')).length;
    const fatCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('fat') || (c.divisi || '').toLowerCase().includes('finance') || (c.divisi || '').toLowerCase().includes('akunting') || (c.divisi || '').toLowerCase().includes('tax')).length;
    const hrCount = (candidates || []).filter(c => (c.divisi || '').toLowerCase().includes('hr') || (c.divisi || '').toLowerCase().includes('personalia') || (c.divisi || '').toLowerCase().includes('ga')).length;
  %>

  <div class="atelier-shell dd-layout-root kov-app-shell">
    <!-- 1. Left Pebble-Sage Sidebar (194px) -->
    <%- include('partials/sidebar', { active: 'hr', user: typeof user !== 'undefined' ? user : null }) %>

    <!-- 2. Main System Workspace -->
    <main class="atelier-main dd-main-canvas kov-main-content dd-theme" id="mainWorkspace">

      <!-- Top Bar (64px Warm Artisanal Paper #FCFBF9) -->
      <header class="atelier-topbar dd-topbar">
        <div class="d-flex align-items-center gap-2 min-w-0">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M4 7H20M4 12H20M4 17H20" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
          <span class="status-pill pill-emerald font-mono-num" id="activeRoleBadge">Super Admin HR</span>
          <span class="d-none d-sm-inline" style="color: var(--ink-muted); font-size: 12px;">/</span>
          <span class="d-none d-sm-inline text-truncate fw-semibold" style="color: var(--ink-body); font-size: 12px;">KOV Semarang Roastery &amp; People</span>
        </div>

        <div class="d-flex align-items-center gap-2 flex-shrink-0">
          <!-- Search with Hand-Drawn Loupe SVG -->
          <div class="atelier-search-box">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" class="flex-shrink-0">
              <path d="M10.8 4.2C14.6 4.1 17.5 7.2 17.3 10.9C17.1 14.7 14 17.4 10.3 17.3C6.6 17.2 3.9 14.1 4.1 10.4C4.3 7.1 7.2 4.3 10.8 4.2Z" fill="#dfece3" stroke="#3f6f56" stroke-width="1.85" stroke-linecap="round"/>
              <path d="M15.6 15.8L20.2 20.1" stroke="#3f6f56" stroke-width="2.1" stroke-linecap="round"/>
            </svg>
            <input type="text" id="searchInput" class="atelier-search-input" placeholder="Cari kandidat, NIK, outlet..." aria-label="Cari nama pelamar" onkeyup="applyFilterAndSort()">
          </div>

          <!-- Toggle Right Calendar Button -->
          <button type="button" id="btnToggleRightCalendar" class="btn-kov-outline" onclick="toggleRightCalendarPanel()" title="Sembunyikan / Tampilkan Kalender">
            <svg class="hand-icon" style="width: 16px; height: 16px;" viewBox="0 0 24 24" fill="none">
              <path d="M4.5 7.2C4.5 5.8 5.6 4.8 7 4.8H17.2C18.6 4.8 19.6 5.9 19.5 7.3V18.2C19.4 19.6 18.3 20.5 16.9 20.5H6.8C5.4 20.5 4.4 19.4 4.5 18V7.2Z" fill="#dfece3" stroke="#3f6f56" stroke-width="1.75"/>
              <path d="M8.2 3.2V6.1M15.8 3.4V6.2M4.8 9.6H19.2" stroke="#3f6f56" stroke-width="1.9" stroke-linecap="round"/>
            </svg>
            <span class="d-none d-sm-inline">Kalender</span>
          </button>

          <!-- Export Excel Button -->
          <a href="/api/export/excel" class="btn-kov-outline d-none d-md-inline-flex text-decoration-none" title="Export Rekap ke Excel">
            <svg class="hand-icon" style="width: 15px; height: 15px;" viewBox="0 0 24 24" fill="none">
              <path d="M6.8 5.2H15.4L18.8 8.6V19.2C18.8 20.1 18.1 20.8 17.2 20.8H6.8C5.9 20.8 5.2 20.1 5.2 19.2V6.8C5.2 5.9 5.9 5.2 6.8 5.2Z" fill="#dfece3" stroke="#3f6f56" stroke-width="1.8" stroke-linejoin="round"/>
              <path d="M9.5 11.5L14.5 16.5M14.5 11.5L9.5 16.5" stroke="#3f6f56" stroke-width="1.9" stroke-linecap="round"/>
            </svg>
            <span>Excel</span>
          </a>

          <!-- Acak Token Button -->
          <button type="button" id="btnAcakToken" class="btn-kov-outline d-none d-lg-inline-flex" onclick="generateRandomShareLink(false)" title="Acak Token Tautan Formulir">
            <svg class="hand-icon" style="width: 15px; height: 15px;" viewBox="0 0 24 24" fill="none">
              <path d="M16 3H21V8M4 20L21 3M21 16V21H16M15 15L21 21M4 4L9 9" stroke="#3f6f56" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Acak Token</span>
          </button>

          <!-- Salin Link Form Primary Button -->
          <button type="button" id="btnSalinLink" class="btn-kov-primary btn-dd-hero" onclick="generateAndCopyShareLink()">
            <svg class="hand-icon" style="width: 16px; height: 16px;" viewBox="0 0 24 24" fill="none">
              <path d="M9.8 14.2L14.3 9.7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M11.2 7.5L13.4 5.3C15.1 3.6 17.8 3.7 19.3 5.2C20.8 6.7 20.7 9.4 19 11.1L16.8 13.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <path d="M12.8 16.5L10.6 18.7C8.9 20.4 6.2 20.3 4.7 18.8C3.2 17.3 3.3 14.6 5 12.9L7.2 10.7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
            <span>Salin Link Form</span>
          </button>

          <!-- Buka Form Biodata External Link -->
          <a href="/?ref=c-kov9821x" target="_blank" rel="noopener noreferrer" class="btn-dd-hero text-decoration-none" style="font-size: 0.82rem; padding: 7px 14px;" title="Buka Formulir Biodata Pelamar">+ Form Biodata</a>

          <!-- Hidden Token Utility Hooks for JS / Tests -->
          <div class="d-none">
            <span id="shareUrl"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/?ref=c-Sysujatg</span>
            <button type="button" id="btnIconCopy" onclick="generateAndCopyShareLink()"><i id="iconCopySmall"></i></button>
          </div>
        </div>
      </header>

      <!-- Scrollable Workspace Body with Generous Breathing Room -->
      <div class="atelier-scroll">

        <!-- Row 1: Asymmetric Editorial Title Band + 3 Natural Tonal Summary Pills -->
        <section class="editorial-header-band dd-hero-banner">
          <div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <h1 class="font-display m-0 fw-bold" style="font-size: 1.35rem; color: var(--ink-deep);" id="pageTitleHeading">
                Direktori Kandidat Pelamar
              </h1>
              <span class="status-pill pill-emerald font-mono-num">
                <span id="candidateCount"><%= candidates.length %></span> Data
              </span>
              <!-- Hidden greeting text for legacy test compatibility -->
              <span class="dd-hero-title d-none">Dashboard Rekrutmen HR — <%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'Administrator HR' %></span>
            </div>
            <p class="m-0 mt-1" style="font-size: 12px; color: var(--ink-body);">
              Kelola seleksi kandidat, verifikasi berkas, dan jadwal agenda HRD dalam tata letak pastel yang tenang.
            </p>
          </div>

          <!-- Asymmetric 3-Card Tonal Summary Cluster (1.15fr 1fr 1fr) -->
          <div class="tonal-summary-strip">
            <div class="tonal-pill-card pigment-celadon" onclick="filterByStatusCard('all')" role="button" tabindex="0" title="Tampilkan Semua Pelamar">
              <div>
                <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.85;">Total Pelamar</div>
                <div class="font-display font-mono-num fw-bold mt-0.5" style="font-size: 1.2rem; color: var(--celadon-ink);"><%= candidates.length %> Kandidat</div>
              </div>
              <svg class="hand-icon" viewBox="0 0 24 24" fill="none">
                <path d="M7.5 9.2C7.5 6.8 9.4 5 11.8 5.2C14.2 5.4 15.8 7.3 15.6 9.7C15.4 12.1 13.5 13.8 11.1 13.6C8.8 13.4 7.5 11.5 7.5 9.2Z" fill="#bdd6c5" fill-opacity="0.65"/>
                <path d="M11.2 4.8C13.6 4.7 15.6 6.6 15.5 9C15.4 11.4 13.4 13.2 11 13.2C8.6 13.2 6.8 11.3 6.9 8.9C7 6.6 8.9 4.9 11.2 4.8Z" stroke="#3f6f56" stroke-width="1.85" stroke-linecap="round"/>
                <path d="M4.2 19.6C4.8 16.5 7.6 15.1 11.2 15.1C14.8 15.1 17.5 16.7 18.2 19.7" stroke="#3f6f56" stroke-width="2.05" stroke-linecap="round"/>
              </svg>
            </div>

            <div class="tonal-pill-card pigment-ochre" onclick="filterByStatusCard('Belum Diproses')" role="button" tabindex="0" title="Saring Berkas Perlu Evaluasi">
              <div>
                <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.85;">Perlu Evaluasi</div>
                <div class="font-display font-mono-num fw-bold mt-0.5" style="font-size: 1.2rem; color: var(--ochre-ink);"><%= pendingCandidateCount %> Berkas</div>
              </div>
              <svg class="hand-icon" viewBox="0 0 24 24" fill="none">
                <path d="M12.4 4.5L14.6 9.1L19.6 9.7L15.9 13.1L16.9 18.1L12.3 15.6L7.8 18.2L8.8 13.2L5.1 9.8L10.1 9.1L12.4 4.5Z" fill="#e5d4a7" fill-opacity="0.7"/>
                <path d="M11.9 4.2L14.1 8.8L19.1 9.4L15.4 12.8L16.4 17.8L11.8 15.3L7.3 17.9L8.3 12.9L4.6 9.5L9.6 8.8L11.9 4.2Z" stroke="#9c782b" stroke-width="1.8" stroke-linejoin="round"/>
              </svg>
            </div>

            <div class="tonal-pill-card pigment-mauve" onclick="filterByStatusCard('Diterima')" role="button" tabindex="0" title="Saring Kandidat Lulus Seleksi">
              <div>
                <div style="font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; opacity: 0.85;">Lulus Seleksi</div>
                <div class="font-display font-mono-num fw-bold mt-0.5" style="font-size: 1.2rem; color: var(--mauve-ink);"><%= acceptedCandidateCount %> Siap PKWT</div>
              </div>
              <svg class="hand-icon" viewBox="0 0 24 24" fill="none">
                <path d="M6.8 5.2H15.4L18.8 8.6V19.2C18.8 20.1 18.1 20.8 17.2 20.8H6.8C5.9 20.8 5.2 20.1 5.2 19.2V6.8C5.2 5.9 5.9 5.2 6.8 5.2Z" fill="#c8cfe6" fill-opacity="0.55"/>
                <path d="M6.2 4.6H14.8L18.4 8.2V18.8C18.4 19.7 17.7 20.4 16.8 20.4H6.2C5.3 20.4 4.6 19.7 4.6 18.8V6.2C4.6 5.3 5.3 4.6 6.2 4.6Z" stroke="#54638f" stroke-width="1.8" stroke-linejoin="round"/>
                <path d="M8.2 11.5H14.6M8.2 15.2H12.4" stroke="#54638f" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </div>
          </div>
        </section>

        <!-- Hidden Legacy Folder Cards for Automated Test Compatibility -->
        <div class="d-none" id="foldersGrid" aria-hidden="true">
          <div class="dd-folder-card dd-folder-indigo folder-all active" data-divisi="all" onclick="filterByDivisiQuick('all')">Semua Divisi</div>
          <div class="dd-folder-card dd-folder-coral folder-coral" data-divisi="barista" onclick="filterByDivisiQuick('barista')">Barista</div>
          <div class="dd-folder-card dd-folder-royal folder-blue" data-divisi="operasional" onclick="filterByDivisiQuick('operasional')">Operasional</div>
          <div class="dd-folder-card dd-folder-amber folder-amber" data-divisi="kitchen" onclick="filterByDivisiQuick('kitchen')">Kitchen</div>
          <div class="dd-folder-card dd-folder-cyan folder-cyan" data-divisi="teknisi" onclick="filterByDivisiQuick('teknisi')">Teknisi</div>
          <div class="dd-folder-card dd-folder-violet folder-violet" data-divisi="it" onclick="filterByDivisiQuick('it')">IT Systems</div>
          <div class="dd-folder-card dd-folder-emerald folder-fat" data-divisi="fat" onclick="filterByDivisiQuick('fat')">Finance</div>
          <div class="dd-folder-card dd-folder-rose folder-rose" data-divisi="hr" onclick="filterByDivisiQuick('hr')">HR &amp; GA</div>
        </div>

        <!-- Row 2: Asymmetric 2-Column Workspace (Spacious Data Sheet + Tactile Memo Pad) -->
        <section class="workspace-asymmetric-grid" id="bentoWorkspaceGrid">

          <!-- Left Column: Main Candidates Paper Card -->
          <div class="kov-paper-card kov-table-card min-w-0">
            <!-- Clean Filter Bar (Status Tab Pills Left + Division & Sort Dropdowns Right) -->
            <div class="atelier-table-toolbar">
              <div class="d-flex align-items-center gap-1 flex-wrap">
                <button type="button" class="kov-tab-pill kov-filter-pill-botanical active" data-filter="all" onclick="setFilter('all', this)">
                  <span>Semua</span>
                </button>
                <button type="button" class="kov-tab-pill kov-filter-pill-botanical" data-filter="Belum Diproses" onclick="setFilter('Belum Diproses', this)">
                  <span>Belum Diproses</span>
                </button>
                <button type="button" class="kov-tab-pill kov-filter-pill-botanical" data-filter="Dipertimbangkan" onclick="setFilter('Dipertimbangkan', this)">
                  <span>Dipertimbangkan</span>
                </button>
                <button type="button" class="kov-tab-pill kov-filter-pill-botanical" data-filter="Diterima" onclick="setFilter('Diterima', this)">
                  <span>Diterima</span>
                </button>
                <button type="button" class="kov-tab-pill kov-filter-pill-botanical" data-filter="Ditolak" onclick="setFilter('Ditolak', this)">
                  <span>Ditolak</span>
                </button>
                <button type="button" class="kov-tab-pill kov-filter-pill-botanical <%= duplicateCount > 0 ? '' : 'd-none' %>" data-filter="duplicate" onclick="setFilter('duplicate', this)">
                  <span>Duplikat (<%= duplicateCount %>)</span>
                </button>
              </div>

              <div class="d-flex align-items-center gap-2 flex-wrap">
                <!-- Active Date Filter Chip -->
                <div id="activeDateBadgeWrap" class="d-none">
                  <button type="button" onclick="clearCalDateFilter()" class="status-pill pill-ochre border-0" style="cursor: pointer;" title="Hapus Filter Tanggal">
                    <span id="activeDateBadgeText">Tanggal</span> &times;
                  </button>
                </div>

                <!-- Clean Division Select -->
                <select id="divisiSelect" class="kov-pastel-input" style="height: 32px; padding: 0 11px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;" aria-label="Filter berdasarkan Divisi" onchange="applyFilterAndSort()">
                  <option value="all" selected>Semua Divisi (<%= candidates.length %>)</option>
                  <option value="operasional">Operasional (<%= opsCount %>)</option>
                  <option value="fat">Finance / FAT (<%= fatCount %>)</option>
                  <option value="it">IT Systems (<%= itCount %>)</option>
                  <option value="barista">Barista (<%= baristaCount %>)</option>
                  <option value="kitchen">Kitchen (<%= kitchenCount %>)</option>
                  <option value="teknisi">Teknisi (<%= teknisiCount %>)</option>
                  <option value="hr">HR &amp; GA (<%= hrCount %>)</option>
                </select>

                <!-- Clean Sort Select -->
                <select id="sortSelect" class="kov-pastel-input" style="height: 32px; padding: 0 10px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer;" aria-label="Urutkan daftar pelamar" onchange="applyFilterAndSort()">
                  <option value="date-desc" selected>Terbaru</option>
                  <option value="date-asc">Terlama</option>
                  <option value="name-asc">Nama (A-Z)</option>
                  <option value="name-desc">Nama (Z-A)</option>
                  <option value="status-asc">Status (A-Z)</option>
                </select>
              </div>
            </div>

            <!-- 4-Column Breathable Table -->
            <div class="table-responsive" id="candidateTableView">
              <table class="kov-table">
                <thead>
                  <tr>
                    <th style="width: 28%;">Kandidat &amp; Pendidikan</th>
                    <th style="width: 26%;">Posisi &amp; Penempatan</th>
                    <th style="width: 22%;">NIK KTP &amp; Rekening</th>
                    <th style="width: 24%; text-align: right;">Status &amp; Aksi</th>
                  </tr>
                </thead>
                <tbody id="candidateTableBody">
                  <% if (candidates.length === 0) { %>
                    <tr id="noDataRow">
                      <td colspan="4" class="text-center py-5" style="color: var(--ink-muted);">
                        Belum ada data pelamar yang masuk. Klik <strong>Salin Link Form</strong> di kanan atas untuk membagikan formulir.
                      </td>
                    </tr>
                  <% } %>
                  <%
                    const avatarPalettes = [
                      { bg: '#dfece3', ink: '#2e5943' },
                      { bg: '#e6e9f4', ink: '#3c4a73' },
                      { bg: '#f0e4e8', ink: '#6e3645' },
                      { bg: '#f6eed8', ink: '#6e5219' },
                      { bg: '#f6e5da', ink: '#784124' }
                    ];
                    candidates.forEach((c, idx) => {
                      const cDiv = c.divisi || 'Operasional';
                      const dLow = cDiv.toLowerCase();
                      const rawStatus = (c.kesimpulan_status || 'Belum Diproses').trim();
                      const pal = avatarPalettes[idx % avatarPalettes.length];

                      let divPillClass = 'pill-emerald';
                      if (dLow.includes('barista')) divPillClass = 'pill-peach';
                      else if (dLow.includes('kitchen')) divPillClass = 'pill-rose';
                      else if (dLow.includes('fat') || dLow.includes('finance')) divPillClass = 'pill-ochre';
                      else if (dLow.includes('it') || dLow.includes('operasional')) divPillClass = 'pill-lavender';

                      let stPillClass = 'pill-lavender';
                      if (rawStatus === 'Diterima') stPillClass = 'pill-emerald';
                      else if (rawStatus === 'Dipertimbangkan') stPillClass = 'pill-ochre';
                      else if (rawStatus === 'Ditolak') stPillClass = 'pill-rose';

                      let badgeClass = 'dd-badge-pdf', badgeText = 'PDF';
                      if (c.foto_kandidat) { badgeClass = 'dd-badge-png'; badgeText = 'PNG'; }
                      else if (dLow.includes('kitchen')) { badgeClass = 'dd-badge-zip'; badgeText = 'ZIP'; }
                  %>
                    <tr data-id="<%= c.id %>"
                        data-date="<%= c.created_at ? new Date(c.created_at).getTime() : 0 %>"
                        data-name="<%= (c.nama_lengkap || '').toLowerCase() %>"
                        data-status="<%= rawStatus %>"
                        data-divisi="<%= dLow %>"
                        data-duplicate="<%= c.is_duplicate ? 'true' : 'false' %>">
                      <td>
                        <div class="d-flex align-items-center gap-3">
                          <span class="dd-file-badge <%= badgeClass %> d-none"><%= badgeText %></span>
                          <% if (c.foto_kandidat) { %>
                            <img src="<%= c.foto_kandidat %>" alt="<%= c.nama_lengkap %>" class="rounded-circle flex-shrink-0" style="width: 32px; height: 32px; object-fit: cover; border: 1px solid var(--border-organic);">
                          <% } else { %>
                            <div class="rounded-circle font-display fw-bold d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-size: 12px; background: <%= pal.bg %>; color: <%= pal.ink %>;">
                              <%= (c.nama_lengkap && c.nama_lengkap.trim()) ? c.nama_lengkap.trim().charAt(0).toUpperCase() : '?' %>
                            </div>
                          <% } %>
                          <div class="min-w-0">
                            <div class="font-display fw-bold text-truncate" style="font-size: 13px; color: var(--ink-deep); max-width: 190px;">
                              <%= (c.nama_lengkap && c.nama_lengkap.trim()) ? c.nama_lengkap : '(Tanpa Nama)' %>
                            </div>
                            <div style="font-size: 11px; color: var(--ink-muted);">
                              <%= c.pendidikan_terakhir || 'Pelamar KOV' %> &bull; <%= formatDate(c.created_at, false) %>
                            </div>
                          </div>
                        </div>
                      </td>
                      <td>
                        <div class="d-flex align-items-center gap-1.5 flex-wrap">
                          <span class="fw-semibold" style="font-size: 12px; color: var(--ink-deep);"><%= c.posisi_dilamar || cDiv %></span>
                          <span class="status-pill <%= divPillClass %>" style="font-size: 9.5px; padding: 1px 8px;"><%= cDiv %></span>
                        </div>
                        <div style="font-size: 11px; color: var(--ink-muted); margin-top: 2px;">
                          <%= c.outlet_tujuan || (c.share_token ? 'Token: ' + c.share_token : 'KOV Semarang Roastery') %>
                          <% if (c.is_duplicate) { %>
                            <span class="status-pill pill-ochre ms-1" style="font-size: 9px; padding: 0 6px;">Duplikat <%= c.duplicate_count %>x</span>
                          <% } %>
                        </div>
                      </td>
                      <td>
                        <div class="font-mono-num fw-semibold" style="font-size: 12px; color: var(--ink-deep);">
                          <%= c.nomor_ktp || '-' %>
                        </div>
                        <div class="font-mono-num" style="font-size: 11px; color: var(--ink-muted);">
                          <%= c.no_rekening ? c.no_rekening + ' • ' : '' %><%= c.no_hp || c.email || '-' %>
                        </div>
                      </td>
                      <td class="text-end">
                        <div class="d-inline-flex align-items-center justify-content-end gap-1">
                          <span class="status-pill <%= stPillClass %>"><%= rawStatus %></span>
                          <a href="/admin/candidate/<%= c.id %>" class="btn-kov-outline kov-action-review-btn text-decoration-none" style="height: 28px; padding: 0 9px; font-size: 11px;" title="Lihat Detail & Evaluasi">
                            Detail
                          </a>
                          <button type="button" class="btn-kov-outline" style="height: 28px; padding: 0 7px; font-size: 11px;" onclick="scheduleCandidateMemo(<%= JSON.stringify(c.nama_lengkap || 'Kandidat') %>)" title="Jadwalkan di Kalender">
                            + Memo
                          </button>
                          <a href="/api/export/pdf/<%= c.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-outline kov-action-icon-circle text-decoration-none" style="height: 28px; padding: 0 7px; font-size: 11px;" title="Export PDF Biodata" aria-label="Export PDF Biodata <%= c.nama_lengkap %>">
                            PDF
                          </a>
                          <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                            <form action="/admin/candidate/delete/<%= c.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus berkas pelamar <%= c.nama_lengkap %> secara permanen?');">
                              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                              <button type="submit" class="btn-kov-outline" style="height: 28px; padding: 0 7px; font-size: 11px; color: var(--mauve-stroke);" title="Hapus Berkas Pelamar">
                                &times;
                              </button>
                            </form>
                          <% } %>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Right Column: Warm Cream Calendar & Memo Pad (#F7F3E8) -->
          <aside class="kov-pad-card dd-right-panel" id="hrRightSidebar">
            <div class="px-3.5 py-3 border-bottom d-flex align-items-center justify-content-between" style="border-color: var(--border-organic) !important; padding: 14px 16px;">
              <div class="d-flex align-items-center gap-2">
                <!-- Hand-Drawn Botanical Pin Icon -->
                <svg class="hand-icon" style="width: 16px; height: 16px;" viewBox="0 0 24 24" fill="none">
                  <path d="M6.5 4.8H17.5C18.5 4.8 19.2 5.6 19.2 6.6V18.4C19.2 19.4 18.4 20.2 17.4 20.2H6.5C5.5 20.2 4.8 19.4 4.8 18.4V6.6C4.8 5.6 5.5 4.8 6.5 4.8Z" fill="#f6eed8" stroke="#9c782b" stroke-width="1.75"/>
                  <path d="M8.5 9.5H15.5M8.5 13H13.5" stroke="#9c782b" stroke-width="1.9" stroke-linecap="round"/>
                </svg>
                <h2 class="font-display m-0 fw-bold" style="font-size: 12px; color: var(--ink-deep);">Kalender &amp; Memo</h2>
              </div>
              <button type="button" onclick="filterByStatusCard('Belum Diproses')" class="status-pill pill-ochre border-0 dd-task-card" style="cursor: pointer;" title="Klik untuk menyaring berkas perlu evaluasi">
                <span class="font-mono-num" id="pendingTaskBadge"><%= pendingCandidateCount %> Notif</span>
              </button>
            </div>

            <div style="padding: 16px; display: flex; flex-direction: column; gap: 16px;">
              <!-- Mini Calendar Grid -->
              <div class="dd-calendar-widget" id="ddCalendarWidget" style="background: var(--bg-paper); border: 1px solid var(--border-organic); border-radius: 12px; padding: 12px;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span class="font-display fw-bold" style="font-size: 12px; color: var(--ink-deep);" id="calMonthDisplay">Oktober 2026</span>
                  <div class="d-flex align-items-center gap-1">
                    <button type="button" id="btnPrevCalMonth" onclick="prevCalPeriod()" class="kov-soft-icon-btn border-0 rounded" style="width: 22px; height: 22px; font-size: 12px;" title="Bulan Sebelumnya">&lsaquo;</button>
                    <button type="button" onclick="clearCalDateFilter()" class="kov-soft-icon-btn border-0 rounded fw-bold" style="height: 22px; padding: 0 6px; font-size: 10px; color: var(--celadon-stroke);">Semua</button>
                    <button type="button" id="btnNextCalMonth" onclick="nextCalPeriod()" class="kov-soft-icon-btn border-0 rounded" style="width: 22px; height: 22px; font-size: 12px;" title="Bulan Selanjutnya">&rsaquo;</button>
                  </div>
                </div>

                <!-- Hidden period tabs for legacy test compatibility -->
                <div class="dd-period-toggle d-none">
                  <button type="button" class="dd-period-btn" id="calTabWeek" onclick="switchCalPeriod('week', this)">Minggu</button>
                  <button type="button" class="dd-period-btn active" id="calTabMonth" onclick="switchCalPeriod('month', this)">Bulan</button>
                  <button type="button" class="dd-period-btn" id="calTabYear" onclick="switchCalPeriod('year', this)">Tahun</button>
                </div>

                <div id="calBodyWrapper">
                  <div class="dd-calendar-grid font-mono-num" id="calGrid"></div>
                  <div id="calYearGrid" class="dd-year-grid d-none"></div>
                  <div id="calDateFilterNotice" class="d-none mt-2 pt-2 border-top text-center" style="font-size: 11px;">
                    <span class="fw-bold" style="color: var(--celadon-ink);" id="calFilterText">Filter Tanggal Aktif</span>
                    <a href="javascript:void(0)" onclick="clearCalDateFilter()" class="ms-2 text-decoration-none fw-semibold" style="color: var(--mauve-stroke);">&times; Reset</a>
                  </div>
                </div>
              </div>

              <!-- Click-Date Memo Composer (Always Open, Botanical Celadon Card) -->
              <div class="pigment-celadon" id="hrMemoStudioWidget" style="padding: 14px; border-radius: 12px; border: 1px solid var(--celadon-border);">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <span style="font-size: 11px; font-weight: 700; color: var(--celadon-ink);">Catatan Tanggal</span>
                  <span class="font-mono-num fw-bold px-2 py-0.5 rounded-pill" style="font-size: 10px; background: #ffffff; color: var(--celadon-ink);" id="memoActiveDateLabel">24/10/2026</span>
                </div>

                <form id="hrMemoForm" onsubmit="submitHrMemo(event)" novalidate>
                  <div class="mb-2">
                    <input type="text" id="hrMemoTitleInput" placeholder="Tulis agenda / memo..." class="w-100 kov-pastel-input" style="height: 32px; padding: 0 10px; border-radius: 8px; font-size: 12px; border-color: var(--celadon-border);">
                  </div>
                  <div class="row g-1.5 mb-2">
                    <div class="col-6">
                      <select id="hrMemoCatInput" class="w-100 kov-pastel-input" style="height: 28px; padding: 0 8px; border-radius: 8px; font-size: 11px; font-weight: 600; border-color: var(--celadon-border);" aria-label="Kategori Memo">
                        <option value="Interview">Interview</option>
                        <option value="Uji Praktik">Uji Praktik</option>
                        <option value="Approval">Approval</option>
                        <option value="Onboarding">Onboarding</option>
                      </select>
                    </div>
                    <div class="col-6">
                      <input type="time" id="hrMemoTimeInput" value="10:00" class="w-100 kov-pastel-input font-mono-num" style="height: 28px; padding: 0 8px; border-radius: 8px; font-size: 11px; border-color: var(--celadon-border);" aria-label="Jam Memo">
                    </div>
                  </div>
                  <input type="hidden" id="hrMemoDateInput" value="2026-10-24">
                  <input type="hidden" id="hrMemoNoteInput" value="">

                  <button type="submit" id="btnSaveHrMemo" class="btn-kov-primary w-100" style="height: 32px; font-size: 12px;">
                    <span>+ Simpan ke Kalender</span>
                  </button>
                </form>
              </div>

              <!-- Daftar Agenda -->
              <div>
                <div class="fw-bold mb-2" style="font-size: 11px; color: var(--ink-deep);">Daftar Agenda</div>
                <div id="hrMemoListContainer" style="max-height: 185px; overflow-y: auto; display: flex; flex-direction: column; gap: 6px;"></div>
              </div>
            </div>
          </aside>

        </section>

      </div>

    </main>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    const KOV_CSRF_TOKEN = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

    function toggleRightCalendarPanel() {
      const grid = document.getElementById('bentoWorkspaceGrid');
      if (grid) grid.classList.toggle('calendar-collapsed');
    }

    function scheduleCandidateMemo(name) {
      const grid = document.getElementById('bentoWorkspaceGrid');
      if (grid) grid.classList.remove('calendar-collapsed');
      const input = document.getElementById('hrMemoTitleInput');
      if (input) {
        input.value = 'Interview — ' + name;
        input.focus();
      }
      if (window.KovToast && typeof window.KovToast.info === 'function') {
        window.KovToast.info('Klik "+ Simpan ke Kalender" di panel kanan.', 'Jadwalkan ' + name);
      }
    }

    function getAppBaseUrl() {
      if (window.location && window.location.origin && window.location.origin !== 'null') {
        return window.location.origin;
      }
      return 'https://internal.kovgroups.com';
    }

    function getRandomToken() {
      const chars = '23456789abcdefghjkmnpqrstuvwxyz';
      let result = '';
      for (let i = 0; i < 8; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return 'c-' + result;
    }

    function generateRandomShareLink(shouldCopy = true, showToast = true) {
      const token = getRandomToken();
      const url = getAppBaseUrl() + '/?ref=' + token;
      const shareEl = document.getElementById('shareUrl');
      if (shareEl) shareEl.innerText = url;
      if (shouldCopy) {
        copyTextWithFeedback(url, 'Tautan formulir rekrutmen berhasil disalin ke clipboard:\n' + url);
      } else if (showToast && window.KovToast && typeof window.KovToast.info === 'function') {
        window.KovToast.info('Token baru aktif: ' + token, 'Token Diperbarui');
      }
      return url;
    }

    function generateAndCopyShareLink() {
      const shareEl = document.getElementById('shareUrl');
      const url = (shareEl && shareEl.innerText.trim() && !shareEl.innerText.includes('Sysujatg'))
        ? shareEl.innerText.trim()
        : (getAppBaseUrl() + '/?ref=' + getRandomToken());
      if (shareEl) shareEl.innerText = url;
      copyTextWithFeedback(url, 'Tautan formulir rekrutmen berhasil disalin:\n' + url);
    }

    function copyTextWithFeedback(text, successMsg) {
      const btnSalin = document.getElementById('btnSalinLink');
      if (btnSalin && !btnSalin.getAttribute('data-orig-html')) {
        btnSalin.setAttribute('data-orig-html', btnSalin.innerHTML);
      }
      const origSalinText = btnSalin ? btnSalin.getAttribute('data-orig-html') : '';

      function triggerSuccessUI() {
        if (btnSalin) {
          btnSalin.innerHTML = '<span>✓ Tersalin!</span>';
          clearTimeout(btnSalin._timer);
          btnSalin._timer = setTimeout(() => {
            btnSalin.innerHTML = origSalinText;
          }, 1500);
        }
        if (window.KovToast && typeof window.KovToast.success === 'function') {
          window.KovToast.success(successMsg || 'Berhasil disalin ke clipboard!', 'Tautan Disalin');
        }
      }

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(triggerSuccessUI).catch(() => fallbackClipboardCopy(text, triggerSuccessUI));
      } else {
        fallbackClipboardCopy(text, triggerSuccessUI);
      }
    }

    function fallbackClipboardCopy(text, onSuccess) {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.top = '-9999px';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        const success = document.execCommand('copy');
        document.body.removeChild(ta);
        if (success && onSuccess) onSuccess();
      } catch (e) {}
    }

    let activeFilter = 'all';

    function normalizeStatus(st) {
      if (!st) return 'Belum Diproses';
      const s = String(st).trim().toLowerCase();
      if (s === 'diterima' || s === 'lolos' || s === 'accepted') return 'Diterima';
      if (s === 'dipertimbangkan' || s === 'hold' || s === 'cadangan') return 'Dipertimbangkan';
      if (s === 'ditolak' || s === 'rejected' || s === 'gagal') return 'Ditolak';
      return 'Belum Diproses';
    }

    function setFilter(filterType, btnElem) {
      activeFilter = filterType;
      document.querySelectorAll('.kov-filter-pill-botanical').forEach(btn => {
        btn.classList.remove('active');
      });
      if (btnElem) {
        btnElem.classList.add('active');
      } else {
        const matchingBtn = document.querySelector(`.kov-filter-pill-botanical[data-filter="${filterType}"]`);
        if (matchingBtn) matchingBtn.classList.add('active');
      }
      applyFilterAndSort();
    }

    function filterByStatusCard(status) {
      setFilter(status, null);
    }

    function filterByDivisiQuick(divisi) {
      const select = document.getElementById('divisiSelect');
      if (select) {
        select.value = divisi;
        applyFilterAndSort();
      }
      document.querySelectorAll('.dd-folder-card').forEach(card => {
        card.classList.toggle('active', card.getAttribute('data-divisi') === divisi);
      });
    }

    function applyFilterAndSort() {
      const searchVal = (document.getElementById('searchInput') ? document.getElementById('searchInput').value : '').toLowerCase().trim();
      const sortVal = document.getElementById('sortSelect') ? document.getElementById('sortSelect').value : 'date-desc';
      const divisiVal = (document.getElementById('divisiSelect') ? document.getElementById('divisiSelect').value : 'all').toLowerCase();
      const tbody = document.getElementById('candidateTableBody');
      if (!tbody) return;

      const rows = Array.from(tbody.querySelectorAll('tr[data-id]'));
      let visibleCount = 0;

      rows.forEach(row => {
        const rowText = row.innerText.toLowerCase();
        const rawStatus = row.getAttribute('data-status') || '';
        const rowNormStatus = normalizeStatus(rawStatus);
        const rowDivisi = (row.getAttribute('data-divisi') || '').toLowerCase();
        const isDuplicate = row.getAttribute('data-duplicate') === 'true';

        let matchesSearch = searchVal === '' || rowText.includes(searchVal);
        let matchesFilter = true;

        if (activeFilter === 'duplicate') {
          matchesFilter = isDuplicate;
        } else if (activeFilter !== 'all') {
          matchesFilter = (rowNormStatus === normalizeStatus(activeFilter));
        }

        let matchesDivisi = (divisiVal === 'all' || rowDivisi.includes(divisiVal));
        let matchesDate = true;
        if (activeDateFilter) {
          const rowTs = parseInt(row.getAttribute('data-date')) || 0;
          if (rowTs) {
            const rd = new Date(rowTs);
            const rk = formatDateKey(rd);
            matchesDate = (rk === activeDateFilter);
          } else {
            matchesDate = false;
          }
        }

        if (matchesSearch && matchesFilter && matchesDivisi && matchesDate) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      const countEl = document.getElementById('candidateCount');
      if (countEl) countEl.innerText = visibleCount;

      let emptyRow = document.getElementById('filterEmptyRow');
      if (visibleCount === 0 && rows.length > 0) {
        if (!emptyRow) {
          emptyRow = document.createElement('tr');
          emptyRow.id = 'filterEmptyRow';
          emptyRow.innerHTML = `<td colspan="4" class="text-center py-4" style="color: var(--ink-muted); font-size: 12px;">Tidak ada data pelamar yang cocok dengan filter.</td>`;
          tbody.appendChild(emptyRow);
        } else {
          emptyRow.style.display = '';
        }
      } else if (emptyRow) {
        emptyRow.style.display = 'none';
      }

      rows.sort((a, b) => {
        const dateA = parseInt(a.getAttribute('data-date')) || 0;
        const dateB = parseInt(b.getAttribute('data-date')) || 0;
        const nameA = a.getAttribute('data-name') || '';
        const nameB = b.getAttribute('data-name') || '';
        const statusA = a.getAttribute('data-status') || '';
        const statusB = b.getAttribute('data-status') || '';
        if (sortVal === 'date-desc') return dateB - dateA;
        if (sortVal === 'date-asc') return dateA - dateB;
        if (sortVal === 'name-asc') return nameA.localeCompare(nameB);
        if (sortVal === 'name-desc') return nameB.localeCompare(nameA);
        if (sortVal === 'status-asc') return statusA.localeCompare(statusB);
        return 0;
      });
      rows.forEach(row => tbody.appendChild(row));
    }

    // Calendar & Memo Studio
    const today = new Date();
    let currentCalYear = 2026;
    let currentCalMonth = 9; // October
    let activeCalPeriod = 'month';
    let activeDateFilter = null;
    let currentWeekStart = getMondayOfWeek(new Date(2026, 9, 26));

    const monthNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];

    function getMondayOfWeek(d) {
      const date = new Date(d);
      const day = (date.getDay() + 6) % 7;
      date.setDate(date.getDate() - day);
      date.setHours(0, 0, 0, 0);
      return date;
    }

    function formatDateKey(d) {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function formatDisplayDate(dateKey) {
      if (!dateKey) return 'Semua';
      const parts = dateKey.split('-');
      if (parts.length !== 3) return dateKey;
      return `${parts[2]}/${parts[1]}/${parts[0]}`;
    }

    function getCandidateDateMap() {
      const counts = {};
      document.querySelectorAll('#candidateTableBody tr[data-date]').forEach(r => {
        const ts = parseInt(r.getAttribute('data-date')) || 0;
        if (ts) {
          const k = formatDateKey(new Date(ts));
          counts[k] = (counts[k] || 0) + 1;
        }
      });
      return counts;
    }

    function renderCalendar() {
      const calGrid = document.getElementById('calGrid');
      const headerEl = document.getElementById('calMonthDisplay');
      if (!calGrid) return;

      const candidateMap = getCandidateDateMap();

      if (headerEl) {
        headerEl.textContent = `${monthNames[currentCalMonth]} ${currentCalYear}`;
      }

      let html = `
        <div class="dd-cal-weekday">Sn</div>
        <div class="dd-cal-weekday">Sl</div>
        <div class="dd-cal-weekday">Rb</div>
        <div class="dd-cal-weekday">Km</div>
        <div class="dd-cal-weekday">Jm</div>
        <div class="dd-cal-weekday">Sb</div>
        <div class="dd-cal-weekday">Mg</div>
      `;

      const firstDayIdx = (new Date(currentCalYear, currentCalMonth, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(currentCalYear, currentCalMonth + 1, 0).getDate();
      const daysInPrevMonth = new Date(currentCalYear, currentCalMonth, 0).getDate();

      for (let i = firstDayIdx - 1; i >= 0; i--) {
        const dayNum = daysInPrevMonth - i;
        const prevDate = new Date(currentCalYear, currentCalMonth - 1, dayNum);
        const k = formatDateKey(prevDate);
        html += `<div class="dd-cal-day cal-day-btn muted" onclick="selectCalDate('${k}')"><span>${dayNum}</span></div>`;
      }

      for (let day = 1; day <= daysInMonth; day++) {
        const curDate = new Date(currentCalYear, currentCalMonth, day);
        const k = formatDateKey(curDate);
        const isActive = (k === activeDateFilter);
        const count = candidateMap[k] || 0;
        const hasMemo = (hrMemosState || []).some(m => m.tanggal === k);

        let classes = ['dd-cal-day', 'cal-day-btn'];
        if (isActive) classes.push('active');
        if (count > 0 || hasMemo) classes.push('has-event');

        let dot = (count > 0 || hasMemo)
          ? `<span class="cal-dot" style="background: ${isActive ? '#ffffff' : '#497a61'};"></span>`
          : '';
        html += `<div class="${classes.join(' ')}" onclick="selectCalDate('${k}')"><span>${day}</span>${dot}</div>`;
      }

      calGrid.innerHTML = html;
    }

    function selectCalDate(dateKey) {
      if (activeDateFilter === dateKey) {
        activeDateFilter = null;
      } else {
        activeDateFilter = dateKey;
        const parts = dateKey.split('-');
        if (parts.length === 3) {
          currentCalYear = parseInt(parts[0], 10);
          currentCalMonth = parseInt(parts[1], 10) - 1;
        }
        onCalendarDateClickForMemo(dateKey);
      }
      updateDateFilterUI();
      renderCalendar();
      renderHrMemoList();
      applyFilterAndSort();
    }

    function clearCalDateFilter() {
      activeDateFilter = null;
      updateDateFilterUI();
      renderCalendar();
      renderHrMemoList();
      applyFilterAndSort();
    }

    function updateDateFilterUI() {
      const chipWrap = document.getElementById('activeDateBadgeWrap');
      const chipText = document.getElementById('activeDateBadgeText');
      const dateLabel = document.getElementById('memoActiveDateLabel');

      if (activeDateFilter) {
        const label = formatDisplayDate(activeDateFilter);
        if (chipWrap && chipText) {
          chipText.textContent = label;
          chipWrap.classList.remove('d-none');
        }
        if (dateLabel) dateLabel.textContent = label;
      } else {
        if (chipWrap) chipWrap.classList.add('d-none');
        if (dateLabel) dateLabel.textContent = '24/10/2026';
      }
    }

    function switchCalPeriod(period, btn) {
      activeCalPeriod = period;
      document.querySelectorAll('.dd-period-btn').forEach(b => b.classList.remove('active'));
      const targetBtn = btn || document.getElementById(`calTab${period.charAt(0).toUpperCase() + period.slice(1)}`);
      if (targetBtn) targetBtn.classList.add('active');
      renderCalendar();
    }

    function prevCalPeriod() {
      currentCalMonth--;
      if (currentCalMonth < 0) { currentCalMonth = 11; currentCalYear--; }
      renderCalendar();
    }

    function nextCalPeriod() {
      currentCalMonth++;
      if (currentCalMonth > 11) { currentCalMonth = 0; currentCalYear++; }
      renderCalendar();
    }

    window.generateRandomShareLink = generateRandomShareLink;
    window.generateAndCopyShareLink = generateAndCopyShareLink;
    window.setFilter = setFilter;
    window.filterByStatusCard = filterByStatusCard;
    window.filterByDivisiQuick = filterByDivisiQuick;
    window.applyFilterAndSort = applyFilterAndSort;
    window.switchCalPeriod = switchCalPeriod;
    window.prevCalPeriod = prevCalPeriod;
    window.nextCalPeriod = nextCalPeriod;
    window.selectCalDate = selectCalDate;
    window.clearCalDateFilter = clearCalDateFilter;
    window.renderCalendar = renderCalendar;

    // Memo Studio State (Connected to SQLite /api/hr/memos + LocalStorage Sync)
    const DEFAULT_HR_MEMOS = [
      { id: 901, tanggal: '2026-10-24', waktu: '10:00', kategori: 'Interview', judul: 'Interview Barista — Budi Santoso', catatan: '', selesai: 0 },
      { id: 902, tanggal: '2026-10-24', waktu: '14:00', kategori: 'Interview', judul: 'Verifikasi NIK & Referensi Siti Rahma', catatan: '', selesai: 0 },
      { id: 903, tanggal: '2026-10-26', waktu: '09:30', kategori: 'Onboarding', judul: 'Tanda tangan PKWT karyawan baru', catatan: '', selesai: 0 }
    ];

    let hrMemosState = [];

    function loadHrMemos() {
      try {
        const raw = localStorage.getItem('kov_hr_memos_v11');
        hrMemosState = raw ? JSON.parse(raw) : DEFAULT_HR_MEMOS.slice();
      } catch (e) {
        hrMemosState = DEFAULT_HR_MEMOS.slice();
      }
      renderHrMemoList();

      if (typeof fetch === 'function') {
        fetch('/api/hr/memos', { headers: { 'Accept': 'application/json' } })
          .then(r => r.ok ? r.json() : null)
          .then(data => {
            if (data && data.ok && Array.isArray(data.memos) && data.memos.length > 0) {
              hrMemosState = data.memos;
              saveHrMemosLocal();
              renderHrMemoList();
              renderCalendar();
            }
          })
          .catch(() => {});
      }
    }

    function saveHrMemosLocal() {
      try {
        localStorage.setItem('kov_hr_memos_v11', JSON.stringify(hrMemosState));
      } catch (e) {}
    }

    function renderHrMemoList() {
      const container = document.getElementById('hrMemoListContainer');
      if (!container) return;

      const filtered = activeDateFilter
        ? hrMemosState.filter(m => m.tanggal === activeDateFilter)
        : hrMemosState;

      if (filtered.length === 0) {
        container.innerHTML = `<div class="text-center py-2" style="font-size: 11px; color: var(--ink-muted);">Tidak ada agenda di tanggal ini.</div>`;
        return;
      }

      container.innerHTML = filtered.map(m => `
        <div class="p-2.5 rounded-3 d-flex align-items-start justify-content-between gap-2 ${m.selesai ? 'opacity-50' : ''}" style="background: var(--bg-paper); border: 1px solid var(--border-organic); padding: 9px 11px;">
          <label class="d-flex align-items-start gap-2 flex-grow-1 min-w-0 m-0" style="cursor: pointer;">
            <input type="checkbox" class="mt-1 flex-shrink-0" style="accent-color: #497a61; cursor: pointer;" ${m.selesai ? 'checked' : ''} onchange="toggleHrMemoDone(${m.id})">
            <div class="min-w-0 flex-grow-1">
              <div class="fw-bold ${m.selesai ? 'text-decoration-line-through' : ''}" style="font-size: 11.5px; color: var(--ink-deep); line-height: 1.3;">${m.judul}</div>
              <div class="font-mono-num mt-0.5" style="font-size: 10px; color: var(--ink-muted);">${formatDisplayDate(m.tanggal)} &bull; ${m.waktu || '10:00'} &bull; ${m.kategori}</div>
            </div>
          </label>
          <button type="button" class="border-0 bg-transparent p-0 px-1" style="color: var(--ink-muted); font-size: 12px;" onclick="deleteHrMemo(${m.id})" title="Hapus">&times;</button>
        </div>
      `).join('');
    }

    function submitHrMemo(e) {
      if (e) e.preventDefault();
      const titleInput = document.getElementById('hrMemoTitleInput');
      const dateInput = document.getElementById('hrMemoDateInput');
      const timeInput = document.getElementById('hrMemoTimeInput');
      const catInput = document.getElementById('hrMemoCatInput');

      const judul = titleInput ? titleInput.value.trim() : '';
      if (!judul) {
        if (window.KovToast && typeof window.KovToast.triggerError === 'function') {
          window.KovToast.triggerError(titleInput, 'Isi memo wajib ditulis dulu!', 'Belum Lengkap');
        }
        return;
      }

      const payload = {
        tanggal: (dateInput && dateInput.value) ? dateInput.value : '2026-10-24',
        waktu: (timeInput && timeInput.value) ? timeInput.value : '10:00',
        kategori: (catInput && catInput.value) ? catInput.value : 'Interview',
        judul: judul,
        catatan: '',
        _csrf: KOV_CSRF_TOKEN
      };

      const optimisticMemo = { id: Date.now(), ...payload, selesai: 0 };
      hrMemosState.unshift(optimisticMemo);
      saveHrMemosLocal();
      if (titleInput) titleInput.value = '';
      renderHrMemoList();
      renderCalendar();

      if (typeof fetch === 'function') {
        fetch('/api/hr/memos', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': KOV_CSRF_TOKEN },
          body: JSON.stringify(payload)
        })
          .then(r => r.ok ? r.json() : null)
          .then(data => {
            if (data && data.ok && data.memo) {
              optimisticMemo.id = data.memo.id;
              saveHrMemosLocal();
              renderHrMemoList();
            }
          })
          .catch(() => {});
      }

      if (window.KovToast && typeof window.KovToast.success === 'function') {
        window.KovToast.success(`Agenda "${payload.judul}" disimpan ke kalender.`, 'Memo Tersimpan');
      }
    }

    function toggleHrMemoDone(id) {
      const item = hrMemosState.find(m => m.id === id);
      if (!item) return;
      item.selesai = item.selesai ? 0 : 1;
      saveHrMemosLocal();
      renderHrMemoList();

      if (typeof fetch === 'function') {
        fetch('/api/hr/memos/' + id + '/toggle', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': KOV_CSRF_TOKEN },
          body: JSON.stringify({ _csrf: KOV_CSRF_TOKEN })
        }).catch(() => {});
      }
    }

    function deleteHrMemo(id) {
      hrMemosState = hrMemosState.filter(m => m.id !== id);
      saveHrMemosLocal();
      renderHrMemoList();
      renderCalendar();

      if (typeof fetch === 'function') {
        fetch('/api/hr/memos/' + id, {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json', 'x-csrf-token': KOV_CSRF_TOKEN },
          body: JSON.stringify({ _csrf: KOV_CSRF_TOKEN })
        }).catch(() => {});
      }
    }

    function onCalendarDateClickForMemo(dateKey) {
      const dateInput = document.getElementById('hrMemoDateInput');
      const titleInput = document.getElementById('hrMemoTitleInput');
      const dateLabel = document.getElementById('memoActiveDateLabel');
      if (dateKey) {
        if (dateInput) dateInput.value = dateKey;
        if (dateLabel) dateLabel.textContent = formatDisplayDate(dateKey);
        if (titleInput) setTimeout(() => titleInput.focus(), 60);
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadHrMemos();
      renderCalendar();
      applyFilterAndSort();
    });
  </script>
  <script src="/idle-timer.js"></script>
</body>
</html>
