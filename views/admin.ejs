<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Rekrutmen HR - KOV Portal</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/figma-ui.css" rel="stylesheet">
  <!-- Toast & Theme Global Utilities in Head for Immediate Availability -->
  <script src="/assets/js/kov-toast.js"></script>
  <script src="/assets/js/kov-theme.js"></script>
  <style>
    /* Custom page-level enhancements */
    .filter-pill {
      font-size: 0.8rem;
      font-weight: 600;
      padding: 0.4rem 0.85rem;
      border-radius: var(--kov-radius-pill);
      border: 1px solid var(--kov-slate-200);
      background: #ffffff;
      color: var(--kov-slate-600);
      transition: var(--kov-transition);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
    }

    .filter-pill:hover {
      background: var(--kov-slate-100);
      color: var(--kov-slate-900);
      border-color: var(--kov-slate-300);
    }

    .filter-pill.active {
      background: var(--kov-slate-900);
      color: #ffffff;
      border-color: var(--kov-slate-900);
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.2);
    }

    .sortable-header {
      cursor: pointer;
      user-select: none;
      transition: var(--kov-transition);
    }

    .sortable-header:hover {
      background-color: var(--kov-slate-100);
      color: var(--kov-slate-900);
    }

    /* Table row transitions */
    #candidateTableBody tr {
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    /* Topbar Dropdown Polish */
    .kov-notif-dropdown-menu {
      min-width: 320px;
      max-width: 360px;
      border-radius: 14px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
      border: 1px solid #e2e8f0;
      overflow: hidden;
      margin-top: 8px !important;
    }

    [data-theme="dark"] .kov-notif-dropdown-menu {
      background: #0f172a;
      border-color: #1e293b;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    }

    [data-theme="dark"] .kov-notif-dropdown-menu .bg-light {
      background: #1e293b !important;
      color: #f1f5f9 !important;
    }

    .kov-user-dropdown-menu {
      min-width: 230px;
      border-radius: 14px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.16);
      border: 1px solid #e2e8f0;
      margin-top: 8px !important;
    }

    [data-theme="dark"] .kov-user-dropdown-menu {
      background: #0f172a;
      border-color: #1e293b;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    }

    [data-theme="dark"] .kov-user-dropdown-menu .dropdown-item {
      color: #cbd5e1;
    }

    [data-theme="dark"] .kov-user-dropdown-menu .dropdown-item:hover {
      background: #1e293b;
      color: #ffffff;
    }
  </style>
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'hr', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Botanical Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Dashboard Rekrutmen HR</h1>
            <span class="d-none d-md-inline" style="font-size: 12px; color: var(--kov-botanical-text-muted, #5e8377); margin-left: 8px;">Kelola proses rekrutmen dengan lebih mudah dan terorganisir</span>
          </div>
        </div>

        <div class="kov-topbar-right d-flex align-items-center gap-2">
          <% 
            const pendingCandidateCount = (candidates || []).filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses').length;
            const duplicateCount = (candidates || []).filter(c => c.is_duplicate).length;
          %>

          <!-- Notification Bell Dropdown -->
          <div class="dropdown">
            <button type="button" class="kov-topbar-bell-btn position-relative" id="notifDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Pusat Notifikasi Rekrutmen" aria-label="Pusat Notifikasi">
              <i class="far fa-bell"></i>
              <% if (pendingCandidateCount > 0 || duplicateCount > 0) { %>
                <span class="kov-topbar-bell-dot"></span>
              <% } %>
            </button>
            <div class="dropdown-menu dropdown-menu-end kov-notif-dropdown-menu p-0" aria-labelledby="notifDropdownBtn">
              <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between">
                <span class="fw-bold small text-dark"><i class="fas fa-bell me-1.5 text-success"></i> Notifikasi Rekrutmen</span>
                <span class="badge bg-success bg-opacity-25 text-success border border-success" style="font-size: 0.7rem;"><%= pendingCandidateCount %> Perlu Tindakan</span>
              </div>
              <div class="p-2" style="max-height: 280px; overflow-y: auto;">
                <% if (pendingCandidateCount > 0) { %>
                  <a href="javascript:void(0)" onclick="filterByStatusCard('Belum Diproses')" class="dropdown-item d-flex align-items-start gap-2.5 p-2 rounded-2">
                    <div class="rounded-circle bg-warning bg-opacity-25 text-warning d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.85rem;">
                      <i class="fas fa-clock text-warning"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                      <div class="fw-bold small leading-tight"><%= pendingCandidateCount %> Berkas Perlu Review</div>
                      <div class="text-muted" style="font-size: 0.72rem;">Klik untuk menyaring daftar pelamar belum diproses.</div>
                    </div>
                  </a>
                <% } else { %>
                  <div class="text-center py-3 text-muted small">
                    <i class="fas fa-circle-check text-success fa-2x mb-2 d-block"></i>
                    Seluruh berkas pelamar telah diproses
                  </div>
                <% } %>

                <% if (duplicateCount > 0) { %>
                  <a href="javascript:void(0)" onclick="filterByStatusCard('duplicate')" class="dropdown-item d-flex align-items-start gap-2.5 p-2 rounded-2 mt-1">
                    <div class="rounded-circle bg-danger bg-opacity-25 text-danger d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.85rem;">
                      <i class="fas fa-triangle-exclamation text-danger"></i>
                    </div>
                    <div class="flex-grow-1 min-w-0">
                      <div class="fw-bold small leading-tight"><%= duplicateCount %> Berkas Terindikasi Duplikat</div>
                      <div class="text-muted" style="font-size: 0.72rem;">Klik untuk menyaring pelamar terdeteksi ganda.</div>
                    </div>
                  </a>
                <% } %>
              </div>
              <div class="p-2 bg-light border-top text-center">
                <a href="javascript:void(0)" onclick="filterByStatusCard('all')" class="btn btn-sm btn-link text-success text-decoration-none fw-semibold p-0" style="font-size: 0.75rem;">
                  Tampilkan Semua Pelamar (<%= candidates.length %>)
                </a>
              </div>
            </div>
          </div>

          <!-- Real-Time Date & Time Widget -->
          <div class="kov-topbar-clock d-none d-sm-inline-flex">
            <i class="far fa-calendar-days text-success fs-6"></i>
            <div class="d-flex flex-column text-start" style="line-height: 1.15;">
              <span id="kovLiveDate" style="font-weight: 700; font-size: 0.78rem;">25 Okt 2026</span>
              <span id="kovLiveTime" style="font-size: 0.68rem; color: #5e8377;">00:20 WIB</span>
            </div>
          </div>

          <!-- Interactive User Profile Dropdown -->
          <div class="dropdown">
            <button type="button" class="kov-topbar-user-pill border-0 bg-transparent p-0" id="userMenuDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Menu Pengguna" style="cursor: pointer;">
              <div class="kov-avatar-monogram" style="width: 32px; height: 32px; font-size: 0.85rem;">
                <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
              </div>
              <div class="d-none d-md-flex flex-column text-start" style="line-height: 1.15;">
                <span style="font-size: 0.78rem; font-weight: 700; color: #072b22;">
                  <%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'Administrator HR' %>
                </span>
                <span style="font-size: 0.68rem; color: #5e8377;">
                  <%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Superadmin' %>
                </span>
              </div>
              <i class="fas fa-chevron-down ms-1 text-muted" style="font-size: 0.65rem;"></i>
            </button>
            <div class="dropdown-menu dropdown-menu-end kov-user-dropdown-menu p-2" aria-labelledby="userMenuDropdownBtn">
              <div class="px-3 py-2 border-bottom mb-1">
                <div class="fw-bold text-dark small"><%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'Administrator HR' %></div>
                <div class="text-muted" style="font-size: 0.72rem;"><%= (typeof user !== 'undefined' && user && user.username) ? '@' + user.username : '@admin' %> &bull; <span class="badge bg-success bg-opacity-25 text-success"><%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Superadmin' %></span></div>
              </div>
              <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                <a class="dropdown-item rounded-2 py-1.5 small" href="/admin/users"><i class="fas fa-users-gear me-2 text-primary"></i> Kelola User &amp; Role</a>
              <% } %>
              <a class="dropdown-item rounded-2 py-1.5 small" href="javascript:void(0)" onclick="toggleKovTheme()"><i class="fas fa-moon me-2 text-warning"></i> Ganti Tema (Gelap/Terang)</a>
              <div class="dropdown-divider my-1"></div>
              <a class="dropdown-item rounded-2 py-1.5 small text-danger fw-semibold" href="/admin/logout"><i class="fas fa-arrow-right-from-bracket me-2"></i> Keluar (Logout)</a>
            </div>
          </div>

          <!-- Theme Switcher Button -->
          <button type="button" class="kov-theme-toggle" onclick="toggleKovTheme()" title="Ganti Mode Gelap / Terang">
            <i class="fas fa-moon kov-theme-icon"></i>
          </button>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

        <!-- 6 KPI Metric Cards Grid -->
        <div class="kov-kpi-grid">
          <!-- 1. Total Pelamar -->
          <div class="kov-kpi-card active" data-kpi="all" onclick="filterByStatusCard('all')" title="Klik untuk filter: Semua Pelamar" role="button" tabindex="0">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-mint">
                <i class="fas fa-user-group"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #00a86b;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.length %></div>
              <div class="kov-kpi-title">Total Pelamar</div>
              <div class="kov-kpi-sub">Seluruh berkas pelamar</div>
            </div>
          </div>

          <!-- 2. Perlu Review -->
          <div class="kov-kpi-card" data-kpi="Belum Diproses" onclick="filterByStatusCard('Belum Diproses')" title="Klik untuk filter: Perlu Review" role="button" tabindex="0">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-blue">
                <i class="fas fa-file-lines"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #2563eb;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses').length %></div>
              <div class="kov-kpi-title">Perlu Review</div>
              <div class="kov-kpi-sub">Menunggu review HR/User</div>
            </div>
          </div>

          <!-- 3. Diterima -->
          <div class="kov-kpi-card" data-kpi="Diterima" onclick="filterByStatusCard('Diterima')" title="Klik untuk filter: Diterima" role="button" tabindex="0">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-emerald">
                <i class="fas fa-circle-check"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #059669;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.filter(c => c.kesimpulan_status === 'Diterima').length %></div>
              <div class="kov-kpi-title">Diterima</div>
              <div class="kov-kpi-sub">Lolos interview kerja</div>
            </div>
          </div>

          <!-- 4. Dipertimbangkan -->
          <div class="kov-kpi-card" data-kpi="Dipertimbangkan" onclick="filterByStatusCard('Dipertimbangkan')" title="Klik untuk filter: Dipertimbangkan" role="button" tabindex="0">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-amber">
                <i class="fas fa-hourglass-half"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #f59e0b;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.filter(c => c.kesimpulan_status === 'Dipertimbangkan').length %></div>
              <div class="kov-kpi-title">Dipertimbangkan</div>
              <div class="kov-kpi-sub">Kandidat hold / cadangan</div>
            </div>
          </div>

          <!-- 5. Ditolak -->
          <div class="kov-kpi-card" data-kpi="Ditolak" onclick="filterByStatusCard('Ditolak')" title="Klik untuk filter: Ditolak" role="button" tabindex="0">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-rose">
                <i class="fas fa-circle-xmark"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #ef4444;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.filter(c => c.kesimpulan_status === 'Ditolak').length %></div>
              <div class="kov-kpi-title">Ditolak</div>
              <div class="kov-kpi-sub">Belum memenuhi syarat</div>
            </div>
          </div>

          <!-- 6. Duplikat -->
          <div class="kov-kpi-card" data-kpi="duplicate" onclick="filterByStatusCard('duplicate')" title="Klik untuk filter: Duplikat" role="button" tabindex="0">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-orange">
                <i class="fas fa-triangle-exclamation"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #ea580c;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.filter(c => c.is_duplicate).length %></div>
              <div class="kov-kpi-title">Duplikat</div>
              <div class="kov-kpi-sub">Terdeteksi mengirim berkas &gt;1x</div>
            </div>
          </div>
        </div>

        <!-- "Link Formulir Kandidat" Share Banner -->
        <div class="kov-share-banner">
          <svg class="kov-share-watermark" viewBox="0 0 160 160" fill="currentColor">
            <path d="M80 10 C50 40, 30 90, 60 130 C80 155, 120 155, 140 120 C155 85, 130 35, 80 10 Z" />
            <path d="M120 40 C145 60, 155 100, 135 130 C120 100, 110 65, 120 40 Z" opacity="0.6"/>
          </svg>
          <div class="kov-share-left">
            <div class="kov-share-squircle" style="background: #00a86b; border-color: #00a86b; color: #ffffff;">
              <i class="fas fa-link"></i>
            </div>
            <div>
              <div class="kov-share-title">Link Formulir Kandidat</div>
              <div class="kov-share-subtitle d-flex align-items-center gap-2 mt-1 flex-wrap">
                <div class="kov-share-url-pill">
                  <span id="shareUrl" class="user-select-all font-monospace" style="transition: opacity 0.15s ease;"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/?ref=c-Sysujatg</span>
                  <button type="button" class="kov-url-copy-btn" id="btnIconCopy" onclick="generateAndCopyShareLink()" title="Salin URL ke Clipboard" aria-label="Salin URL">
                    <i class="far fa-copy" id="iconCopySmall"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
          <div class="kov-share-right d-flex align-items-center gap-2 flex-wrap">
            <a href="/api/export/excel" class="kov-btn-outline-pill text-decoration-none" title="Download Excel Seluruh Pelamar" aria-label="Export Seluruh Data Pelamar ke Excel">
              <i class="fas fa-file-excel me-1 text-success"></i> Export Excel
            </a>
            <button type="button" class="kov-btn-outline-pill" id="btnAcakToken" onclick="generateRandomShareLink(false)" title="Hasilkan token formulir baru">
              <i class="fas fa-shuffle me-1 text-success" id="iconAcak"></i> Acak Token Baru
            </button>
            <button type="button" class="kov-btn-mint-pill" id="btnSalinLink" onclick="generateAndCopyShareLink()" title="Salin tautan formulir pelamar">
              <i class="fas fa-link me-1" id="iconSalin"></i> Salin Link
            </button>
          </div>
        </div>

        <!-- "Daftar Pelamar Kerja" Table Card -->
        <div class="kov-table-card">
          <!-- Card Header & Filter Bar -->
          <div class="kov-table-header-box">
            <div class="kov-table-title-group">
              <div class="kov-table-squircle">
                <i class="fas fa-user-group"></i>
              </div>
              <div>
                <h2 class="kov-table-title">
                  <span>Daftar Pelamar Kerja</span>
                  <span class="kov-badge-count"><span id="candidateCount"><%= candidates.length %></span> Data</span>
                </h2>
                <div style="font-size: 0.78rem; color: #5e8377; margin-top: 3px;">
                  Gunakan filter status dan pencarian data untuk mempermudah seleksi HR.
                </div>
              </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
              <!-- Search Box -->
              <div class="kov-pill-search-wrap">
                <i class="fas fa-magnifying-glass"></i>
                <input type="text" class="kov-pill-search" id="searchInput" placeholder="Cari nama, NIK, Rekening..." aria-label="Cari nama pelamar, NIK, atau Rekening" onkeyup="applyFilterAndSort()">
              </div>

              <!-- Divisi Filter -->
              <div class="kov-select-wrap">
                <i class="fas fa-layer-group kov-select-icon"></i>
                <select class="kov-pill-select" id="divisiSelect" aria-label="Filter berdasarkan Divisi" onchange="applyFilterAndSort()">
                  <option value="all" selected>Semua Divisi</option>
                  <option value="kitchen">Kitchen</option>
                  <option value="barista">Barista</option>
                  <option value="operasional">Operasional</option>
                  <option value="hr">HR</option>
                  <option value="teknisi">Teknisi</option>
                  <option value="fat">FAT (Finance)</option>
                  <option value="it">IT</option>
                </select>
                <i class="fas fa-chevron-down kov-select-chevron"></i>
              </div>

              <!-- Sort Select -->
              <div class="kov-select-wrap">
                <i class="far fa-calendar-days kov-select-icon"></i>
                <select class="kov-pill-select" id="sortSelect" aria-label="Urutkan daftar pelamar" onchange="applyFilterAndSort()">
                  <option value="date-desc" selected>Tanggal (Terbaru)</option>
                  <option value="date-asc">Tanggal (Terlama)</option>
                  <option value="name-asc">Nama Pelamar (A-Z)</option>
                  <option value="name-desc">Nama Pelamar (Z-A)</option>
                  <option value="status-asc">Status Rekrutmen (A-Z)</option>
                  <option value="status-desc">Status Rekrutmen (Z-A)</option>
                </select>
                <i class="fas fa-chevron-down kov-select-chevron"></i>
              </div>
            </div>
          </div>

          <!-- Status Segmented Pills -->
          <div class="kov-status-filter-bar">
            <span class="small fw-bold text-dark me-1" style="font-size: 0.82rem;">Status:</span>

            <button type="button" class="kov-filter-pill-botanical active" data-filter="all" onclick="setFilter('all', this)">
              Semua (<%= candidates.length %>)
            </button>

            <button type="button" class="kov-filter-pill-botanical" data-filter="Belum Diproses" onclick="setFilter('Belum Diproses', this)">
              <i class="far fa-circle-dot" style="color: #3b82f6;"></i> Belum Diproses (<%= candidates.filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses').length %>)
            </button>

            <button type="button" class="kov-filter-pill-botanical" data-filter="Diterima" onclick="setFilter('Diterima', this)">
              <i class="fas fa-circle-check" style="color: #10b981;"></i> Diterima (<%= candidates.filter(c => c.kesimpulan_status === 'Diterima').length %>)
            </button>

            <button type="button" class="kov-filter-pill-botanical" data-filter="Dipertimbangkan" onclick="setFilter('Dipertimbangkan', this)">
              <i class="fas fa-circle-exclamation" style="color: #f59e0b;"></i> Dipertimbangkan (<%= candidates.filter(c => c.kesimpulan_status === 'Dipertimbangkan').length %>)
            </button>

            <button type="button" class="kov-filter-pill-botanical" data-filter="Ditolak" onclick="setFilter('Ditolak', this)">
              <i class="fas fa-circle-xmark" style="color: #ef4444;"></i> Ditolak (<%= candidates.filter(c => c.kesimpulan_status === 'Ditolak').length %>)
            </button>

            <button type="button" class="kov-filter-pill-botanical warning-pill ms-auto" data-filter="duplicate" onclick="setFilter('duplicate', this)">
              <i class="far fa-clone" style="color: #ea580c;"></i> Duplikat (<%= candidates.filter(c => c.is_duplicate).length %>)
            </button>
          </div>

          <!-- Modern Table Content -->
          <div class="kov-botanical-table-wrap">
            <table class="kov-botanical-table" id="candidateTable">
              <thead>
                <tr>
                  <th style="width: 50px;">ID</th>
                  <th class="sortable-header" role="button" tabindex="0" aria-sort="none" onclick="toggleSort('date')" onkeydown="if(event.key==='Enter'||event.key===' ') { toggleSort('date'); event.preventDefault(); }" style="min-width: 120px; cursor: pointer;">
                    TANGGAL SUBMIT <i class="fas fa-sort ms-1 opacity-50" id="sortIconDate"></i>
                  </th>
                  <th class="sortable-header" role="button" tabindex="0" aria-sort="none" onclick="toggleSort('name')" onkeydown="if(event.key==='Enter'||event.key===' ') { toggleSort('name'); event.preventDefault(); }" style="min-width: 200px; cursor: pointer;">
                    NAMA &amp; IDENTITAS <i class="fas fa-sort ms-1 opacity-50" id="sortIconName"></i>
                  </th>
                  <th style="min-width: 130px;">POSISI DILAMAR</th>
                  <th style="min-width: 140px;">KONTAK</th>
                  <th class="sortable-header" role="button" tabindex="0" aria-sort="none" onclick="toggleSort('status')" onkeydown="if(event.key==='Enter'||event.key===' ') { toggleSort('status'); event.preventDefault(); }" style="min-width: 130px; cursor: pointer;">
                    STATUS SELEKSI <i class="fas fa-sort ms-1 opacity-50" id="sortIconStatus"></i>
                  </th>
                  <th style="min-width: 90px;">INDIKATOR</th>
                  <th class="text-center" style="min-width: 110px;">AKSI</th>
                </tr>
              </thead>
              <tbody id="candidateTableBody">
                <% if (candidates.length === 0) { %>
                  <tr id="noDataRow">
                    <td colspan="8" class="text-center py-5 text-muted">
                      <div class="py-4">
                        <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                        <h6 class="fw-bold text-dark">Belum Ada Pelamar</h6>
                        <p class="small text-muted mb-0">Bagikan tautan form kepada kandidat untuk mulai menerima data.</p>
                      </div>
                    </td>
                  </tr>
                <% } %>
                <% candidates.forEach(c => { 
                  const cDiv = c.divisi || 'Operasional';
                  const dLow = cDiv.toLowerCase();
                  const rawStatus = (c.kesimpulan_status || 'Belum Diproses').trim();
                %>
                  <tr data-id="<%= c.id %>"
                      data-date="<%= c.created_at ? new Date(c.created_at).getTime() : 0 %>"
                      data-name="<%= (c.nama_lengkap || '').toLowerCase() %>"
                      data-status="<%= rawStatus %>"
                      data-divisi="<%= dLow %>"
                      data-duplicate="<%= c.is_duplicate ? 'true' : 'false' %>">
                    <td class="fw-bold text-muted">#<%= c.id %></td>
                    <td class="small fw-semibold text-secondary">
                      <i class="far fa-calendar text-muted me-1.5"></i><%= formatDate(c.created_at, true) %>
                    </td>
                    <td>
                      <div class="d-flex align-items-center gap-2.5">
                        <% if (c.foto_kandidat) { %>
                          <img src="<%= c.foto_kandidat %>" class="rounded-circle border flex-shrink-0" style="width: 38px; height: 38px; object-fit: cover;">
                        <% } else { %>
                          <div class="kov-avatar-monogram">
                            <%= c.nama_lengkap ? c.nama_lengkap.trim().charAt(0).toUpperCase() : 'P' %>
                          </div>
                        <% } %>
                        <div>
                          <div class="kov-candidate-name"><%= c.nama_lengkap %></div>
                          <div class="kov-candidate-sub">
                            <%= c.nama_panggilan ? '(' + c.nama_panggilan + ')' : '' %>
                            <% if (c.nomor_ktp) { %> <span class="ms-1 border-start ps-1">NIK: <%= c.nomor_ktp %></span> <% } %>
                            <% if (c.no_rekening) { %> <span class="ms-1 border-start ps-1">Rek: <%= c.no_rekening %></span> <% } %>
                          </div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <% if (dLow.includes('barista')) { %>
                        <span class="kov-divisi-pill" style="background: #f8fafc; border-color: #e2e8f0; color: #475569;">
                          <i class="fas fa-mug-hot me-1 text-muted"></i> Barista
                        </span>
                      <% } else if (dLow.includes('kitchen')) { %>
                        <span class="kov-divisi-pill" style="background: #fffbeb; border-color: #fde68a; color: #b45309;">
                          <i class="fas fa-utensils me-1"></i> Kitchen
                        </span>
                      <% } else if (dLow.includes('hr')) { %>
                        <span class="kov-divisi-pill" style="background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8;">
                          <i class="fas fa-user-tie me-1"></i> HR
                        </span>
                      <% } else if (dLow.includes('it')) { %>
                        <span class="kov-divisi-pill" style="background: #f1f5f9; border-color: #cbd5e1; color: #0f172a;">
                          <i class="fas fa-laptop me-1"></i> IT
                        </span>
                      <% } else if (dLow.includes('teknisi')) { %>
                        <span class="kov-divisi-pill" style="background: #ecfeff; border-color: #a5f3fc; color: #0e7490;">
                          <i class="fas fa-wrench me-1"></i> Teknisi
                        </span>
                      <% } else { %>
                        <span class="kov-divisi-pill" style="background: #e6f9f0; border-color: #c9eedc; color: #00a86b;">
                          <i class="fas fa-briefcase me-1"></i> <%= cDiv %>
                        </span>
                      <% } %>
                      <div class="fw-semibold text-dark small mt-1">
                        <%= c.posisi_dilamar %>
                      </div>
                    </td>
                    <td>
                      <div class="d-flex align-items-center gap-1.5 text-secondary" style="font-size: 0.78rem;">
                        <i class="fas fa-phone text-muted" style="width: 14px;"></i> <span><%= c.no_hp || '-' %></span>
                      </div>
                      <div class="d-flex align-items-center gap-1.5 text-secondary mt-0.5" style="font-size: 0.78rem;">
                        <i class="far fa-envelope text-muted" style="width: 14px;"></i> <span><%= c.email || '-' %></span>
                      </div>
                    </td>
                    <td>
                      <% 
                        const statusName = rawStatus;
                        let pillBg = '#eff6ff', pillColor = '#1d4ed8', pillBorder = '#dbeafe', dotBg = '#2563eb';
                        if (statusName === 'Diterima') {
                          pillBg = '#f0fdf4'; pillColor = '#15803d'; pillBorder = '#bbf7d0'; dotBg = '#16a34a';
                        } else if (statusName === 'Dipertimbangkan') {
                          pillBg = '#fffbeb'; pillColor = '#b45309'; pillBorder = '#fef3c7'; dotBg = '#d97706';
                        } else if (statusName === 'Ditolak') {
                          pillBg = '#fef2f2'; pillColor = '#b91c1c'; pillBorder = '#fecaca'; dotBg = '#dc2626';
                        }
                      %>
                      <span class="status-pill-modern" style="background: <%= pillBg %>; color: <%= pillColor %>; border: 1px solid <%= pillBorder %>;">
                        <span class="status-dot-pulse" style="background: <%= dotBg %>;"></span>
                        <%= statusName %>
                      </span>
                    </td>
                    <td>
                      <% if (c.is_duplicate) { %>
                        <span class="badge bg-warning bg-opacity-25 text-warning-emphasis border border-warning px-2 py-1" title="Terdeteksi mengisi form <%= c.duplicate_count %>x">
                          <i class="fas fa-triangle-exclamation text-danger me-1"></i>Melamar <%= c.duplicate_count %>x
                        </span>
                      <% } else { %>
                        <span class="badge" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #475569; font-size: 0.72rem; font-weight: 600; padding: 3px 8px; border-radius: 6px;">
                          Unik
                        </span>
                      <% } %>
                      <% if (c.share_token) { %>
                        <div class="text-muted font-monospace" style="font-size: 0.7rem; margin-top: 3px;"><%= c.share_token %></div>
                      <% } %>
                      <% if (c.review_count && c.review_count > 0) { %>
                        <div class="mt-1">
                          <span class="badge bg-info-subtle text-info-emphasis border border-info px-2 py-1" style="font-size: 0.7rem;" title="Catatan Reviewer: <%= c.catatan_reviewer || '' %>">
                            <i class="fas fa-comments text-info me-1"></i><%= c.review_count %> Review
                          </span>
                        </div>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <div class="d-inline-flex gap-1.5 align-items-center">
                        <a href="/admin/candidate/<%= c.id %>" class="kov-action-review-btn" title="Review Berkas & Catatan Pewawancara">
                          <i class="fas fa-user-check me-1"></i> Review
                        </a>
                        <a href="/api/export/pdf/<%= c.id %>" target="_blank" rel="noopener noreferrer" class="kov-action-icon-circle text-danger" title="Export PDF Biodata" aria-label="Export PDF Biodata <%= c.nama_lengkap %>">
                          <i class="fas fa-file-pdf"></i>
                        </a>
                        <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                          <form action="/admin/candidate/delete/<%= c.id %>" method="POST" class="d-inline" onsubmit="return confirm('Apakah Anda yakin ingin menghapus berkas pelamar <%= c.nama_lengkap %> secara permanen?');">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="kov-action-icon-circle text-danger border-0 bg-transparent" title="Hapus Berkas Pelamar" aria-label="Hapus Berkas Pelamar <%= c.nama_lengkap %>">
                              <i class="fas fa-trash-can"></i>
                            </button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

        </div>

      </main>
    </div>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    function getAppBaseUrl() {
      if (window.location && window.location.origin && window.location.origin !== 'null') {
        return window.location.origin;
      }
      return 'https://internal.kovgroups.com';
    }

    function getRandomToken() {
      const chars = '23456789abcdefghjkmnpqrstuvwxyz';
      let result = '';
      for (let i = 0; i < 8; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return 'c-' + result;
    }

    function generateRandomShareLink(shouldCopy = true) {
      const token = getRandomToken();
      const url = getAppBaseUrl() + '/?ref=' + token;
      const shareEl = document.getElementById('shareUrl');
      if (shareEl) {
        shareEl.innerText = url;
        shareEl.classList.add('bg-warning', 'bg-opacity-25');
        setTimeout(() => shareEl.classList.remove('bg-warning', 'bg-opacity-25'), 300);
      }

      const btnAcak = document.getElementById('btnAcakToken');
      if (btnAcak) {
        if (!btnAcak.getAttribute('data-orig-content')) {
          btnAcak.setAttribute('data-orig-content', btnAcak.innerHTML);
        }
        const origContent = btnAcak.getAttribute('data-orig-content');
        btnAcak.innerHTML = '<i class="fas fa-check me-1 text-success"></i> Token Baru!';
        clearTimeout(btnAcak._timer);
        btnAcak._timer = setTimeout(() => {
          btnAcak.innerHTML = origContent;
        }, 900);
      }

      if (shouldCopy) {
        copyTextWithFeedback(url, 'Tautan formulir rekrutmen berhasil disalin ke clipboard:\n' + url);
      } else if (window.KovToast && typeof window.KovToast.info === 'function') {
        window.KovToast.info('Token baru aktif: ' + token, 'Token Diperbarui');
      }
      return url;
    }

    function generateAndCopyShareLink() {
      const shareEl = document.getElementById('shareUrl');
      const url = (shareEl && shareEl.innerText.trim() && !shareEl.innerText.includes('Sysujatg')) 
        ? shareEl.innerText.trim() 
        : (getAppBaseUrl() + '/?ref=' + getRandomToken());
      
      if (shareEl) shareEl.innerText = url;
      copyTextWithFeedback(url, 'Tautan formulir rekrutmen berhasil disalin:\n' + url);
    }

    function copyTextWithFeedback(text, successMsg) {
      const btnSalin = document.getElementById('btnSalinLink');
      const iconCopy = document.getElementById('iconCopySmall');
      if (btnSalin && !btnSalin.getAttribute('data-orig-html')) {
        btnSalin.setAttribute('data-orig-html', btnSalin.innerHTML);
      }
      const origSalinText = btnSalin ? btnSalin.getAttribute('data-orig-html') : '';

      function triggerSuccessUI() {
        if (btnSalin) {
          btnSalin.innerHTML = '<i class="fas fa-check me-1"></i> Tersalin!';
          btnSalin.style.background = '#047857';
          clearTimeout(btnSalin._timer);
          btnSalin._timer = setTimeout(() => {
            btnSalin.innerHTML = origSalinText;
            btnSalin.style.background = '';
          }, 1500);
        }
        if (iconCopy) {
          iconCopy.className = 'fas fa-check text-success';
          clearTimeout(iconCopy._timer);
          iconCopy._timer = setTimeout(() => {
            iconCopy.className = 'far fa-copy';
          }, 1500);
        }
        if (window.KovToast && typeof window.KovToast.success === 'function') {
          window.KovToast.success(successMsg || 'Berhasil disalin ke clipboard!', 'Tautan Disalin');
        }
      }

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(triggerSuccessUI).catch(() => fallbackClipboardCopy(text, triggerSuccessUI));
      } else {
        fallbackClipboardCopy(text, triggerSuccessUI);
      }
    }

    function fallbackClipboardCopy(text, onSuccess) {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.top = '-9999px';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        const success = document.execCommand('copy');
        document.body.removeChild(ta);
        if (success && onSuccess) onSuccess();
        else if (window.KovToast) window.KovToast.info('Tautan: ' + text, 'Salin Manual');
      } catch (e) {
        if (window.KovToast) window.KovToast.info('Tautan: ' + text, 'Salin Manual');
      }
    }

    // Real-Time Date & Time Clock
    function updateKovLiveClock() {
      const dateEl = document.getElementById('kovLiveDate');
      const timeEl = document.getElementById('kovLiveTime');
      try {
        const now = new Date();
        const dateStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Jakarta' });
        const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }).replace(/\./g, ':') + ' WIB';
        if (dateEl) dateEl.textContent = dateStr;
        if (timeEl) timeEl.textContent = timeStr;
      } catch (e) {
        if (dateEl) dateEl.textContent = '25 Okt 2026';
        if (timeEl) timeEl.textContent = '00:20 WIB';
      }
    }

    let activeFilter = 'all';

    function normalizeStatus(st) {
      if (!st) return 'Belum Diproses';
      const s = String(st).trim().toLowerCase();
      if (s === 'diterima' || s === 'lolos' || s === 'accepted') return 'Diterima';
      if (s === 'dipertimbangkan' || s === 'hold' || s === 'cadangan') return 'Dipertimbangkan';
      if (s === 'ditolak' || s === 'rejected' || s === 'gagal') return 'Ditolak';
      return 'Belum Diproses';
    }

    function setFilter(filterType, btnElem) {
      activeFilter = filterType;

      // Update segmented pills active state
      document.querySelectorAll('.kov-filter-pill-botanical').forEach(btn => {
        btn.classList.remove('active');
      });
      if (btnElem) {
        btnElem.classList.add('active');
      } else {
        const matchingBtn = document.querySelector(`.kov-filter-pill-botanical[data-filter="${filterType}"]`);
        if (matchingBtn) matchingBtn.classList.add('active');
      }

      // Synchronize KPI cards active state
      document.querySelectorAll('.kov-kpi-card').forEach(card => {
        card.classList.remove('active');
      });
      const matchingKpi = document.querySelector(`.kov-kpi-card[data-kpi="${filterType}"]`);
      if (matchingKpi) {
        matchingKpi.classList.add('active');
      }

      applyFilterAndSort();
    }

    function filterByStatusCard(status) {
      setFilter(status, null);
      const tableCard = document.querySelector('.kov-table-card');
      if (tableCard) {
        tableCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function toggleSort(type) {
      const select = document.getElementById('sortSelect');
      if (type === 'date') {
        select.value = select.value === 'date-desc' ? 'date-asc' : 'date-desc';
      } else if (type === 'name') {
        select.value = select.value === 'name-asc' ? 'name-desc' : 'name-asc';
      } else if (type === 'status') {
        select.value = select.value === 'status-asc' ? 'status-desc' : 'status-asc';
      }
      applyFilterAndSort();
    }

    function applyFilterAndSort() {
      const searchVal = (document.getElementById('searchInput') ? document.getElementById('searchInput').value : '').toLowerCase().trim();
      const sortVal = document.getElementById('sortSelect') ? document.getElementById('sortSelect').value : 'date-desc';
      const divisiVal = (document.getElementById('divisiSelect') ? document.getElementById('divisiSelect').value : 'all').toLowerCase();
      const tbody = document.getElementById('candidateTableBody');
      if (!tbody) return;

      const rows = Array.from(tbody.querySelectorAll('tr[data-id]'));
      let visibleCount = 0;

      rows.forEach(row => {
        const rowText = row.innerText.toLowerCase();
        const rawStatus = row.getAttribute('data-status') || '';
        const rowNormStatus = normalizeStatus(rawStatus);
        const rowDivisi = (row.getAttribute('data-divisi') || '').toLowerCase();
        const isDuplicate = row.getAttribute('data-duplicate') === 'true';

        let matchesSearch = searchVal === '' || rowText.includes(searchVal);
        let matchesFilter = true;

        if (activeFilter === 'duplicate') {
          matchesFilter = isDuplicate;
        } else if (activeFilter !== 'all') {
          matchesFilter = (rowNormStatus === normalizeStatus(activeFilter));
        }

        let matchesDivisi = (divisiVal === 'all' || rowDivisi.includes(divisiVal));

        if (matchesSearch && matchesFilter && matchesDivisi) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      const countEl = document.getElementById('candidateCount');
      if (countEl) countEl.innerText = visibleCount;

      // Handle Empty State when filtered to 0
      let emptyRow = document.getElementById('filterEmptyRow');
      if (visibleCount === 0 && rows.length > 0) {
        if (!emptyRow) {
          emptyRow = document.createElement('tr');
          emptyRow.id = 'filterEmptyRow';
          emptyRow.innerHTML = `
            <td colspan="8" class="text-center py-5 text-muted">
              <div class="py-4">
                <i class="fas fa-filter-circle-xmark fa-3x mb-3 text-secondary opacity-50"></i>
                <h6 class="fw-bold text-dark">Tidak Ada Data Pelamar</h6>
                <p class="small text-muted mb-2">Tidak ditemukan berkas pelamar untuk kriteria filter "${activeFilter}".</p>
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 mt-1" onclick="setFilter('all', null)">
                  <i class="fas fa-rotate-left me-1"></i> Tampilkan Semua Pelamar
                </button>
              </div>
            </td>
          `;
          tbody.appendChild(emptyRow);
        } else {
          emptyRow.style.display = '';
        }
      } else {
        if (emptyRow) emptyRow.style.display = 'none';
      }

      // Sorting Logic
      rows.sort((a, b) => {
        const dateA = parseInt(a.getAttribute('data-date')) || 0;
        const dateB = parseInt(b.getAttribute('data-date')) || 0;
        const nameA = a.getAttribute('data-name') || '';
        const nameB = b.getAttribute('data-name') || '';
        const statusA = a.getAttribute('data-status') || '';
        const statusB = b.getAttribute('data-status') || '';

        if (sortVal === 'date-desc') {
          return dateB - dateA;
        } else if (sortVal === 'date-asc') {
          return dateA - dateB;
        } else if (sortVal === 'name-asc') {
          return nameA.localeCompare(nameB);
        } else if (sortVal === 'name-desc') {
          return nameB.localeCompare(nameA);
        } else if (sortVal === 'status-asc') {
          return statusA.localeCompare(statusB);
        } else if (sortVal === 'status-desc') {
          return statusB.localeCompare(statusA);
        }
        return 0;
      });

      rows.forEach(row => tbody.appendChild(row));
    }

    window.getRandomToken = getRandomToken;
    window.generateRandomShareLink = generateRandomShareLink;
    window.generateAndCopyShareLink = generateAndCopyShareLink;
    window.setFilter = setFilter;
    window.filterByStatusCard = filterByStatusCard;
    window.toggleSort = toggleSort;
    window.applyFilterAndSort = applyFilterAndSort;


    document.addEventListener('DOMContentLoaded', () => {
      updateKovLiveClock();
      setInterval(updateKovLiveClock, 30000);
      try {
        generateRandomShareLink(false);
      } catch (e) {
        console.warn('Initial token generation notice:', e);
      }

      // Explicit Event Listeners Binding (Bulletproof against CSP script-src-attr)
      document.querySelectorAll('.kov-kpi-card').forEach(card => {
        card.addEventListener('click', function() {
          const kpi = this.getAttribute('data-kpi');
          if (kpi) filterByStatusCard(kpi);
        });
        card.addEventListener('keydown', function(e) {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            const kpi = this.getAttribute('data-kpi');
            if (kpi) filterByStatusCard(kpi);
          }
        });
      });

      document.querySelectorAll('.kov-filter-pill-botanical').forEach(pill => {
        pill.addEventListener('click', function() {
          const filter = this.getAttribute('data-filter');
          if (filter) setFilter(filter, this);
        });
      });

      const btnAcak = document.getElementById('btnAcakToken');
      if (btnAcak) {
        btnAcak.addEventListener('click', function(e) {
          e.preventDefault();
          generateRandomShareLink(false);
        });
      }

      const btnSalin = document.getElementById('btnSalinLink');
      if (btnSalin) {
        btnSalin.addEventListener('click', function(e) {
          e.preventDefault();
          generateAndCopyShareLink();
        });
      }

      const btnIconCopy = document.getElementById('btnIconCopy');
      if (btnIconCopy) {
        btnIconCopy.addEventListener('click', function(e) {
          e.preventDefault();
          generateAndCopyShareLink();
        });
      }

      applyFilterAndSort();
    });
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
