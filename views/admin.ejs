          <div class="dd-task-time">
            <i class="far fa-clock me-1"></i> <%= pendingCandidateCount > 0 ? (pendingCandidateCount + ' Berkas Memerlukan Evaluasi') : 'Semua Berkas Terverifikasi' %>
          </div>
        </div>
      </div>

      <!-- Memo & Agenda HRD Studio -->
      <div class="kov-memo-studio-widget" id="hrMemoStudioWidget">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div>
            <h4 class="dd-section-title">Memo &amp; Agenda HRD</h4>
            <div class="text-muted" style="font-size: 10.5px;" id="memoActiveDateLabel">Semua Jadwal &amp; Catatan</div>
          </div>
          <button type="button" class="btn-kov-outline btn-sm" style="height: 24px; padding: 0 7px; font-size: 10.5px;" onclick="toggleMemoComposer()" id="btnToggleMemoComposer">
            <i class="fas fa-plus"></i> Isi
          </button>
        </div>

        <!-- Inline Memo Form -->
        <form id="hrMemoForm" class="d-none mb-2" onsubmit="submitHrMemo(event)" novalidate>
