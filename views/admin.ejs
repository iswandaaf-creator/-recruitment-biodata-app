<!DOCTYPE html>
<html lang="id">
<head>
  <!-- Security: Masking Address Bar agar direktori internal tidak terekspos -->
  <script>
    (function() {
      try {
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, document.title, '/');
        }
      } catch (e) {}
    })();
  </script>


  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Rekrutmen HR - KOV Portal</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --kov-emerald: #059669;
      --kov-emerald-dark: #065f46;
      --kov-emerald-light: #ecfdf5;
      --kov-slate-900: #0f172a;
      --kov-slate-800: #1e293b;
      --kov-slate-700: #334155;
      --kov-slate-600: #475569;
      --kov-slate-100: #f1f5f9;
      --kov-slate-50: #f8fafc;
      --kov-border: #e2e8f0;
    }

    * {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background-color: #f8fafc;
      color: #1e293b;
      min-height: 100vh;
    }

    /* Modern Navbar */
    .top-navbar {
      background: #0f172a;
      border-bottom: 1px solid #1e293b;
      padding: 0.75rem 1.5rem;
    }

    .nav-brand-title {
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #ffffff;
      font-size: 1.05rem;
    }

    .nav-tag {
      font-size: 0.7rem;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 9999px;
      background: rgba(16, 185, 129, 0.2);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }

    .nav-btn {
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* Bento Stat Metric Cards */
    .metric-card {
      background: #ffffff;
      border: 1px solid var(--kov-border);
      border-radius: 14px;
      padding: 1.25rem;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      position: relative;
      overflow: hidden;
    }

    .metric-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px -2px rgba(0, 0, 0, 0.06);
    }

    .metric-icon-wrap {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.15rem;
    }

    .metric-title {
      font-size: 0.8rem;
      font-weight: 600;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 0.25rem;
    }

    .metric-value {
      font-size: 1.75rem;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.2;
    }

    /* Share Link Widget Banner */
    .share-banner {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-left: 4px solid var(--kov-emerald);
      border-radius: 12px;
      padding: 1rem 1.25rem;
      box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }

    .share-token-box {
      background: #f1f5f9;
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 0.35rem 0.75rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.85rem;
      color: #0f172a;
      font-weight: 600;
    }

    /* Card Container */
    .main-table-card {
      background: #ffffff;
      border: 1px solid var(--kov-border);
      border-radius: 16px;
      box-shadow: 0 4px 20px -4px rgba(0, 0, 0, 0.04);
      overflow: hidden;
    }

    /* Filter Buttons */
    .filter-pill {
      font-size: 0.825rem;
      font-weight: 600;
      padding: 0.4rem 0.9rem;
      border-radius: 9999px;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      color: #475569;
      transition: all 0.15s ease;
      cursor: pointer;
    }

    .filter-pill:hover {
      background: #f1f5f9;
      color: #0f172a;
    }

    .filter-pill.active {
      background: #0f172a;
      color: #ffffff;
      border-color: #0f172a;
      box-shadow: 0 2px 8px rgba(15, 23, 42, 0.2);
    }

    .filter-pill.active-warning {
      background: #d97706 !important;
      color: #ffffff !important;
      border-color: #d97706 !important;
    }

    /* Modern Table Styling */
    .modern-table thead th {
      background-color: #f8fafc;
      color: #64748b;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-bottom: 1px solid #e2e8f0;
      padding: 0.95rem 1rem;
      vertical-align: middle;
    }

    .modern-table tbody td {
      padding: 1rem 1rem;
      border-bottom: 1px solid #f1f5f9;
      vertical-align: middle;
      font-size: 0.875rem;
    }

    .modern-table tbody tr:hover {
      background-color: #f8fafc;
    }

    .sortable-header {
      cursor: pointer;
      user-select: none;
      transition: background 0.15s ease;
    }

    .sortable-header:hover {
      background-color: #e2e8f0;
      color: #0f172a;
    }

    /* Status Badges */
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 9999px;
      font-size: 0.78rem;
      font-weight: 600;
      border: 1px solid transparent;
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }

    .status-Diterima {
      background: #ecfdf5;
      color: #065f46;
      border-color: #a7f3d0;
    }
    .status-Diterima .status-dot { background: #10b981; }

    .status-Dipertimbangkan {
      background: #fffbeb;
      color: #92400e;
      border-color: #fde68a;
    }
    .status-Dipertimbangkan .status-dot { background: #f59e0b; }

    .status-Ditolak {
      background: #fef2f2;
      color: #991b1b;
      border-color: #fecaca;
    }
    .status-Ditolak .status-dot { background: #ef4444; }

    .status-Belum {
      background: #f1f5f9;
      color: #475569;
      border-color: #cbd5e1;
    }
    .status-Belum .status-dot { background: #94a3b8; }

    /* Action Buttons */
    .btn-action {
      font-size: 0.8rem;
      font-weight: 600;
      padding: 0.35rem 0.7rem;
      border-radius: 6px;
      transition: all 0.15s ease;
    }
  </style>
</head>
<body>

  <!-- Top Navbar -->
  <header class="top-navbar">
    <div class="container-fluid d-flex flex-wrap align-items-center justify-content-between gap-3">
      
      <!-- Brand & Title -->
      <div class="d-flex align-items-center gap-3">
        <a href="/admin" class="d-flex align-items-center text-decoration-none">
          <div class="bg-white p-1 rounded-3 me-2 d-flex align-items-center justify-content-center" style="height: 38px; width: 38px;">
            <img src="/logo_kov_hijau.png" alt="KOV Logo" style="height: 28px; width: auto; object-fit: contain;">
          </div>
          <div>
            <div class="nav-brand-title d-flex align-items-center gap-2">
              HR Recruitment Portal
              <span class="nav-tag">HR Dashboard</span>
            </div>
            <div class="text-white-50" style="font-size: 0.75rem;">Sistem Manajemen & Rekrutmen Pelamar Kerja</div>
          </div>
        </a>
      </div>

      <!-- Quick Links & User Info -->
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="d-flex align-items-center text-white px-2 py-1 rounded bg-slate-800 me-2" style="background: rgba(255,255,255,0.08); font-size: 0.825rem;">
            <i class="fas fa-circle-user text-emerald-400 me-2" style="color: #34d399;"></i>
            <span class="fw-semibold"><%= user.nama || user.username %></span>
            <span class="text-white-50 ms-1">(<%= user.role %>)</span>
          </div>

          <% if (user.role === 'superadmin' || user.role === 'admin' || user.role === 'operasional') { %>
            <a href="/admin/operasional" class="btn btn-outline-light nav-btn">
              <i class="fas fa-boxes-stacked text-warning"></i> Operasional & PO
            </a>
          <% } %>

          <% if (user.role === 'superadmin' || user.role === 'admin' || user.role === 'it') { %>
            <a href="/admin/it" class="btn btn-outline-light nav-btn">
              <i class="fas fa-laptop-code text-info"></i> Rekap IT
            </a>
          <% } %>

          <% if (user.role === 'superadmin' || user.role === 'admin') { %>
            <a href="/admin/users" class="btn btn-warning nav-btn text-dark">
              <i class="fas fa-users-gear"></i> Kelola User
            </a>
          <% } %>
        <% } %>

        <a href="/api/export/excel" class="btn btn-success nav-btn" style="background-color: #059669; border-color: #059669;">
          <i class="fas fa-file-excel"></i> Export Excel
        </a>

        <a href="/admin/logout" onclick="sessionStorage.clear();" class="btn btn-outline-danger nav-btn text-white border-secondary">
          <i class="fas fa-arrow-right-from-bracket"></i> Logout
        </a>
      </div>

    </div>
  </header>

  <div class="container-fluid px-4 py-4">

    <!-- Bento Metric Cards (Statistik Ringkas) -->
    <div class="row g-3 mb-4">
      <!-- Total Pelamar -->
      <div class="col-6 col-md-4 col-xl-2">
        <div class="metric-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="metric-title">Total Pelamar</div>
              <div class="metric-value"><%= candidates.length %></div>
            </div>
            <div class="metric-icon-wrap" style="background: #eff6ff; color: #2563eb;">
              <i class="fas fa-users"></i>
            </div>
          </div>
          <div class="mt-2 text-muted" style="font-size: 0.75rem;">Seluruh berkas pelamar</div>
        </div>
      </div>

      <!-- Belum Diproses -->
      <div class="col-6 col-md-4 col-xl-2">
        <div class="metric-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="metric-title">Perlu Review</div>
              <div class="metric-value text-secondary">
                <%= candidates.filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses').length %>
              </div>
            </div>
            <div class="metric-icon-wrap" style="background: #f1f5f9; color: #64748b;">
              <i class="fas fa-inbox"></i>
            </div>
          </div>
          <div class="mt-2 text-muted" style="font-size: 0.75rem;">Menunggu keputusan</div>
        </div>
      </div>

      <!-- Diterima -->
      <div class="col-6 col-md-4 col-xl-2">
        <div class="metric-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="metric-title">Diterima</div>
              <div class="metric-value text-success" style="color: #059669 !important;">
                <%= candidates.filter(c => c.kesimpulan_status === 'Diterima').length %>
              </div>
            </div>
            <div class="metric-icon-wrap" style="background: #ecfdf5; color: #059669;">
              <i class="fas fa-circle-check"></i>
            </div>
          </div>
          <div class="mt-2 text-muted" style="font-size: 0.75rem;">Lolos seleksi interview</div>
        </div>
      </div>

      <!-- Dipertimbangkan -->
      <div class="col-6 col-md-4 col-xl-2">
        <div class="metric-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="metric-title">Dipertimbangkan</div>
              <div class="metric-value text-warning" style="color: #d97706 !important;">
                <%= candidates.filter(c => c.kesimpulan_status === 'Dipertimbangkan').length %>
              </div>
            </div>
            <div class="metric-icon-wrap" style="background: #fffbeb; color: #d97706;">
              <i class="fas fa-hourglass-half"></i>
            </div>
          </div>
          <div class="mt-2 text-muted" style="font-size: 0.75rem;">Kandidat cadangan / hold</div>
        </div>
      </div>

      <!-- Ditolak -->
      <div class="col-6 col-md-4 col-xl-2">
        <div class="metric-card">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="metric-title">Ditolak</div>
              <div class="metric-value text-danger" style="color: #dc2626 !important;">
                <%= candidates.filter(c => c.kesimpulan_status === 'Ditolak').length %>
              </div>
            </div>
            <div class="metric-icon-wrap" style="background: #fef2f2; color: #dc2626;">
              <i class="fas fa-circle-xmark"></i>
            </div>
          </div>
          <div class="mt-2 text-muted" style="font-size: 0.75rem;">Tidak memenuhi syarat</div>
        </div>
      </div>

      <!-- Pelamar Berulang -->
      <div class="col-6 col-md-4 col-xl-2">
        <div class="metric-card" style="border-color: #fed7aa;">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="metric-title text-warning" style="color: #b45309 !important;">Duplikat</div>
              <div class="metric-value text-warning" style="color: #b45309 !important;">
                <%= candidates.filter(c => c.is_duplicate).length %>
              </div>
            </div>
            <div class="metric-icon-wrap" style="background: #fff7ed; color: #ea580c;">
              <i class="fas fa-triangle-exclamation"></i>
            </div>
          </div>
          <div class="mt-2 text-muted" style="font-size: 0.75rem;">Terdeteksi kirim &gt;1x</div>
        </div>
      </div>
    </div>

    <!-- Modern Share Link Bar -->
    <div class="share-banner d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div class="d-flex align-items-center gap-3">
        <div class="metric-icon-wrap" style="background: #ecfdf5; color: #059669; width: 40px; height: 40px;">
          <i class="fas fa-share-nodes"></i>
        </div>
        <div>
          <div class="fw-bold text-dark" style="font-size: 0.9rem;">
            Link Formulir Kandidat (Anti-Spam Token Acak)
          </div>
          <div class="d-flex align-items-center gap-2 mt-1">
            <span id="shareUrl" class="share-token-box user-select-all"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/?ref=c-8f3a921d</span>
            <span class="badge bg-light text-secondary border">Siap Disebar</span>
          </div>
        </div>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary fw-semibold px-3" onclick="generateRandomShareLink(false)">
          <i class="fas fa-rotate me-1 text-primary"></i> Acak Token Baru
        </button>
        <button class="btn btn-sm btn-success fw-bold px-3" style="background-color: #059669; border-color: #059669;" onclick="generateAndCopyShareLink()">
          <i class="fas fa-copy me-1"></i> Salin Link
        </button>
      </div>
    </div>

    <!-- Candidate List Table Card -->
    <div class="main-table-card">
      
      <!-- Card Filter Header -->
      <div class="p-3 bg-white border-bottom">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
          <div>
            <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
              <span>Daftar Pelamar Kerja</span>
              <span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1" style="font-size: 0.8rem;">
                <span id="candidateCount"><%= candidates.length %></span> Data
              </span>
            </h5>
            <div class="text-muted" style="font-size: 0.825rem;">Gunakan filter status dan pencarian data untuk mempermudah seleksi HR.</div>
          </div>
          
          <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- Search Box -->
            <div class="input-group input-group-sm" style="width: 260px;">
              <span class="input-group-text bg-light border-end-0"><i class="fas fa-magnifying-glass text-muted"></i></span>
              <input type="text" class="form-control border-start-0" id="searchInput" placeholder="Cari nama, NIK, Rekening..." onkeyup="applyFilterAndSort()">
            </div>

            <!-- Sort Select -->
            <div class="input-group input-group-sm" style="width: 220px;">
              <span class="input-group-text bg-light"><i class="fas fa-arrow-down-short-wide text-muted"></i></span>
              <select class="form-select" id="sortSelect" onchange="applyFilterAndSort()">
                <option value="date-desc" selected>Tanggal (Terbaru)</option>
                <option value="date-asc">Tanggal (Terlama)</option>
                <option value="name-asc">Nama Pelamar (A-Z)</option>
                <option value="name-desc">Nama Pelamar (Z-A)</option>
                <option value="status-asc">Status Rekrutmen</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Filter Pills Segmented -->
        <div class="mt-3 d-flex flex-wrap gap-2 align-items-center pt-2 border-top">
          <span class="small fw-bold me-1 text-muted"><i class="fas fa-sliders me-1"></i>Status:</span>
          
          <button type="button" class="filter-pill active" data-filter="all" onclick="setFilter('all', this)">
            Semua (<%= candidates.length %>)
          </button>
          
          <button type="button" class="filter-pill" data-filter="Belum Diproses" onclick="setFilter('Belum Diproses', this)">
            Belum Diproses (<%= candidates.filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses').length %>)
          </button>
          
          <button type="button" class="filter-pill" data-filter="Diterima" onclick="setFilter('Diterima', this)">
            <i class="fas fa-circle-check text-success me-1"></i>Diterima (<%= candidates.filter(c => c.kesimpulan_status === 'Diterima').length %>)
          </button>
          
          <button type="button" class="filter-pill" data-filter="Dipertimbangkan" onclick="setFilter('Dipertimbangkan', this)">
            <i class="fas fa-hourglass text-warning me-1"></i>Dipertimbangkan (<%= candidates.filter(c => c.kesimpulan_status === 'Dipertimbangkan').length %>)
          </button>
          
          <button type="button" class="filter-pill" data-filter="Ditolak" onclick="setFilter('Ditolak', this)">
            <i class="fas fa-circle-xmark text-danger me-1"></i>Ditolak (<%= candidates.filter(c => c.kesimpulan_status === 'Ditolak').length %>)
          </button>
          
          <button type="button" class="filter-pill ms-auto" data-filter="duplicate" onclick="setFilter('duplicate', this)" style="border-color: #f59e0b; color: #b45309;">
            <i class="fas fa-triangle-exclamation text-danger me-1"></i>Duplikat Pelamar (<%= candidates.filter(c => c.is_duplicate).length %>)
          </button>
        </div>
      </div>

      <!-- Modern Table -->
      <div class="table-responsive">
        <table class="table modern-table mb-0" id="candidateTable">
          <thead>
            <tr>
              <th class="ps-4" style="width: 60px;">ID</th>
              <th class="sortable-header" onclick="toggleSort('date')" style="min-width: 140px;">
                Tanggal Submit <i class="fas fa-sort ms-1 text-muted" id="sortIconDate"></i>
              </th>
              <th class="sortable-header" onclick="toggleSort('name')" style="min-width: 250px;">
                Nama & Identitas <i class="fas fa-sort ms-1 text-muted" id="sortIconName"></i>
              </th>
              <th style="min-width: 160px;">Posisi Dilamar</th>
              <th style="min-width: 180px;">Kontak</th>
              <th class="sortable-header" onclick="toggleSort('status')" style="min-width: 160px;">
                Status Seleksi <i class="fas fa-sort ms-1 text-muted" id="sortIconStatus"></i>
              </th>
              <th style="min-width: 150px;">Indikator</th>
              <th class="text-center pe-4" style="min-width: 160px;">Aksi</th>
            </tr>
          </thead>
          <tbody id="candidateTableBody">
            <% if (candidates.length === 0) { %>
              <tr id="noDataRow">
                <td colspan="8" class="text-center py-5 text-muted">
                  <div class="py-4">
                    <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                    <h6 class="fw-bold text-dark">Belum Ada Pelamar</h6>
                    <p class="small text-muted mb-0">Bagikan tautan form kepada kandidat untuk mulai menerima data.</p>
                  </div>
                </td>
              </tr>
            <% } %>
            <% candidates.forEach(c => { %>
              <tr data-id="<%= c.id %>"
                  data-date="<%= new Date(c.created_at).getTime() %>"
                  data-name="<%= (c.nama_lengkap || '').toLowerCase() %>"
                  data-status="<%= c.kesimpulan_status || 'Belum Diproses' %>"
                  data-duplicate="<%= c.is_duplicate ? 'true' : 'false' %>">
                <td class="ps-4 fw-bold text-muted">#<%= c.id %></td>
                <td class="small text-secondary fw-semibold">
                  <%= formatDate(c.created_at, true) %>
                </td>
                <td>
                  <div class="d-flex align-items-center gap-2">
                    <% if (c.foto_kandidat) { %>
                      <img src="<%= c.foto_kandidat %>" class="rounded-circle border shadow-sm flex-shrink-0" style="width: 40px; height: 40px; object-fit: cover;">
                    <% } else { %>
                      <div class="rounded-circle d-flex align-items-center justify-content-center text-secondary fw-bold flex-shrink-0" style="width: 40px; height: 40px; font-size: 14px; background: #e2e8f0; color: #475569;">
                        <%= c.nama_lengkap ? c.nama_lengkap.charAt(0).toUpperCase() : 'P' %>
                      </div>
                    <% } %>
                    <div>
                      <div class="fw-bold text-dark"><%= c.nama_lengkap %></div>
                      <div class="text-muted" style="font-size: 0.76rem;">
                        <%= c.nama_panggilan ? '(' + c.nama_panggilan + ')' : '' %>
                        <% if (c.nomor_ktp) { %> <span class="ms-1 border-start ps-1">NIK: <%= c.nomor_ktp %></span> <% } %>
                        <% if (c.no_rekening) { %> <span class="ms-1 border-start ps-1">Rek: <%= c.no_rekening %></span> <% } %>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge bg-slate-100 text-dark border px-2 py-1" style="background-color: #f1f5f9; font-weight: 600;">
                    <%= c.posisi_dilamar %>
                  </span>
                </td>
                <td>
                  <div class="small fw-semibold text-dark"><i class="fas fa-envelope text-muted me-1"></i><%= c.email %></div>
                  <div class="text-muted" style="font-size: 0.78rem;"><i class="fas fa-phone text-muted me-1"></i><%= c.no_hp %></div>
                </td>
                <td>
                  <% 
                    const statusName = c.kesimpulan_status || 'Belum Diproses';
                    let statusClassKey = 'Belum';
                    if (statusName === 'Diterima') statusClassKey = 'Diterima';
                    else if (statusName === 'Dipertimbangkan') statusClassKey = 'Dipertimbangkan';
                    else if (statusName === 'Ditolak') statusClassKey = 'Ditolak';
                  %>
                  <span class="status-pill status-<%= statusClassKey %>">
                    <span class="status-dot"></span>
                    <%= statusName %>
                  </span>
                </td>
                <td>
                  <% if (c.is_duplicate) { %>
                    <span class="badge bg-warning bg-opacity-25 text-warning-emphasis border border-warning px-2 py-1" title="Terdeteksi mengisi form <%= c.duplicate_count %>x dengan <%= c.match_reason %> yang sama">
                      <i class="fas fa-triangle-exclamation text-danger me-1"></i>Melamar <%= c.duplicate_count %>x
                    </span>
                  <% } else { %>
                    <span class="badge bg-light text-secondary border px-2 py-1">
                      <i class="fas fa-shield-check text-success me-1"></i>Unik
                    </span>
                  <% } %>
                  <% if (c.share_token) { %>
                    <div class="mt-1"><span class="badge bg-light text-muted font-monospace border" style="font-size: 0.7rem;" title="Token Unik Link saat melamar"><%= c.share_token %></span></div>
                  <% } %>
                </td>
                <td class="text-center pe-4">
                  <div class="d-inline-flex gap-1">
                    <a href="/admin/candidate/<%= c.id %>" class="btn btn-sm btn-outline-primary btn-action" title="Edit Catatan Pewawancara / Detail">
                      <i class="fas fa-user-check me-1"></i>Review
                    </a>
                    <a href="/api/export/pdf/<%= c.id %>" target="_blank" class="btn btn-sm btn-outline-danger btn-action" title="Export 5-Page PDF">
                      <i class="fas fa-file-pdf"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const token = getRandomToken();
      const url = window.location.origin + '/?ref=' + token;
      document.getElementById('shareUrl').innerText = url;
    });

    function getRandomToken() {
      const chars = '23456789abcdefghjkmnpqrstuvwxyz';
      let result = '';
      for (let i = 0; i < 8; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return 'c-' + result;
    }

    function generateRandomShareLink(shouldCopy = true) {
      const token = getRandomToken();
      const url = window.location.origin + '/?ref=' + token;
      document.getElementById('shareUrl').innerText = url;

      if (shouldCopy) {
        navigator.clipboard.writeText(url).then(() => {
          alert('✅ Link Form Unik Baru Berhasil Disalin!\n\nURL: ' + url + '\n\nKandidat yang mengisi melalui tautan ini akan otomatis terlacak.');
        });
      }
      return url;
    }

    function generateAndCopyShareLink() {
      generateRandomShareLink(true);
    }

    let activeFilter = 'all';

    function setFilter(filterType, btnElem) {
      activeFilter = filterType;
      document.querySelectorAll('.filter-pill').forEach(btn => {
        btn.classList.remove('active', 'active-warning');
      });
      
      if (filterType === 'duplicate') {
        btnElem.classList.add('active-warning');
      } else {
        btnElem.classList.add('active');
      }
      applyFilterAndSort();
    }

    function toggleSort(type) {
      const select = document.getElementById('sortSelect');
      if (type === 'date') {
        select.value = select.value === 'date-desc' ? 'date-asc' : 'date-desc';
      } else if (type === 'name') {
        select.value = select.value === 'name-asc' ? 'name-desc' : 'name-asc';
      } else if (type === 'status') {
        select.value = select.value === 'status-asc' ? 'date-desc' : 'status-asc';
      }
      applyFilterAndSort();
    }

    function applyFilterAndSort() {
      const searchVal = document.getElementById('searchInput').value.toLowerCase();
      const sortVal = document.getElementById('sortSelect').value;
      const tbody = document.getElementById('candidateTableBody');
      const rows = Array.from(tbody.querySelectorAll('tr[data-id]'));

      let visibleCount = 0;

      rows.forEach(row => {
        const rowText = row.innerText.toLowerCase();
        const rowStatus = row.getAttribute('data-status');
        const isDuplicate = row.getAttribute('data-duplicate') === 'true';

        let matchesSearch = rowText.includes(searchVal);
        let matchesFilter = true;

        if (activeFilter === 'duplicate') {
          matchesFilter = isDuplicate;
        } else if (activeFilter !== 'all') {
          matchesFilter = (rowStatus === activeFilter);
        }

        if (matchesSearch && matchesFilter) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      document.getElementById('candidateCount').innerText = visibleCount;

      // Sorting Logic
      rows.sort((a, b) => {
        if (sortVal === 'date-desc') {
          return parseInt(b.getAttribute('data-date')) - parseInt(a.getAttribute('data-date'));
        } else if (sortVal === 'date-asc') {
          return parseInt(a.getAttribute('data-date')) - parseInt(b.getAttribute('data-date'));
        } else if (sortVal === 'name-asc') {
          return a.getAttribute('data-name').localeCompare(b.getAttribute('data-name'));
        } else if (sortVal === 'name-desc') {
          return b.getAttribute('data-name').localeCompare(a.getAttribute('data-name'));
        } else if (sortVal === 'status-asc') {
          return a.getAttribute('data-status').localeCompare(b.getAttribute('data-status'));
        }
        return 0;
      });

      rows.forEach(row => tbody.appendChild(row));
    }

    document.addEventListener('DOMContentLoaded', () => {
      generateRandomShareLink(false);
      applyFilterAndSort();
    });
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
