<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Rekrutmen HR - KOV Portal</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/figma-ui.css" rel="stylesheet">
  <style>
    /* Custom page-level enhancements */
    .filter-pill {
      font-size: 0.8rem;
      font-weight: 600;
      padding: 0.4rem 0.85rem;
      border-radius: var(--kov-radius-pill);
      border: 1px solid var(--kov-slate-200);
      background: #ffffff;
      color: var(--kov-slate-600);
      transition: var(--kov-transition);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
    }

    .filter-pill:hover {
      background: var(--kov-slate-100);
      color: var(--kov-slate-900);
      border-color: var(--kov-slate-300);
    }

    .filter-pill.active {
      background: var(--kov-slate-900);
      color: #ffffff;
      border-color: var(--kov-slate-900);
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.2);
    }

    .filter-pill.active-warning {
      background: var(--kov-amber) !important;
      color: #ffffff !important;
      border-color: var(--kov-amber) !important;
    }

    .sortable-header {
      cursor: pointer;
      user-select: none;
      transition: var(--kov-transition);
    }

    .sortable-header:hover {
      background-color: var(--kov-slate-100);
      color: var(--kov-slate-900);
    }

    .share-banner-modern {
      background: #ffffff;
      border: 1px solid var(--kov-border);
      border-left: 4px solid var(--kov-primary-500);
      border-radius: var(--kov-radius-lg);
      padding: 1rem 1.25rem;
      box-shadow: var(--kov-shadow-xs);
    }

    .share-token-box {
      background: var(--kov-slate-50);
      border: 1px solid var(--kov-slate-200);
      border-radius: var(--kov-radius-sm);
      padding: 0.35rem 0.75rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.85rem;
      color: var(--kov-slate-900);
      font-weight: 600;
    }
  </style>
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'hr', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Minimalist Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Dashboard Rekrutmen HR</h1>
          </div>
        </div>
        <div class="kov-topbar-right">
          <a href="/api/export/excel" class="btn-kov-primary btn-kov-sm">
            <i class="fas fa-file-excel"></i> <span class="d-none d-sm-inline">Export Excel</span>
          </a>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

    <!-- Bento Metric Cards (Statistik Cepat & Responsif) -->
    <div class="bento-grid">
      <!-- Total Pelamar -->
      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title">Total Pelamar</div>
          <div class="bento-metric-value"><%= candidates.length %></div>
          <div class="bento-metric-sub">Seluruh berkas pelamar</div>
        </div>
        <div class="coinbase-ring coinbase-ring-blue">
          <div class="coinbase-ring-inner">
            <i class="fas fa-users"></i>
          </div>
        </div>
      </div>

      <!-- Belum Diproses / Perlu Review -->
      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title">Perlu Review</div>
          <div class="bento-metric-value text-secondary">
            <%= candidates.filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses').length %>
          </div>
          <div class="bento-metric-sub">Menunggu review HR/User</div>
        </div>
        <div class="coinbase-ring" style="background: #f1f5f9; border-color: #e2e8f0;">
          <div class="coinbase-ring-inner text-secondary">
            <i class="fas fa-inbox"></i>
          </div>
        </div>
      </div>

      <!-- Diterima -->
      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title text-success">Diterima</div>
          <div class="bento-metric-value" style="color: var(--kov-primary-600);">
            <%= candidates.filter(c => c.kesimpulan_status === 'Diterima').length %>
          </div>
          <div class="bento-metric-sub">Lolos interview kerja</div>
        </div>
        <div class="coinbase-ring coinbase-ring-emerald">
          <div class="coinbase-ring-inner">
            <i class="fas fa-circle-check"></i>
          </div>
        </div>
      </div>

      <!-- Dipertimbangkan -->
      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title text-warning">Dipertimbangkan</div>
          <div class="bento-metric-value text-warning" style="color: var(--kov-amber) !important;">
            <%= candidates.filter(c => c.kesimpulan_status === 'Dipertimbangkan').length %>
          </div>
          <div class="bento-metric-sub">Kandidat hold / cadangan</div>
        </div>
        <div class="coinbase-ring coinbase-ring-amber">
          <div class="coinbase-ring-inner">
            <i class="fas fa-hourglass-half"></i>
          </div>
        </div>
      </div>

      <!-- Ditolak -->
      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title text-danger">Ditolak</div>
          <div class="bento-metric-value text-danger">
            <%= candidates.filter(c => c.kesimpulan_status === 'Ditolak').length %>
          </div>
          <div class="bento-metric-sub">Belum memenuhi syarat</div>
        </div>
        <div class="coinbase-ring coinbase-ring-rose">
          <div class="coinbase-ring-inner">
            <i class="fas fa-circle-xmark"></i>
          </div>
        </div>
      </div>

      <!-- Pelamar Duplikat -->
      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title" style="color: #ea580c;">Duplikat</div>
          <div class="bento-metric-value" style="color: #ea580c;">
            <%= candidates.filter(c => c.is_duplicate).length %>
          </div>
          <div class="bento-metric-sub">Terdeteksi mengirim berkas &gt;1x</div>
        </div>
        <div class="coinbase-ring" style="background: #fff7ed; border-color: #ffedd5;">
          <div class="coinbase-ring-inner" style="color: #ea580c;">
            <i class="fas fa-triangle-exclamation"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Modern Share Link Banner -->
    <div class="share-banner-modern d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div class="d-flex align-items-center gap-3">
        <div class="bento-icon-box bento-icon-emerald" style="width: 40px; height: 40px;">
          <i class="fas fa-share-nodes"></i>
        </div>
        <div>
          <div class="fw-bold text-dark" style="font-size: 0.925rem;">
            Link Formulir Kandidat
          </div>
          <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
            <span id="shareUrl" class="share-token-box user-select-all"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/?ref=c-8f3a921d</span>
          </div>
        </div>
      </div>
      <div class="d-flex gap-2">
        <button class="btn-kov-secondary btn-kov-sm" onclick="generateRandomShareLink(false)">
          <i class="fas fa-rotate text-primary"></i> Acak Token Baru
        </button>
        <button class="btn-kov-primary btn-kov-sm" onclick="generateAndCopyShareLink()">
          <i class="fas fa-copy"></i> Salin Link
        </button>
      </div>
    </div>

    <!-- Candidate Table Card -->
    <div class="kov-card">
      
      <!-- Card Filter Header -->
      <div class="kov-card-header">
        <div>
          <h5 class="kov-card-title">
            <span>Daftar Pelamar Kerja</span>
            <span class="badge bg-light text-secondary border px-2 py-1" style="font-size: 0.8rem;">
              <span id="candidateCount"><%= candidates.length %></span> Data
            </span>
          </h5>
          <div class="text-muted small mt-1">Gunakan filter status dan pencarian data untuk mempermudah seleksi HR.</div>
        </div>
        
        <div class="d-flex flex-wrap align-items-center gap-2 mobile-w-100">
          <!-- Search Box -->
          <div class="input-group input-group-sm" style="min-width: 220px;">
            <span class="input-group-text bg-light border-end-0"><i class="fas fa-magnifying-glass text-muted"></i></span>
            <input type="text" class="form-control border-start-0" id="searchInput" placeholder="Cari nama, NIK, Rekening..." onkeyup="applyFilterAndSort()">
          </div>

          <!-- Divisi Filter -->
          <div class="input-group input-group-sm" style="min-width: 170px;">
            <span class="input-group-text bg-light"><i class="fas fa-layer-group text-muted"></i></span>
            <select class="form-select" id="divisiSelect" onchange="applyFilterAndSort()">
              <option value="all" selected>Semua Divisi</option>
              <option value="kitchen">Kitchen</option>
              <option value="barista">Barista</option>
              <option value="operasional">Operasional</option>
              <option value="hr">HR</option>
              <option value="teknisi">Teknisi</option>
              <option value="fat">FAT (Finance)</option>
              <option value="it">IT</option>
            </select>
          </div>

          <!-- Sort Select -->
          <div class="input-group input-group-sm" style="min-width: 180px;">
            <span class="input-group-text bg-light"><i class="fas fa-arrow-down-short-wide text-muted"></i></span>
            <select class="form-select" id="sortSelect" onchange="applyFilterAndSort()">
              <option value="date-desc" selected>Tanggal (Terbaru)</option>
              <option value="date-asc">Tanggal (Terlama)</option>
              <option value="name-asc">Nama Pelamar (A-Z)</option>
              <option value="name-desc">Nama Pelamar (Z-A)</option>
              <option value="status-asc">Status Rekrutmen</option>
            </select>
          </div>
        </div>
      </div>

      <!-- Segmented Status Filter Tabs -->
      <div class="px-3 py-2 bg-light border-bottom d-flex flex-wrap gap-2 align-items-center">
        <span class="small fw-bold me-1 text-muted"><i class="fas fa-sliders me-1"></i>Status:</span>
        
        <button type="button" class="filter-pill active" data-filter="all" onclick="setFilter('all', this)">
          Semua (<%= candidates.length %>)
        </button>
        
        <button type="button" class="filter-pill" data-filter="Belum Diproses" onclick="setFilter('Belum Diproses', this)">
          Belum Diproses (<%= candidates.filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses').length %>)
        </button>
        
        <button type="button" class="filter-pill" data-filter="Diterima" onclick="setFilter('Diterima', this)">
          <i class="fas fa-circle-check text-success"></i> Diterima (<%= candidates.filter(c => c.kesimpulan_status === 'Diterima').length %>)
        </button>
        
        <button type="button" class="filter-pill" data-filter="Dipertimbangkan" onclick="setFilter('Dipertimbangkan', this)">
          <i class="fas fa-hourglass text-warning"></i> Dipertimbangkan (<%= candidates.filter(c => c.kesimpulan_status === 'Dipertimbangkan').length %>)
        </button>
        
        <button type="button" class="filter-pill" data-filter="Ditolak" onclick="setFilter('Ditolak', this)">
          <i class="fas fa-circle-xmark text-danger"></i> Ditolak (<%= candidates.filter(c => c.kesimpulan_status === 'Ditolak').length %>)
        </button>
        
        <button type="button" class="filter-pill ms-auto" data-filter="duplicate" onclick="setFilter('duplicate', this)" style="border-color: #f59e0b; color: #b45309;">
          <i class="fas fa-triangle-exclamation text-danger"></i> Duplikat (<%= candidates.filter(c => c.is_duplicate).length %>)
        </button>
      </div>

      <!-- Modern Table Content -->
      <div class="table-responsive-modern">
        <table class="kov-table" id="candidateTable">
          <thead>
            <tr>
              <th class="ps-3" style="width: 60px;">ID</th>
              <th class="sortable-header" onclick="toggleSort('date')" style="min-width: 140px;">
                Tanggal Submit <i class="fas fa-sort ms-1 text-muted" id="sortIconDate"></i>
              </th>
              <th class="sortable-header" onclick="toggleSort('name')" style="min-width: 250px;">
                Nama &amp; Identitas <i class="fas fa-sort ms-1 text-muted" id="sortIconName"></i>
              </th>
              <th style="min-width: 160px;">Posisi Dilamar</th>
              <th style="min-width: 180px;">Kontak</th>
              <th class="sortable-header" onclick="toggleSort('status')" style="min-width: 160px;">
                Status Seleksi <i class="fas fa-sort ms-1 text-muted" id="sortIconStatus"></i>
              </th>
              <th style="min-width: 150px;">Indikator</th>
              <th class="text-center pe-3" style="min-width: 150px;">Aksi</th>
            </tr>
          </thead>
          <tbody id="candidateTableBody">
            <% if (candidates.length === 0) { %>
              <tr id="noDataRow">
                <td colspan="8" class="text-center py-5 text-muted">
                  <div class="py-4">
                    <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                    <h6 class="fw-bold text-dark">Belum Ada Pelamar</h6>
                    <p class="small text-muted mb-0">Bagikan tautan form kepada kandidat untuk mulai menerima data.</p>
                  </div>
                </td>
              </tr>
            <% } %>
            <% candidates.forEach(c => { 
              const cDiv = c.divisi || 'Operasional';
              const dLow = cDiv.toLowerCase();
              let divBadgeClass = 'bg-light text-dark border';
              if (dLow.includes('kitchen')) divBadgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning';
              else if (dLow.includes('barista')) divBadgeClass = 'bg-amber-subtle text-amber-emphasis border';
              else if (dLow.includes('hr')) divBadgeClass = 'bg-primary-subtle text-primary border';
              else if (dLow.includes('teknisi')) divBadgeClass = 'bg-info-subtle text-info border';
              else if (dLow.includes('fat') || dLow.includes('finance')) divBadgeClass = 'bg-success-subtle text-success border';
              else if (dLow.includes('it')) divBadgeClass = 'bg-dark text-info border border-info';
              else divBadgeClass = 'bg-success-subtle text-success border';
            %>
              <tr data-id="<%= c.id %>"
                  data-date="<%= new Date(c.created_at).getTime() %>"
                  data-name="<%= (c.nama_lengkap || '').toLowerCase() %>"
                  data-status="<%= c.kesimpulan_status || 'Belum Diproses' %>"
                  data-divisi="<%= dLow %>"
                  data-duplicate="<%= c.is_duplicate ? 'true' : 'false' %>">
                <td class="ps-3 fw-bold text-muted">#<%= c.id %></td>
                <td class="small text-secondary fw-semibold">
                  <%= formatDate(c.created_at, true) %>
                </td>
                <td>
                  <div class="d-flex align-items-center gap-2.5">
                    <% if (c.foto_kandidat) { %>
                      <img src="<%= c.foto_kandidat %>" class="rounded-3 border shadow-xs flex-shrink-0" style="width: 38px; height: 38px; object-fit: cover;">
                    <% } else { %>
                      <div class="user-avatar-initials flex-shrink-0">
                        <%= c.nama_lengkap ? c.nama_lengkap.charAt(0).toUpperCase() : 'P' %>
                      </div>
                    <% } %>
                    <div>
                      <div class="fw-bold text-dark"><%= c.nama_lengkap %></div>
                      <div class="text-muted" style="font-size: 0.76rem;">
                        <%= c.nama_panggilan ? '(' + c.nama_panggilan + ')' : '' %>
                        <% if (c.nomor_ktp) { %> <span class="ms-1 border-start ps-1">NIK: <%= c.nomor_ktp %></span> <% } %>
                        <% if (c.no_rekening) { %> <span class="ms-1 border-start ps-1">Rek: <%= c.no_rekening %></span> <% } %>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <div class="mb-1">
                    <span class="badge <%= divBadgeClass %> px-2 py-1" style="font-size: 0.72rem;">
                      <i class="fas fa-layer-group me-1"></i><%= cDiv %>
                    </span>
                  </div>
                  <span class="fw-semibold text-dark small">
                    <%= c.posisi_dilamar %>
                  </span>
                </td>
                <td>
                  <div class="small fw-semibold text-dark"><i class="fas fa-envelope text-muted me-1"></i><%= c.email %></div>
                  <div class="text-muted" style="font-size: 0.78rem;"><i class="fas fa-phone text-muted me-1"></i><%= c.no_hp %></div>
                </td>
                <td>
                  <% 
                    const statusName = c.kesimpulan_status || 'Belum Diproses';
                    let pillClass = 'pill-slate';
                    if (statusName === 'Diterima') pillClass = 'pill-success';
                    else if (statusName === 'Dipertimbangkan') pillClass = 'pill-warning';
                    else if (statusName === 'Ditolak') pillClass = 'pill-danger';
                  %>
                  <span class="status-pill-modern <%= pillClass %>">
                    <span class="status-dot-pulse"></span>
                    <%= statusName %>
                  </span>
                </td>
                <td>
                  <% if (c.is_duplicate) { %>
                    <span class="badge bg-warning bg-opacity-25 text-warning-emphasis border border-warning px-2 py-1" title="Terdeteksi mengisi form <%= c.duplicate_count %>x dengan <%= c.match_reason %> yang sama">
                      <i class="fas fa-triangle-exclamation text-danger me-1"></i>Melamar <%= c.duplicate_count %>x
                    </span>
                  <% } else { %>
                    <span class="badge bg-light text-secondary border px-2 py-1">
                      <i class="fas fa-shield-check text-success me-1"></i>Unik
                    </span>
                  <% } %>
                  <% if (c.review_count && c.review_count > 0) { %>
                    <div class="mt-1">
                      <span class="badge bg-info-subtle text-info-emphasis border border-info px-2 py-1" style="font-size: 0.72rem;" title="Catatan Reviewer: <%= c.catatan_reviewer || '' %>">
                        <i class="fas fa-comments text-info me-1"></i><%= c.review_count %> Reviewer
                      </span>
                    </div>
                  <% } %>
                  <% if (c.share_token) { %>
                    <div class="mt-1"><span class="badge bg-light text-muted font-monospace border" style="font-size: 0.7rem;" title="Token Unik Link"><%= c.share_token %></span></div>
                  <% } %>
                </td>
                <td class="text-center pe-3">
                  <div class="d-inline-flex gap-1.5">
                    <a href="/admin/candidate/<%= c.id %>" class="btn-kov-outline btn-kov-sm" title="Edit Catatan Pewawancara / Detail">
                      <i class="fas fa-user-check"></i> Review
                    </a>
                    <a href="/api/export/pdf/<%= c.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-secondary btn-kov-sm text-danger" title="Export 5-Page PDF">
                      <i class="fas fa-file-pdf"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>

    </div>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const token = getRandomToken();
      const url = window.location.origin + '/?ref=' + token;
      document.getElementById('shareUrl').innerText = url;
    });

    function getRandomToken() {
      const chars = '23456789abcdefghjkmnpqrstuvwxyz';
      let result = '';
      for (let i = 0; i < 8; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return 'c-' + result;
    }

    function generateRandomShareLink(shouldCopy = true) {
      const token = getRandomToken();
      const url = window.location.origin + '/?ref=' + token;
      document.getElementById('shareUrl').innerText = url;

      if (shouldCopy) {
        navigator.clipboard.writeText(url).then(() => {
          KovToast.success('Tautan form rekrutmen berhasil disalin ke clipboard:\n' + url, 'Link Formulir Disalin');
        }).catch(() => {
          KovToast.info('Tautan: ' + url, 'Link Formulir');
        });
      }
      return url;
    }

    function generateAndCopyShareLink() {
      generateRandomShareLink(true);
    }

    let activeFilter = 'all';

    function setFilter(filterType, btnElem) {
      activeFilter = filterType;
      document.querySelectorAll('.filter-pill').forEach(btn => {
        btn.classList.remove('active', 'active-warning');
      });
      
      if (filterType === 'duplicate') {
        btnElem.classList.add('active-warning');
      } else {
        btnElem.classList.add('active');
      }
      applyFilterAndSort();
    }

    function toggleSort(type) {
      const select = document.getElementById('sortSelect');
      if (type === 'date') {
        select.value = select.value === 'date-desc' ? 'date-asc' : 'date-desc';
      } else if (type === 'name') {
        select.value = select.value === 'name-asc' ? 'name-desc' : 'name-asc';
      } else if (type === 'status') {
        select.value = select.value === 'status-asc' ? 'date-desc' : 'status-asc';
      }
      applyFilterAndSort();
    }

    function applyFilterAndSort() {
      const searchVal = document.getElementById('searchInput').value.toLowerCase();
      const sortVal = document.getElementById('sortSelect').value;
      const divisiVal = (document.getElementById('divisiSelect') ? document.getElementById('divisiSelect').value : 'all').toLowerCase();
      const tbody = document.getElementById('candidateTableBody');
      const rows = Array.from(tbody.querySelectorAll('tr[data-id]'));

      let visibleCount = 0;

      rows.forEach(row => {
        const rowText = row.innerText.toLowerCase();
        const rowStatus = row.getAttribute('data-status');
        const rowDivisi = (row.getAttribute('data-divisi') || '').toLowerCase();
        const isDuplicate = row.getAttribute('data-duplicate') === 'true';

        let matchesSearch = rowText.includes(searchVal);
        let matchesFilter = true;

        if (activeFilter === 'duplicate') {
          matchesFilter = isDuplicate;
        } else if (activeFilter !== 'all') {
          matchesFilter = (rowStatus === activeFilter);
        }

        let matchesDivisi = (divisiVal === 'all' || rowDivisi.includes(divisiVal));

        if (matchesSearch && matchesFilter && matchesDivisi) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      document.getElementById('candidateCount').innerText = visibleCount;

      // Sorting Logic
      rows.sort((a, b) => {
        if (sortVal === 'date-desc') {
          return parseInt(b.getAttribute('data-date')) - parseInt(a.getAttribute('data-date'));
        } else if (sortVal === 'date-asc') {
          return parseInt(a.getAttribute('data-date')) - parseInt(b.getAttribute('data-date'));
        } else if (sortVal === 'name-asc') {
          return a.getAttribute('data-name').localeCompare(b.getAttribute('data-name'));
        } else if (sortVal === 'name-desc') {
          return b.getAttribute('data-name').localeCompare(a.getAttribute('data-name'));
        } else if (sortVal === 'status-asc') {
          return a.getAttribute('data-status').localeCompare(b.getAttribute('data-status'));
        }
        return 0;
      });

      rows.forEach(row => tbody.appendChild(row));
    }

    document.addEventListener('DOMContentLoaded', () => {
      generateRandomShareLink(false);
      applyFilterAndSort();
    });
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
