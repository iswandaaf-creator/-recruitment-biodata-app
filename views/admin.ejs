            <div class="col-7">
              <input type="date" id="hrMemoDateInput" class="form-control form-control-sm" style="font-size: 10.5px;" value="2026-10-29">
            </div>
            <div class="col-5">
              <input type="time" id="hrMemoTimeInput" class="form-control form-control-sm" style="font-size: 10.5px;" value="10:00">
            </div>
          </div>
          <div class="mb-1.5">
            <select id="hrMemoCatInput" class="form-select form-select-sm" style="font-size: 10.5px;">
              <option value="Interview">Agenda Interview</option>
              <option value="Memo HRD">Catatan Memo HRD</option>
              <option value="Onboarding">Onboarding Staf</option>
              <option value="Deadline">Deadline Penting</option>
            </select>
