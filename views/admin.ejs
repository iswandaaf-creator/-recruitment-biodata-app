            <textarea id="hrMemoNoteInput" class="form-control form-control-sm" rows="2" style="font-size: 10.5px;" placeholder="Catatan..."></textarea>
          </div>
          <div class="d-flex align-items-center gap-1">
            <button type="submit" id="btnSaveHrMemo" class="btn-dd-hero btn-sm flex-grow-1" style="height: 26px; font-size: 10.5px; justify-content: center;">
              Simpan Memo
            </button>
