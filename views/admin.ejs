<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Rekrutmen HR - KOV Portal</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/figma-ui.css" rel="stylesheet">
  <style>
    /* Custom page-level enhancements */
    .filter-pill {
      font-size: 0.8rem;
      font-weight: 600;
      padding: 0.4rem 0.85rem;
      border-radius: var(--kov-radius-pill);
      border: 1px solid var(--kov-slate-200);
      background: #ffffff;
      color: var(--kov-slate-600);
      transition: var(--kov-transition);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      white-space: nowrap;
    }

    .filter-pill:hover {
      background: var(--kov-slate-100);
      color: var(--kov-slate-900);
      border-color: var(--kov-slate-300);
    }

    .filter-pill.active {
      background: var(--kov-slate-900);
      color: #ffffff;
      border-color: var(--kov-slate-900);
      box-shadow: 0 2px 6px rgba(15, 23, 42, 0.2);
    }

    .filter-pill.active-warning {
      background: var(--kov-amber) !important;
      color: #ffffff !important;
      border-color: var(--kov-amber) !important;
    }

    .sortable-header {
      cursor: pointer;
      user-select: none;
      transition: var(--kov-transition);
    }

    .sortable-header:hover {
      background-color: var(--kov-slate-100);
      color: var(--kov-slate-900);
    }

    .share-banner-modern {
      background: #ffffff;
      border: 1px solid var(--kov-border);
      border-left: 4px solid var(--kov-primary-500);
      border-radius: var(--kov-radius-lg);
      padding: 1rem 1.25rem;
      box-shadow: var(--kov-shadow-xs);
    }

    .share-token-box {
      background: var(--kov-slate-50);
      border: 1px solid var(--kov-slate-200);
      border-radius: var(--kov-radius-sm);
      padding: 0.35rem 0.75rem;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 0.85rem;
      color: var(--kov-slate-900);
      font-weight: 600;
    }
  </style>
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'hr', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Botanical Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Dashboard Rekrutmen HR</h1>
            <span class="d-none d-md-inline" style="font-size: 12px; color: var(--kov-botanical-text-muted, #5e8377); margin-left: 8px;">Kelola proses rekrutmen dengan lebih mudah dan terorganisir</span>
          </div>
        </div>
        <div class="kov-topbar-right d-flex align-items-center gap-2">
          <!-- Notification Bell -->
          <button type="button" class="kov-topbar-bell-btn" title="Notifikasi" onclick="KovToast.info('Tidak ada notifikasi baru yang tertunda', 'Notifikasi')">
            <i class="far fa-bell"></i>
            <span class="kov-topbar-bell-dot"></span>
          </button>

          <!-- Real-Time Date & Time Widget -->
          <div class="kov-topbar-clock d-none d-sm-inline-flex">
            <i class="far fa-calendar-days text-success fs-6"></i>
            <div class="d-flex flex-column text-start" style="line-height: 1.15;">
              <span id="kovLiveDate" style="font-weight: 700; font-size: 0.78rem;">20 Okt 2026</span>
              <span id="kovLiveTime" style="font-size: 0.68rem; color: #5e8377;">10:24 WIB</span>
            </div>
          </div>

          <!-- User Profile Dropdown Pill -->
          <div class="kov-topbar-user-pill">
            <div class="kov-avatar-monogram" style="width: 32px; height: 32px; font-size: 0.85rem;">
              <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
            </div>
            <div class="d-none d-md-flex flex-column text-start" style="line-height: 1.15;">
              <span style="font-size: 0.78rem; font-weight: 700; color: #072b22;">
                <%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'Administrator HR' %>
              </span>
              <span style="font-size: 0.68rem; color: #5e8377;">
                <%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Superadmin' %>
              </span>
            </div>
            <i class="fas fa-chevron-down ms-1 text-muted" style="font-size: 0.65rem;"></i>
          </div>

          <!-- Theme Switcher Button -->
          <button type="button" class="kov-theme-toggle" onclick="toggleKovTheme()" title="Ganti Mode Gelap / Terang">
            <i class="fas fa-moon kov-theme-icon"></i>
          </button>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

        <!-- 6 KPI Metric Cards Grid -->
        <div class="kov-kpi-grid">
          <!-- 1. Total Pelamar -->
          <div class="kov-kpi-card" onclick="filterByStatusCard('all')" title="Klik untuk filter: Semua Pelamar">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-mint">
                <i class="fas fa-user-group"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #00a86b;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.length %></div>
              <div class="kov-kpi-title">Total Pelamar</div>
              <div class="kov-kpi-sub">Seluruh berkas pelamar</div>
            </div>
          </div>

          <!-- 2. Perlu Review -->
          <div class="kov-kpi-card" onclick="filterByStatusCard('Belum Diproses')" title="Klik untuk filter: Perlu Review">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-blue">
                <i class="fas fa-file-lines"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #2563eb;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses').length %></div>
              <div class="kov-kpi-title">Perlu Review</div>
              <div class="kov-kpi-sub">Menunggu review HR/User</div>
            </div>
          </div>

          <!-- 3. Diterima -->
          <div class="kov-kpi-card" onclick="filterByStatusCard('Diterima')" title="Klik untuk filter: Diterima">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-emerald">
                <i class="fas fa-circle-check"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #059669;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.filter(c => c.kesimpulan_status === 'Diterima').length %></div>
              <div class="kov-kpi-title">Diterima</div>
              <div class="kov-kpi-sub">Lolos interview kerja</div>
            </div>
          </div>

          <!-- 4. Dipertimbangkan -->
          <div class="kov-kpi-card" onclick="filterByStatusCard('Dipertimbangkan')" title="Klik untuk filter: Dipertimbangkan">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-amber">
                <i class="fas fa-hourglass-half"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #f59e0b;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.filter(c => c.kesimpulan_status === 'Dipertimbangkan').length %></div>
              <div class="kov-kpi-title">Dipertimbangkan</div>
              <div class="kov-kpi-sub">Kandidat hold / cadangan</div>
            </div>
          </div>

          <!-- 5. Ditolak -->
          <div class="kov-kpi-card" onclick="filterByStatusCard('Ditolak')" title="Klik untuk filter: Ditolak">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-rose">
                <i class="fas fa-circle-xmark"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #ef4444;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.filter(c => c.kesimpulan_status === 'Ditolak').length %></div>
              <div class="kov-kpi-title">Ditolak</div>
              <div class="kov-kpi-sub">Belum memenuhi syarat</div>
            </div>
          </div>

          <!-- 6. Duplikat -->
          <div class="kov-kpi-card" onclick="filterByStatusCard('duplicate')" title="Klik untuk filter: Duplikat">
            <div class="kov-kpi-card-top">
              <div class="kov-kpi-icon-box kov-icon-orange">
                <i class="fas fa-triangle-exclamation"></i>
              </div>
              <div class="kov-kpi-arrow-btn" style="color: #ea580c;"><i class="fas fa-chevron-right"></i></div>
            </div>
            <div>
              <div class="kov-kpi-value"><%= candidates.filter(c => c.is_duplicate).length %></div>
              <div class="kov-kpi-title">Duplikat</div>
              <div class="kov-kpi-sub">Terdeteksi mengirim berkas &gt;1x</div>
            </div>
          </div>
        </div>

        <!-- "Link Formulir Kandidat" Share Banner -->
        <div class="kov-share-banner">
          <svg class="kov-share-watermark" viewBox="0 0 160 160" fill="currentColor">
            <path d="M80 10 C50 40, 30 90, 60 130 C80 155, 120 155, 140 120 C155 85, 130 35, 80 10 Z" />
            <path d="M120 40 C145 60, 155 100, 135 130 C120 100, 110 65, 120 40 Z" opacity="0.6"/>
          </svg>
          <div class="kov-share-left">
            <div class="kov-share-squircle" style="background: #00a86b; border-color: #00a86b; color: #ffffff;">
              <i class="fas fa-link"></i>
            </div>
            <div>
              <div class="kov-share-title">Link Formulir Kandidat</div>
              <div class="kov-share-subtitle d-flex align-items-center gap-2 mt-1 flex-wrap">
                <div class="kov-share-url-pill">
                  <span id="shareUrl" class="user-select-all"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/?ref=c-Sysujatg</span>
                  <button type="button" class="kov-url-copy-btn" onclick="generateAndCopyShareLink()" title="Salin URL">
                    <i class="far fa-copy"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
          <div class="kov-share-right">
            <button type="button" class="kov-btn-outline-pill" onclick="generateRandomShareLink(false)">
              <i class="fas fa-shuffle me-1 text-success"></i> Acak Token Baru
            </button>
            <button type="button" class="kov-btn-mint-pill" onclick="generateAndCopyShareLink()">
              <i class="fas fa-link me-1"></i> Salin Link
            </button>
          </div>
        </div>

        <!-- "Daftar Pelamar Kerja" Table Card -->
        <div class="kov-table-card">
          <!-- Card Header & Filter Bar -->
          <div class="kov-table-header-box">
            <div class="kov-table-title-group">
              <div class="kov-table-squircle">
                <i class="fas fa-user-group"></i>
              </div>
              <div>
                <h2 class="kov-table-title">
                  <span>Daftar Pelamar Kerja</span>
                  <span class="kov-badge-count"><span id="candidateCount"><%= candidates.length %></span> Data</span>
                </h2>
                <div style="font-size: 0.78rem; color: #5e8377; margin-top: 3px;">
                  Gunakan filter status dan pencarian data untuk mempermudah seleksi HR.
                </div>
              </div>
            </div>

            <div class="d-flex flex-wrap align-items-center gap-2">
              <!-- Search Box -->
              <div class="kov-pill-search-wrap">
                <i class="fas fa-magnifying-glass"></i>
                <input type="text" class="kov-pill-search" id="searchInput" placeholder="Cari nama, NIK, Rekening..." onkeyup="applyFilterAndSort()">
              </div>

              <!-- Filter Icon Button -->
              <button type="button" class="kov-filter-icon-btn" title="Toggle Filter" onclick="document.getElementById('searchInput').focus()">
                <i class="fas fa-sliders"></i>
              </button>

              <!-- Divisi Filter -->
              <div class="kov-select-wrap">
                <i class="fas fa-layer-group kov-select-icon"></i>
                <select class="kov-pill-select" id="divisiSelect" onchange="applyFilterAndSort()">
                  <option value="all" selected>Semua Divisi</option>
                  <option value="kitchen">Kitchen</option>
                  <option value="barista">Barista</option>
                  <option value="operasional">Operasional</option>
                  <option value="hr">HR</option>
                  <option value="teknisi">Teknisi</option>
                  <option value="fat">FAT (Finance)</option>
                  <option value="it">IT</option>
                </select>
                <i class="fas fa-chevron-down kov-select-chevron"></i>
              </div>

              <!-- Sort Select -->
              <div class="kov-select-wrap">
                <i class="far fa-calendar-days kov-select-icon"></i>
                <select class="kov-pill-select" id="sortSelect" onchange="applyFilterAndSort()">
                  <option value="date-desc" selected>Tanggal (Terbaru)</option>
                  <option value="date-asc">Tanggal (Terlama)</option>
                  <option value="name-asc">Nama Pelamar (A-Z)</option>
                  <option value="name-desc">Nama Pelamar (Z-A)</option>
                  <option value="status-asc">Status Rekrutmen</option>
                </select>
                <i class="fas fa-chevron-down kov-select-chevron"></i>
              </div>
            </div>
          </div>

          <!-- Status Segmented Pills -->
          <div class="kov-status-filter-bar">
            <span class="small fw-bold text-dark me-1" style="font-size: 0.82rem;">Status:</span>

            <button type="button" class="kov-filter-pill-botanical active" data-filter="all" onclick="setFilter('all', this)">
              Semua (<%= candidates.length %>)
            </button>

            <button type="button" class="kov-filter-pill-botanical" data-filter="Belum Diproses" onclick="setFilter('Belum Diproses', this)">
              <i class="far fa-circle-dot" style="color: #3b82f6;"></i> Belum Diproses (<%= candidates.filter(c => !c.kesimpulan_status || c.kesimpulan_status === 'Belum Diproses').length %>)
            </button>

            <button type="button" class="kov-filter-pill-botanical" data-filter="Diterima" onclick="setFilter('Diterima', this)">
              <i class="fas fa-circle-check" style="color: #10b981;"></i> Diterima (<%= candidates.filter(c => c.kesimpulan_status === 'Diterima').length %>)
            </button>

            <button type="button" class="kov-filter-pill-botanical" data-filter="Dipertimbangkan" onclick="setFilter('Dipertimbangkan', this)">
              <i class="fas fa-circle-exclamation" style="color: #f59e0b;"></i> Dipertimbangkan (<%= candidates.filter(c => c.kesimpulan_status === 'Dipertimbangkan').length %>)
            </button>

            <button type="button" class="kov-filter-pill-botanical" data-filter="Ditolak" onclick="setFilter('Ditolak', this)">
              <i class="fas fa-circle-xmark" style="color: #ef4444;"></i> Ditolak (<%= candidates.filter(c => c.kesimpulan_status === 'Ditolak').length %>)
            </button>

            <button type="button" class="kov-filter-pill-botanical warning-pill ms-auto" data-filter="duplicate" onclick="setFilter('duplicate', this)">
              <i class="far fa-clone" style="color: #ea580c;"></i> Duplikat (<%= candidates.filter(c => c.is_duplicate).length %>)
            </button>
          </div>

          <!-- Modern Table Content -->
          <div class="kov-botanical-table-wrap">
            <table class="kov-botanical-table" id="candidateTable">
              <thead>
                <tr>
                  <th style="width: 65px;">ID</th>
                  <th class="sortable-header" onclick="toggleSort('date')" style="min-width: 140px; cursor: pointer;">
                    TANGGAL SUBMIT <i class="fas fa-sort ms-1 opacity-50" id="sortIconDate"></i>
                  </th>
                  <th class="sortable-header" onclick="toggleSort('name')" style="min-width: 250px; cursor: pointer;">
                    NAMA &amp; IDENTITAS <i class="fas fa-sort ms-1 opacity-50" id="sortIconName"></i>
                  </th>
                  <th style="min-width: 160px;">POSISI DILAMAR</th>
                  <th style="min-width: 180px;">KONTAK</th>
                  <th class="sortable-header" onclick="toggleSort('status')" style="min-width: 160px; cursor: pointer;">
                    STATUS SELEKSI <i class="fas fa-sort ms-1 opacity-50" id="sortIconStatus"></i>
                  </th>
                  <th style="min-width: 130px;">INDIKATOR</th>
                  <th class="text-center" style="min-width: 140px;">AKSI</th>
                </tr>
              </thead>
              <tbody id="candidateTableBody">
                <% if (candidates.length === 0) { %>
                  <tr id="noDataRow">
                    <td colspan="8" class="text-center py-5 text-muted">
                      <div class="py-4">
                        <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                        <h6 class="fw-bold text-dark">Belum Ada Pelamar</h6>
                        <p class="small text-muted mb-0">Bagikan tautan form kepada kandidat untuk mulai menerima data.</p>
                      </div>
                    </td>
                  </tr>
                <% } %>
                <% candidates.forEach(c => { 
                  const cDiv = c.divisi || 'Operasional';
                  const dLow = cDiv.toLowerCase();
                %>
                  <tr data-id="<%= c.id %>"
                      data-date="<%= new Date(c.created_at).getTime() %>"
                      data-name="<%= (c.nama_lengkap || '').toLowerCase() %>"
                      data-status="<%= c.kesimpulan_status || 'Belum Diproses' %>"
                      data-divisi="<%= dLow %>"
                      data-duplicate="<%= c.is_duplicate ? 'true' : 'false' %>">
                    <td class="fw-bold text-muted">#<%= c.id %></td>
                    <td class="small fw-semibold text-secondary">
                      <i class="far fa-calendar text-muted me-1.5"></i><%= formatDate(c.created_at, true) %>
                    </td>
                    <td>
                      <div class="d-flex align-items-center gap-2.5">
                        <% if (c.foto_kandidat) { %>
                          <img src="<%= c.foto_kandidat %>" class="rounded-circle border flex-shrink-0" style="width: 38px; height: 38px; object-fit: cover;">
                        <% } else { %>
                          <div class="kov-avatar-monogram">
                            <%= c.nama_lengkap ? c.nama_lengkap.trim().charAt(0).toUpperCase() : 'P' %>
                          </div>
                        <% } %>
                        <div>
                          <div class="kov-candidate-name"><%= c.nama_lengkap %></div>
                          <div class="kov-candidate-sub">
                            <%= c.nama_panggilan ? '(' + c.nama_panggilan + ')' : '' %>
                            <% if (c.nomor_ktp) { %> <span class="ms-1 border-start ps-1">NIK: <%= c.nomor_ktp %></span> <% } %>
                            <% if (c.no_rekening) { %> <span class="ms-1 border-start ps-1">Rek: <%= c.no_rekening %></span> <% } %>
                          </div>
                        </div>
                      </div>
                    </td>
                    <td>
                      <% if (dLow.includes('barista')) { %>
                        <span class="kov-divisi-pill" style="background: #f8fafc; border-color: #e2e8f0; color: #475569;">
                          <i class="fas fa-mug-hot me-1 text-muted"></i> Barista
                        </span>
                      <% } else if (dLow.includes('kitchen')) { %>
                        <span class="kov-divisi-pill" style="background: #fffbeb; border-color: #fde68a; color: #b45309;">
                          <i class="fas fa-utensils me-1"></i> Kitchen
                        </span>
                      <% } else if (dLow.includes('hr')) { %>
                        <span class="kov-divisi-pill" style="background: #eff6ff; border-color: #bfdbfe; color: #1d4ed8;">
                          <i class="fas fa-user-tie me-1"></i> HR
                        </span>
                      <% } else if (dLow.includes('it')) { %>
                        <span class="kov-divisi-pill" style="background: #f1f5f9; border-color: #cbd5e1; color: #0f172a;">
                          <i class="fas fa-laptop me-1"></i> IT
                        </span>
                      <% } else if (dLow.includes('teknisi')) { %>
                        <span class="kov-divisi-pill" style="background: #ecfeff; border-color: #a5f3fc; color: #0e7490;">
                          <i class="fas fa-wrench me-1"></i> Teknisi
                        </span>
                      <% } else { %>
                        <span class="kov-divisi-pill" style="background: #e6f9f0; border-color: #c9eedc; color: #00a86b;">
                          <i class="fas fa-briefcase me-1"></i> <%= cDiv %>
                        </span>
                      <% } %>
                      <div class="fw-semibold text-dark small mt-1">
                        <%= c.posisi_dilamar %>
                      </div>
                    </td>
                    <td>
                      <div class="d-flex align-items-center gap-1.5 text-secondary" style="font-size: 0.78rem;">
                        <i class="fas fa-phone text-muted" style="width: 14px;"></i> <span><%= c.no_hp || '-' %></span>
                      </div>
                      <div class="d-flex align-items-center gap-1.5 text-secondary mt-0.5" style="font-size: 0.78rem;">
                        <i class="far fa-envelope text-muted" style="width: 14px;"></i> <span><%= c.email || '-' %></span>
                      </div>
                    </td>
                    <td>
                      <% 
                        const statusName = c.kesimpulan_status || 'Belum Diproses';
                        let pillBg = '#eff6ff', pillColor = '#1d4ed8', pillBorder = '#dbeafe', dotBg = '#2563eb';
                        if (statusName === 'Diterima') {
                          pillBg = '#f0fdf4'; pillColor = '#15803d'; pillBorder = '#bbf7d0'; dotBg = '#16a34a';
                        } else if (statusName === 'Dipertimbangkan') {
                          pillBg = '#fffbeb'; pillColor = '#b45309'; pillBorder = '#fef3c7'; dotBg = '#d97706';
                        } else if (statusName === 'Ditolak') {
                          pillBg = '#fef2f2'; pillColor = '#b91c1c'; pillBorder = '#fecaca'; dotBg = '#dc2626';
                        }
                      %>
                      <span class="status-pill-modern" style="background: <%= pillBg %>; color: <%= pillColor %>; border: 1px solid <%= pillBorder %>;">
                        <span class="status-dot-pulse" style="background: <%= dotBg %>;"></span>
                        <%= statusName %>
                      </span>
                    </td>
                    <td>
                      <% if (c.is_duplicate) { %>
                        <span class="badge bg-warning bg-opacity-25 text-warning-emphasis border border-warning px-2 py-1" title="Terdeteksi mengisi form <%= c.duplicate_count %>x">
                          <i class="fas fa-triangle-exclamation text-danger me-1"></i>Melamar <%= c.duplicate_count %>x
                        </span>
                      <% } else { %>
                        <span class="badge" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #475569; font-size: 0.72rem; font-weight: 600; padding: 3px 8px; border-radius: 6px;">
                          Unik
                        </span>
                      <% } %>
                      <% if (c.share_token) { %>
                        <div class="text-muted font-monospace" style="font-size: 0.7rem; margin-top: 3px;"><%= c.share_token %></div>
                      <% } %>
                      <% if (c.review_count && c.review_count > 0) { %>
                        <div class="mt-1">
                          <span class="badge bg-info-subtle text-info-emphasis border border-info px-2 py-1" style="font-size: 0.7rem;" title="Catatan Reviewer: <%= c.catatan_reviewer || '' %>">
                            <i class="fas fa-comments text-info me-1"></i><%= c.review_count %> Review
                          </span>
                        </div>
                      <% } %>
                    </td>
                    <td class="text-center">
                      <div class="d-inline-flex gap-1.5 align-items-center">
                        <a href="/admin/candidate/<%= c.id %>" class="kov-action-review-btn" title="Review Berkas & Catatan Pewawancara">
                          <i class="fas fa-user-check me-1"></i> Review
                        </a>
                        <button type="button" class="kov-action-icon-circle" title="Detail & Opsi" onclick="window.location.href='/admin/candidate/<%= c.id %>'">
                          <i class="fas fa-ellipsis-vertical"></i>
                        </button>
                        <a href="/api/export/pdf/<%= c.id %>" target="_blank" rel="noopener noreferrer" class="kov-action-icon-circle text-danger" title="Export PDF Biodata">
                          <i class="fas fa-file-pdf"></i>
                        </a>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

        </div>

      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const token = getRandomToken();
      const url = window.location.origin + '/?ref=' + token;
      document.getElementById('shareUrl').innerText = url;
    });

    function getRandomToken() {
      const chars = '23456789abcdefghjkmnpqrstuvwxyz';
      let result = '';
      for (let i = 0; i < 8; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return 'c-' + result;
    }

    function generateRandomShareLink(shouldCopy = true) {
      const token = getRandomToken();
      const url = window.location.origin + '/?ref=' + token;
      document.getElementById('shareUrl').innerText = url;

      if (shouldCopy) {
        navigator.clipboard.writeText(url).then(() => {
          KovToast.success('Tautan form rekrutmen berhasil disalin ke clipboard:\n' + url, 'Link Formulir Disalin');
        }).catch(() => {
          KovToast.info('Tautan: ' + url, 'Link Formulir');
        });
      }
      return url;
    }

    function generateAndCopyShareLink() {
      generateRandomShareLink(true);
    }

    // Real-Time Date & Time Clock
    function updateKovLiveClock() {
      const dateEl = document.getElementById('kovLiveDate');
      const timeEl = document.getElementById('kovLiveTime');
      const clockEl = document.getElementById('kovLiveClock');
      try {
        const now = new Date();
        const dateStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Jakarta' });
        const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }).replace(/\./g, ':') + ' WIB';
        if (dateEl) dateEl.textContent = dateStr;
        if (timeEl) timeEl.textContent = timeStr;
        if (clockEl) clockEl.textContent = dateStr + ', ' + timeStr;
      } catch (e) {
        if (dateEl) dateEl.textContent = '20 Okt 2026';
        if (timeEl) timeEl.textContent = '10:24 WIB';
      }
    }

    let activeFilter = 'all';

    function setFilter(filterType, btnElem) {
      activeFilter = filterType;
      document.querySelectorAll('.kov-filter-pill-botanical, .filter-pill').forEach(btn => {
        btn.classList.remove('active');
      });
      
      if (btnElem) {
        btnElem.classList.add('active');
      }
      applyFilterAndSort();
    }

    function filterByStatusCard(status) {
      const targetBtn = document.querySelector(`.kov-filter-pill-botanical[data-filter="${status}"]`);
      if (targetBtn) {
        setFilter(status, targetBtn);
        const tableCard = document.querySelector('.kov-table-card');
        if (tableCard) {
          tableCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    function toggleSort(type) {
      const select = document.getElementById('sortSelect');
      if (type === 'date') {
        select.value = select.value === 'date-desc' ? 'date-asc' : 'date-desc';
      } else if (type === 'name') {
        select.value = select.value === 'name-asc' ? 'name-desc' : 'name-asc';
      } else if (type === 'status') {
        select.value = select.value === 'status-asc' ? 'date-desc' : 'status-asc';
      }
      applyFilterAndSort();
    }

    function applyFilterAndSort() {
      const searchVal = document.getElementById('searchInput').value.toLowerCase();
      const sortVal = document.getElementById('sortSelect').value;
      const divisiVal = (document.getElementById('divisiSelect') ? document.getElementById('divisiSelect').value : 'all').toLowerCase();
      const tbody = document.getElementById('candidateTableBody');
      const rows = Array.from(tbody.querySelectorAll('tr[data-id]'));

      let visibleCount = 0;

      rows.forEach(row => {
        const rowText = row.innerText.toLowerCase();
        const rowStatus = row.getAttribute('data-status');
        const rowDivisi = (row.getAttribute('data-divisi') || '').toLowerCase();
        const isDuplicate = row.getAttribute('data-duplicate') === 'true';

        let matchesSearch = rowText.includes(searchVal);
        let matchesFilter = true;

        if (activeFilter === 'duplicate') {
          matchesFilter = isDuplicate;
        } else if (activeFilter !== 'all') {
          matchesFilter = (rowStatus === activeFilter);
        }

        let matchesDivisi = (divisiVal === 'all' || rowDivisi.includes(divisiVal));

        if (matchesSearch && matchesFilter && matchesDivisi) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      document.getElementById('candidateCount').innerText = visibleCount;

      // Sorting Logic
      rows.sort((a, b) => {
        if (sortVal === 'date-desc') {
          return parseInt(b.getAttribute('data-date')) - parseInt(a.getAttribute('data-date'));
        } else if (sortVal === 'date-asc') {
          return parseInt(a.getAttribute('data-date')) - parseInt(b.getAttribute('data-date'));
        } else if (sortVal === 'name-asc') {
          return a.getAttribute('data-name').localeCompare(b.getAttribute('data-name'));
        } else if (sortVal === 'name-desc') {
          return b.getAttribute('data-name').localeCompare(a.getAttribute('data-name'));
        } else if (sortVal === 'status-asc') {
          return a.getAttribute('data-status').localeCompare(b.getAttribute('data-status'));
        }
        return 0;
      });

      rows.forEach(row => tbody.appendChild(row));
    }

    document.addEventListener('DOMContentLoaded', () => {
      updateKovLiveClock();
      setInterval(updateKovLiveClock, 30000);
      generateRandomShareLink(false);
      applyFilterAndSort();
    });
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
