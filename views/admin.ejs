  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    function getAppBaseUrl() {
      if (window.location && window.location.origin && window.location.origin !== 'null') {
        return window.location.origin;
      }
      return 'https://internal.kovgroups.com';
    }

    function getRandomToken() {
      const chars = '23456789abcdefghjkmnpqrstuvwxyz';
      let result = '';
      for (let i = 0; i < 8; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return 'c-' + result;
    }

    function generateRandomShareLink(shouldCopy = true, showToast = true) {
      const token = getRandomToken();
      const url = getAppBaseUrl() + '/?ref=' + token;
      const shareEl = document.getElementById('shareUrl');
      if (shareEl) {
        shareEl.innerText = url;
        shareEl.classList.add('bg-warning', 'bg-opacity-25');
        setTimeout(() => shareEl.classList.remove('bg-warning', 'bg-opacity-25'), 300);
      }

      const btnAcak = document.getElementById('btnAcakToken');
      if (btnAcak && showToast) {
        if (!btnAcak.getAttribute('data-orig-content')) {
          btnAcak.setAttribute('data-orig-content', btnAcak.innerHTML);
        }
        const origContent = btnAcak.getAttribute('data-orig-content');
        btnAcak.innerHTML = '<i class="fas fa-check me-1 text-success"></i> Token Baru!';
        clearTimeout(btnAcak._timer);
        btnAcak._timer = setTimeout(() => {
          btnAcak.innerHTML = origContent;
        }, 900);
      }

      if (shouldCopy) {
        copyTextWithFeedback(url, 'Tautan formulir rekrutmen berhasil disalin ke clipboard:\n' + url);
      } else if (showToast && window.KovToast && typeof window.KovToast.info === 'function') {
        window.KovToast.info('Token baru aktif: ' + token, 'Token Diperbarui');
      }
      return url;
    }

    function generateAndCopyShareLink() {
      const shareEl = document.getElementById('shareUrl');
      const url = (shareEl && shareEl.innerText.trim() && !shareEl.innerText.includes('Sysujatg')) 
        ? shareEl.innerText.trim() 
        : (getAppBaseUrl() + '/?ref=' + getRandomToken());
      
      if (shareEl) shareEl.innerText = url;
      copyTextWithFeedback(url, 'Tautan formulir rekrutmen berhasil disalin:\n' + url);
    }

    function copyTextWithFeedback(text, successMsg) {
      const btnSalin = document.getElementById('btnSalinLink');
      const iconCopy = document.getElementById('iconCopySmall');
      if (btnSalin && !btnSalin.getAttribute('data-orig-html')) {
        btnSalin.setAttribute('data-orig-html', btnSalin.innerHTML);
      }
      const origSalinText = btnSalin ? btnSalin.getAttribute('data-orig-html') : '';

      function triggerSuccessUI() {
        if (btnSalin) {
          btnSalin.innerHTML = '<i class="fas fa-check me-1"></i> Tersalin!';
          btnSalin.style.background = '#484ec9';
          clearTimeout(btnSalin._timer);
          btnSalin._timer = setTimeout(() => {
            btnSalin.innerHTML = origSalinText;
            btnSalin.style.background = '';
          }, 1500);
        }
        if (iconCopy) {
          iconCopy.className = 'fas fa-check text-success';
          clearTimeout(iconCopy._timer);
          iconCopy._timer = setTimeout(() => {
            iconCopy.className = 'far fa-copy';
          }, 1500);
        }
        if (window.KovToast && typeof window.KovToast.success === 'function') {
          window.KovToast.success(successMsg || 'Berhasil disalin ke clipboard!', 'Tautan Disalin');
        }
      }

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(triggerSuccessUI).catch(() => fallbackClipboardCopy(text, triggerSuccessUI));
      } else {
        fallbackClipboardCopy(text, triggerSuccessUI);
      }
    }

    function fallbackClipboardCopy(text, onSuccess) {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.top = '-9999px';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        const success = document.execCommand('copy');
        document.body.removeChild(ta);
        if (success && onSuccess) onSuccess();
        else if (window.KovToast) window.KovToast.info('Tautan: ' + text, 'Salin Manual');
      } catch (e) {
        if (window.KovToast) window.KovToast.info('Tautan: ' + text, 'Salin Manual');
      }
    }

    // Real-Time Date & Time Clock
    function updateKovLiveClock() {
      const dateEl = document.getElementById('kovLiveDate');
      const timeEl = document.getElementById('kovLiveTime');
      try {
        const now = new Date();
        const dateStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Jakarta' });
        const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }).replace(/\./g, ':') + ' WIB';
        if (dateEl) dateEl.textContent = dateStr;
        if (timeEl) timeEl.textContent = timeStr;
      } catch (e) {
        if (dateEl) dateEl.textContent = '25 Okt 2026';
        if (timeEl) timeEl.textContent = '00:20 WIB';
      }
    }

    let activeFilter = 'all';

    function normalizeStatus(st) {
      if (!st) return 'Belum Diproses';
      const s = String(st).trim().toLowerCase();
      if (s === 'diterima' || s === 'lolos' || s === 'accepted') return 'Diterima';
      if (s === 'dipertimbangkan' || s === 'hold' || s === 'cadangan') return 'Dipertimbangkan';
      if (s === 'ditolak' || s === 'rejected' || s === 'gagal') return 'Ditolak';
      return 'Belum Diproses';
    }

    function setFilter(filterType, btnElem) {
      activeFilter = filterType;

      // Update segmented pills active state
      document.querySelectorAll('.kov-filter-pill-botanical').forEach(btn => {
        btn.classList.remove('active');
      });
      if (btnElem) {
        btnElem.classList.add('active');
      } else {
        const matchingBtn = document.querySelector(`.kov-filter-pill-botanical[data-filter="${filterType}"]`);
        if (matchingBtn) matchingBtn.classList.add('active');
      }

      applyFilterAndSort();
      if (typeof renderHrMemoList === "function") renderHrMemoList();
      if (typeof onCalendarDateClickForMemo === "function") onCalendarDateClickForMemo(activeDateFilter);
    }

    function filterByStatusCard(status) {
      setFilter(status, null);
      if (window.innerWidth < 768) {
        const tableCard = document.querySelector('.kov-table-card');
        if (tableCard) {
          tableCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    function filterByDivisiQuick(divisi) {
      const select = document.getElementById('divisiSelect');
      if (select) {
        select.value = divisi;
        applyFilterAndSort();
      }
      // Update active highlight state on all 8 folder cards
      document.querySelectorAll('.dd-folder-card').forEach(card => {
        const cDiv = card.getAttribute('data-divisi');
        if (cDiv === divisi) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
      if (window.innerWidth < 768) {
        const tableCard = document.querySelector('.kov-table-card');
        if (tableCard) {
          tableCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    function selectCandidateCard(el) {
      document.querySelectorAll('.dd-file-card-item').forEach(c => c.classList.remove('active', 'selected'));
      if (el) el.classList.add('active', 'selected');
    }

    function toggleSort(type) {
      const select = document.getElementById('sortSelect');
      if (!select) return;
      if (type === 'date') {
        select.value = select.value === 'date-desc' ? 'date-asc' : 'date-desc';
      } else if (type === 'name') {
        select.value = select.value === 'name-asc' ? 'name-desc' : 'name-asc';
      } else if (type === 'status') {
        select.value = select.value === 'status-asc' ? 'status-desc' : 'status-asc';
      }
      applyFilterAndSort();
    }

    function applyFilterAndSort() {
      const searchVal = (document.getElementById('searchInput') ? document.getElementById('searchInput').value : '').toLowerCase().trim();
      const sortVal = document.getElementById('sortSelect') ? document.getElementById('sortSelect').value : 'date-desc';
      const divisiVal = (document.getElementById('divisiSelect') ? document.getElementById('divisiSelect').value : 'all').toLowerCase();
      const tbody = document.getElementById('candidateTableBody');
      if (!tbody) return;

      const rows = Array.from(tbody.querySelectorAll('tr[data-id]'));
      let visibleCount = 0;

      rows.forEach(row => {
        const rowText = row.innerText.toLowerCase();
        const rawStatus = row.getAttribute('data-status') || '';
        const rowNormStatus = normalizeStatus(rawStatus);
        const rowDivisi = (row.getAttribute('data-divisi') || '').toLowerCase();
        const isDuplicate = row.getAttribute('data-duplicate') === 'true';

        let matchesSearch = searchVal === '' || rowText.includes(searchVal);
        let matchesFilter = true;

        if (activeFilter === 'duplicate') {
          matchesFilter = isDuplicate;
        } else if (activeFilter !== 'all') {
          matchesFilter = (rowNormStatus === normalizeStatus(activeFilter));
        }

        let matchesDivisi = (divisiVal === 'all' || rowDivisi.includes(divisiVal));
        let matchesDate = true;
        if (activeDateFilter) {
          const rowTs = parseInt(row.getAttribute('data-date')) || 0;
          if (rowTs) {
            const rd = new Date(rowTs);
            const rk = formatDateKey(rd);
            matchesDate = (rk === activeDateFilter);
          } else {
            matchesDate = false;
          }
        }

        if (matchesSearch && matchesFilter && matchesDivisi && matchesDate) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      // Synchronize Floating Card items in #candidateCardsList
      const cardContainer = document.getElementById('candidateCardsList');
      if (cardContainer) {
        const cards = Array.from(cardContainer.querySelectorAll('.dd-file-card-item'));
        cards.forEach(card => {
          const cardText = card.innerText.toLowerCase();
          const rawStatus = card.getAttribute('data-status') || '';
          const cardNormStatus = normalizeStatus(rawStatus);
          const cardDivisi = (card.getAttribute('data-divisi') || '').toLowerCase();
          const isDuplicate = card.getAttribute('data-duplicate') === 'true';

          let matchesSearch = searchVal === '' || cardText.includes(searchVal);
          let matchesFilter = true;

          if (activeFilter === 'duplicate') {
            matchesFilter = isDuplicate;
          } else if (activeFilter !== 'all') {
            matchesFilter = (cardNormStatus === normalizeStatus(activeFilter));
          }

          let matchesDivisi = (divisiVal === 'all' || cardDivisi.includes(divisiVal));
          let matchesCardDate = true;
          if (activeDateFilter) {
            const cardTs = parseInt(card.getAttribute('data-date')) || 0;
            if (cardTs) {
              const cd = new Date(cardTs);
              const ck = formatDateKey(cd);
              matchesCardDate = (ck === activeDateFilter);
            } else {
              matchesCardDate = false;
            }
          }

          if (matchesSearch && matchesFilter && matchesDivisi && matchesCardDate) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        // Sort Cards
        cards.sort((a, b) => {
          const dateA = parseInt(a.getAttribute('data-date')) || 0;
          const dateB = parseInt(b.getAttribute('data-date')) || 0;
          const nameA = a.getAttribute('data-name') || '';
          const nameB = b.getAttribute('data-name') || '';
          const statusA = a.getAttribute('data-status') || '';
          const statusB = b.getAttribute('data-status') || '';

          if (sortVal === 'date-desc') return dateB - dateA;
          if (sortVal === 'date-asc') return dateA - dateB;
          if (sortVal === 'name-asc') return nameA.localeCompare(nameB);
          if (sortVal === 'name-desc') return nameB.localeCompare(nameA);
          if (sortVal === 'status-asc') return statusA.localeCompare(statusB);
          if (sortVal === 'status-desc') return statusB.localeCompare(statusA);
          return 0;
        });
        cards.forEach(card => cardContainer.appendChild(card));
      }

      const countEl = document.getElementById('candidateCount');
      if (countEl) countEl.innerText = visibleCount;

      // Handle Empty State when filtered to 0
      let emptyRow = document.getElementById('filterEmptyRow');
      if (visibleCount === 0 && rows.length > 0) {
        if (!emptyRow) {
          emptyRow = document.createElement('tr');
          emptyRow.id = 'filterEmptyRow';
          emptyRow.innerHTML = `
            <td colspan="8" class="text-center py-5 text-muted">
              <div class="py-4">
                <i class="fas fa-filter-circle-xmark fa-3x mb-3 text-secondary opacity-50"></i>
                <h6 class="fw-bold text-dark">Tidak Ada Data Pelamar</h6>
                <p class="small text-muted mb-2">Tidak ditemukan berkas pelamar untuk kriteria filter "${activeFilter}".</p>
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 mt-1" onclick="setFilter('all', null)">
                  <i class="fas fa-rotate-left me-1"></i> Tampilkan Semua Pelamar
                </button>
              </div>
            </td>
          `;
          tbody.appendChild(emptyRow);
        } else {
          emptyRow.style.display = '';
        }
      } else {
        if (emptyRow) emptyRow.style.display = 'none';
      }

      // Sorting Logic
      rows.sort((a, b) => {
        const dateA = parseInt(a.getAttribute('data-date')) || 0;
        const dateB = parseInt(b.getAttribute('data-date')) || 0;
        const nameA = a.getAttribute('data-name') || '';
        const nameB = b.getAttribute('data-name') || '';
        const statusA = a.getAttribute('data-status') || '';
        const statusB = b.getAttribute('data-status') || '';

        if (sortVal === 'date-desc') {
          return dateB - dateA;
        } else if (sortVal === 'date-asc') {
          return dateA - dateB;
        } else if (sortVal === 'name-asc') {
          return nameA.localeCompare(nameB);
        } else if (sortVal === 'name-desc') {
          return nameB.localeCompare(nameA);
        } else if (sortVal === 'status-asc') {
          return statusA.localeCompare(statusB);
        } else if (sortVal === 'status-desc') {
          return statusB.localeCompare(statusA);
        }
        return 0;
      });

      rows.forEach(row => tbody.appendChild(row));
    }

    // View toggle handler: Switch between Dribbble Cards and Spreadsheet Table
    function setViewMode(mode) {
      const cardsList = document.getElementById('candidateCardsList');
      const tableView = document.getElementById('candidateTableView');
      const btnGrid = document.getElementById('btnViewGrid');
      const btnList = document.getElementById('btnViewList');
      if (mode === 'grid') {
        if (cardsList) cardsList.style.display = 'block';
        if (tableView) tableView.style.display = 'none';
        if (btnGrid) btnGrid.classList.add('active');
        if (btnList) btnList.classList.remove('active');
      } else {
        if (cardsList) cardsList.style.display = 'none';
        if (tableView) tableView.style.display = 'block';
        if (btnGrid) btnGrid.classList.remove('active');
        if (btnList) btnList.classList.add('active');
      }
    }

    // =========================================================================
    // DYNAMIC SELECTION CALENDAR SYSTEM (Fully Interactive)
    // =========================================================================
    const today = new Date();
    let currentCalYear = 2026; // Match application epoch or current year
    let currentCalMonth = 9;   // October (0-indexed)
    let activeCalPeriod = 'month'; // 'week', 'month', 'year'
    let activeDateFilter = null;   // 'YYYY-MM-DD' or null
    let currentWeekStart = getMondayOfWeek(new Date(2026, 9, 26));

    const monthNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];
    const shortMonthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Agu', 'Sep', 'Okt', 'Nov', 'Des'];

    function getMondayOfWeek(d) {
      const date = new Date(d);
      const day = (date.getDay() + 6) % 7; // Monday = 0
      date.setDate(date.getDate() - day);
      date.setHours(0, 0, 0, 0);
      return date;
    }

    function formatDateKey(d) {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    function formatDisplayDate(dateKey) {
      if (!dateKey) return '';
      const parts = dateKey.split('-');
      if (parts.length !== 3) return dateKey;
      const day = parseInt(parts[2], 10);
      const mIdx = parseInt(parts[1], 10) - 1;
      const year = parts[0];
      return `${day} ${monthNames[mIdx] || ''} ${year}`;
    }

    function getCandidateDateMap() {
      const counts = {};
      const rows = document.querySelectorAll('#candidateTableBody tr[data-date]');
      rows.forEach(r => {
        const ts = parseInt(r.getAttribute('data-date')) || 0;
        if (ts) {
          const d = new Date(ts);
          const k = formatDateKey(d);
          counts[k] = (counts[k] || 0) + 1;
        }
      });
      return counts;
    }

    function renderCalendar() {
      const calGrid = document.getElementById('calGrid');
      const calYearGrid = document.getElementById('calYearGrid');
      const headerEl = document.getElementById('calMonthDisplay');
      if (!calGrid) return;

      const candidateMap = getCandidateDateMap();
      const todayKey = formatDateKey(today);

      if (activeCalPeriod === 'year') {
        if (headerEl) headerEl.textContent = String(currentCalYear);
        calGrid.classList.add('d-none');
        if (calYearGrid) {
          calYearGrid.classList.remove('d-none');
          let yHtml = '';
          for (let m = 0; m < 12; m++) {
            const isSelectedMonth = (m === currentCalMonth);
            let mCount = 0;
            const prefix = `${currentCalYear}-${String(m + 1).padStart(2, '0')}`;
            for (const k in candidateMap) {
              if (k.startsWith(prefix)) mCount += candidateMap[k];
            }
            yHtml += `
              <button type="button" class="dd-year-month-btn ${isSelectedMonth ? 'active' : ''}" onclick="selectCalMonth(${m})">
                <div class="fw-bold">${shortMonthNames[m]}</div>
                <div style="font-size: 0.65rem; opacity: 0.8;">${mCount > 0 ? mCount + ' berkas' : '-'}</div>
              </button>
            `;
          }
          calYearGrid.innerHTML = yHtml;
        }
        return;
      }

      if (calYearGrid) calYearGrid.classList.add('d-none');
      calGrid.classList.remove('d-none');

      if (activeCalPeriod === 'week') {
        const weekEnd = new Date(currentWeekStart);
        weekEnd.setDate(weekEnd.getDate() + 6);
        if (headerEl) {
          headerEl.textContent = `${currentWeekStart.getDate()} ${shortMonthNames[currentWeekStart.getMonth()]} - ${weekEnd.getDate()} ${shortMonthNames[weekEnd.getMonth()]} ${weekEnd.getFullYear()}`;
        }

        let html = `
          <div class="dd-cal-weekday">Sen</div>
          <div class="dd-cal-weekday">Sel</div>
          <div class="dd-cal-weekday">Rab</div>
          <div class="dd-cal-weekday">Kam</div>
          <div class="dd-cal-weekday">Jum</div>
          <div class="dd-cal-weekday">Sab</div>
          <div class="dd-cal-weekday">Min</div>
        `;

        for (let i = 0; i < 7; i++) {
          const d = new Date(currentWeekStart);
          d.setDate(d.getDate() + i);
          const k = formatDateKey(d);
          const isToday = (k === todayKey);
          const isActive = (k === activeDateFilter);
          const count = candidateMap[k] || 0;

          let classes = ['dd-cal-day'];
          if (isToday) classes.push('today');
          if (isActive) classes.push('active');
          if (count > 0) classes.push('has-event');

          let dot = (count > 0) ? `<span class="dd-event-dot ${isActive ? 'dot-white' : 'dd-event-royal'}"></span>` : '';
          html += `<div class="${classes.join(' ')}" onclick="selectCalDate('${k}')" title="${d.getDate()} ${monthNames[d.getMonth()]} ${d.getFullYear()}${count > 0 ? ' (' + count + ' berkas pelamar)' : ''}">${d.getDate()}${dot}</div>`;
        }
        calGrid.innerHTML = html;
        return;
      }

      // Default: Month View
      if (headerEl) {
        headerEl.textContent = `${monthNames[currentCalMonth]} ${currentCalYear}`;
      }

      let html = `
        <div class="dd-cal-weekday">Sen</div>
        <div class="dd-cal-weekday">Sel</div>
        <div class="dd-cal-weekday">Rab</div>
        <div class="dd-cal-weekday">Kam</div>
        <div class="dd-cal-weekday">Jum</div>
        <div class="dd-cal-weekday">Sab</div>
        <div class="dd-cal-weekday">Min</div>
      `;

      const firstDayIdx = (new Date(currentCalYear, currentCalMonth, 1).getDay() + 6) % 7;
      const daysInMonth = new Date(currentCalYear, currentCalMonth + 1, 0).getDate();
      const daysInPrevMonth = new Date(currentCalYear, currentCalMonth, 0).getDate();

      // Trailing previous month days
      for (let i = firstDayIdx - 1; i >= 0; i--) {
        const dayNum = daysInPrevMonth - i;
        const prevDate = new Date(currentCalYear, currentCalMonth - 1, dayNum);
        const k = formatDateKey(prevDate);
        const count = candidateMap[k] || 0;
        let dot = (count > 0) ? `<span class="dd-event-dot dd-event-royal"></span>` : '';
        html += `<div class="dd-cal-day muted" onclick="navToDate('${k}')" title="${dayNum} ${monthNames[prevDate.getMonth()]} ${prevDate.getFullYear()}">${dayNum}${dot}</div>`;
      }

      // Current month days
      for (let day = 1; day <= daysInMonth; day++) {
        const curDate = new Date(currentCalYear, currentCalMonth, day);
        const k = formatDateKey(curDate);
        const isToday = (k === todayKey);
        const isActive = (k === activeDateFilter);
        const count = candidateMap[k] || 0;

        let classes = ['dd-cal-day'];
        if (isToday) classes.push('today');
        if (isActive) classes.push('active');
        if (count > 0) classes.push('has-event');

        let dot = (count > 0) ? `<span class="dd-event-dot ${isActive ? 'dot-white' : 'dd-event-royal'}"></span>` : '';
        html += `<div class="${classes.join(' ')}" onclick="selectCalDate('${k}')" title="${day} ${monthNames[currentCalMonth]} ${currentCalYear}${count > 0 ? ' (' + count + ' berkas pelamar)' : ''}">${day}${dot}</div>`;
      }

      // Leading next month days
      const totalCells = firstDayIdx + daysInMonth;
      const remaining = (7 - (totalCells % 7)) % 7;
      for (let nextDay = 1; nextDay <= remaining; nextDay++) {
        const nextDate = new Date(currentCalYear, currentCalMonth + 1, nextDay);
        const k = formatDateKey(nextDate);
        const count = candidateMap[k] || 0;
        let dot = (count > 0) ? `<span class="dd-event-dot dd-event-royal"></span>` : '';
        html += `<div class="dd-cal-day muted" onclick="navToDate('${k}')" title="${nextDay} ${monthNames[nextDate.getMonth()]} ${nextDate.getFullYear()}">${nextDay}${dot}</div>`;
      }

      calGrid.innerHTML = html;
    }

    function selectCalDate(dateKey) {
      if (activeDateFilter === dateKey) {
        activeDateFilter = null;
      } else {
        activeDateFilter = dateKey;
        const parts = dateKey.split('-');
        if (parts.length === 3) {
          currentCalYear = parseInt(parts[0], 10);
          currentCalMonth = parseInt(parts[1], 10) - 1;
        }
      }
      updateDateFilterUI();
      renderCalendar();
      applyFilterAndSort();
    }

    function navToDate(dateKey) {
      const parts = dateKey.split('-');
      if (parts.length === 3) {
        currentCalYear = parseInt(parts[0], 10);
        currentCalMonth = parseInt(parts[1], 10) - 1;
      }
      selectCalDate(dateKey);
    }

    function selectCalMonth(m) {
      currentCalMonth = m;
      switchCalPeriod('month');
    }

    function clearCalDateFilter() {
      activeDateFilter = null;
      updateDateFilterUI();
      renderCalendar();
      applyFilterAndSort();
    }

    function updateDateFilterUI() {
      const chipWrap = document.getElementById('activeDateBadgeWrap');
      const chipText = document.getElementById('activeDateBadgeText');
      const noticeWrap = document.getElementById('calDateFilterNotice');
      const noticeText = document.getElementById('calFilterText');

      if (activeDateFilter) {
        const label = formatDisplayDate(activeDateFilter);
        if (chipWrap && chipText) {
          chipText.textContent = `Tanggal: ${label}`;
          chipWrap.classList.remove('d-none');
          chipWrap.classList.add('d-flex');
        }
        if (noticeWrap && noticeText) {
          noticeText.textContent = `Filter: ${label}`;
          noticeWrap.classList.remove('d-none');
        }
      } else {
        if (chipWrap) {
          chipWrap.classList.add('d-none');
          chipWrap.classList.remove('d-flex');
        }
        if (noticeWrap) {
          noticeWrap.classList.add('d-none');
        }
      }
    }

    function switchCalPeriod(period, btn) {
      activeCalPeriod = period;
      document.querySelectorAll('.dd-period-btn').forEach(b => b.classList.remove('active'));
      const targetBtn = btn || document.getElementById(`calTab${period.charAt(0).toUpperCase() + period.slice(1)}`);
      if (targetBtn) targetBtn.classList.add('active');
      renderCalendar();
    }

    function prevCalMonth() {
      prevCalPeriod();
    }

    function nextCalMonth() {
      nextCalPeriod();
    }

    function prevCalPeriod() {
      if (activeCalPeriod === 'month') {
        currentCalMonth--;
        if (currentCalMonth < 0) { currentCalMonth = 11; currentCalYear--; }
      } else if (activeCalPeriod === 'week') {
        currentWeekStart.setDate(currentWeekStart.getDate() - 7);
      } else if (activeCalPeriod === 'year') {
        currentCalYear--;
      }
      renderCalendar();
    }

    function nextCalPeriod() {
      if (activeCalPeriod === 'month') {
        currentCalMonth++;
        if (currentCalMonth > 11) { currentCalMonth = 0; currentCalYear++; }
      } else if (activeCalPeriod === 'week') {
        currentWeekStart.setDate(currentWeekStart.getDate() + 7);
      } else if (activeCalPeriod === 'year') {
        currentCalYear++;
      }
      renderCalendar();
    }

    function toggleCalCollapse() {
      const body = document.getElementById('calBodyWrapper');
      const icon = document.getElementById('calCollapseIcon');
      if (body) {
        const isHidden = body.classList.contains('d-none');
        if (isHidden) {
          body.classList.remove('d-none');
          if (icon) icon.style.transform = 'rotate(0deg)';
        } else {
          body.classList.add('d-none');
          if (icon) icon.style.transform = 'rotate(180deg)';
        }
      }
    }

    window.getRandomToken = getRandomToken;
    window.generateRandomShareLink = generateRandomShareLink;
    window.generateAndCopyShareLink = generateAndCopyShareLink;
    window.setFilter = setFilter;
    window.filterByStatusCard = filterByStatusCard;
    window.filterByDivisiQuick = filterByDivisiQuick;
    window.toggleSort = toggleSort;
    window.applyFilterAndSort = applyFilterAndSort;
    window.setViewMode = setViewMode;
    window.switchCalPeriod = switchCalPeriod;
    window.prevCalMonth = prevCalMonth;
    window.nextCalMonth = nextCalMonth;
    window.prevCalPeriod = prevCalPeriod;
    window.nextCalPeriod = nextCalPeriod;
    window.selectCalDate = selectCalDate;
    window.selectCalMonth = selectCalMonth;
    window.clearCalDateFilter = clearCalDateFilter;
    window.toggleCalCollapse = toggleCalCollapse;
    window.renderCalendar = renderCalendar;

    function toggleRightCalendarPanel() {
      const panel = document.getElementById('hrRightSidebar');
      if (panel) {
        const isHidden = panel.classList.contains('d-none');
        if (isHidden) {
          panel.classList.remove('d-none');
        } else {
          panel.classList.add('d-none');
        }
      }
    }
    window.toggleRightCalendarPanel = toggleRightCalendarPanel;

    function setLaserLoading(active) {
      const bar = document.getElementById('topLaserBar');
      if (bar) bar.classList.toggle('is-loading', active);
    }
    window.setLaserLoading = setLaserLoading;


    // =========================================================================
    // HRD CALENDAR MEMO & AGENDA STUDIO (Right Sidebar Interactive Controller)
    // =========================================================================
    const DEFAULT_HR_MEMOS = [
      { id: 901, tanggal: '2026-10-24', waktu: '10:00', kategori: 'Interview', judul: 'Interview User Head Barista — Budi Santoso', catatan: 'Tes kalibrasi mesin espresso bersama SPV Bar.', selesai: 0 },
      { id: 902, tanggal: '2026-10-24', waktu: '14:00', kategori: 'Memo HRD', judul: 'Cek Referensi Kerja Siti Rahma', catatan: 'Konfirmasi riwayat kerja & disiplin shift.', selesai: 0 },
      { id: 903, tanggal: '2026-10-29', waktu: '09:30', kategori: 'Onboarding', judul: 'Briefing Kontrak & Seragam Karyawan Baru', catatan: 'Outlet KOV Koffie Sula & Heritage Kota Lama.', selesai: 0 }
    ];

    let hrMemosState = [];

    function loadHrMemos() {
      try {
        const raw = localStorage.getItem('kov_hr_memos_v11');
        if (raw) {
          hrMemosState = JSON.parse(raw);
        } else {
          hrMemosState = DEFAULT_HR_MEMOS.slice();
          localStorage.setItem('kov_hr_memos_v11', JSON.stringify(hrMemosState));
        }
      } catch (e) {
        hrMemosState = DEFAULT_HR_MEMOS.slice();
      }
      // Also fetch from server API if available
      if (typeof fetch === 'function') {
        fetch('/api/hr/memos', { headers: { 'Accept': 'application/json' } })
          .then(r => r.ok ? r.json() : null)
          .then(data => {
            if (data && data.ok && Array.isArray(data.memos) && data.memos.length > 0) {
              hrMemosState = data.memos;
              renderHrMemoList();
            }
          })
          .catch(() => {});
      }
      renderHrMemoList();
    }

    function saveHrMemosLocal() {
      try {
        localStorage.setItem('kov_hr_memos_v11', JSON.stringify(hrMemosState));
      } catch (e) {}
    }

    function toggleMemoComposer() {
      const form = document.getElementById('hrMemoForm');
      if (!form) return;
      form.classList.toggle('d-none');
      const input = document.getElementById('hrMemoTitleInput');
      if (!form.classList.contains('d-none') && input) input.focus();
    }

    function renderHrMemoList(newlyAddedId = null) {
      const container = document.getElementById('hrMemoListContainer');
      const dateLabel = document.getElementById('memoActiveDateLabel');
      const dateInput = document.getElementById('hrMemoDateInput');
      if (!container) return;

      if (activeDateFilter) {
        if (dateLabel) dateLabel.textContent = 'Agenda Tanggal: ' + formatDisplayDate(activeDateFilter);
        if (dateInput) dateInput.value = activeDateFilter;
      } else {
        if (dateLabel) dateLabel.textContent = 'Semua Jadwal & Catatan (' + hrMemosState.length + ')';
      }

      const filtered = activeDateFilter
        ? hrMemosState.filter(m => m.tanggal === activeDateFilter)
        : hrMemosState;

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="text-center py-3 px-2 rounded-3 border border-dashed mt-2" style="font-size: 11.5px; color: #64748b;">
            Belum ada memo atau agenda pada tanggal ini. Isi form di atas untuk menambahkan.
          </div>
        `;
        return;
      }

      const catColorMap = {
        'Interview': { border: '#059669', badgeBg: '#d1fae5', badgeText: '#065f46' },
        'Memo HRD': { border: '#d97706', badgeBg: '#fef3c7', badgeText: '#854d0e' },
        'Onboarding': { border: '#2563eb', badgeBg: '#dbeafe', badgeText: '#1e40af' },
        'Deadline': { border: '#dc2626', badgeBg: '#fee2e2', badgeText: '#991b1b' }
      };

      container.innerHTML = filtered.map(m => {
        const c = catColorMap[m.kategori] || catColorMap['Interview'];
        const isNew = newlyAddedId && m.id === newlyAddedId;
        return `
          <div class="kov-memo-item ${m.selesai ? 'is-done' : ''} ${isNew ? 'kov-memo-arrive' : ''}" style="border-left-color: ${c.border};">
            <div class="d-flex align-items-start justify-content-between gap-1">
              <div class="d-flex align-items-start gap-2 min-w-0">
                <input type="checkbox" class="form-check-input mt-0.5 flex-shrink-0" style="cursor: pointer;" ${m.selesai ? 'checked' : ''} onchange="toggleHrMemoDone(${m.id})" title="Tandai Selesai">
                <div class="min-w-0">
                  <div class="kov-memo-item-title fw-bold text-dark" style="font-size: 11.5px; line-height: 1.3;">${m.judul}</div>
                  ${m.catatan ? `<div class="text-muted mt-0.5" style="font-size: 10.5px; line-height: 1.35;">${m.catatan}</div>` : ''}
                  <div class="d-flex align-items-center gap-1.5 mt-1 flex-wrap">
                    <span class="badge" style="background: ${c.badgeBg}; color: ${c.badgeText}; font-size: 9.5px; font-weight: 700; padding: 2px 6px;">${m.kategori}</span>
                    <span class="font-monospace text-muted" style="font-size: 10px;"><i class="far fa-clock me-0.5"></i>${m.tanggal} ${m.waktu || ''}</span>
                  </div>
                </div>
              </div>
              <button type="button" class="btn btn-sm p-0 text-muted hover-danger border-0 bg-transparent" style="font-size: 11px;" onclick="deleteHrMemo(${m.id})" title="Hapus Memo">
                <i class="fas fa-xmark"></i>
              </button>
            </div>
          </div>
        `;
      }).join('');
    }

    function submitHrMemo(e) {
      if (e) e.preventDefault();
      const titleInput = document.getElementById('hrMemoTitleInput');
      const dateInput = document.getElementById('hrMemoDateInput');
      const timeInput = document.getElementById('hrMemoTimeInput');
      const catInput = document.getElementById('hrMemoCatInput');
      const noteInput = document.getElementById('hrMemoNoteInput');
      const saveBtn = document.getElementById('btnSaveHrMemo');

      const judul = titleInput ? titleInput.value.trim() : '';
      if (!judul) {
        if (window.KovToast && typeof window.KovToast.triggerError === 'function') {
          window.KovToast.triggerError(titleInput, 'Judul memo atau agenda HRD tidak boleh kosong!', 'Gagal Menyimpan Memo');
        }
        return;
      }

      if (window.KovToast && typeof window.KovToast.setLoading === 'function') {
        window.KovToast.setLoading(saveBtn, 'Menyimpan...');
      }

      const newMemo = {
        id: Date.now(),
        tanggal: (dateInput && dateInput.value) ? dateInput.value : '2026-10-29',
        waktu: (timeInput && timeInput.value) ? timeInput.value : '10:00',
        kategori: (catInput && catInput.value) ? catInput.value : 'Interview',
        judul: judul,
        catatan: (noteInput && noteInput.value) ? noteInput.value.trim() : '',
        selesai: 0
      };

      setTimeout(() => {
        hrMemosState.unshift(newMemo);
        saveHrMemosLocal();
        if (titleInput) titleInput.value = '';
        if (noteInput) noteInput.value = '';
        if (window.KovToast && typeof window.KovToast.resetLoading === 'function') {
          window.KovToast.resetLoading(saveBtn);
        }
        renderHrMemoList(newMemo.id);
        if (typeof renderCalendar === 'function') renderCalendar();
        if (window.KovToast && typeof window.KovToast.approvalFeedback === 'function') {
          window.KovToast.approvalFeedback({
            title: 'Memo & Agenda HRD Tersimpan',
            message: `[${newMemo.kategori}] "${newMemo.judul}" dijadwalkan pada ${newMemo.tanggal} pukul ${newMemo.waktu}.`,
            duration: 1650
          });
        }
      }, 420);
    }

    function testMemoErrorState() {
      const titleInput = document.getElementById('hrMemoTitleInput');
      if (titleInput) titleInput.value = '';
      if (window.KovToast && typeof window.KovToast.triggerError === 'function') {
        window.KovToast.triggerError(titleInput, 'Kolom Judul Memo & Agenda wajib diisi sebelum menyimpan!', 'Contoh Validasi Error');
      }
    }

    function toggleHrMemoDone(id) {
      const item = hrMemosState.find(m => m.id === id);
      if (!item) return;
      item.selesai = item.selesai ? 0 : 1;
      saveHrMemosLocal();
      renderHrMemoList();
      if (window.KovToast) {
        window.KovToast.success(
          item.selesai ? `Agenda "${item.judul}" ditandai selesai.` : `Agenda "${item.judul}" dibuka kembali.`,
          item.selesai ? 'Agenda Selesai' : 'Status Diperbarui'
        );
      }
    }

    function deleteHrMemo(id) {
      hrMemosState = hrMemosState.filter(m => m.id !== id);
      saveHrMemosLocal();
      renderHrMemoList();
      if (window.KovToast) {
        window.KovToast.info('Catatan memo telah dihapus dari kalender HRD.', 'Memo Dihapus');
      }
    }

    
    function onCalendarDateClickForMemo(dateKey) {
      const form = document.getElementById('hrMemoForm');
      const dateInput = document.getElementById('hrMemoDateInput');
      const titleInput = document.getElementById('hrMemoTitleInput');
      if (dateKey) {
        if (form && form.classList.contains('d-none')) {
          form.classList.remove('d-none');
        }
        if (dateInput) dateInput.value = dateKey;
        if (titleInput) setTimeout(() => titleInput.focus(), 80);
        const dayMemos = (hrMemosState || []).filter(m => m.tanggal === dateKey);
        if (window.KovToast) {
          if (dayMemos.length > 0) {
            window.KovToast.info(
              `Ada ${dayMemos.length} agenda pada ${formatDisplayDate(dateKey)}: "${dayMemos[0].judul}". Silakan isi form di bawah kalender untuk menambah memo baru.`,
              `Pengingat Kalender (${formatDisplayDate(dateKey)})`
            );
          } else {
            window.KovToast.info(
              `Tanggal ${formatDisplayDate(dateKey)} dipilih. Ketik memo atau agenda HRD pada kotak di bawah kalender.`,
              `Isi Memo — ${formatDisplayDate(dateKey)}`
            );
          }
        }
      }
    }
    window.onCalendarDateClickForMemo = onCalendarDateClickForMemo;

    window.toggleMemoComposer = toggleMemoComposer;
    window.submitHrMemo = submitHrMemo;
    window.testMemoErrorState = testMemoErrorState;
    window.toggleHrMemoDone = toggleHrMemoDone;
    window.deleteHrMemo = deleteHrMemo;

    document.addEventListener('DOMContentLoaded', () => {
      loadHrMemos();
      renderCalendar();
      updateKovLiveClock();
      setInterval(updateKovLiveClock, 30000);
      try {
        generateRandomShareLink(false, false);
      } catch (e) {
        console.warn('Initial token generation notice:', e);
      }

      document.querySelectorAll('.kov-filter-pill-botanical').forEach(pill => {
        pill.addEventListener('click', function() {
          const filter = this.getAttribute('data-filter');
          if (filter) setFilter(filter, this);
        });
      });

      const btnAcak = document.getElementById('btnAcakToken');
      if (btnAcak) {
        btnAcak.addEventListener('click', function(e) {
          e.preventDefault();
          generateRandomShareLink(false);
        });
      }

      const btnAcakTopbar = document.getElementById('btnAcakTokenTopbar');
      if (btnAcakTopbar) {
        btnAcakTopbar.addEventListener('click', function(e) {
          e.preventDefault();
          generateRandomShareLink(true);
        });
      }

      const btnSalin = document.getElementById('btnSalinLink');
      if (btnSalin) {
        btnSalin.addEventListener('click', function(e) {
          e.preventDefault();
          generateAndCopyShareLink();
        });
      }

      const btnIconCopy = document.getElementById('btnIconCopy');
      if (btnIconCopy) {
        btnIconCopy.addEventListener('click', function(e) {
          e.preventDefault();
          generateAndCopyShareLink();
        });
      }

      applyFilterAndSort();
    });
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
