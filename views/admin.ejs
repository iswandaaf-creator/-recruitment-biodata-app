        <div class="dd-chart-canvas">
          <div class="dd-chart-y-axis">
            <span>100</span>
            <span>80</span>
            <span>60</span>
            <span>40</span>
            <span>20</span>
            <span>0</span>
          </div>
          <div class="dd-chart-bars-wrap">
            <div class="dd-chart-col">
              <div class="dd-chart-bar-pillar" title="Mei: 20 Masuk, 25 Review, 35 Lolos">
                <div class="dd-bar-segment seg-coral" style="height: 35%;"></div>
                <div class="dd-bar-segment seg-amber" style="height: 25%;"></div>
                <div class="dd-bar-segment seg-royal" style="height: 20%;"></div>
              </div>
              <span class="dd-chart-month-lbl">Mei</span>
            </div>
            <div class="dd-chart-col">
              <div class="dd-chart-bar-pillar" title="Jun: 15 Masuk, 30 Review, 40 Lolos">
                <div class="dd-bar-segment seg-coral" style="height: 40%;"></div>
                <div class="dd-bar-segment seg-amber" style="height: 30%;"></div>
                <div class="dd-bar-segment seg-royal" style="height: 15%;"></div>
              </div>
              <span class="dd-chart-month-lbl">Jun</span>
            </div>
            <div class="dd-chart-col">
              <div class="dd-chart-bar-pillar" title="Jul: 20 Masuk, 20 Review, 50 Lolos">
                <div class="dd-bar-segment seg-coral" style="height: 50%;"></div>
                <div class="dd-bar-segment seg-amber" style="height: 20%;"></div>
                <div class="dd-bar-segment seg-royal" style="height: 20%;"></div>
              </div>
              <span class="dd-chart-month-lbl">Jul</span>
            </div>
            <div class="dd-chart-col">
              <div class="dd-chart-bar-pillar" title="Agt: 15 Masuk, 35 Review, 45 Lolos">
                <div class="dd-bar-segment seg-coral" style="height: 45%;"></div>
                <div class="dd-bar-segment seg-amber" style="height: 35%;"></div>
                <div class="dd-bar-segment seg-royal" style="height: 15%;"></div>
              </div>
              <span class="dd-chart-month-lbl">Agt</span>
            </div>
            <div class="dd-chart-col">
              <div class="dd-chart-bar-pillar" title="Sep: 15 Masuk, 20 Review, 60 Lolos">
                <div class="dd-bar-segment seg-coral" style="height: 60%;"></div>
                <div class="dd-bar-segment seg-amber" style="height: 20%;"></div>
                <div class="dd-bar-segment seg-royal" style="height: 15%;"></div>
              </div>
              <span class="dd-chart-month-lbl">Sep</span>
            </div>
            <div class="dd-chart-col">
              <div class="dd-chart-bar-pillar" title="Okt: 10 Masuk, 15 Review, 70 Lolos">
                <div class="dd-bar-segment seg-coral" style="height: 70%;"></div>
                <div class="dd-bar-segment seg-amber" style="height: 15%;"></div>
                <div class="dd-bar-segment seg-royal" style="height: 10%;"></div>
              </div>
              <span class="dd-chart-month-lbl">Okt</span>
            </div>
          </div>
        </div>

        <div class="dd-chart-legend">
          <div class="dd-legend-item"><span class="dd-legend-dot seg-coral"></span> Berkas Masuk</div>
          <div class="dd-legend-item"><span class="dd-legend-dot seg-amber"></span> Review</div>
          <div class="dd-legend-item"><span class="dd-legend-dot seg-royal"></span> Lolos</div>
        </div>
      </div>

    </aside>

  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    function getAppBaseUrl() {
      if (window.location && window.location.origin && window.location.origin !== 'null') {
        return window.location.origin;
      }
      return 'https://internal.kovgroups.com';
    }

    function getRandomToken() {
      const chars = '23456789abcdefghjkmnpqrstuvwxyz';
      let result = '';
      for (let i = 0; i < 8; i++) {
        result += chars.charAt(Math.floor(Math.random() * chars.length));
      }
      return 'c-' + result;
    }

    function generateRandomShareLink(shouldCopy = true) {
      const token = getRandomToken();
      const url = getAppBaseUrl() + '/?ref=' + token;
      const shareEl = document.getElementById('shareUrl');
      if (shareEl) {
        shareEl.innerText = url;
        shareEl.classList.add('bg-warning', 'bg-opacity-25');
        setTimeout(() => shareEl.classList.remove('bg-warning', 'bg-opacity-25'), 300);
      }

      const btnAcak = document.getElementById('btnAcakToken');
      if (btnAcak) {
        if (!btnAcak.getAttribute('data-orig-content')) {
          btnAcak.setAttribute('data-orig-content', btnAcak.innerHTML);
        }
        const origContent = btnAcak.getAttribute('data-orig-content');
        btnAcak.innerHTML = '<i class="fas fa-check me-1 text-success"></i> Token Baru!';
        clearTimeout(btnAcak._timer);
        btnAcak._timer = setTimeout(() => {
          btnAcak.innerHTML = origContent;
        }, 900);
      }

      if (shouldCopy) {
        copyTextWithFeedback(url, 'Tautan formulir rekrutmen berhasil disalin ke clipboard:\n' + url);
      } else if (window.KovToast && typeof window.KovToast.info === 'function') {
        window.KovToast.info('Token baru aktif: ' + token, 'Token Diperbarui');
      }
      return url;
    }

    function generateAndCopyShareLink() {
      const shareEl = document.getElementById('shareUrl');
      const url = (shareEl && shareEl.innerText.trim() && !shareEl.innerText.includes('Sysujatg')) 
        ? shareEl.innerText.trim() 
        : (getAppBaseUrl() + '/?ref=' + getRandomToken());
      
      if (shareEl) shareEl.innerText = url;
      copyTextWithFeedback(url, 'Tautan formulir rekrutmen berhasil disalin:\n' + url);
    }

    function copyTextWithFeedback(text, successMsg) {
      const btnSalin = document.getElementById('btnSalinLink');
      const iconCopy = document.getElementById('iconCopySmall');
      if (btnSalin && !btnSalin.getAttribute('data-orig-html')) {
        btnSalin.setAttribute('data-orig-html', btnSalin.innerHTML);
      }
      const origSalinText = btnSalin ? btnSalin.getAttribute('data-orig-html') : '';

      function triggerSuccessUI() {
        if (btnSalin) {
          btnSalin.innerHTML = '<i class="fas fa-check me-1"></i> Tersalin!';
          btnSalin.style.background = '#484ec9';
          clearTimeout(btnSalin._timer);
          btnSalin._timer = setTimeout(() => {
            btnSalin.innerHTML = origSalinText;
            btnSalin.style.background = '';
          }, 1500);
        }
        if (iconCopy) {
          iconCopy.className = 'fas fa-check text-success';
          clearTimeout(iconCopy._timer);
          iconCopy._timer = setTimeout(() => {
            iconCopy.className = 'far fa-copy';
          }, 1500);
        }
        if (window.KovToast && typeof window.KovToast.success === 'function') {
          window.KovToast.success(successMsg || 'Berhasil disalin ke clipboard!', 'Tautan Disalin');
        }
      }

      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).then(triggerSuccessUI).catch(() => fallbackClipboardCopy(text, triggerSuccessUI));
      } else {
        fallbackClipboardCopy(text, triggerSuccessUI);
      }
    }

    function fallbackClipboardCopy(text, onSuccess) {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.top = '-9999px';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        const success = document.execCommand('copy');
        document.body.removeChild(ta);
        if (success && onSuccess) onSuccess();
        else if (window.KovToast) window.KovToast.info('Tautan: ' + text, 'Salin Manual');
      } catch (e) {
        if (window.KovToast) window.KovToast.info('Tautan: ' + text, 'Salin Manual');
      }
    }

    // Real-Time Date & Time Clock
    function updateKovLiveClock() {
      const dateEl = document.getElementById('kovLiveDate');
      const timeEl = document.getElementById('kovLiveTime');
      try {
        const now = new Date();
        const dateStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Jakarta' });
        const timeStr = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Jakarta' }).replace(/\./g, ':') + ' WIB';
        if (dateEl) dateEl.textContent = dateStr;
        if (timeEl) timeEl.textContent = timeStr;
      } catch (e) {
        if (dateEl) dateEl.textContent = '25 Okt 2026';
        if (timeEl) timeEl.textContent = '00:20 WIB';
      }
    }

    let activeFilter = 'all';

    function normalizeStatus(st) {
      if (!st) return 'Belum Diproses';
      const s = String(st).trim().toLowerCase();
      if (s === 'diterima' || s === 'lolos' || s === 'accepted') return 'Diterima';
      if (s === 'dipertimbangkan' || s === 'hold' || s === 'cadangan') return 'Dipertimbangkan';
      if (s === 'ditolak' || s === 'rejected' || s === 'gagal') return 'Ditolak';
      return 'Belum Diproses';
    }

    function setFilter(filterType, btnElem) {
      activeFilter = filterType;

      // Update segmented pills active state
      document.querySelectorAll('.kov-filter-pill-botanical').forEach(btn => {
        btn.classList.remove('active');
      });
      if (btnElem) {
        btnElem.classList.add('active');
      } else {
        const matchingBtn = document.querySelector(`.kov-filter-pill-botanical[data-filter="${filterType}"]`);
        if (matchingBtn) matchingBtn.classList.add('active');
      }

      applyFilterAndSort();
    }

    function filterByStatusCard(status) {
      setFilter(status, null);
      const tableCard = document.querySelector('.kov-table-card');
      if (tableCard) {
        tableCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    function filterByDivisiQuick(divisi) {
      const select = document.getElementById('divisiSelect');
      if (select) {
        select.value = divisi;
        applyFilterAndSort();
        const tableCard = document.querySelector('.kov-table-card');
        if (tableCard) {
          tableCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    }

    function selectCandidateCard(el) {
      document.querySelectorAll('.dd-file-card-item').forEach(c => c.classList.remove('active', 'selected'));
      if (el) el.classList.add('active', 'selected');
    }

    function toggleSort(type) {
      const select = document.getElementById('sortSelect');
      if (!select) return;
      if (type === 'date') {
        select.value = select.value === 'date-desc' ? 'date-asc' : 'date-desc';
      } else if (type === 'name') {
        select.value = select.value === 'name-asc' ? 'name-desc' : 'name-asc';
      } else if (type === 'status') {
        select.value = select.value === 'status-asc' ? 'status-desc' : 'status-asc';
      }
      applyFilterAndSort();
    }

    function applyFilterAndSort() {
      const searchVal = (document.getElementById('searchInput') ? document.getElementById('searchInput').value : '').toLowerCase().trim();
      const sortVal = document.getElementById('sortSelect') ? document.getElementById('sortSelect').value : 'date-desc';
      const divisiVal = (document.getElementById('divisiSelect') ? document.getElementById('divisiSelect').value : 'all').toLowerCase();
      const tbody = document.getElementById('candidateTableBody');
      if (!tbody) return;

      const rows = Array.from(tbody.querySelectorAll('tr[data-id]'));
      let visibleCount = 0;

      rows.forEach(row => {
        const rowText = row.innerText.toLowerCase();
        const rawStatus = row.getAttribute('data-status') || '';
        const rowNormStatus = normalizeStatus(rawStatus);
        const rowDivisi = (row.getAttribute('data-divisi') || '').toLowerCase();
        const isDuplicate = row.getAttribute('data-duplicate') === 'true';

        let matchesSearch = searchVal === '' || rowText.includes(searchVal);
        let matchesFilter = true;

        if (activeFilter === 'duplicate') {
          matchesFilter = isDuplicate;
        } else if (activeFilter !== 'all') {
          matchesFilter = (rowNormStatus === normalizeStatus(activeFilter));
        }

        let matchesDivisi = (divisiVal === 'all' || rowDivisi.includes(divisiVal));

        if (matchesSearch && matchesFilter && matchesDivisi) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      // Synchronize Floating Card items in #candidateCardsList
      const cardContainer = document.getElementById('candidateCardsList');
      if (cardContainer) {
        const cards = Array.from(cardContainer.querySelectorAll('.dd-file-card-item'));
        cards.forEach(card => {
          const cardText = card.innerText.toLowerCase();
          const rawStatus = card.getAttribute('data-status') || '';
          const cardNormStatus = normalizeStatus(rawStatus);
          const cardDivisi = (card.getAttribute('data-divisi') || '').toLowerCase();
          const isDuplicate = card.getAttribute('data-duplicate') === 'true';

          let matchesSearch = searchVal === '' || cardText.includes(searchVal);
          let matchesFilter = true;

          if (activeFilter === 'duplicate') {
            matchesFilter = isDuplicate;
          } else if (activeFilter !== 'all') {
            matchesFilter = (cardNormStatus === normalizeStatus(activeFilter));
          }

          let matchesDivisi = (divisiVal === 'all' || cardDivisi.includes(divisiVal));

          if (matchesSearch && matchesFilter && matchesDivisi) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        // Sort Cards
        cards.sort((a, b) => {
          const dateA = parseInt(a.getAttribute('data-date')) || 0;
          const dateB = parseInt(b.getAttribute('data-date')) || 0;
          const nameA = a.getAttribute('data-name') || '';
          const nameB = b.getAttribute('data-name') || '';
          const statusA = a.getAttribute('data-status') || '';
          const statusB = b.getAttribute('data-status') || '';

          if (sortVal === 'date-desc') return dateB - dateA;
          if (sortVal === 'date-asc') return dateA - dateB;
          if (sortVal === 'name-asc') return nameA.localeCompare(nameB);
          if (sortVal === 'name-desc') return nameB.localeCompare(nameA);
          if (sortVal === 'status-asc') return statusA.localeCompare(statusB);
          if (sortVal === 'status-desc') return statusB.localeCompare(statusA);
          return 0;
        });
        cards.forEach(card => cardContainer.appendChild(card));
      }

      const countEl = document.getElementById('candidateCount');
      if (countEl) countEl.innerText = visibleCount;

      // Handle Empty State when filtered to 0
      let emptyRow = document.getElementById('filterEmptyRow');
      if (visibleCount === 0 && rows.length > 0) {
        if (!emptyRow) {
          emptyRow = document.createElement('tr');
          emptyRow.id = 'filterEmptyRow';
          emptyRow.innerHTML = `
            <td colspan="8" class="text-center py-5 text-muted">
              <div class="py-4">
                <i class="fas fa-filter-circle-xmark fa-3x mb-3 text-secondary opacity-50"></i>
                <h6 class="fw-bold text-dark">Tidak Ada Data Pelamar</h6>
                <p class="small text-muted mb-2">Tidak ditemukan berkas pelamar untuk kriteria filter "${activeFilter}".</p>
                <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 mt-1" onclick="setFilter('all', null)">
                  <i class="fas fa-rotate-left me-1"></i> Tampilkan Semua Pelamar
                </button>
              </div>
            </td>
          `;
          tbody.appendChild(emptyRow);
        } else {
          emptyRow.style.display = '';
        }
      } else {
        if (emptyRow) emptyRow.style.display = 'none';
      }

      // Sorting Logic
      rows.sort((a, b) => {
        const dateA = parseInt(a.getAttribute('data-date')) || 0;
        const dateB = parseInt(b.getAttribute('data-date')) || 0;
        const nameA = a.getAttribute('data-name') || '';
        const nameB = b.getAttribute('data-name') || '';
        const statusA = a.getAttribute('data-status') || '';
        const statusB = b.getAttribute('data-status') || '';

        if (sortVal === 'date-desc') {
          return dateB - dateA;
        } else if (sortVal === 'date-asc') {
          return dateA - dateB;
        } else if (sortVal === 'name-asc') {
          return nameA.localeCompare(nameB);
        } else if (sortVal === 'name-desc') {
          return nameB.localeCompare(nameA);
        } else if (sortVal === 'status-asc') {
          return statusA.localeCompare(statusB);
        } else if (sortVal === 'status-desc') {
          return statusB.localeCompare(statusA);
        }
        return 0;
      });

      rows.forEach(row => tbody.appendChild(row));
    }

    // View toggle handler: Switch between Dribbble Cards and Spreadsheet Table
    function setViewMode(mode) {
      const cardsList = document.getElementById('candidateCardsList');
      const tableView = document.getElementById('candidateTableView');
      const btnGrid = document.getElementById('btnViewGrid');
      const btnList = document.getElementById('btnViewList');
      if (mode === 'grid') {
        if (cardsList) cardsList.style.display = 'block';
        if (tableView) tableView.style.display = 'none';
        if (btnGrid) btnGrid.classList.add('active');
        if (btnList) btnList.classList.remove('active');
      } else {
        if (cardsList) cardsList.style.display = 'none';
        if (tableView) tableView.style.display = 'block';
        if (btnGrid) btnGrid.classList.remove('active');
        if (btnList) btnList.classList.add('active');
      }
    }

    // Calendar widget handlers
    let currentCalMonth = 9; // October (0-indexed)
    let currentCalYear = 2026;
    const monthNames = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'];

    function switchCalPeriod(period, btn) {
      document.querySelectorAll('.dd-period-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
    }

    function prevCalMonth() {
      currentCalMonth--;
      if (currentCalMonth < 0) { currentCalMonth = 11; currentCalYear--; }
      updateCalHeader();
    }

    function nextCalMonth() {
      currentCalMonth++;
      if (currentCalMonth > 11) { currentCalMonth = 0; currentCalYear++; }
      updateCalHeader();
    }

    function updateCalHeader() {
      const el = document.getElementById('calMonthDisplay');
      if (el) el.textContent = monthNames[currentCalMonth] + ' ' + currentCalYear;
    }

    window.getRandomToken = getRandomToken;
    window.generateRandomShareLink = generateRandomShareLink;
    window.generateAndCopyShareLink = generateAndCopyShareLink;
    window.setFilter = setFilter;
    window.filterByStatusCard = filterByStatusCard;
    window.filterByDivisiQuick = filterByDivisiQuick;
    window.toggleSort = toggleSort;
    window.applyFilterAndSort = applyFilterAndSort;
    window.setViewMode = setViewMode;
    window.switchCalPeriod = switchCalPeriod;
    window.prevCalMonth = prevCalMonth;
    window.nextCalMonth = nextCalMonth;

    document.addEventListener('DOMContentLoaded', () => {
      updateKovLiveClock();
      setInterval(updateKovLiveClock, 30000);
      try {
        generateRandomShareLink(false);
      } catch (e) {
        console.warn('Initial token generation notice:', e);
      }

      document.querySelectorAll('.kov-filter-pill-botanical').forEach(pill => {
        pill.addEventListener('click', function() {
          const filter = this.getAttribute('data-filter');
          if (filter) setFilter(filter, this);
        });
      });

      const btnAcak = document.getElementById('btnAcakToken');
      if (btnAcak) {
        btnAcak.addEventListener('click', function(e) {
          e.preventDefault();
          generateRandomShareLink(false);
        });
      }

      const btnSalin = document.getElementById('btnSalinLink');
      if (btnSalin) {
        btnSalin.addEventListener('click', function(e) {
          e.preventDefault();
          generateAndCopyShareLink();
        });
      }

      const btnIconCopy = document.getElementById('btnIconCopy');
      if (btnIconCopy) {
        btnIconCopy.addEventListener('click', function(e) {
          e.preventDefault();
          generateAndCopyShareLink();
        });
      }

      const btnNextCal = document.getElementById('btnNextCalMonth');
      if (btnNextCal) {
        btnNextCal.addEventListener('click', function(e) {
          e.preventDefault();
          nextCalMonth();
        });
      }

      const btnPrevCal = document.getElementById('btnPrevCalMonth');
      if (btnPrevCal) {
        btnPrevCal.addEventListener('click', function(e) {
          e.preventDefault();
          prevCalMonth();
        });
      }

      applyFilterAndSort();
    });
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
