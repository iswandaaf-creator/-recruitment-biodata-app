              <label class="form-label mb-1" style="font-size: 10.5px; font-weight: 600;">Jam</label>
              <input type="time" id="hrMemoTimeInput" class="form-control form-control-sm font-monospace" style="font-size: 11.5px; height: 30px;" value="10:00">
