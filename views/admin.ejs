            <button type="button" class="btn-kov-outline btn-sm" style="height: 30px; min-height: 30px; font-size: 11px; padding: 0 8px;" onclick="testMemoErrorState()" title="Uji Animasi Error Validasi">
              <i class="fas fa-bolt text-danger"></i> Uji Error
            </button>
            <button type="submit" id="btnSaveHrMemo" class="btn-kov-primary btn-sm flex-grow-1" style="height: 30px; min-height: 30px; font-size: 11.5px;">
              <i class="fas fa-check"></i> Simpan Memo
