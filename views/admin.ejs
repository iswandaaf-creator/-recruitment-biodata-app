      <!-- "Storage / Rekrutmen Analytics" Stacked Bar Chart -->
      <div class="dd-storage-chart-card">
        <div class="dd-chart-header">
          <div class="dd-chart-capacity">
            <span class="dd-chart-sub">Kapasitas Berkas</span>
            <span class="dd-chart-val">Tersedia 73 GB</span>
          </div>
          <button type="button" class="dd-chart-select-pill">
            <i class="far fa-calendar"></i> Bulan Ini <i class="fas fa-chevron-down" style="font-size: 0.65rem;"></i>
          </button>
