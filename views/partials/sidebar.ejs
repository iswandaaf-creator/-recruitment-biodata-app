<!-- Backdrop for mobile sidebar drawer -->
<div class="kov-sidebar-backdrop" id="sidebarBackdrop"></div>

<!-- Master Sidebar Navigation (Compact & Streamlined) -->
<aside class="kov-sidebar" id="appSidebar">
  
  <!-- Brand Header -->
  <div class="kov-sidebar-brand">
    <a href="/admin" class="kov-brand-info">
      <div class="kov-brand-logo">
        <img src="/logo_kov_hijau.png" alt="KOV Logo">
      </div>
      <div>
        <h1 class="kov-brand-name">KOV Group</h1>
        <span class="kov-brand-sub">Management Portal</span>
      </div>
    </a>
    <button type="button" class="btn btn-sm text-white-50 p-1 d-lg-none" id="sidebarCloseBtn" aria-label="Close Sidebar">
      <i class="fas fa-times fs-5"></i>
    </button>
  </div>

  <%
    const userRole = (typeof user !== 'undefined' && user && user.role) ? user.role.toLowerCase().trim() : '';
    const isSuperOrAdmin = userRole === 'superadmin' || userRole === 'admin';
    const canHR = isSuperOrAdmin || userRole === 'hr';
    const canReviewer = isSuperOrAdmin || userRole === 'user' || (typeof user !== 'undefined' && user && user.reviewer_divisions && user.reviewer_divisions.trim().length > 0);
    const canOperasional = isSuperOrAdmin || userRole === 'operasional' || userRole === 'admin_operasional';
    const canIT = isSuperOrAdmin || userRole === 'it';
    const canUsers = isSuperOrAdmin;
  %>

  <!-- Navigation Links (Grouped & Streamlined) -->
  <nav class="kov-sidebar-nav">
    
    <!-- Group: HR & Recruitment -->
    <% if (canHR || canReviewer) { %>
      <div class="kov-nav-group-title">Rekrutmen &amp; HR</div>
      <% if (canHR) { %>
        <a href="/admin" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'hr') ? 'active' : '' %>">
          <i class="fas fa-users"></i>
          <span>Dashboard HR</span>
        </a>
      <% } %>
      <% if (canReviewer) { %>
        <a href="/reviewer" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'reviewer') ? 'active' : '' %>">
          <i class="fas fa-user-check"></i>
          <span>Reviewer Divisi</span>
        </a>
      <% } %>
    <% } %>

    <!-- Group: Operasional -->
    <% if (canOperasional) { %>
      <div class="kov-nav-group-title">Operasional</div>
      <a href="/admin/operasional" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'operasional') ? 'active' : '' %>">
        <i class="fas fa-boxes-stacked"></i>
        <span>Berita Acara (BA)</span>
      </a>
      <a href="/admin/operasional/po" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'po') ? 'active' : '' %>">
        <i class="fas fa-receipt"></i>
        <span>Purchase Order</span>
      </a>
      <a href="/admin/operasional/surat-tugas" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'surat_tugas') ? 'active' : '' %>">
        <i class="fas fa-file-signature"></i>
        <span>Surat Tugas &amp; LPJ</span>
      </a>
    <% } %>

    <!-- Group: Infrastruktur & IT -->
    <% if (canIT) { %>
      <div class="kov-nav-group-title">Infrastruktur &amp; IT</div>
      <a href="/admin/it" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'it') ? 'active' : '' %>">
        <i class="fas fa-laptop-code"></i>
        <span>Rekap Belanja IT</span>
      </a>
    <% } %>

    <!-- Group: Administrasi & Akun -->
    <% if (canUsers) { %>
      <div class="kov-nav-group-title">Sistem</div>
      <a href="/admin/users" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'users') ? 'active' : '' %>">
        <i class="fas fa-user-shield"></i>
        <span>Kelola User &amp; Role</span>
      </a>
    <% } %>

  </nav>

  <!-- User Profile & Session Footer -->
  <div class="kov-sidebar-footer">
    <div class="kov-user-badge-box">
      <div class="kov-user-avatar">
        <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'U' %>
      </div>
      <div class="flex-grow-1 min-w-0">
        <div class="text-white small fw-bold text-truncate leading-tight">
          <%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : ((typeof user !== 'undefined' && user && user.username) ? user.username : 'User') %>
        </div>
        <div class="text-white-50" style="font-size: 10.5px;">
          <span class="badge bg-success bg-opacity-25 text-success py-0 px-1 border border-success border-opacity-25">
            <%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Staff' %>
          </span>
        </div>
      </div>
    </div>
    <a href="/admin/logout" onclick="sessionStorage.clear();" class="kov-logout-link">
      <i class="fas fa-sign-out-alt"></i>
      <span>Keluar (Logout)</span>
    </a>
  </div>

</aside>

<script>
  (function() {
    const sidebar = document.getElementById('appSidebar');
    const backdrop = document.getElementById('sidebarBackdrop');
    const closeBtn = document.getElementById('sidebarCloseBtn');

    window.toggleKovSidebar = function() {
      if (sidebar && backdrop) {
        sidebar.classList.toggle('show');
        backdrop.classList.toggle('show');
      }
    };

    if (backdrop) {
      backdrop.addEventListener('click', function() {
        if (sidebar) sidebar.classList.remove('show');
        backdrop.classList.remove('show');
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        if (sidebar) sidebar.classList.remove('show');
        if (backdrop) backdrop.classList.remove('show');
      });
    }

    window.addEventListener('resize', function() {
      if (window.innerWidth >= 992) {
        if (sidebar) sidebar.classList.remove('show');
        if (backdrop) backdrop.classList.remove('show');
      }
    });
  })();
</script>
