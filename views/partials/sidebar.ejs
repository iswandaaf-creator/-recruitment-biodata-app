<!-- Backdrop for mobile sidebar drawer -->
<div class="kov-sidebar-backdrop" id="sidebarBackdrop"></div>

<!-- Master Sidebar Navigation (Collapsible Mini/Full & Streamlined) -->
<aside class="kov-sidebar" id="appSidebar">
  
  <!-- Immediate inline script to prevent layout flicker & sync theme on reload -->
  <script>
    (function() {
      try {
        if (localStorage.getItem('kov_sidebar_collapsed') === 'true' && window.innerWidth >= 992) {
          document.getElementById('appSidebar').classList.add('collapsed');
          const mc = document.querySelector('.kov-main-content');
          if (mc) mc.classList.add('collapsed');
        }
        if (localStorage.getItem('kov_theme') === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
          if (document.body) document.body.classList.add('theme-dark');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Brand Header -->
  <div class="kov-sidebar-brand">
    <a href="/admin" class="kov-brand-info" title="KOV Koffie Portal">
      <div class="kov-brand-logo">
        <img src="/logo_kov_2.jpg" alt="KOV Koffie Logo" style="border-radius: 8px;">
      </div>
      <div class="kov-brand-text-group">
        <h1 class="kov-brand-name">KOV Koffie</h1>
        <span class="kov-brand-sub">Management Portal</span>
      </div>
    </a>
    
    <!-- Mobile close drawer button (<992px) -->
    <button type="button" class="btn btn-sm text-white-50 p-1 d-lg-none" id="sidebarCloseBtn" aria-label="Close Sidebar">
      <i class="fas fa-times fs-5"></i>
    </button>

    <!-- Desktop collapse/fold button (>=992px) -->
    <button type="button" class="kov-sidebar-collapse-btn d-none d-lg-inline-flex" id="sidebarCollapseBtn" onclick="toggleSidebarCollapse()" title="Lipat / Perluas Sidebar" aria-label="Collapse Sidebar">
      <i class="fas fa-angles-left" id="sidebarCollapseIcon"></i>
    </button>
  </div>

  <%
    const userRole = (typeof user !== 'undefined' && user && user.role) ? user.role.toLowerCase().trim() : '';
    const isSuperOrAdmin = userRole === 'superadmin' || userRole === 'admin';
    const canHR = isSuperOrAdmin || userRole === 'hr';
    const canReviewer = isSuperOrAdmin || userRole === 'user' || (typeof user !== 'undefined' && user && user.reviewer_divisions && user.reviewer_divisions.trim().length > 0);
    const canOperasional = isSuperOrAdmin || userRole === 'operasional' || userRole === 'admin_operasional';
    const canIT = isSuperOrAdmin || userRole === 'it';
    const canUsers = isSuperOrAdmin;
  %>

  <!-- Navigation Links (Grouped & Streamlined with Tooltips) -->
  <nav class="kov-sidebar-nav">
    
    <!-- Group: HR & Recruitment -->
    <% if (canHR || canReviewer) { %>
      <div class="kov-nav-group-title">Rekrutmen &amp; HR</div>
      <% if (canHR) { %>
        <a href="/admin" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'hr') ? 'active' : '' %>" data-tooltip="Dashboard HR" title="Dashboard HR">
          <i class="fas fa-users"></i>
          <span>Dashboard HR</span>
        </a>
      <% } %>
      <% if (canReviewer) { %>
        <a href="/reviewer" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'reviewer') ? 'active' : '' %>" data-tooltip="Reviewer Divisi" title="Reviewer Divisi">
          <i class="fas fa-user-check"></i>
          <span>Reviewer Divisi</span>
        </a>
      <% } %>
    <% } %>

    <!-- Group: Operasional -->
    <% if (canOperasional) { %>
      <div class="kov-nav-group-title">Operasional</div>
      <a href="/admin/operasional" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'operasional') ? 'active' : '' %>" data-tooltip="Berita Acara (BA)" title="Berita Acara (BA)">
        <i class="fas fa-boxes-stacked"></i>
        <span>Berita Acara (BA)</span>
      </a>
      <a href="/admin/operasional/po" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'po') ? 'active' : '' %>" data-tooltip="Purchase Order" title="Purchase Order">
        <i class="fas fa-receipt"></i>
        <span>Purchase Order</span>
      </a>
      <a href="/admin/operasional/surat-tugas" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'surat_tugas') ? 'active' : '' %>" data-tooltip="Surat Tugas & LPJ" title="Surat Tugas & LPJ">
        <i class="fas fa-file-signature"></i>
        <span>Surat Tugas &amp; LPJ</span>
      </a>
    <% } %>

    <!-- Group: Infrastruktur & IT -->
    <% if (canIT) { %>
      <div class="kov-nav-group-title">Infrastruktur &amp; IT</div>
      <a href="/admin/it" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'it') ? 'active' : '' %>" data-tooltip="Rekap Belanja IT" title="Rekap Belanja IT">
        <i class="fas fa-laptop-code"></i>
        <span>Rekap Belanja IT</span>
      </a>
    <% } %>

    <!-- Group: Administrasi & Akun -->
    <% if (canUsers) { %>
      <div class="kov-nav-group-title">Sistem</div>
      <a href="/admin/users" class="kov-nav-item <%= (typeof active !== 'undefined' && active === 'users') ? 'active' : '' %>" data-tooltip="Kelola User & Role" title="Kelola User & Role">
        <i class="fas fa-user-shield"></i>
        <span>Kelola User &amp; Role</span>
      </a>
    <% } %>

  </nav>

  <!-- User Profile & Session Footer -->
  <div class="kov-sidebar-footer">
    <!-- Coinbase Dual-Theme Switcher Button -->
    <button type="button" class="kov-theme-toggle-sidebar" onclick="toggleKovTheme()" id="themeToggleSidebarBtn" title="Ganti Mode Gelap / Terang">
      <i class="fas fa-moon" id="themeSidebarIcon"></i>
      <span id="themeSidebarText">Mode Gelap</span>
    </button>

    <div class="kov-user-badge-box" title="<%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'User' %> (<%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Staff' %>)">
      <div class="kov-user-avatar">
        <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'U' %>
      </div>
      <div class="flex-grow-1 min-w-0">
        <div class="text-white small fw-bold text-truncate leading-tight">
          <%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : ((typeof user !== 'undefined' && user && user.username) ? user.username : 'User') %>
        </div>
        <div class="text-white-50" style="font-size: 10.5px;">
          <span class="badge bg-success bg-opacity-25 text-success py-0 px-1 border border-success border-opacity-25">
            <%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Staff' %>
          </span>
        </div>
      </div>
    </div>
    <a href="/admin/logout" onclick="sessionStorage.clear();" class="kov-logout-link" data-tooltip="Keluar (Logout)" title="Keluar (Logout)">
      <i class="fas fa-sign-out-alt"></i>
      <span>Keluar (Logout)</span>
    </a>
  </div>

</aside>

<script>
  (function() {
    const sidebar = document.getElementById('appSidebar');
    const backdrop = document.getElementById('sidebarBackdrop');
    const closeBtn = document.getElementById('sidebarCloseBtn');
    const collapseIcon = document.getElementById('sidebarCollapseIcon');
    const appShell = document.querySelector('.kov-app-shell');
    const mainContent = document.querySelector('.kov-main-content');

    // Apply saved state on DOM ready
    function applySavedCollapseState() {
      try {
        const isCollapsed = localStorage.getItem('kov_sidebar_collapsed') === 'true';
        if (isCollapsed && window.innerWidth >= 992) {
          if (sidebar) sidebar.classList.add('collapsed');
          if (mainContent) mainContent.classList.add('collapsed');
          if (appShell) appShell.classList.add('sidebar-collapsed');
          if (collapseIcon) {
            collapseIcon.classList.remove('fa-angles-left');
            collapseIcon.classList.add('fa-angles-right');
          }
        }
      } catch (e) {}
    }

    applySavedCollapseState();

    window.toggleSidebarCollapse = function() {
      if (!sidebar) return;
      const willCollapse = !sidebar.classList.contains('collapsed');
      sidebar.classList.toggle('collapsed', willCollapse);
      if (mainContent) mainContent.classList.toggle('collapsed', willCollapse);
      if (appShell) appShell.classList.toggle('sidebar-collapsed', willCollapse);
      
      if (collapseIcon) {
        if (willCollapse) {
          collapseIcon.classList.remove('fa-angles-left');
          collapseIcon.classList.add('fa-angles-right');
        } else {
          collapseIcon.classList.remove('fa-angles-right');
          collapseIcon.classList.add('fa-angles-left');
        }
      }
      try {
        localStorage.setItem('kov_sidebar_collapsed', willCollapse ? 'true' : 'false');
      } catch (e) {}
    };

    window.toggleKovSidebar = function() {
      if (window.innerWidth >= 992) {
        window.toggleSidebarCollapse();
      } else {
        if (sidebar && backdrop) {
          sidebar.classList.toggle('show');
          backdrop.classList.toggle('show');
        }
      }
    };

    if (backdrop) {
      backdrop.addEventListener('click', function() {
        if (sidebar) sidebar.classList.remove('show');
        backdrop.classList.remove('show');
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        if (sidebar) sidebar.classList.remove('show');
        if (backdrop) backdrop.classList.remove('show');
      });
    }

    window.addEventListener('resize', function() {
      if (window.innerWidth >= 992) {
        if (sidebar) sidebar.classList.remove('show');
        if (backdrop) backdrop.classList.remove('show');
        applySavedCollapseState();
      } else {
        if (sidebar) sidebar.classList.remove('collapsed');
        if (mainContent) mainContent.classList.remove('collapsed');
        if (appShell) appShell.classList.remove('sidebar-collapsed');
      }
    });
  })();
</script>

<!-- Human-Crafted Toast & Micro-Interaction System -->
<script src="/assets/js/kov-toast.js"></script>
<!-- Coinbase Dual-Theme Engine -->
<script src="/assets/js/kov-theme.js"></script>
