<!-- Backdrop for mobile sidebar drawer -->
<div class="kov-sidebar-backdrop" id="sidebarBackdrop"></div>

<!-- Master Sidebar Navigation (Cila Anti-Slop Framed-Sheet Architecture) -->
<aside class="kov-sidebar dd-sidebar" id="appSidebar">
  
  <!-- Inline script to prevent layout flicker on reload -->
  <script>
    (function() {
      try {
        if (localStorage.getItem('kov_sidebar_collapsed') === 'true' && window.innerWidth >= 992) {
          document.getElementById('appSidebar').classList.add('collapsed');
          const mc = document.querySelector('.kov-main-content');
          if (mc) mc.classList.add('collapsed');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Brand Header: Architectural Symmetrical Alignment -->
  <div class="kov-sidebar-brand dd-sidebar-brand">
    <a href="/admin" class="kov-brand-info dd-brand-logo" title="KOV Management Portal">
      <div class="kov-brand-logo dd-brand-icon">
        <img src="/logo_kov_2.jpg" alt="KOV Logo" onerror="this.onerror=null; this.src='data:image/svg+xml,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 40 40\'%3E%3Crect width=\'40\' height=\'40\' fill=\'%23166534\' rx=\'8\'/%3E%3Ctext x=\'50%25\' y=\'55%25\' dominant-baseline=\'middle\' text-anchor=\'middle\' fill=\'white\' font-weight=\'bold\' font-family=\'sans-serif\' font-size=\'14\'%3EKOV%3C/text%3E%3C/svg%3E';">
      </div>
      <div class="kov-brand-text-group dd-brand-text d-flex flex-column">
        <div class="kov-brand-name-wrap" style="white-space: nowrap;">
          <span class="kov-brand-title">KOV Group</span><span class="kov-brand-dot" style="color: #166534; font-weight: 800;">.</span>
        </div>
        <span class="kov-brand-subtitle">MANAGEMENT PORTAL</span>
      </div>
    </a>
    
    <!-- Mobile close drawer button (<992px) -->
    <button type="button" class="btn btn-sm p-1 d-lg-none kov-sidebar-close-btn" id="sidebarCloseBtn" aria-label="Tutup Menu">
      <i class="fas fa-times fs-5"></i>
    </button>

    <!-- Desktop collapse toggle button (>=992px) -->
    <button type="button" class="kov-sidebar-collapse-btn d-none d-lg-inline-flex" id="sidebarCollapseBtn" onclick="toggleSidebarCollapse()" title="Lipat / Perluas Sidebar" aria-label="Lipat Sidebar">
      <i class="fas fa-angles-left" id="sidebarCollapseIcon"></i>
    </button>
  </div>

  <%
    const userRole = (typeof user !== 'undefined' && user && user.role) ? user.role.toLowerCase().trim() : '';
    const isSuperOrAdmin = userRole === 'superadmin' || userRole === 'admin';
    const canHR = isSuperOrAdmin || userRole === 'hr';
    const canReviewer = isSuperOrAdmin || userRole === 'user' || (typeof user !== 'undefined' && user && user.reviewer_divisions && user.reviewer_divisions.trim().length > 0);
    const canOperasional = isSuperOrAdmin || userRole === 'operasional' || userRole === 'admin_operasional';
    const canIT = isSuperOrAdmin || userRole === 'it';
    const canUsers = isSuperOrAdmin;
  %>

  <!-- Navigation Groups & Items -->
  <nav class="kov-sidebar-nav dd-sidebar-nav">
    
    <!-- Group: HR & Recruitment -->
    <% if (canHR || canReviewer) { %>
      <div class="kov-nav-group-title dd-nav-group-title">Rekrutmen &amp; HR</div>
      <% if (canHR) { %>
        <a href="/admin" class="kov-nav-item dd-nav-item <%= (typeof active !== 'undefined' && active === 'hr') ? 'active' : '' %>" data-tooltip="Dashboard HR" title="Dashboard HR">
          <i class="fas fa-house"></i>
          <span>Dashboard HR</span>
        </a>
      <% } %>
      <% if (canReviewer) { %>
        <a href="/reviewer" class="kov-nav-item dd-nav-item <%= (typeof active !== 'undefined' && active === 'reviewer') ? 'active' : '' %>" data-tooltip="Reviewer Divisi" title="Reviewer Divisi">
          <i class="fas fa-user-check"></i>
          <span>Reviewer Divisi</span>
        </a>
      <% } %>
    <% } %>

    <!-- Group: Operasional -->
    <% if (canOperasional) { %>
      <div class="kov-nav-group-title dd-nav-group-title">Operasional</div>
      <a href="/admin/operasional" class="kov-nav-item dd-nav-item <%= (typeof active !== 'undefined' && active === 'operasional') ? 'active' : '' %>" data-tooltip="Berita Acara (BA)" title="Berita Acara (BA)">
        <i class="fas fa-file-lines"></i>
        <span>Berita Acara (BA)</span>
      </a>
      <a href="/admin/operasional/po" class="kov-nav-item dd-nav-item <%= (typeof active !== 'undefined' && active === 'po') ? 'active' : '' %>" data-tooltip="Purchase Order" title="Purchase Order">
        <i class="fas fa-cart-shopping"></i>
        <span>Purchase Order</span>
      </a>
      <a href="/admin/operasional/surat-tugas" class="kov-nav-item dd-nav-item <%= (typeof active !== 'undefined' && active === 'surat_tugas') ? 'active' : '' %>" data-tooltip="Surat Tugas & LPJ" title="Surat Tugas & LPJ">
        <i class="fas fa-file-signature"></i>
        <span>Surat Tugas &amp; LPJ</span>
      </a>
    <% } %>

    <!-- Group: Infrastruktur & IT -->
    <% if (canIT) { %>
      <div class="kov-nav-group-title dd-nav-group-title">Infrastruktur &amp; IT</div>
      <a href="/admin/it" class="kov-nav-item dd-nav-item <%= (typeof active !== 'undefined' && active === 'it') ? 'active' : '' %>" data-tooltip="Rekap Belanja IT" title="Rekap Belanja IT">
        <i class="fas fa-desktop"></i>
        <span>Rekap Belanja IT</span>
      </a>
    <% } %>

    <!-- Group: Administrasi & Sistem -->
    <% if (canUsers) { %>
      <div class="kov-nav-group-title dd-nav-group-title">Sistem</div>
      <a href="/admin/companies" class="kov-nav-item dd-nav-item <%= (typeof active !== 'undefined' && active === 'companies') ? 'active' : '' %>" data-tooltip="Master Perusahaan &amp; Outlet" title="Master Perusahaan &amp; Outlet">
        <i class="fas fa-building-user"></i>
        <span>Master Perusahaan</span>
      </a>
      <a href="/admin/users" class="kov-nav-item dd-nav-item <%= (typeof active !== 'undefined' && active === 'users') ? 'active' : '' %>" data-tooltip="Kelola User & Role" title="Kelola User & Role">
        <i class="fas fa-users-gear"></i>
        <span>Kelola User &amp; Role</span>
      </a>
    <% } %>

  </nav>

  <!-- User Profile & Session Footer -->
  <div class="kov-sidebar-footer dd-sidebar-footer">
    
    <!-- Theme Switcher Button -->
    <button type="button" class="kov-theme-toggle-sidebar dd-theme-toggle-btn" onclick="toggleKovTheme()" id="themeToggleSidebarBtn" title="Ganti Mode Gelap / Terang">
      <i class="fas fa-moon" id="themeSidebarIcon"></i>
      <span id="themeSidebarText">Mode Gelap / Terang</span>
    </button>

    <!-- User Information Badge Box -->
    <div class="kov-user-badge-box" title="<%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'User' %> (<%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Staff' %>)">
      <div class="kov-user-avatar">
        <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
      </div>
      <div class="flex-grow-1 min-w-0">
        <div class="kov-user-name text-truncate">
          <%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : ((typeof user !== 'undefined' && user && user.username) ? user.username : 'Administrator HR') %>
        </div>
        <div class="kov-user-role-wrap">
          <span class="kov-role-badge">
            <%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Superadmin' %>
          </span>
        </div>
      </div>
      <i class="fas fa-chevron-right ms-auto kov-user-chevron"></i>
    </div>

    <!-- Graceful Logout Action -->
    <a href="/admin/logout" onclick="sessionStorage.clear();" class="kov-logout-link" data-tooltip="Keluar (Logout)" title="Keluar (Logout)">
      <i class="fas fa-arrow-right-from-bracket"></i>
      <span>Keluar (Logout)</span>
    </a>
  </div>

</aside>

<script>
  (function() {
    const sidebar = document.getElementById('appSidebar');
    const backdrop = document.getElementById('sidebarBackdrop');
    const closeBtn = document.getElementById('sidebarCloseBtn');
    const collapseIcon = document.getElementById('sidebarCollapseIcon');
    const appShell = document.querySelector('.kov-app-shell');
    const mainContent = document.querySelector('.kov-main-content');

    function applySavedCollapseState() {
      try {
        const isCollapsed = localStorage.getItem('kov_sidebar_collapsed') === 'true';
        if (isCollapsed && window.innerWidth >= 992) {
          if (sidebar) sidebar.classList.add('collapsed');
          if (mainContent) mainContent.classList.add('collapsed');
          if (appShell) appShell.classList.add('sidebar-collapsed');
          if (collapseIcon) {
            collapseIcon.classList.remove('fa-angles-left');
            collapseIcon.classList.add('fa-angles-right');
          }
        }
      } catch (e) {}
    }

    applySavedCollapseState();

    window.toggleSidebarCollapse = function() {
      if (!sidebar) return;
      const willCollapse = !sidebar.classList.contains('collapsed');
      sidebar.classList.toggle('collapsed', willCollapse);
      if (mainContent) mainContent.classList.toggle('collapsed', willCollapse);
      if (appShell) appShell.classList.toggle('sidebar-collapsed', willCollapse);
      
      if (collapseIcon) {
        if (willCollapse) {
          collapseIcon.classList.remove('fa-angles-left');
          collapseIcon.classList.add('fa-angles-right');
        } else {
          collapseIcon.classList.remove('fa-angles-right');
          collapseIcon.classList.add('fa-angles-left');
        }
      }
      try {
        localStorage.setItem('kov_sidebar_collapsed', willCollapse ? 'true' : 'false');
      } catch (e) {}
    };

    window.toggleKovSidebar = function() {
      if (window.innerWidth >= 992) {
        window.toggleSidebarCollapse();
      } else {
        if (sidebar && backdrop) {
          sidebar.classList.toggle('show');
          backdrop.classList.toggle('show');
        }
      }
    };

    if (backdrop) {
      backdrop.addEventListener('click', function() {
        if (sidebar) sidebar.classList.remove('show');
        backdrop.classList.remove('show');
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        if (sidebar) sidebar.classList.remove('show');
        if (backdrop) backdrop.classList.remove('show');
      });
    }

    window.addEventListener('resize', function() {
      if (window.innerWidth >= 992) {
        if (sidebar) sidebar.classList.remove('show');
        if (backdrop) backdrop.classList.remove('show');
        applySavedCollapseState();
      } else {
        if (sidebar) sidebar.classList.remove('collapsed');
        if (mainContent) mainContent.classList.remove('collapsed');
        if (appShell) appShell.classList.remove('sidebar-collapsed');
      }
    });
  })();
</script>
