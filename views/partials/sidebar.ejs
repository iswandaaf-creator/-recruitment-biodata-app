<!-- Backdrop for mobile sidebar drawer -->
<div class="kov-sidebar-backdrop" id="sidebarBackdrop"></div>

<!-- Top Laser Loading Bar -->
<div class="kov-laser-bar" id="topLaserBar"></div>

<aside class="atelier-sidebar dd-sidebar kov-sidebar dd-theme" id="appSidebar">
  <script>
    (function() {
      try {
        localStorage.setItem('kov_theme', 'light');
        document.documentElement.removeAttribute('data-theme');
        if (document.body) document.body.classList.remove('theme-dark');
        if (localStorage.getItem('kov_sidebar_collapsed') === 'true' && window.innerWidth >= 992) {
          document.getElementById('appSidebar').classList.add('collapsed');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Brand Header -->
  <div class="atelier-brand-header dd-sidebar-brand kov-sidebar-brand">
    <a href="/admin" class="atelier-brand-link dd-brand-logo kov-brand-info" title="KOV Koffie Portal">
      <img src="/logo_kov_2.jpg" alt="KOV Logo" class="atelier-brand-logo-img">
      <div class="hide-on-collapse atelier-brand-text-wrap dd-brand-text">
        <div class="atelier-brand-title">KOV Koffie<span style="color: #3b634e;">.</span></div>
        <div class="atelier-brand-sub">Portal Internal</div>
      </div>
    </a>

    <button type="button" class="atelier-collapse-btn d-lg-none" id="sidebarCloseBtn" aria-label="Tutup Navigasi">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6L18 18M18 6L6 18"/></svg>
    </button>

    <button type="button" class="atelier-collapse-btn kov-sidebar-collapse-btn d-none d-lg-inline-flex" id="sidebarCollapseBtn" onclick="toggleSidebarCollapse()" title="Lipat Navigasi" aria-label="Lipat Navigasi">
      <svg width="14" height="14" id="sidebarCollapseIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.5 6.5L8.5 12L14.5 17.5"/>
      </svg>
    </button>
  </div>

  <%
    const userRole = (typeof user !== 'undefined' && user && user.role) ? user.role.toLowerCase().trim() : '';
    const isSuperOrAdmin = userRole === 'superadmin' || userRole === 'admin';
    const canHR = isSuperOrAdmin || userRole === 'hr';
    const canReviewer = isSuperOrAdmin || userRole === 'user' || (typeof user !== 'undefined' && user && user.reviewer_divisions && user.reviewer_divisions.trim().length > 0);
    const canOperasional = isSuperOrAdmin || userRole === 'operasional' || userRole === 'admin_operasional';
    const canIT = isSuperOrAdmin || userRole === 'it';
    const canUsers = isSuperOrAdmin;
  %>

  <!-- Simplified Minimalist Navigation Menu (Form buttons live inside each module page) -->
  <nav class="atelier-nav dd-sidebar-nav kov-sidebar-nav" id="sidebarNav">
    <% if (canHR || canReviewer) { %>
      <div class="nav-group-heading dd-nav-group-title kov-nav-group-title hide-on-collapse">Rekrutmen &amp; HR</div>
      <% if (canHR) { %>
        <a href="/admin" class="nav-btn dd-nav-item kov-nav-item <%= (typeof active !== 'undefined' && active === 'hr') ? 'active' : '' %>" title="Direktori Kandidat">
          <svg class="hand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="8.5" r="3.8"/><path d="M5.5 19.5c1.2-3.1 3.6-4.5 6.5-4.5s5.3 1.4 6.5 4.5"/>
          </svg>
          <span class="hide-on-collapse">Direktori Kandidat</span>
        </a>
      <% } %>
      <% if (canReviewer) { %>
        <a href="/reviewer" class="nav-btn dd-nav-item kov-nav-item <%= (typeof active !== 'undefined' && active === 'reviewer') ? 'active' : '' %>" title="Evaluasi Divisi">
          <svg class="hand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 11.5l2 2 4.5-4.5"/><rect x="4.5" y="4.5" width="15" height="15" rx="3.5"/>
          </svg>
          <span class="hide-on-collapse">Evaluasi Divisi</span>
        </a>
      <% } %>
    <% } %>

    <% if (canOperasional || canIT) { %>
      <div class="nav-group-heading dd-nav-group-title kov-nav-group-title hide-on-collapse">Operasional &amp; Pengadaan</div>
      <% if (canOperasional) { %>
        <a href="/admin/operasional" class="nav-btn dd-nav-item kov-nav-item <%= (typeof active !== 'undefined' && active === 'operasional') ? 'active' : '' %>" title="Berita Acara (BA)">
          <svg class="hand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <rect x="5" y="4.5" width="14" height="15.5" rx="2"/><path d="M8.5 9h7M8.5 13h7M8.5 16.5h4"/>
          </svg>
          <span class="hide-on-collapse">Berita Acara (BA)</span>
        </a>
        <a href="/admin/operasional/po" class="nav-btn dd-nav-item kov-nav-item <%= (typeof active !== 'undefined' && active === 'po') ? 'active' : '' %>" title="Purchase Order (PO)">
          <svg class="hand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 5.5h2.2l1.8 9.2h8.8l1.7-6.7H6.8"/><circle cx="9.2" cy="18.5" r="1.2"/><circle cx="15.8" cy="18.5" r="1.2"/>
          </svg>
          <span class="hide-on-collapse">Purchase Order (PO)</span>
        </a>
        <a href="/admin/operasional/surat-tugas" class="nav-btn dd-nav-item kov-nav-item <%= (typeof active !== 'undefined' && active === 'surat_tugas') ? 'active' : '' %>" title="Surat Tugas & LPJ">
          <svg class="hand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.5 11.2L19 5l-4.2 14-3.6-5.2-6.7-2.6z"/>
          </svg>
          <span class="hide-on-collapse">Surat Tugas &amp; LPJ</span>
        </a>
      <% } %>
    <% } %>

    <% if (canIT || canUsers) { %>
      <div class="nav-group-heading dd-nav-group-title kov-nav-group-title hide-on-collapse">Infrastruktur &amp; Sistem</div>
      <% if (canIT) { %>
        <a href="/admin/it" class="nav-btn dd-nav-item kov-nav-item <%= (typeof active !== 'undefined' && active === 'it') ? 'active' : '' %>" title="Rekap Belanja IT">
          <svg class="hand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="5" width="16" height="11" rx="2"/><path d="M8.5 19.5h7M12 16v3.5"/>
          </svg>
          <span class="hide-on-collapse">Rekap Belanja IT</span>
        </a>
      <% } %>
      <% if (canUsers) { %>
        <a href="/admin/companies" class="nav-btn dd-nav-item kov-nav-item <%= (typeof active !== 'undefined' && active === 'companies') ? 'active' : '' %>" title="Master Outlet & PT">
          <svg class="hand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.5 9.5L6.2 5h11.6l1.7 4.5H4.5z"/><path d="M5.5 9.5V19h13V9.5M10 19v-4.5h4V19"/>
          </svg>
          <span class="hide-on-collapse">Master Outlet &amp; PT</span>
        </a>
        <a href="/admin/users" class="nav-btn dd-nav-item kov-nav-item <%= (typeof active !== 'undefined' && active === 'users') ? 'active' : '' %>" title="Kelola Akun RBAC">
          <svg class="hand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 4l6.5 2.6v5.2c0 4-2.8 6.9-6.5 8.2-3.7-1.3-6.5-4.2-6.5-8.2V6.6L12 4z"/><path d="M9.5 12l1.8 1.8 3.5-3.6"/>
          </svg>
          <span class="hide-on-collapse">Kelola Akun RBAC</span>
        </a>
      <% } %>
    <% } %>
  </nav>

  <!-- Bottom Role Switcher & Session Footer -->
  <div class="atelier-sidebar-footer dd-sidebar-footer kov-sidebar-footer">
    <div class="atelier-rbac-card hide-on-collapse">
      <div class="atelier-rbac-label">Peran Aktif (RBAC)</div>
      <select class="atelier-rbac-select" aria-label="Pilih Peran / Modul" onchange="if(this.value) window.location.href=this.value;">
        <% if (canHR) { %>
          <option value="/admin" <%= (typeof active !== 'undefined' && active === 'hr') ? 'selected' : '' %>>Super Admin HR</option>
        <% } %>
        <% if (canReviewer) { %>
          <option value="/reviewer" <%= (typeof active !== 'undefined' && active === 'reviewer') ? 'selected' : '' %>>Reviewer Divisi</option>
        <% } %>
        <% if (canOperasional) { %>
          <option value="/admin/operasional" <%= (typeof active !== 'undefined' && ['operasional','po','surat_tugas'].includes(active)) ? 'selected' : '' %>>Manajer Operasional</option>
        <% } %>
        <% if (canIT && !canHR && !canOperasional) { %>
          <option value="/admin/it" selected>Staff IT</option>
        <% } %>
      </select>
      <div class="d-flex align-items-center justify-content-between mt-2 pt-1.5" style="border-top: 1px solid #efede7; font-size: 11px;">
        <span class="text-truncate fw-semibold" style="color: #2c3a32; max-width: 110px;">
          <%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : ((typeof user !== 'undefined' && user && user.username) ? user.username : 'Admin HR') %>
        </span>
        <a href="/admin/logout" onclick="sessionStorage.clear();" style="color: #844858; font-weight: 600; text-decoration: none;" title="Keluar (Logout)">Keluar</a>
      </div>
    </div>
  </div>
</aside>

<script>
  (function() {
    const sidebar = document.getElementById('appSidebar');
    const backdrop = document.getElementById('sidebarBackdrop');
    const closeBtn = document.getElementById('sidebarCloseBtn');
    const appShell = document.querySelector('.kov-app-shell');
    const mainContent = document.querySelector('.kov-main-content');

    window.toggleSidebarCollapse = function() {
      if (!sidebar) return;
      const willCollapse = !sidebar.classList.contains('collapsed');
      sidebar.classList.toggle('collapsed', willCollapse);
      if (mainContent) mainContent.classList.toggle('collapsed', willCollapse);
      if (appShell) appShell.classList.toggle('sidebar-collapsed', willCollapse);
      try { localStorage.setItem('kov_sidebar_collapsed', willCollapse ? 'true' : 'false'); } catch (e) {}
    };

    window.toggleKovSidebar = function() {
      if (window.innerWidth >= 992) {
        window.toggleSidebarCollapse();
      } else if (sidebar && backdrop) {
        sidebar.classList.toggle('show');
        backdrop.classList.toggle('show');
      }
    };

    if (backdrop) backdrop.addEventListener('click', function() { sidebar.classList.remove('show'); backdrop.classList.remove('show'); });
    if (closeBtn) closeBtn.addEventListener('click', function() { sidebar.classList.remove('show'); backdrop.classList.remove('show'); });
  })();
</script>
<script src="/assets/js/kov-toast.js"></script>
<script src="/assets/js/kov-theme.js"></script>
