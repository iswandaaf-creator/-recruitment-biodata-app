<!-- Backdrop for mobile sidebar drawer -->
<div class="kov-sidebar-backdrop" id="sidebarBackdrop"></div>

<!-- Master Sidebar Navigation (Atelier Pebble Sage Dock + Symmetrical Pastel Aesthetic) -->
<aside class="atelier-sidebar dd-sidebar kov-sidebar dd-theme" id="appSidebar">
  
  <!-- Immediate inline script to prevent layout flicker & sync collapse on reload -->
  <script>
    (function() {
      try {
        if (localStorage.getItem('kov_sidebar_collapsed') === 'true' && window.innerWidth >= 992) {
          document.getElementById('appSidebar').classList.add('collapsed');
          const mc = document.querySelector('.kov-main-content');
          if (mc) mc.classList.add('collapsed');
          const ash = document.querySelector('.kov-app-shell');
          if (ash) ash.classList.add('sidebar-collapsed');
        }
      } catch (e) {}
    })();
  </script>

  <!-- Brand Header -->
  <div class="dd-sidebar-brand kov-sidebar-brand d-flex items-center justify-between px-3 py-2 border-b" style="border-color: var(--border-organic, #d8e2dc); height: 64px;">
    <a href="/admin" class="dd-brand-logo kov-brand-info d-flex items-center gap-2 text-decoration-none" title="KOV Koffie Portal">
      <div class="dd-brand-icon kov-brand-logo flex-shrink-0" style="width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--celadon-border, #bdd6c5); padding: 1px; background: #ffffff; overflow: hidden; display: flex; align-items: center; justify-content: center;">
        <img src="/logo_kov_2.jpg" alt="KOV Koffie Logo" style="width: 100%; height: 100%; object-fit: cover;">
      </div>
      <div class="dd-brand-text kov-brand-text-group d-flex flex-column hide-on-collapse" style="line-height: 1.15;">
        <div class="font-display font-bold text-xs" style="color: var(--ink-deep, #384d42); font-weight: 800; font-size: 13.5px; letter-spacing: -0.01em;">KOV Koffie<span style="color: var(--celadon-stroke, #3f6f56);">.</span></div>
        <div class="text-[9.5px] font-medium" style="color: var(--ink-muted, #7d9186); font-size: 10px; font-weight: 600; letter-spacing: 0.04em;">Atelier Sistem</div>
      </div>
    </a>
    
    <!-- Mobile close drawer button (<992px) -->
    <button type="button" class="btn btn-sm p-1 d-lg-none" id="sidebarCloseBtn" style="color: var(--ink-deep, #384d42) !important;" aria-label="Tutup Menu">
      <i class="fas fa-times fs-5"></i>
    </button>

    <!-- Desktop collapse/slide button (>=992px) with Symmetrical Chevron -->
    <button type="button" class="kov-sidebar-collapse-btn kov-soft-icon-btn d-none d-lg-inline-flex align-items-center justify-content-center flex-shrink-0" id="sidebarCollapseBtn" onclick="toggleSidebarCollapse()" title="Lipat / Perluas Navigasi" aria-label="Collapse Sidebar" style="width: 28px; height: 28px; border-radius: 8px; border: 1px solid var(--border-organic, #d8e2dc); background: var(--bg-paper, #fcfbf9); color: var(--ink-deep, #384d42); cursor: pointer; transition: background 0.15s ease;">
      <svg class="kov-chevron-icon" id="sidebarCollapseIcon" viewBox="0 0 24 24" fill="none" style="width: 14px; height: 14px; transition: transform 0.25s ease;">
        <path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <%
    const userRole = (typeof user !== 'undefined' && user && user.role) ? user.role.toLowerCase().trim() : '';
    const isSuperOrAdmin = userRole === 'superadmin' || userRole === 'admin';
    const canHR = isSuperOrAdmin || userRole === 'hr';
    const canReviewer = isSuperOrAdmin || userRole === 'user' || (typeof user !== 'undefined' && user && user.reviewer_divisions && user.reviewer_divisions.trim().length > 0);
    const canOperasional = isSuperOrAdmin || userRole === 'operasional' || userRole === 'admin_operasional';
    const canIT = isSuperOrAdmin || userRole === 'it';
    const canUsers = isSuperOrAdmin;
  %>

  <!-- Navigation Links (Symmetrical Geometric Icons & Clean Pastel Accents) -->
  <nav class="dd-sidebar-nav kov-sidebar-nav px-2 py-2" id="sidebarNav">
    
    <!-- Group: HR & Recruitment -->
    <% if (canHR || canReviewer) { %>
      <div class="dd-nav-group-title kov-nav-group-title nav-group-heading hide-on-collapse" style="font-size: 10px; font-weight: 700; letter-spacing: 0.06em; color: var(--ink-muted, #7d9186); padding: 8px 10px 4px;">REKRUTMEN &amp; HR</div>
      <% if (canHR) { %>
        <a href="/admin" class="dd-nav-item kov-nav-item nav-btn <%= (typeof active !== 'undefined' && active === 'hr') ? 'active' : '' %>" data-tooltip="Direktori Kandidat" title="Direktori Kandidat">
          <svg class="hand-icon flex-shrink-0" viewBox="0 0 24 24" fill="none" style="width: 18px; height: 18px;">
            <circle cx="12" cy="7" r="4" fill="#dfece3" stroke="#2e5943" stroke-width="1.8"/>
            <path d="M4 21C4 16.58 7.58 13 12 13C16.42 13 20 16.58 20 21" stroke="#2e5943" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          <i class="fas fa-house d-none"></i>
          <span class="hide-on-collapse">Direktori Kandidat</span>
        </a>
      <% } %>
      <% if (canReviewer) { %>
        <a href="/reviewer" class="dd-nav-item kov-nav-item nav-btn <%= (typeof active !== 'undefined' && active === 'reviewer') ? 'active' : '' %>" data-tooltip="Evaluasi Divisi" title="Evaluasi Divisi">
          <svg class="hand-icon flex-shrink-0" viewBox="0 0 24 24" fill="none" style="width: 18px; height: 18px;">
            <rect x="5" y="4" width="14" height="17" rx="3" fill="#f6eed8" stroke="#9c782b" stroke-width="1.8"/>
            <path d="M9 2H15V5H9V2Z" fill="#e5d4a7" stroke="#9c782b" stroke-width="1.6" stroke-linejoin="round"/>
            <path d="M9 12L11 14L15 10" stroke="#9c782b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <i class="fas fa-user-check d-none"></i>
          <span class="hide-on-collapse">Evaluasi Divisi</span>
        </a>
      <% } %>
    <% } %>

    <!-- Group: Operasional -->
    <% if (canOperasional) { %>
      <div class="dd-nav-group-title kov-nav-group-title nav-group-heading hide-on-collapse" style="font-size: 10px; font-weight: 700; letter-spacing: 0.06em; color: var(--ink-muted, #7d9186); padding: 8px 10px 4px;">OPERASIONAL</div>
      <a href="/admin/operasional" class="dd-nav-item kov-nav-item nav-btn <%= (typeof active !== 'undefined' && active === 'operasional') ? 'active' : '' %>" data-tooltip="Berita Acara (BA)" title="Berita Acara (BA)">
        <svg class="hand-icon flex-shrink-0" viewBox="0 0 24 24" fill="none" style="width: 18px; height: 18px;">
          <path d="M14 2H6C4.9 2 4 2.9 4 4V20C4 21.1 4.9 22 6 22H18C19.1 22 20 21.1 20 20V8L14 2Z" fill="#f6e5da" stroke="#a65d37" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M14 2V8H20" stroke="#a65d37" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M8 13H16M8 17H13" stroke="#a65d37" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <i class="fas fa-file-lines d-none"></i>
        <span class="hide-on-collapse">Berita Acara (BA)</span>
      </a>
      <a href="/admin/operasional/po" class="dd-nav-item kov-nav-item nav-btn <%= (typeof active !== 'undefined' && active === 'po') ? 'active' : '' %>" data-tooltip="Purchase Order" title="Purchase Order">
        <svg class="hand-icon flex-shrink-0" viewBox="0 0 24 24" fill="none" style="width: 18px; height: 18px;">
          <path d="M3 4H5L7 16H18L20 7H6" stroke="#8c4a5b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="8.5" cy="20" r="1.5" fill="#8c4a5b"/>
          <circle cx="16.5" cy="20" r="1.5" fill="#8c4a5b"/>
          <path d="M9 10H15M12 7V13" stroke="#8c4a5b" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <i class="fas fa-cart-shopping d-none"></i>
        <span class="hide-on-collapse">Purchase Order</span>
      </a>
      <a href="/admin/operasional/surat-tugas" class="dd-nav-item kov-nav-item nav-btn <%= (typeof active !== 'undefined' && active === 'surat_tugas') ? 'active' : '' %>" data-tooltip="Surat Tugas & LPJ" title="Surat Tugas & LPJ">
        <svg class="hand-icon flex-shrink-0" viewBox="0 0 24 24" fill="none" style="width: 18px; height: 18px;">
          <rect x="4" y="4" width="16" height="16" rx="3" fill="#f6eed8" stroke="#9c782b" stroke-width="1.8"/>
          <path d="M8 8H16M8 12H16M8 16H12" stroke="#9c782b" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <i class="fas fa-file-signature d-none"></i>
        <span class="hide-on-collapse">Surat Tugas &amp; LPJ</span>
      </a>
    <% } %>

    <!-- Group: Infrastruktur & IT -->
    <% if (canIT) { %>
      <div class="dd-nav-group-title kov-nav-group-title nav-group-heading hide-on-collapse" style="font-size: 10px; font-weight: 700; letter-spacing: 0.06em; color: var(--ink-muted, #7d9186); padding: 8px 10px 4px;">INFRASTRUKTUR &amp; IT</div>
      <a href="/admin/it" class="dd-nav-item kov-nav-item nav-btn <%= (typeof active !== 'undefined' && active === 'it') ? 'active' : '' %>" data-tooltip="Rekap Belanja IT" title="Rekap Belanja IT">
        <svg class="hand-icon flex-shrink-0" viewBox="0 0 24 24" fill="none" style="width: 18px; height: 18px;">
          <rect x="3" y="4" width="18" height="12" rx="2.5" fill="#e6e9f4" stroke="#54638f" stroke-width="1.8"/>
          <path d="M8 20H16M12 16V20" stroke="#54638f" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <i class="fas fa-desktop d-none"></i>
        <span class="hide-on-collapse">Rekap Belanja IT</span>
      </a>
    <% } %>

    <!-- Group: Administrasi & Akun -->
    <% if (canUsers) { %>
      <div class="dd-nav-group-title kov-nav-group-title nav-group-heading hide-on-collapse" style="font-size: 10px; font-weight: 700; letter-spacing: 0.06em; color: var(--ink-muted, #7d9186); padding: 8px 10px 4px;">SISTEM</div>
      <a href="/admin/companies" class="dd-nav-item kov-nav-item nav-btn <%= (typeof active !== 'undefined' && active === 'companies') ? 'active' : '' %>" data-tooltip="Master Perusahaan &amp; Outlet" title="Master Perusahaan &amp; Outlet">
        <svg class="hand-icon flex-shrink-0" viewBox="0 0 24 24" fill="none" style="width: 18px; height: 18px;">
          <path d="M3 21H21M5 21V7L13 3V21M13 7L19 10V21" stroke="#2e5943" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          <rect x="8" y="10" width="2" height="2" fill="#2e5943"/>
          <rect x="8" y="14" width="2" height="2" fill="#2e5943"/>
        </svg>
        <i class="fas fa-building-user d-none"></i>
        <span class="hide-on-collapse">Master Perusahaan</span>
      </a>
      <a href="/admin/users" class="dd-nav-item kov-nav-item nav-btn <%= (typeof active !== 'undefined' && active === 'users') ? 'active' : '' %>" data-tooltip="Kelola User & Role" title="Kelola User & Role">
        <svg class="hand-icon flex-shrink-0" viewBox="0 0 24 24" fill="none" style="width: 18px; height: 18px;">
          <circle cx="9" cy="8" r="3.5" fill="#f0e4e8" stroke="#8c4a5b" stroke-width="1.8"/>
          <path d="M3 19C3 15.68 5.68 13 9 13C12.32 13 15 15.68 15 19" stroke="#8c4a5b" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M16 8C17.65 8 19 9.34 19 11C19 12.65 17.65 14 16 14" stroke="#8c4a5b" stroke-width="1.8" stroke-linecap="round"/>
          <path d="M19 19C19 16.79 17.5 14.94 15.5 14.2" stroke="#8c4a5b" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <i class="fas fa-users-gear d-none"></i>
        <span class="hide-on-collapse">Kelola User &amp; Role</span>
      </a>
    <% } %>

  </nav>

  <!-- User Profile & Session Footer (Pebble-Sage Dock Footer) -->
  <div class="dd-sidebar-footer kov-sidebar-footer p-3 border-t space-y-2" style="border-color: var(--border-organic, #d8e2dc);">
    <!-- Role Indicator Box -->
    <div class="p-2 rounded-xl border hide-on-collapse mb-2" style="background: var(--bg-paper, #fcfbf9); border-color: var(--border-organic, #d8e2dc); border-radius: 10px;">
      <div class="block text-[9.5px] font-bold uppercase tracking-wider mb-1" style="color: var(--ink-muted, #7d9186); font-size: 9.5px; font-weight: 700;">Peran Aktif</div>
      <div class="w-full py-1 px-2 rounded-md border text-[11px] font-bold" style="background: var(--celadon-bg, #dfece3); color: var(--celadon-ink, #2e5943); border-color: var(--celadon-border, #bdd6c5); font-size: 11px; border-radius: 6px;">
        <%= (typeof user !== 'undefined' && user && user.role) ? user.role.toUpperCase() : 'SUPERADMIN HR' %>
      </div>
    </div>

    <!-- Theme Switcher Button with Symmetrical Sun & Leaf SVG -->
    <button type="button" class="dd-theme-toggle-btn kov-theme-toggle-sidebar btn-kov-outline w-100 justify-content-center mb-2" onclick="toggleKovTheme()" id="themeToggleSidebarBtn" title="Ganti Nuansa Pastel (Linen / Sage Lavender)" style="height: 32px; border-radius: 8px; font-size: 11.5px; font-weight: 600;">
      <svg class="hand-icon !w-4 !h-4 me-1.5" id="themeIcon" viewBox="0 0 24 24" fill="none" style="width: 16px; height: 16px;">
        <circle cx="12" cy="12" r="5" fill="#f6eed8" stroke="#9c782b" stroke-width="1.8"/>
        <path d="M12 2V4M12 20V22M4 12H2M22 12H20M5.6 5.6L7 7M17 17L18.4 18.4M5.6 18.4L7 17M17 7L18.4 5.6" stroke="#9c782b" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
      <i class="fas fa-moon d-none" id="themeSidebarIcon"></i>
      <span class="hide-on-collapse" id="themeSidebarText">Nuansa Lavender</span>
    </button>

    <div class="kov-user-badge-box" style="border-radius: 10px;" title="<%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : 'User' %> (<%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Staff' %>)">
      <div class="kov-user-avatar" style="border-radius: 8px;">
        <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
      </div>
      <div class="flex-grow-1 min-w-0 hide-on-collapse">
        <div class="small fw-bold text-truncate leading-tight kov-user-name" style="font-size: 12px; font-weight: 700; color: var(--ink-deep, #384d42);">
          <%= (typeof user !== 'undefined' && user && user.nama) ? user.nama : ((typeof user !== 'undefined' && user && user.username) ? user.username : 'Administrator HR') %>
        </div>
        <div style="font-size: 10px; margin-top: 2px;">
          <span class="badge py-0.5 px-2" style="background: var(--celadon-bg, #dfece3); color: var(--celadon-ink, #2e5943); border: 1px solid var(--celadon-border, #bdd6c5); border-radius: 9999px; font-weight: 700; font-size: 9.5px;">
            <%= (typeof user !== 'undefined' && user && user.role) ? user.role : 'Superadmin' %>
          </span>
        </div>
      </div>
      <i class="fas fa-chevron-right ms-auto hide-on-collapse" style="font-size: 0.75rem; color: var(--ink-muted, #7d9186);"></i>
    </div>
    <a href="/admin/logout" onclick="sessionStorage.clear();" class="kov-logout-link" data-tooltip="Keluar (Logout)" title="Keluar (Logout)" style="border-radius: 8px; font-size: 11.5px; font-weight: 600;">
      <i class="fas fa-arrow-right-from-bracket"></i>
      <span class="hide-on-collapse">Keluar (Logout)</span>
    </a>
  </div>

</aside>

<script>
  (function() {
    const sidebar = document.getElementById('appSidebar');
    const backdrop = document.getElementById('sidebarBackdrop');
    const closeBtn = document.getElementById('sidebarCloseBtn');
    const collapseIcon = document.getElementById('sidebarCollapseIcon');
    const appShell = document.querySelector('.kov-app-shell') || document.querySelector('.atelier-shell');
    const mainContent = document.querySelector('.kov-main-content') || document.querySelector('.atelier-main');

    function applySavedCollapseState() {
      try {
        const isCollapsed = localStorage.getItem('kov_sidebar_collapsed') === 'true';
        if (isCollapsed && window.innerWidth >= 992) {
          if (sidebar) sidebar.classList.add('collapsed');
          if (mainContent) mainContent.classList.add('collapsed');
          if (appShell) appShell.classList.add('sidebar-collapsed');
          if (collapseIcon) {
            collapseIcon.style.transform = 'rotate(180deg)';
          }
        } else {
          if (collapseIcon) {
            collapseIcon.style.transform = 'rotate(0deg)';
          }
        }
      } catch (e) {}
    }

    applySavedCollapseState();

    window.toggleSidebarCollapse = function() {
      if (!sidebar) return;
      const willCollapse = !sidebar.classList.contains('collapsed');
      sidebar.classList.toggle('collapsed', willCollapse);
      if (mainContent) mainContent.classList.toggle('collapsed', willCollapse);
      if (appShell) appShell.classList.toggle('sidebar-collapsed', willCollapse);
      
      if (collapseIcon) {
        collapseIcon.style.transform = willCollapse ? 'rotate(180deg)' : 'rotate(0deg)';
      }
      try {
        localStorage.setItem('kov_sidebar_collapsed', willCollapse ? 'true' : 'false');
      } catch (e) {}
    };

    window.toggleKovSidebar = function() {
      if (window.innerWidth >= 992) {
        window.toggleSidebarCollapse();
      } else {
        if (sidebar && backdrop) {
          sidebar.classList.toggle('show');
          backdrop.classList.toggle('show');
        }
      }
    };

    if (backdrop) {
      backdrop.addEventListener('click', function() {
        if (sidebar) sidebar.classList.remove('show');
        backdrop.classList.remove('show');
      });
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', function() {
        if (sidebar) sidebar.classList.remove('show');
        if (backdrop) backdrop.classList.remove('show');
      });
    }

    // Touch swipe gestures to slide sidebar in and out
    let touchStartX = 0;
    let touchEndX = 0;

    document.addEventListener('touchstart', function(e) {
      if (e.changedTouches && e.changedTouches[0]) {
        touchStartX = e.changedTouches[0].screenX;
      }
    }, { passive: true });

    document.addEventListener('touchend', function(e) {
      if (e.changedTouches && e.changedTouches[0]) {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipeGesture();
      }
    }, { passive: true });

    function handleSwipeGesture() {
      if (window.innerWidth >= 992) return;
      const swipeDistance = touchEndX - touchStartX;
      // Swipe right from left edge (within 60px) to slide open
      if (swipeDistance > 65 && touchStartX < 60 && sidebar && !sidebar.classList.contains('show')) {
        sidebar.classList.add('show');
        if (backdrop) backdrop.classList.add('show');
      }
      // Swipe left to slide close
      if (swipeDistance < -65 && sidebar && sidebar.classList.contains('show')) {
        sidebar.classList.remove('show');
        if (backdrop) backdrop.classList.remove('show');
      }
    }

    window.addEventListener('resize', function() {
      if (window.innerWidth >= 992) {
        if (sidebar) sidebar.classList.remove('show');
        if (backdrop) backdrop.classList.remove('show');
        applySavedCollapseState();
      } else {
        if (sidebar) sidebar.classList.remove('collapsed');
        if (mainContent) mainContent.classList.remove('collapsed');
        if (appShell) appShell.classList.remove('sidebar-collapsed');
        if (collapseIcon) collapseIcon.style.transform = 'rotate(0deg)';
      }
    });
  })();
</script>

<!-- Human-Crafted Toast & Micro-Interaction System -->
<script src="/assets/js/kov-toast.js"></script>
<!-- Dual-Theme Engine -->
<script src="/assets/js/kov-theme.js"></script>
