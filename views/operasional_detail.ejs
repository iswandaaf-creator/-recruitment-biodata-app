<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail &amp; Otorisasi Berita Acara - <%= item.no_ba || ('BA/OPS/' + item.id) %></title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261029j" rel="stylesheet">
  <style>
    .table-detail td { padding: 0.65rem 0.95rem; font-size: 0.875rem; }
    .table-detail td.label-col { width: 32%; background-color: var(--kov-slate-50); font-weight: 700; color: var(--kov-slate-700); }

    @media print {
      .top-navbar-modern, .no-print, .col-lg-4 { display: none !important; }
      .col-lg-8 { width: 100% !important; }
      body { background-color: #fff; }
      .kov-card { box-shadow: none; border: 1px solid #ccc; }
    }
  </style>
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'operasional', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Minimalist Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <a class="btn-kov-secondary btn-kov-sm" href="/admin/operasional">
            <i class="fas fa-arrow-left"></i> <span class="d-none d-sm-inline">Kembali</span>
          </a>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Detail Berita Acara</h1>
            <span class="text-muted d-none d-md-inline" style="font-size: 0.85rem;">/ <%= item.no_ba || ('BA/OPS/' + item.id) %></span>
          </div>
        </div>
        <div class="kov-topbar-right d-flex align-items-center gap-2">
          <!-- KOV Dual-Theme Switcher -->
          <button type="button" class="kov-theme-toggle" onclick="toggleKovTheme()" title="Ganti Mode Gelap / Terang">
            <i class="fas fa-moon kov-theme-icon"></i>
          </button>
          <button onclick="window.print()" class="btn-kov-secondary btn-kov-sm text-dark d-none d-sm-inline-flex">
            <i class="fas fa-print"></i> Cetak
          </button>
          <a href="/api/operasional/export/pdf/<%= item.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-danger btn-kov-sm">
            <i class="fas fa-file-pdf"></i> <span class="d-none d-sm-inline">PDF Resmi</span>
          </a>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">
    
    <!-- Top Header Summary Card -->
    <div class="kov-card mb-4" style="border-left: 4px solid var(--kov-primary-500);">
      <div class="kov-card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <span class="status-pill-modern pill-success mb-2" style="font-size: 0.72rem;">
            <span class="status-dot-pulse"></span> Divisi Operasional KOV
          </span>
          <h3 class="fw-bold text-dark mb-1">Berita Acara No: <%= item.no_ba || ('BA/OPS/' + item.id) %></h3>
          <p class="text-muted mb-0 small">
            <i class="fas fa-calendar me-1"></i>Tanggal Pengajuan: <%= formatDate(item.tanggal_pengajuan) %> &bull; 
            <i class="fas fa-building me-1"></i><%= item.outlet_divisi || '-' %> (<%= item.departemen || '-' %>)
          </p>
        </div>
        <div class="text-end">
          <div class="small text-muted mb-1">Status Approval:</div>
          <% 
            const st = item.status_approval || 'Menunggu Approval';
            let pillClass = 'pill-warning';
            if (st === 'Disetujui') pillClass = 'pill-success';
            else if (st === 'Ditolak') pillClass = 'pill-danger';
            else if (st.includes('Proses')) pillClass = 'pill-info';
            else if (st === 'Selesai') pillClass = 'pill-success';
          %>
          <span class="status-pill-modern <%= pillClass %>" style="font-size: 0.85rem; padding: 6px 14px;">
            <span class="status-dot-pulse"></span> <%= st %>
          </span>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <!-- Left Column: Document Contents -->
      <div class="col-lg-8">
        
        <!-- Section A & B: Identitas & Informasi Barang -->
        <div class="kov-card mb-4">
          <div class="kov-card-header">
            <h5 class="kov-card-title">
              <i class="fas fa-info-circle text-primary"></i>
              <span>A &amp; B. Identitas &amp; Informasi Pengadaan</span>
            </h5>
          </div>
          <div class="table-responsive-modern border-0">
            <table class="table table-bordered table-detail mb-0">
              <tr>
                <td class="label-col">PIC Pengajuan</td>
                <td><strong><%= item.pic_pengajuan || '-' %></strong></td>
              </tr>
              <tr>
                <td class="label-col">Prioritas</td>
                <td><span class="badge bg-secondary"><%= item.prioritas || 'Normal' %></span></td>
              </tr>
              <tr>
                <td class="label-col">Status Pengajuan</td>
                <td><span class="badge bg-light text-dark border"><%= item.status_barang || 'Barang Baru' %></span></td>
              </tr>
              <tr>
                <td class="label-col">Lokasi &amp; PIC Pengguna</td>
                <td>Lokasi: <%= item.lokasi_penempatan || '-' %> | PIC: <%= item.pic_pengguna || '-' %></td>
              </tr>
              <% if (item.link_quotation) { %>
              <tr>
                <td class="label-col">Link Quotation</td>
                <td><a href="<%= item.link_quotation %>" target="_blank" rel="noopener noreferrer" class="text-break"><%= item.link_quotation %></a></td>
              </tr>
              <% } %>
            </table>

            <% 
              let itemsList = [];
              if (item.items_json) {
                try {
                  itemsList = typeof item.items_json === 'string' ? JSON.parse(item.items_json) : item.items_json;
                } catch(e) { itemsList = []; }
              }
            %>

            <% if (itemsList && itemsList.length > 0) { %>
              <!-- Multi Items Table -->
              <div class="p-3 bg-light border-top">
                <h6 class="fw-bold text-success mb-2"><i class="fas fa-boxes-stacked me-1"></i>Rincian Multi-Item Barang (<%= itemsList.length %> Item):</h6>
                <div class="table-responsive">
                  <table class="kov-table bg-white small border">
                    <thead>
                      <tr>
                        <th class="ps-3">No</th>
                        <th>Nama Barang</th>
                        <th>Merk / Spesifikasi</th>
                        <th class="text-center">Qty</th>
                        <th class="text-end">Harga Satuan</th>
                        <th class="text-end pe-3">Subtotal Estimasi</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% itemsList.forEach((it, idx) => { %>
                        <tr>
                          <td class="ps-3"><%= idx + 1 %></td>
                          <td><strong><%= it.nama_barang %></strong></td>
                          <td><%= it.kategori_barang ? ('['+it.kategori_barang+'] ') : '' %><%= it.merk_tipe_model || it.spesifikasi || '-' %></td>
                          <td class="text-center"><%= it.jumlah %> <%= it.satuan %></td>
                          <td class="text-end">Rp <%= Number(it.harga_satuan_estimasi || 0).toLocaleString('id-ID') %></td>
                          <td class="text-end pe-3"><strong>Rp <%= Number(it.total_estimasi || (it.jumlah * it.harga_satuan_estimasi) || 0).toLocaleString('id-ID') %></strong></td>
                        </tr>
                      <% }); %>
                      <tr class="table-light fw-bold">
                        <td colspan="5" class="text-end text-success">TOTAL ESTIMASI KESELURUHAN:</td>
                        <td class="text-end pe-3 text-success fs-6">Rp <%= Number(item.total_estimasi || 0).toLocaleString('id-ID') %></td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            <% } else { %>
              <table class="table table-bordered table-detail mb-0 border-top">
                <tr>
                  <td class="label-col">Nama Barang</td>
                  <td><strong class="text-success fs-6"><%= item.nama_barang || '-' %></strong></td>
                </tr>
                <tr>
                  <td class="label-col">Kategori &amp; Merk</td>
                  <td><%= item.kategori_barang || '-' %> &bull; <%= item.merk_tipe_model || '-' %></td>
                </tr>
                <tr>
                  <td class="label-col">Spesifikasi</td>
                  <td><%= item.spesifikasi || '-' %></td>
                </tr>
                <tr>
                  <td class="label-col">Jumlah &amp; Satuan</td>
                  <td><%= item.jumlah || 1 %> <%= item.satuan || 'Pcs' %></td>
                </tr>
                <tr>
                  <td class="label-col">Harga Satuan Estimasi</td>
                  <td>Rp <%= Number(item.harga_satuan_estimasi || 0).toLocaleString('id-ID') %></td>
                </tr>
                <tr>
                  <td class="label-col">Total Estimasi Biaya</td>
                  <td><strong class="text-dark fs-6">Rp <%= Number(item.total_estimasi || 0).toLocaleString('id-ID') %></strong></td>
                </tr>
              </table>
            <% } %>
          </div>
        </div>

        <!-- Section C: Kebutuhan & Justifikasi -->
        <div class="kov-card mb-4">
          <div class="kov-card-header">
            <h5 class="kov-card-title">
              <i class="fas fa-file-pen text-primary"></i>
              <span>C. Kebutuhan &amp; Justifikasi Operasional</span>
            </h5>
          </div>
          <div class="table-responsive-modern border-0">
            <table class="table table-bordered table-detail mb-0">
              <tr>
                <td class="label-col">Tujuan / Kebutuhan</td>
                <td><%= item.tujuan_kebutuhan || '-' %></td>
              </tr>
              <tr>
                <td class="label-col">Alasan Pengajuan</td>
                <td><%= item.alasan_pengajuan || '-' %></td>
              </tr>
              <tr>
                <td class="label-col">Dampak Operasional</td>
                <td><%= item.dampak_operasional || '-' %></td>
              </tr>
              <tr>
                <td class="label-col">Alternatif Pertimbangan</td>
                <td><%= item.alternatif_dipertimbangkan || '-' %></td>
              </tr>
            </table>
          </div>
        </div>

        <!-- Section D: Khusus Barang Rusak -->
        <% if (item.status_barang === 'Kerusakan' || item.kronologi_kerusakan) { %>
        <div class="kov-card mb-4" style="border-left: 4px solid var(--kov-rose);">
          <div class="kov-card-header">
            <h5 class="kov-card-title text-danger">
              <i class="fas fa-triangle-exclamation"></i>
              <span>D. Khusus Barang Rusak</span>
            </h5>
          </div>
          <div class="table-responsive-modern border-0">
            <table class="table table-bordered table-detail mb-0">
              <tr>
                <td class="label-col">Kronologi Kerusakan</td>
                <td><%= item.kronologi_kerusakan || '-' %></td>
              </tr>
              <tr>
                <td class="label-col">Waktu &amp; Known By</td>
                <td>Tgl: <%= item.tgl_kerusakan || '-' %> Jam: <%= item.jam_kerusakan || '-' %> | Diketahui: <%= item.diketahui_oleh || '-' %></td>
              </tr>
              <tr>
                <td class="label-col">Analisa Penyebab</td>
                <td><span class="badge bg-warning text-dark"><%= item.analisa_penyebab || 'Belum Diketahui' %></span></td>
              </tr>
            </table>
          </div>
        </div>
        <% } %>

        <!-- Section E, F, G, H: Evaluasi & Budget -->
        <div class="kov-card mb-4">
          <div class="kov-card-header">
            <h5 class="kov-card-title">
              <i class="fas fa-calculator text-primary"></i>
              <span>E, F, G &amp; H. Evaluasi, Vendor &amp; Alokasi Budget</span>
            </h5>
          </div>
          <div class="table-responsive-modern border-0">
            <table class="table table-bordered table-detail mb-0">
              <tr>
                <td class="label-col">Rekomendasi Tindakan</td>
                <td><span class="badge bg-primary px-3 py-1"><%= item.rekomendasi || 'Repair' %></span></td>
              </tr>
              <tr>
                <td class="label-col">Biaya Repair vs Replace</td>
                <td>Repair: Rp <%= Number(item.estimasi_biaya_repair || 0).toLocaleString('id-ID') %> | Replace: Rp <%= Number(item.estimasi_biaya_replacement || 0).toLocaleString('id-ID') %></td>
              </tr>
              <tr>
                <td class="label-col">Vendor &amp; PIC</td>
                <td>Vendor: <%= item.vendor_pembelian || '-' %> | PIC: <%= item.pic_vendor || '-' %></td>
              </tr>
              <tr>
                <td class="label-col">Sumber Budget</td>
                <td>Cost Center: <%= item.sumber_budget || '-' %> | Availability: <%= item.ketersediaan_budget || 'Tersedia' %></td>
              </tr>
              <tr>
                <td class="label-col">Treatment Status</td>
                <td><strong><%= item.treatment || '-' %></strong></td>
              </tr>
            </table>

            <!-- Multi Photo Preview Gallery -->
            <% 
              let fotoGallery = [];
              if (item.foto_list) {
                try {
                  fotoGallery = typeof item.foto_list === 'string' ? JSON.parse(item.foto_list) : item.foto_list;
                } catch(e) { fotoGallery = []; }
              }
            %>

            <% if (fotoGallery && fotoGallery.length > 0) { %>
              <div class="p-3 bg-light border-top">
                <h6 class="fw-bold text-success mb-2"><i class="fas fa-images me-1"></i>Lampiran Foto Barang / Kerusakan (<%= fotoGallery.length %> Foto):</h6>
                <%
  function isSafeImg(src) {
    if (!src || typeof src !== 'string') return false;
    const s = src.trim();
    return s.startsWith('data:image/') || s.startsWith('http://') || s.startsWith('https://') || s.startsWith('/uploads/') || s.startsWith('/api/');
  }
%>
                <div class="d-flex flex-wrap gap-2">
                  <% fotoGallery.forEach((imgSrc, fIdx) => { %>
                    <% if (isSafeImg(imgSrc)) { %>
                      <div class="border rounded-3 p-1 bg-white shadow-xs" style="width: 120px; text-align: center;">
                        <a href="<%= imgSrc %>" target="_blank" rel="noopener noreferrer">
                          <img src="<%= imgSrc %>" style="width: 100%; height: 90px; object-fit: contain;">
                        </a>
                        <div class="small text-muted mt-1" style="font-size: 10px;">Foto #<%= fIdx + 1 %></div>
                      </div>
                    <% } %>
                  <% }); %>
                </div>
              </div>
            <% } %>

          </div>
        </div>

      </div>

      <!-- Right Column: Otorisasi & Form Approval -->
      <div class="col-lg-4 no-print">
        <div class="kov-card" style="border-top: 3px solid var(--kov-primary-500);">
          <div class="kov-card-header">
            <h5 class="kov-card-title text-success">
              <i class="fas fa-file-signature"></i>
              <span>Otorisasi &amp; Status Approval</span>
            </h5>
          </div>
          <div class="kov-card-body p-4">
            <form action="/admin/operasional/update/<%= item.id %>" method="POST" data-kov-loading>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              
              <div class="mb-3">
                <label class="kov-label text-success">Status Approval Keseluruhan</label>
                <select name="status_approval" class="form-select fw-bold">
                  <option value="Menunggu Approval" <%= item.status_approval === 'Menunggu Approval' ? 'selected' : '' %>>Menunggu Approval</option>
                  <option value="Disetujui" <%= item.status_approval === 'Disetujui' ? 'selected' : '' %>>Disetujui (Approved)</option>
                  <option value="Dalam Proses" <%= item.status_approval === 'Dalam Proses' ? 'selected' : '' %>>Dalam Proses (In Treatment)</option>
                  <option value="Selesai" <%= item.status_approval === 'Selesai' ? 'selected' : '' %>>Selesai (Completed)</option>
                  <option value="Ditolak" <%= item.status_approval === 'Ditolak' ? 'selected' : '' %>>Ditolak (Rejected)</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="kov-label">Treatment / Tindak Lanjut</label>
                <select name="treatment" class="form-select">
                  <option value="Repair" <%= item.treatment === 'Repair' ? 'selected' : '' %>>Repair</option>
                  <option value="Replacement" <%= item.treatment === 'Replacement' ? 'selected' : '' %>>Replacement</option>
                  <option value="Warranty / Retur" <%= item.treatment === 'Warranty / Retur' ? 'selected' : '' %>>Warranty / Retur</option>
                  <option value="Disposal" <%= item.treatment === 'Disposal' ? 'selected' : '' %>>Disposal</option>
                  <option value="Menunggu Approval" <%= item.treatment === 'Menunggu Approval' ? 'selected' : '' %>>Menunggu Approval</option>
                </select>
              </div>

              <!-- 4 Otorisator Status Controls -->
              <h6 class="fw-bold text-dark border-bottom pb-2 mt-4 mb-3">
                <i class="fas fa-user-check text-primary me-1"></i>Otorisasi 4 Pejabat:
              </h6>

              <!-- Otorisator 1 -->
              <div class="mb-3 bg-light p-2.5 border rounded-3">
                <label class="kov-label small mb-1">1. Andre Antariza (Mengetahui)</label>
                <input type="hidden" name="mengetahui_1" value="<%= item.mengetahui_1 || 'Andre Antariza' %>">
                <select name="status_mengetahui_1" class="form-select form-select-sm">
                  <option value="Pending" <%= (item.status_mengetahui_1 || 'Pending') === 'Pending' ? 'selected' : '' %>>Pending</option>
                  <option value="Disetujui" <%= item.status_mengetahui_1 === 'Disetujui' ? 'selected' : '' %>>Disetujui (Confirmed)</option>
                  <option value="Ditolak" <%= item.status_mengetahui_1 === 'Ditolak' ? 'selected' : '' %>>Ditolak (Rejected)</option>
                </select>
              </div>

              <!-- Otorisator 2 -->
              <div class="mb-3 bg-light p-2.5 border rounded-3">
                <label class="kov-label small mb-1">2. Chusnaeni M (Mengetahui)</label>
                <input type="hidden" name="mengetahui_2" value="<%= item.mengetahui_2 || 'Chusnaeni M' %>">
                <select name="status_mengetahui_2" class="form-select form-select-sm">
                  <option value="Pending" <%= (item.status_mengetahui_2 || 'Pending') === 'Pending' ? 'selected' : '' %>>Pending</option>
                  <option value="Disetujui" <%= item.status_mengetahui_2 === 'Disetujui' ? 'selected' : '' %>>Disetujui (Confirmed)</option>
                  <option value="Ditolak" <%= item.status_mengetahui_2 === 'Ditolak' ? 'selected' : '' %>>Ditolak (Rejected)</option>
                </select>
              </div>

              <!-- Otorisator 3 -->
              <div class="mb-3 bg-light p-2.5 border rounded-3">
                <label class="kov-label small mb-1">3. Setyo Adhi P (Mengetahui)</label>
                <input type="hidden" name="mengetahui_3" value="<%= item.mengetahui_3 || 'Setyo Adhi P' %>">
                <select name="status_mengetahui_3" class="form-select form-select-sm">
                  <option value="Pending" <%= (item.status_mengetahui_3 || 'Pending') === 'Pending' ? 'selected' : '' %>>Pending</option>
                  <option value="Disetujui" <%= item.status_mengetahui_3 === 'Disetujui' ? 'selected' : '' %>>Disetujui (Confirmed)</option>
                  <option value="Ditolak" <%= item.status_mengetahui_3 === 'Ditolak' ? 'selected' : '' %>>Ditolak (Rejected)</option>
                </select>
              </div>

              <!-- Otorisator 4 -->
              <div class="mb-3 bg-light p-2.5 border rounded-3 border-success">
                <label class="kov-label small mb-1 text-success">4. Owner (Menyetujui)</label>
                <input type="hidden" name="menyetujui_owner" value="<%= item.menyetujui_owner || 'Owner' %>">
                <select name="status_menyetujui_owner" class="form-select form-select-sm fw-bold">
                  <option value="Pending" <%= (item.status_menyetujui_owner || 'Pending') === 'Pending' ? 'selected' : '' %>>Pending</option>
                  <option value="Disetujui" <%= item.status_menyetujui_owner === 'Disetujui' ? 'selected' : '' %>>Disetujui (Approved)</option>
                  <option value="Ditolak" <%= item.status_menyetujui_owner === 'Ditolak' ? 'selected' : '' %>>Ditolak (Rejected)</option>
                </select>
              </div>

              <div class="mb-3">
                <label class="kov-label">Vendor Service (Jika Perbaikan)</label>
                <input type="text" name="vendor_service" class="form-control" value="<%= item.vendor_service || '' %>" placeholder="Nama vendor perbaikan">
              </div>

              <div class="mb-3">
                <label class="kov-label">Estimasi Harga Service (Rp)</label>
                <input type="number" name="estimasi_harga_service" class="form-control" value="<%= item.estimasi_harga_service || 0 %>">
              </div>

              <div class="mb-3">
                <label class="kov-label">Target Penyelesaian</label>
                <input type="text" name="target_penyelesaian" class="form-control" value="<%= item.target_penyelesaian || '' %>" placeholder="Contoh: 30 September 2026">
              </div>

              <div class="mb-3">
                <label class="kov-label">Catatan Manajemen / Operasional</label>
                <textarea name="catatan_approval" class="form-control" rows="3" placeholder="Catatan instruksi tambahan..."><%= item.catatan_approval || '' %></textarea>
              </div>

              <button type="submit" class="btn-kov-approve w-100 py-2.5 fs-6 shadow-sm" data-loading-text="Menyimpan Otorisasi...">
                <i class="fas fa-circle-check me-1"></i> Simpan &amp; Otorisasi
              </button>

            </form>
          </div>
        </div>
      </div>
    </div>
      </main>
    </div>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
