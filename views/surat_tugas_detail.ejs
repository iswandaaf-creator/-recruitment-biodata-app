<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Detail Surat Tugas - <%= item.no_surat %></title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261029_cila_v8" rel="stylesheet">
  <style>
    @media print {
      body { background-color: #fff; font-size: 11px; }
      .top-navbar-modern, .no-print { display: none !important; }
      .print-page { page-break-after: always; break-after: page; box-shadow: none !important; border: 1px solid #ccc !important; }
      .kov-card { box-shadow: none !important; border: 1px solid #ccc !important; }
    }
  </style>
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'surat_tugas', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Minimalist Topbar (no-print) -->
      <header class="kov-topbar no-print">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <a class="btn-kov-secondary btn-kov-sm" href="/admin/operasional/surat-tugas">
            <i class="fas fa-arrow-left"></i> <span class="d-none d-sm-inline">Kembali</span>
          </a>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Detail Surat Tugas</h1>
            <span class="text-muted d-none d-md-inline" style="font-size: 0.85rem;">/ <%= item.no_surat %></span>
          </div>
        </div>
        <div class="kov-topbar-right d-flex align-items-center gap-2">
          <!-- KOV Dual-Theme Switcher -->
          <button type="button" class="kov-theme-toggle" onclick="toggleKovTheme()" title="Ganti Mode Gelap / Terang">
            <i class="fas fa-moon kov-theme-icon"></i>
          </button>
          <button class="btn-kov-secondary btn-kov-sm text-dark d-none d-sm-inline-flex" onclick="window.print()">
            <i class="fas fa-print"></i> Cetak
          </button>
          <a href="/api/operasional/surat-tugas/export/pdf/<%= item.id %>" class="btn-kov-danger btn-kov-sm" target="_blank" rel="noopener noreferrer">
            <i class="fas fa-file-pdf"></i> <span class="d-none d-sm-inline">PDF Resmi</span>
          </a>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

    <!-- Header Status Card -->
    <div class="kov-card mb-4" style="border-left: 4px solid var(--kov-primary-500);">
      <div class="kov-card-body p-4 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
          <span class="text-muted small">Nomor Surat Tugas Resmi:</span>
          <h4 class="fw-bold text-success mb-1" style="color: var(--kov-primary-600) !important;"><%= item.no_surat %></h4>
          <span class="small text-muted"><i class="fas fa-calendar-day me-1"></i><%= item.kota_surat || 'Semarang' %>, <%= formatDate(item.tanggal_surat) %></span>
        </div>
        <div class="d-flex align-items-center gap-3">
          <div class="text-end">
            <div class="small text-muted mb-1">Status Surat:</div>
            <% 
              let stPill = 'pill-warning';
              if ((item.status_surat || '').includes('Disetujui')) stPill = 'pill-success';
              else if ((item.status_surat || '').includes('Ditolak')) stPill = 'pill-danger';
            %>
            <span class="status-pill-modern <%= stPill %>" style="font-size: 0.85rem; padding: 6px 14px;">
              <span class="status-dot-pulse"></span> <%= item.status_surat || 'Menunggu Approval' %>
            </span>
          </div>
          <div class="text-end border-start ps-3">
            <div class="small text-muted mb-1">Status LPJ:</div>
            <% if (item.lpj_diisi === 1) { %>
              <span class="status-pill-modern pill-info" style="font-size: 0.85rem; padding: 6px 14px;">
                <span class="status-dot-pulse"></span> LPJ Terisi
              </span>
            <% } else { %>
              <span class="badge bg-light text-secondary border px-3 py-2">Belum Ada LPJ</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <!-- HALAMAN 1: SURAT TUGAS -->
    <div class="kov-card print-page mb-4">
      <div class="kov-card-header">
        <h5 class="kov-card-title">
          <i class="fas fa-file-contract text-primary"></i>
          <span>HALAMAN 1: SURAT TUGAS OPERASIONAL</span>
        </h5>
        <span class="status-pill-modern pill-success" style="font-size: 0.72rem;">
          <span class="status-dot-pulse"></span> Resmi KOV Group
        </span>
      </div>
      <div class="kov-card-body p-4">
        
        <!-- Identitas Pemberi Tugas -->
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label class="kov-label">Nama Pemberi Tugas (KA Outlet):</label>
            <div class="fw-bold text-dark"><%= item.user_pembuat_nama || item.pemberi_tugas_nama || '-' %></div>
          </div>
          <div class="col-md-4">
            <label class="kov-label">Jabatan (KA Outlet):</label>
            <div class="fw-bold text-dark"><%= item.user_pembuat_jabatan || item.pemberi_tugas_jabatan || '-' %></div>
          </div>
          <div class="col-md-4">
            <label class="kov-label">Divisi Terkait:</label>
            <div><span class="badge bg-light text-dark border"><%= item.divisi_terkait || '-' %></span></div>
          </div>
        </div>

        <!-- Tabel Petugas / Penerima Tugas -->
        <h6 class="fw-bold text-dark mb-2"><i class="fas fa-users text-primary me-2"></i>Daftar Penerima Tugas:</h6>
        <div class="table-responsive-modern mb-4">
          <table class="kov-table">
            <thead>
              <tr>
                <th class="ps-3" style="width: 50px;">No</th>
                <th>Nama Karyawan</th>
                <th style="width: 35%;">Jabatan</th>
                <th class="pe-3" style="width: 25%;">Divisi</th>
              </tr>
            </thead>
            <tbody>
              <% 
                let petugasArr = [];
                try {
                  petugasArr = typeof item.petugas_json === 'string' ? JSON.parse(item.petugas_json || '[]') : (item.petugas || []);
                } catch(e) { petugasArr = []; }
              %>
              <% if (petugasArr && petugasArr.length > 0) { %>
                <% petugasArr.forEach((p, idx) => { %>
                  <tr>
                    <td class="ps-3 fw-bold text-muted"><%= idx + 1 %></td>
                    <td><strong class="text-dark"><%= p.nama || '-' %></strong></td>
                    <td><%= p.jabatan || '-' %></td>
                    <td class="pe-3"><%= p.divisi || '-' %></td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td class="ps-3 fw-bold text-muted">1</td>
                  <td><strong class="text-dark"><%= item.lpj_nama || item.user_pembuat_nama || '-' %></strong></td>
                  <td><%= item.lpj_jabatan_divisi || item.user_pembuat_jabatan || '-' %></td>
                  <td class="pe-3"><%= item.divisi_terkait || '-' %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Rincian Penugasan -->
        <h6 class="fw-bold text-dark mb-2"><i class="fas fa-map-location-dot text-primary me-2"></i>Rincian Penugasan Luar Kota:</h6>
        <div class="row g-3 mb-4 p-3 bg-light rounded-3 border">
          <div class="col-md-6">
            <label class="kov-label small">Lokasi / Tujuan:</label>
            <div class="fw-bold text-dark"><%= item.lokasi_tujuan || '-' %></div>
          </div>
          <div class="col-md-6">
            <label class="kov-label small">Kota Tujuan:</label>
            <div class="fw-bold text-dark"><%= item.kota_tujuan || '-' %></div>
          </div>
          <div class="col-md-6">
            <label class="kov-label small">Jadwal Perjalanan:</label>
            <div class="fw-bold text-primary">
              <i class="fas fa-calendar-alt me-1"></i><%= formatDate(item.tanggal_berangkat) %> s/d <%= formatDate(item.tanggal_kembali) %>
            </div>
          </div>
          <div class="col-md-6">
            <label class="kov-label small">Keperluan Tugas:</label>
            <div class="fw-semibold text-dark"><%= item.keperluan || '-' %></div>
          </div>
        </div>

        <!-- Klausul Resmi -->
        <div class="p-3 bg-white border-start border-4 border-success rounded-3 small mb-4" style="border-left-color: var(--kov-primary-500) !important;">
          <p class="mb-1 text-dark"><strong>Klausul:</strong> Selama melaksanakan tugas tersebut, yang bersangkutan wajib menjalankan tugas dan tanggung jawab dengan sebaik–baiknya serta menjaga nama baik KOV Group.</p>
          <p class="mb-0 text-muted">Biaya yang timbul sehubungan dengan pelaksanaan tugas mengikuti ketentuan perjalanan dinas yang berlaku di perusahaan dan dipertanggungjawabkan sesuai prosedur yang ditetapkan.</p>
        </div>

        <!-- Lembar Otorisasi 3 Pihak -->
        <div class="row g-3 text-center">
          <div class="col-md-4">
            <div class="p-3 border rounded-3 bg-light h-100">
              <span class="status-pill-modern pill-slate mb-2" style="font-size: 0.72rem;">Dibuat Oleh</span>
              <div class="fw-bold text-dark"><%= item.user_pembuat_nama || 'User' %></div>
              <div class="small text-muted mb-2"><%= item.user_pembuat_jabatan || 'KA Outlet' %></div>
              <% if (item.signature_pembuat) { %>
                <img src="<%= item.signature_pembuat %>" style="max-height: 50px; max-width: 140px; object-fit: contain;" alt="TTD">
              <% } else { %>
                <div class="text-muted small py-3"><em>(Tanda tangan tercatat)</em></div>
              <% } %>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-3 border rounded-3 bg-light h-100">
              <span class="status-pill-modern pill-info mb-2" style="font-size: 0.72rem;">Diperiksa Oleh</span>
              <div class="fw-bold text-dark"><%= item.gm_nama || 'Aldo Widarta - GM' %></div>
              <div class="small text-muted mb-2">General Manager</div>
              <div class="mt-2">
                <% if (item.status_gm === 'Disetujui') { %>
                  <span class="status-pill-modern pill-success" style="font-size: 0.78rem;"><i class="fas fa-circle-check me-1"></i> Disetujui</span>
                  <div class="small text-muted mt-1"><%= item.tgl_gm || '' %></div>
                <% } else if (item.status_gm === 'Ditolak') { %>
                  <span class="status-pill-modern pill-danger" style="font-size: 0.78rem;"><i class="fas fa-circle-xmark me-1"></i> Ditolak</span>
                <% } else { %>
                  <span class="status-pill-modern pill-warning" style="font-size: 0.78rem;"><i class="fas fa-clock me-1"></i> Menunggu</span>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="p-3 border rounded-3 bg-light h-100 border-success">
              <span class="status-pill-modern pill-success mb-2" style="font-size: 0.72rem;">Disetujui Oleh (KA Divisi)</span>
              <div class="fw-bold text-success fs-6"><%= item.ka_divisi_nama || 'KA Divisi' %></div>
              <div class="small text-muted mb-2"><%= item.ka_divisi_jabatan || ('Penyetuju / KA Divisi ' + (item.divisi_terkait || '')) %></div>
              <div class="mt-2">
                <% if (item.status_ka_divisi === 'Disetujui') { %>
                  <span class="status-pill-modern pill-success" style="font-size: 0.78rem;"><i class="fas fa-circle-check me-1"></i> Disetujui</span>
                  <div class="small text-muted mt-1"><%= item.tgl_ka_divisi || '' %></div>
                <% } else if (item.status_ka_divisi === 'Ditolak') { %>
                  <span class="status-pill-modern pill-danger" style="font-size: 0.78rem;"><i class="fas fa-circle-xmark me-1"></i> Ditolak</span>
                <% } else { %>
                  <span class="status-pill-modern pill-warning" style="font-size: 0.78rem;"><i class="fas fa-clock me-1"></i> Menunggu</span>
                <% } %>
              </div>
            </div>
          </div>
          <div class="col-12 text-start">
            <div class="small text-muted"><strong>Tembusan :</strong> 1. Owner &bull; 2. FAT &bull; 3. HRD</div>
          </div>
        </div>

      </div>
    </div>

    <!-- HALAMAN 2: FORM PERTANGGUNGJAWABAN (LPJ) -->
    <div class="kov-card print-page mb-4">
      <div class="kov-card-header">
        <h5 class="kov-card-title">
          <i class="fas fa-receipt text-primary"></i>
          <span>HALAMAN 2: FORM PERTANGGUNGJAWABAN PERJALANAN DINAS (LPJ)</span>
        </h5>
        <% if (item.lpj_diisi === 1) { %>
          <span class="status-pill-modern pill-info" style="font-size: 0.72rem;">Laporan Realisasi Terlampir</span>
        <% } else { %>
          <span class="status-pill-modern pill-warning" style="font-size: 0.72rem;">Belum Diisi / Masih Draft</span>
        <% } %>
      </div>
      <div class="kov-card-body p-4">

        <% if (item.lpj_diisi === 1) { %>
          
          <!-- A. Realisasi Perjalanan -->
          <h6 class="fw-bold text-dark mb-2"><i class="fas fa-clock-rotate-left text-primary me-2"></i>A. REALISASI PERJALANAN</h6>
          <div class="table-responsive-modern mb-4">
            <table class="kov-table">
              <thead>
                <tr>
                  <th class="ps-3" style="width: 50%;">Keterangan</th>
                  <th class="pe-3">Realisasi Pelaksanaan</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="ps-3">Tanggal Berangkat</td>
                  <td class="pe-3 fw-bold text-dark"><%= formatDate(item.realisasi_tgl_berangkat || item.tanggal_berangkat) %></td>
                </tr>
                <tr>
                  <td class="ps-3">Jam Berangkat</td>
                  <td class="pe-3"><%= item.realisasi_jam_berangkat || '-' %> WIB</td>
                </tr>
                <tr>
                  <td class="ps-3">Tanggal Kembali</td>
                  <td class="pe-3 fw-bold text-dark"><%= formatDate(item.realisasi_tgl_kembali || item.tanggal_kembali) %></td>
                </tr>
                <tr>
                  <td class="ps-3">Jam Kembali</td>
                  <td class="pe-3"><%= item.realisasi_jam_kembali || '-' %> WIB</td>
                </tr>
                <tr class="table-light">
                  <td class="ps-3"><strong>Jumlah Hari Dinas</strong></td>
                  <td class="pe-3"><strong class="text-success"><%= item.realisasi_jumlah_hari || 0 %> hari</strong></td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- B. Pelaksanaan Tugas -->
          <h6 class="fw-bold text-dark mb-2"><i class="fas fa-tasks text-primary me-2"></i>B. PELAKSANAAN TUGAS</h6>
          <div class="table-responsive-modern mb-3">
            <table class="kov-table">
              <thead>
                <tr>
                  <th class="ps-3" style="width: 40%;">Keperluan / Tugas</th>
                  <th style="width: 40%;">Hasil Pelaksanaan</th>
                  <th class="text-center pe-3" style="width: 20%;">Status</th>
                </tr>
              </thead>
              <tbody>
                <% 
                  let tugasArr = [];
                  try {
                    tugasArr = typeof item.pelaksanaan_tugas_json === 'string' ? JSON.parse(item.pelaksanaan_tugas_json || '[]') : (item.pelaksanaan_tugas || []);
                  } catch(e) { tugasArr = []; }
                %>
                <% if (tugasArr && tugasArr.length > 0) { %>
                  <% tugasArr.forEach(t => { %>
                    <tr>
                      <td class="ps-3"><%= t.tugas || '-' %></td>
                      <td><%= t.hasil || '-' %></td>
                      <td class="text-center pe-3">
                        <% if ((t.status || '').toLowerCase() === 'selesai') { %>
                          <span class="status-pill-modern pill-success" style="font-size: 0.72rem;"><i class="fas fa-check me-1"></i> Selesai</span>
                        <% } else { %>
                          <span class="status-pill-modern pill-warning" style="font-size: 0.72rem;">Belum Selesai</span>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td class="ps-3"><%= item.keperluan || '-' %></td>
                    <td>Tugas telah dilaksanakan sesuai arahan.</td>
                    <td class="text-center pe-3"><span class="status-pill-modern pill-success" style="font-size: 0.72rem;"><i class="fas fa-check me-1"></i> Selesai</span></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <div class="small text-muted mb-4 p-2.5 bg-light rounded-3 border">
            <strong>Bukti Dokumen Pendukung:</strong> <%= item.bukti_dokumen_keterangan || '-' %>
            <% if (item.bukti_dokumen_link) { %>
              &bull; <a href="<%= item.bukti_dokumen_link %>" target="_blank" rel="noopener noreferrer" class="fw-bold text-success"><i class="fas fa-link me-1"></i>Buka Tautan Lampiran</a>
            <% } %>
          </div>

          <!-- C. Perhitungan Biaya -->
          <h6 class="fw-bold text-dark mb-2"><i class="fas fa-calculator text-primary me-2"></i>C. PERHITUNGAN BIAYA</h6>
          <div class="table-responsive-modern mb-4">
            <table class="kov-table">
              <thead>
                <tr>
                  <th class="ps-3" style="width: 30%;">Komponen</th>
                  <th style="width: 40%;">Dasar Perhitungan</th>
                  <th class="text-end pe-3" style="width: 30%;">Jumlah (Rp)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="ps-3">Uang Dinas</td>
                  <td>Rp 50.000 × <%= item.uang_dinas_hari || 0 %> hari</td>
                  <td class="text-end pe-3 fw-semibold">Rp <%= (item.uang_dinas_total || 0).toLocaleString('id-ID') %></td>
                </tr>
                <tr>
                  <td class="ps-3">Uang Menginap</td>
                  <td>Rp 25.000 × <%= item.uang_menginap_malam || 0 %> malam</td>
                  <td class="text-end pe-3 fw-semibold">Rp <%= (item.uang_menginap_total || 0).toLocaleString('id-ID') %></td>
                </tr>
                <tr>
                  <td class="ps-3">Transportasi</td>
                  <td>Sesuai bukti / realisasi</td>
                  <td class="text-end pe-3 fw-semibold">Rp <%= (item.biaya_transportasi || 0).toLocaleString('id-ID') %></td>
                </tr>
                <tr>
                  <td class="ps-3">Penginapan</td>
                  <td>Sesuai bukti / realisasi</td>
                  <td class="text-end pe-3 fw-semibold">Rp <%= (item.biaya_penginapan || 0).toLocaleString('id-ID') %></td>
                </tr>
                <tr>
                  <td class="ps-3">Biaya lainnya</td>
                  <td><%= item.keterangan_biaya_lain ? item.keterangan_biaya_lain : 'Sesuai ketentuan' %></td>
                  <td class="text-end pe-3 fw-semibold">Rp <%= (item.biaya_lainnya || 0).toLocaleString('id-ID') %></td>
                </tr>
                <tr class="table-light fw-bold">
                  <td class="ps-3 text-end text-uppercase" colspan="2">TOTAL PERTANGGUNGJAWABAN:</td>
                  <td class="text-end pe-3 text-success fs-6">Rp <%= (item.total_biaya || 0).toLocaleString('id-ID') %></td>
                </tr>
              </tbody>
            </table>
          </div>

        <% } else { %>
          <div class="text-center py-4 bg-light rounded-3 mb-3 border">
            <i class="fas fa-file-circle-exclamation fs-2 text-warning mb-2"></i>
            <h6 class="fw-bold text-dark">Form Pertanggungjawaban (LPJ) Belum Dilaporkan</h6>
            <p class="text-muted small mb-0">Gunakan form di bawah untuk menginput realisasi dinas dan rincian biaya.</p>
          </div>
        <% } %>

      </div>
    </div>

    <!-- UPDATE / APPROVAL FORM (NO PRINT) -->
    <div class="kov-card no-print">
      <div class="kov-card-header">
        <h5 class="kov-card-title text-success">
          <i class="fas fa-pen-to-square"></i>
          <span>Update Approval &amp; Pertanggungjawaban (LPJ)</span>
        </h5>
      </div>
      <div class="kov-card-body p-4">
        <form action="/admin/operasional/surat-tugas/update/<%= item.id %>" method="POST" data-kov-loading>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          
          <div class="row g-4 mb-4">
            <!-- Approval Pemeriksa (GM) -->
            <div class="col-md-6 border-end pe-md-4">
              <h6 class="fw-bold text-dark mb-3"><i class="fas fa-user-check text-primary me-2"></i>1. Otorisasi Pemeriksa (Aldo Widarta - GM)</h6>
              <div class="mb-3">
                <label class="kov-label small">Status Pemeriksa (GM):</label>
                <select class="form-select" name="status_gm">
                  <option value="Pending" <%= item.status_gm === 'Pending' ? 'selected' : '' %>>Pending</option>
                  <option value="Disetujui" <%= item.status_gm === 'Disetujui' ? 'selected' : '' %>>Selesai Diperiksa / Disetujui</option>
                  <option value="Ditolak" <%= item.status_gm === 'Ditolak' ? 'selected' : '' %>>Ditolak</option>
                </select>
              </div>
              <div class="mb-3">
                <label class="kov-label small">Catatan Pemeriksa (GM):</label>
                <textarea class="form-control" name="catatan_gm" rows="2" placeholder="Catatan masukan General Manager..."><%= item.catatan_gm || '' %></textarea>
              </div>
            </div>

            <!-- Approval Penyetuju (KA Divisi) -->
            <div class="col-md-6 ps-md-4">
              <h6 class="fw-bold text-dark mb-3"><i class="fas fa-stamp text-success me-2"></i>2. Otorisasi Menyetujui (<%= item.ka_divisi_nama || 'KA Divisi' %>)</h6>
              <div class="mb-3">
                <label class="kov-label small">Status Penyetuju (<%= item.ka_divisi_nama %>):</label>
                <select class="form-select" name="status_ka_divisi">
                  <option value="Pending" <%= item.status_ka_divisi === 'Pending' ? 'selected' : '' %>>Pending</option>
                  <option value="Disetujui" <%= item.status_ka_divisi === 'Disetujui' ? 'selected' : '' %>>Disetujui (Approved)</option>
                  <option value="Ditolak" <%= item.status_ka_divisi === 'Ditolak' ? 'selected' : '' %>>Ditolak</option>
                </select>
              </div>
              <div class="mb-3">
                <label class="kov-label small">Catatan Penyetuju:</label>
                <textarea class="form-control" name="catatan_ka_divisi" rows="2" placeholder="Catatan persetujuan KA Divisi..."><%= item.catatan_ka_divisi || '' %></textarea>
              </div>
              <div class="mb-3">
                <label class="kov-label small">Status Keseluruhan Surat Tugas:</label>
                <select class="form-select fw-bold text-success" name="status_surat">
                  <option value="Menunggu Approval" <%= item.status_surat === 'Menunggu Approval' ? 'selected' : '' %>>Menunggu Approval</option>
                  <option value="Disetujui" <%= item.status_surat === 'Disetujui' ? 'selected' : '' %>>Disetujui</option>
                  <option value="Ditolak" <%= item.status_surat === 'Ditolak' ? 'selected' : '' %>>Ditolak</option>
                  <option value="Selesai" <%= item.status_surat === 'Selesai' ? 'selected' : '' %>>Selesai &amp; LPJ Closed</option>
                </select>
              </div>
            </div>
          </div>

          <hr class="my-4">

          <!-- Form Edit Realisasi Biaya LPJ -->
          <h6 class="fw-bold text-dark mb-3"><i class="fas fa-coins text-primary me-2"></i>Update / Input Rincian LPJ Biaya</h6>
          <div class="row g-3">
            <div class="col-md-3">
              <label class="kov-label small">Tgl Berangkat Realisasi:</label>
              <input type="date" class="form-control" name="realisasi_tgl_berangkat" value="<%= item.realisasi_tgl_berangkat || item.tanggal_berangkat || '' %>">
            </div>
            <div class="col-md-3">
              <label class="kov-label small">Jam Berangkat:</label>
              <input type="time" class="form-control" name="realisasi_jam_berangkat" value="<%= item.realisasi_jam_berangkat || '08:00' %>">
            </div>
            <div class="col-md-3">
              <label class="kov-label small">Tgl Kembali Realisasi:</label>
              <input type="date" class="form-control" name="realisasi_tgl_kembali" value="<%= item.realisasi_tgl_kembali || item.tanggal_kembali || '' %>">
            </div>
            <div class="col-md-3">
              <label class="kov-label small">Jam Kembali:</label>
              <input type="time" class="form-control" name="realisasi_jam_kembali" value="<%= item.realisasi_jam_kembali || '18:00' %>">
            </div>

            <div class="col-md-3">
              <label class="kov-label small">Jumlah Hari (Uang Dinas Rp 50k):</label>
              <input type="number" class="form-control" name="uang_dinas_hari" value="<%= item.uang_dinas_hari || item.realisasi_jumlah_hari || 1 %>">
            </div>
            <div class="col-md-3">
              <label class="kov-label small">Jumlah Malam (Uang Inap Rp 25k):</label>
              <input type="number" class="form-control" name="uang_menginap_malam" value="<%= item.uang_menginap_malam || 0 %>">
            </div>
            <div class="col-md-3">
              <label class="kov-label small">Transportasi (Rp):</label>
              <input type="number" class="form-control" name="biaya_transportasi" value="<%= item.biaya_transportasi || 0 %>">
            </div>
            <div class="col-md-3">
              <label class="kov-label small">Penginapan / Hotel (Rp):</label>
              <input type="number" class="form-control" name="biaya_penginapan" value="<%= item.biaya_penginapan || 0 %>">
            </div>

            <div class="col-md-6">
              <label class="kov-label small">Keterangan Biaya Lainnya:</label>
              <input type="text" class="form-control" name="keterangan_biaya_lain" value="<%= item.keterangan_biaya_lain || '' %>" placeholder="Parkir, tol, dll">
            </div>
            <div class="col-md-3">
              <label class="kov-label small">Biaya Lainnya (Rp):</label>
              <input type="number" class="form-control" name="biaya_lainnya" value="<%= item.biaya_lainnya || 0 %>">
            </div>
            <div class="col-md-3">
              <label class="kov-label small">Status LPJ:</label>
              <select class="form-select" name="status_lpj">
                <option value="Draft" <%= item.status_lpj === 'Draft' ? 'selected' : '' %>>Draft</option>
                <option value="Menunggu Approval LPJ" <%= item.status_lpj === 'Menunggu Approval LPJ' ? 'selected' : '' %>>Menunggu Approval LPJ</option>
                <option value="Disetujui LPJ" <%= item.status_lpj === 'Disetujui LPJ' ? 'selected' : '' %>>Disetujui LPJ</option>
              </select>
            </div>
            <div class="col-md-12">
              <label class="kov-label small">Bukti Dokumen / Catatan Hasil Tugas:</label>
              <input type="text" class="form-control" name="bukti_dokumen_keterangan" value="<%= item.bukti_dokumen_keterangan || '' %>" placeholder="Keterangan dokumen hasil penugasan...">
            </div>
          </div>

          <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn-kov-approve px-4 py-2" data-loading-text="Menyimpan Approval...">
              <i class="fas fa-circle-check me-1"></i> Simpan Perubahan &amp; Approval
            </button>
          </div>

        </form>
      </div>
    </div>
      </main>
    </div>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
