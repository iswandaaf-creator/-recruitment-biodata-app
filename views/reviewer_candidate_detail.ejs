<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Review Pelamar - <%= candidate.nama_lengkap %> (<%= candidate.divisi || candidate.posisi_dilamar %>)</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/figma-ui.css" rel="stylesheet">
  <link href="/assets/css/dribbble-drive.css" rel="stylesheet">
  <style>
    .review-timeline-item {
      position: relative;
      padding-left: 2rem;
      padding-bottom: 1.5rem;
      border-left: 2px solid var(--kov-slate-200);
    }
    .review-timeline-item:last-child {
      border-left: 2px solid transparent;
      padding-bottom: 0;
    }
    .review-timeline-dot {
      position: absolute;
      left: -9px;
      top: 0;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--kov-primary-600);
      border: 3px solid #ffffff;
      box-shadow: 0 0 0 1px var(--kov-slate-300);
    }
  </style>
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'reviewer', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Minimalist Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <a class="btn-kov-secondary btn-kov-sm" href="/reviewer">
            <i class="fas fa-arrow-left"></i> <span class="d-none d-sm-inline">Kembali</span>
          </a>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Review Pelamar</h1>
            <span class="text-muted d-none d-md-inline" style="font-size: 0.85rem;">/ <%= candidate.nama_lengkap %></span>
          </div>
        </div>
        <div class="kov-topbar-right d-flex align-items-center gap-2">
          <!-- Coinbase Dual-Theme Switcher -->
          <button type="button" class="kov-theme-toggle" onclick="toggleKovTheme()" title="Ganti Mode Gelap / Terang (Coinbase Theme)">
            <i class="fas fa-moon kov-theme-icon"></i>
          </button>
          <% if (user && (user.role === 'superadmin' || user.role === 'admin')) { %>
            <a href="/admin/candidate/<%= candidate.id %>" class="btn-kov-outline btn-kov-sm">
              <i class="fas fa-user-gear"></i> <span class="d-none d-sm-inline">Mode HR</span>
            </a>
          <% } %>
          <a href="/api/export/pdf/<%= candidate.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-danger btn-kov-sm">
            <i class="fas fa-file-pdf"></i> <span class="d-none d-sm-inline">PDF 5 Halaman</span>
          </a>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

    <!-- Flash message -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 shadow-xs" role="alert">
        <i class="fas fa-circle-check me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3 shadow-xs" role="alert">
        <i class="fas fa-circle-exclamation me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <!-- Candidate Main Header Card -->
    <% 
      const dLow = (candidate.divisi || 'operasional').toLowerCase();
      let divBadgeClass = 'bg-light text-dark border';
      if (dLow.includes('kitchen')) divBadgeClass = 'bg-warning-subtle text-warning-emphasis border border-warning';
      else if (dLow.includes('barista')) divBadgeClass = 'bg-amber-subtle text-amber-emphasis border';
      else if (dLow.includes('hr')) divBadgeClass = 'bg-primary-subtle text-primary border';
      else if (dLow.includes('teknisi')) divBadgeClass = 'bg-info-subtle text-info border';
      else if (dLow.includes('fat') || dLow.includes('finance')) divBadgeClass = 'bg-success-subtle text-success border';
      else if (dLow.includes('it')) divBadgeClass = 'bg-dark text-info border border-info';
      else divBadgeClass = 'bg-success-subtle text-success border';
    %>
    <div class="kov-card mb-4">
      <div class="kov-card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
          <div class="d-flex align-items-center gap-3.5 flex-wrap">
            <% if (candidate.foto_kandidat) { %>
              <div class="position-relative">
                <img src="<%= candidate.foto_kandidat %>" class="rounded-3 border shadow-xs" style="width: 85px; height: 110px; object-fit: cover;">
                <span class="badge bg-dark position-absolute bottom-0 start-50 translate-middle-x mb-1 opacity-75" style="font-size: 9px;">Pasfoto</span>
              </div>
            <% } else { %>
              <div class="rounded-3 bg-light border d-flex flex-column align-items-center justify-content-center text-muted" style="width: 85px; height: 110px;">
                <i class="fas fa-camera fa-2x mb-1 opacity-50"></i>
                <span style="font-size: 10px;">Tanpa Foto</span>
              </div>
            <% } %>
            <div>
              <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                <h3 class="fw-bold mb-0 text-dark"><%= candidate.nama_lengkap %></h3>
                <span class="badge <%= divBadgeClass %> px-2 py-1">
                  <i class="fas fa-briefcase me-1"></i>Divisi: <%= candidate.divisi || 'Operasional' %>
                </span>
              </div>
              <div class="text-muted small mb-2">
                <span class="me-3 fw-semibold text-dark"><i class="fas fa-tag me-1 text-primary"></i>Posisi Dilamar: <%= candidate.posisi_dilamar %></span>
                <% if (candidate.posisi_lain) { %>
                  <span class="me-3 text-muted">(Alternatif: <%= candidate.posisi_lain %>)</span>
                <% } %>
              </div>
              <div class="d-flex flex-wrap gap-3 text-secondary small">
                <span><i class="fas fa-envelope text-primary me-1"></i><%= candidate.email %></span>
                <span><i class="fas fa-phone text-primary me-1"></i><%= candidate.no_hp %></span>
                <span><i class="fas fa-location-dot text-primary me-1"></i><%= candidate.kota_domisili || candidate.kota_ktp || '-' %></span>
                <span><i class="fas fa-calendar text-primary me-1"></i>Melamar: <%= formatDate(candidate.created_at, true) %></span>
              </div>
            </div>
          </div>

          <div>
            <span class="badge bg-light text-dark border px-3 py-2 fs-6 rounded-3">
              Ref ID Pelamar: #<%= candidate.id %>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- FORM INPUT CATATAN REVIEWER -->
    <div class="kov-card mb-4" style="border-top: 3px solid var(--kov-blue);">
      <div class="kov-card-header">
        <h5 class="kov-card-title">
          <i class="fas fa-pen-to-square text-primary"></i>
          <span>Beri Catatan &amp; Evaluasi Reviewer Divisi</span>
        </h5>
        <span class="status-pill-modern pill-info" style="font-size: 0.75rem;">
          <span class="status-dot-pulse"></span> Reviewer: <%= user.nama || user.username %> (<%= user.role %>)
        </span>
      </div>
      <div class="kov-card-body p-4">
        <form action="/reviewer/candidate/<%= candidate.id %>/review" method="POST" data-kov-loading>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="row g-3">
            
            <!-- Pilih Divisi Evaluasi -->
            <div class="col-md-4">
              <label class="kov-label">Divisi Evaluasi Anda <span class="text-danger">*</span></label>
              <select class="form-select" name="divisi" required>
                <% if (allowedDivisions.length > 0) { %>
                  <% allowedDivisions.forEach(div => { %>
                    <option value="<%= div %>" <%= (candidate.divisi && candidate.divisi.toLowerCase() === div.toLowerCase()) ? 'selected' : '' %>>
                      <%= div %>
                    </option>
                  <% }); %>
                <% } else { %>
                  <option value="<%= candidate.divisi || 'Operasional' %>"><%= candidate.divisi || 'Operasional' %></option>
                <% } %>
              </select>
              <div class="form-text small">Divisi asal penilaian catatan Anda.</div>
            </div>

            <!-- Rekomendasi Seleksi -->
            <div class="col-md-8">
              <label class="kov-label">Rekomendasi Seleksi Dari Reviewer <span class="text-danger">*</span></label>
              <div class="d-flex flex-wrap gap-2">
                <div class="form-check form-check-inline border rounded-3 p-2 px-3 bg-light">
                  <input class="form-check-input" type="radio" name="rekomendasi" id="rek_lolos" value="Direkomendasikan Lolos" required checked>
                  <label class="form-check-label text-success fw-bold small" for="rek_lolos">
                    <i class="fas fa-circle-check me-1"></i>Direkomendasikan Lolos
                  </label>
                </div>
                <div class="form-check form-check-inline border rounded-3 p-2 px-3 bg-light">
                  <input class="form-check-input" type="radio" name="rekomendasi" id="rek_hold" value="Dipertimbangkan / Cadangan">
                  <label class="form-check-label text-warning-emphasis fw-bold small" for="rek_hold">
                    <i class="fas fa-hourglass-half me-1"></i>Dipertimbangkan / Cadangan
                  </label>
                </div>
                <div class="form-check form-check-inline border rounded-3 p-2 px-3 bg-light">
                  <input class="form-check-input" type="radio" name="rekomendasi" id="rek_tolak" value="Tidak Direkomendasikan">
                  <label class="form-check-label text-danger fw-bold small" for="rek_tolak">
                    <i class="fas fa-circle-xmark me-1"></i>Tidak Direkomendasikan
                  </label>
                </div>
              </div>
            </div>

            <!-- Catatan Evaluasi Reviewer -->
            <div class="col-12">
              <label class="kov-label">Catatan &amp; Ulasan Reviewer Terhadap Pelamar <span class="text-danger">*</span></label>
              <textarea class="form-control" name="catatan" rows="4" placeholder="Tuliskan ulasan detail kualifikasi pelamar: keahlian teknis, riwayat pengalaman, attitude/sikap, kecocokan posisi di outlet/divisi, dan saran untuk tim HR..." required></textarea>
              <div class="form-text small">
                <i class="fas fa-info-circle me-1"></i>Catatan ini akan tersimpan permanen dalam riwayat rekrutmen dan dapat dilihat oleh Tim HR &amp; Super Admin.
              </div>
            </div>

            <div class="col-12 text-end mt-3">
              <button type="submit" class="btn-kov-primary" data-loading-text="Menyimpan Review...">
                <i class="fas fa-paper-plane me-1"></i> Simpan &amp; Kirim Catatan Review
              </button>
            </div>

          </div>
        </form>
      </div>
    </div>

    <!-- RIWAYAT CATATAN REVIEWER -->
    <div class="kov-card mb-4">
      <div class="kov-card-header">
        <h5 class="kov-card-title">
          <i class="fas fa-comments text-primary"></i>
          <span>Riwayat Catatan Reviewer Pelamar Ini (<%= reviews.length %>)</span>
        </h5>
        <span class="badge bg-light text-secondary border">Timeline Diskusi Review</span>
      </div>
      <div class="kov-card-body p-4">
        <% if (reviews.length === 0) { %>
          <div class="text-center py-4 text-muted">
            <i class="fas fa-comment-slash fa-2x mb-2 opacity-50"></i>
            <p class="mb-0 small">Belum ada catatan review untuk pelamar ini. Jadilah yang pertama memberikan catatan evaluasi di atas!</p>
          </div>
        <% } else { %>
          <div class="review-timeline">
            <% reviews.forEach(r => { 
              let rekBadge = 'pill-slate';
              if ((r.rekomendasi || '').includes('Direkomendasikan Lolos')) rekBadge = 'pill-success';
              else if ((r.rekomendasi || '').includes('Dipertimbangkan')) rekBadge = 'pill-warning';
              else if ((r.rekomendasi || '').includes('Tidak')) rekBadge = 'pill-danger';
            %>
              <div class="review-timeline-item">
                <div class="review-timeline-dot"></div>
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
                  <div>
                    <strong class="text-dark"><%= r.reviewer_name || r.reviewer_username %></strong>
                    <span class="badge bg-light text-dark border ms-1 small">Divisi: <%= r.divisi || 'Umum' %></span>
                    <span class="badge bg-light text-muted border ms-1 small">@<%= r.reviewer_username %></span>
                  </div>
                  <div>
                    <span class="status-pill-modern <%= rekBadge %> me-2" style="font-size: 0.72rem;">
                      <span class="status-dot-pulse"></span> <%= r.rekomendasi || 'Catatan' %>
                    </span>
                    <span class="small text-muted"><i class="fas fa-clock me-1"></i><%= formatDate(r.created_at, true) %></span>
                  </div>
                </div>
                <div class="p-3 bg-light rounded-3 border text-dark mt-2" style="white-space: pre-line; line-height: 1.5;">
                  <%= r.catatan %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>

    <!-- DETAIL BIODATA LENGKAP PELAMAR -->
    <div class="kov-card mb-4">
      <div class="kov-card-header">
        <h5 class="kov-card-title">
          <i class="fas fa-id-card text-muted"></i>
          <span>Informasi Lengkap Biodata Pelamar</span>
        </h5>
      </div>
      <div class="kov-card-body p-4">
        
        <!-- Identitas Diri -->
        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-user me-2 text-primary"></i>1. Identitas Diri</h6>
        <div class="row g-3 mb-4 small">
          <div class="col-md-4"><strong>Nama Lengkap:</strong> <%= candidate.nama_lengkap %></div>
          <div class="col-md-4"><strong>Nama Panggilan:</strong> <%= candidate.nama_panggilan || '-' %></div>
          <div class="col-md-4"><strong>Jenis Kelamin:</strong> <%= candidate.jenis_kelamin %></div>
          <div class="col-md-4"><strong>Tempat, Tgl Lahir:</strong> <%= candidate.tempat_lahir %>, <%= formatDate(candidate.tanggal_lahir) %></div>
          <div class="col-md-4"><strong>Agama:</strong> <%= candidate.agama || '-' %></div>
          <div class="col-md-4"><strong>Status Pernikahan:</strong> <%= candidate.status_perkawinan || '-' %></div>
          <div class="col-md-4"><strong>Golongan Darah:</strong> <%= candidate.golongan_darah || '-' %></div>
          <div class="col-md-4"><strong>Suku / Bangsa:</strong> <%= candidate.suku || '-' %> / <%= candidate.kewarganegaraan || '-' %></div>
          <div class="col-md-4"><strong>Hobby / Minat:</strong> <%= candidate.hobby || '-' %></div>
          <div class="col-md-6"><strong>Alamat KTP:</strong> <%= candidate.alamat_ktp %> (<%= candidate.kota_ktp || '-' %>)</div>
          <div class="col-md-6"><strong>Alamat Domisili:</strong> <%= candidate.alamat_domisili %> (<%= candidate.kota_domisili || '-' %>)</div>
        </div>

        <!-- Riwayat Pendidikan Formal -->
        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-graduation-cap me-2 text-primary"></i>2. Riwayat Pendidikan Formal</h6>
        <% 
          let pendFormal = [];
          try {
            pendFormal = typeof candidate.pendidikan_formal === 'string' ? JSON.parse(candidate.pendidikan_formal || '[]') : (candidate.pendidikan_formal || []);
          } catch(e) {}
        %>
        <% if (pendFormal.length > 0) { %>
          <div class="table-responsive-modern mb-4">
            <table class="kov-table">
              <thead>
                <tr>
                  <th class="ps-3">Tingkat</th>
                  <th>Nama Sekolah / Universitas</th>
                  <th>Jurusan</th>
                  <th>Tahun Lulus</th>
                  <th class="pe-3">Nilai / IPK</th>
                </tr>
              </thead>
              <tbody>
                <% pendFormal.forEach(p => { %>
                  <% if (p.sekolah || p.jurusan) { %>
                    <tr>
                      <td class="ps-3 fw-semibold"><%= p.tingkat || '-' %></td>
                      <td><%= p.sekolah || '-' %></td>
                      <td><%= p.jurusan || '-' %></td>
                      <td><%= p.tahun_lulus || '-' %></td>
                      <td class="pe-3"><%= p.ipk || '-' %></td>
                    </tr>
                  <% } %>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="text-muted small mb-4">Tidak ada data pendidikan formal tercatat.</p>
        <% } %>

        <!-- Riwayat Pekerjaan -->
        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-building me-2 text-primary"></i>3. Riwayat Pengalaman Kerja</h6>
        <% 
          let riwayatKerja = [];
          try {
            riwayatKerja = typeof candidate.riwayat_pekerjaan === 'string' ? JSON.parse(candidate.riwayat_pekerjaan || '[]') : (candidate.riwayat_pekerjaan || []);
          } catch(e) {}
        %>
        <% if (riwayatKerja.length > 0 && riwayatKerja.some(r => r.nama_perusahaan)) { %>
          <div class="row g-3 mb-4">
            <% riwayatKerja.forEach((r, idx) => { %>
              <% if (r.nama_perusahaan) { %>
                <div class="col-md-6">
                  <div class="p-3 bg-light rounded-3 border h-100">
                    <div class="fw-bold text-dark fs-6"><%= r.jabatan || 'Staf' %> - <%= r.nama_perusahaan %></div>
                    <div class="text-muted small mb-2"><i class="fas fa-calendar-alt me-1"></i>Periode: <%= r.periode || '-' %></div>
                    <div class="small mb-1"><strong>Gaji Terakhir:</strong> <%= r.gaji || '-' %></div>
                    <div class="small mb-1"><strong>Alasan Berhenti:</strong> <%= r.alasan_resign || '-' %></div>
                    <div class="small mb-1"><strong>Tugas &amp; Tanggung Jawab:</strong></div>
                    <p class="small text-secondary mb-0 bg-white p-2.5 rounded-3 border"><%= r.tugas || '-' %></p>
                  </div>
                </div>
              <% } %>
            <% }); %>
          </div>
        <% } else { %>
          <p class="text-muted small mb-4">Tidak ada riwayat pekerjaan / pelamar lulusan baru (Fresh Graduate).</p>
        <% } %>

        <!-- Informasi Tambahan & Minat -->
        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-lightbulb me-2 text-primary"></i>4. Motivasi &amp; Informasi Tambahan</h6>
        <div class="row g-3 small">
          <div class="col-md-6">
            <strong>Alasan Melamar di Perusahaan:</strong>
            <div class="p-2.5 bg-light rounded-3 border small mt-1"><%= candidate.alasan_rekrutmen || '-' %></div>
          </div>
          <div class="col-md-6">
            <strong>Minat / Passion Khusus:</strong>
            <div class="p-2.5 bg-light rounded-3 border small mt-1"><%= candidate.minat_passion || '-' %></div>
          </div>
          <div class="col-md-6">
            <strong>Rencana 3-5 Tahun Ke Depan:</strong>
            <div class="p-2.5 bg-light rounded-3 border small mt-1"><%= candidate.rencana_3_5_tahun || '-' %></div>
          </div>
          <div class="col-md-6">
            <strong>Prestasi Yang Pernah Diraih:</strong>
            <div class="p-2.5 bg-light rounded-3 border small mt-1"><%= candidate.prestasi || '-' %></div>
          </div>
          <div class="col-md-4">
            <strong>Perkiraan Kesiapan Bergabung:</strong>
            <div class="p-2.5 bg-light rounded-3 border small mt-1"><%= candidate.perkiraan_bergabung || '-' %></div>
          </div>
          <div class="col-md-4">
            <strong>Gaji Yang Diharapkan:</strong>
            <div class="p-2.5 bg-light rounded-3 border small mt-1"><%= candidate.gaji_diharapkan || '-' %></div>
          </div>
          <div class="col-md-4">
            <strong>Memiliki Kerabat di Perusahaan:</strong>
            <div class="p-2.5 bg-light rounded-3 border small mt-1"><%= candidate.punya_kerabat || 'Tidak' %> <%= candidate.nama_kerabat_posisi ? '(' + candidate.nama_kerabat_posisi + ')' : '' %></div>
          </div>
        </div>

      </div>
    </div>
      </main>
    </div>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
