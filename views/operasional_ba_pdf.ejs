<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Berita Acara Pengajuan Barang - <%= ba.no_ba || ('BA/OPS/' + ba.id) %></title>
  <style>
    @page {
      size: A4;
      margin: 10mm 12mm;
    }
    body {
      font-family: Arial, Helvetica, sans-serif;
      font-size: 11px;
      color: #111;
      line-height: 1.4;
      background: #fff;
    }
    .header-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 12px;
    }
    .header-table td {
      vertical-align: middle;
    }
    .title-box {
      text-align: center;
      padding: 6px;
      background-color: #0f5132;
      color: white;
      border-radius: 4px;
    }
    .title-box h2 {
      margin: 0;
      font-size: 16px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }
    .title-box p {
      margin: 2px 0 0 0;
      font-size: 11px;
      font-weight: bold;
    }
    .section-header {
      background-color: #e8f5e9;
      color: #0f5132;
      font-weight: bold;
      font-size: 11px;
      padding: 5px 8px;
      border: 1px solid #198754;
      border-left: 4px solid #0f5132;
      margin-top: 10px;
      margin-bottom: 4px;
      text-transform: uppercase;
    }
    .content-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 6px;
    }
    .content-table td, .content-table th {
      border: 1px solid #ccc;
      padding: 5px 8px;
      vertical-align: top;
    }
    .content-table td.label {
      width: 32%;
      background-color: #f9f9f9;
      font-weight: bold;
      color: #333;
    }
    .content-table td.value {
      width: 68%;
    }
    .checkbox-item {
      display: inline-block;
      margin-right: 15px;
    }
    .checkbox-box {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 1px solid #333;
      text-align: center;
      line-height: 10px;
      font-size: 10px;
      font-weight: bold;
      vertical-align: middle;
      margin-right: 4px;
    }
    .checked {
      background-color: #0f5132;
      color: white;
    }
    .signature-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 15px;
      text-align: center;
    }
    .signature-table td {
      border: 1px solid #ccc;
      padding: 8px;
      width: 33.33%;
      vertical-align: top;
    }
    .signature-box {
      height: 65px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .signature-img {
      max-height: 55px;
      max-width: 140px;
    }
    .footer-note {
      margin-top: 12px;
      font-size: 9.5px;
      color: #666;
      font-style: italic;
      border-top: 1px dashed #bbb;
      padding-top: 4px;
    }
    .badge-priority {
      padding: 2px 6px;
      border-radius: 3px;
      font-size: 10px;
      font-weight: bold;
      color: white;
    }
    .bg-normal { background-color: #0d6efd; }
    .bg-urgent { background-color: #fd7e14; }
    .bg-critical { background-color: #dc3545; }
  </style>
</head>
<body>

  <!-- Header Document & Print Bar -->
  <div style="text-align: right; margin-bottom: 8px;" class="no-print">
    <button onclick="window.print()" style="background-color: #0f5132; color: white; border: none; padding: 6px 14px; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 11px;">
      <i class="fas fa-print" style="margin-right: 4px;"></i> Cetak / Print Dokumen PDF
    </button>
  </div>

  <table class="header-table">
    <tr>
      <td>
        <div class="title-box">
          <% if (typeof logoBase64 !== 'undefined' && logoBase64) { %>
            <div style="margin-bottom: 4px;">
              <img src="<%= logoBase64 %>" style="height: 38px; max-width: 160px; object-fit: contain;">
            </div>
          <% } %>
          <h2>BERITA ACARA PENGAJUAN BARANG</h2>
          <p>No. BA : <%= ba.no_ba || ('BA/OPS/' + String(ba.id).padStart(5, '0')) %></p>
        </div>
      </td>
    </tr>
  </table>

  <!-- A. IDENTITAS PENGAJUAN -->
  <div class="section-header">A. IDENTITAS PENGAJUAN</div>
  <table class="content-table">
    <tr>
      <td class="label">Tanggal Pengajuan</td>
      <td class="value"><%= ba.tanggal_pengajuan || '-' %></td>
    </tr>
    <tr>
      <td class="label">Outlet / Divisi</td>
      <td class="value"><%= ba.outlet_divisi || '-' %></td>
    </tr>
    <tr>
      <td class="label">Departemen</td>
      <td class="value"><%= ba.departemen || '-' %></td>
    </tr>
    <tr>
      <td class="label">PIC Pengajuan</td>
      <td class="value"><%= ba.pic_pengajuan || '-' %></td>
    </tr>
    <tr>
      <td class="label">Prioritas</td>
      <td class="value">
        <span class="checkbox-item"><span class="checkbox-box <%= ba.prioritas === 'Normal' ? 'checked' : '' %>"><%= ba.prioritas === 'Normal' ? '✓' : '' %></span> Normal</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.prioritas === 'Urgent' ? 'checked' : '' %>"><%= ba.prioritas === 'Urgent' ? '✓' : '' %></span> Urgent</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.prioritas === 'Critical' ? 'checked' : '' %>"><%= ba.prioritas === 'Critical' ? '✓' : '' %></span> Critical</span>
      </td>
    </tr>
    <tr>
      <td class="label">Barang Dibutuhkan Paling Lambat</td>
      <td class="value"><%= ba.barang_dibutuhkan_paling_lambat || '-' %></td>
    </tr>
  </table>

  <!-- B. INFORMASI BARANG (MULTI-ITEM SUPPORT) -->
  <div class="section-header">B. INFORMASI BARANG / EQUIPMENT</div>

  <% 
    let items = [];
    if (ba.items_json) {
      try {
        items = typeof ba.items_json === 'string' ? JSON.parse(ba.items_json) : ba.items_json;
      } catch(e) { items = []; }
    }
  %>

  <table class="content-table" style="margin-bottom: 6px;">
    <tr>
      <td class="label">Status Pengajuan Barang</td>
      <td class="value">
        <span class="checkbox-item"><span class="checkbox-box <%= ba.status_barang === 'Barang Baru' ? 'checked' : '' %>"><%= ba.status_barang === 'Barang Baru' ? '✓' : '' %></span> Barang Baru</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.status_barang === 'Penggantian' ? 'checked' : '' %>"><%= ba.status_barang === 'Penggantian' ? '✓' : '' %></span> Penggantian</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.status_barang === 'Kerusakan' ? 'checked' : '' %>"><%= ba.status_barang === 'Kerusakan' ? '✓' : '' %></span> Kerusakan</span>
      </td>
    </tr>
    <tr>
      <td class="label">Lokasi Penempatan & PIC Pengguna</td>
      <td class="value">Lokasi: <%= ba.lokasi_penempatan || '-' %> | PIC: <%= ba.pic_pengguna || '-' %></td>
    </tr>
    <% if (ba.link_quotation) { %>
    <tr>
      <td class="label">Link Quotation / Penawaran</td>
      <td class="value"><a href="<%= ba.link_quotation %>" target="_blank"><%= ba.link_quotation %></a></td>
    </tr>
    <% } %>
  </table>

  <% if (items && items.length > 0) { %>
    <!-- Multi Items Table -->
    <table class="content-table" style="text-align: center;">
      <thead>
        <tr style="background-color: #f4f4f4; color: #0f5132; font-weight: bold;">
          <th style="width: 5%;">No</th>
          <th style="width: 30%; text-align: left;">Nama Barang / Equipment</th>
          <th style="width: 25%; text-align: left;">Merk / Spesifikasi</th>
          <th style="width: 12%;">Qty & Satuan</th>
          <th style="width: 13%; text-align: right;">Harga Satuan</th>
          <th style="width: 15%; text-align: right;">Subtotal Estimasi</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach((it, idx) => { %>
          <tr>
            <td><%= idx + 1 %></td>
            <td style="text-align: left;"><strong><%= it.nama_barang || '-' %></strong></td>
            <td style="text-align: left;">
              <%= it.kategori_barang ? ('[' + it.kategori_barang + '] ') : '' %>
              <%= it.merk_tipe_model || it.spesifikasi || '-' %>
            </td>
            <td><%= it.jumlah || 1 %> <%= it.satuan || 'Pcs' %></td>
            <td style="text-align: right;">Rp <%= Number(it.harga_satuan_estimasi || 0).toLocaleString('id-ID') %></td>
            <td style="text-align: right;"><strong>Rp <%= Number(it.total_estimasi || (it.jumlah * it.harga_satuan_estimasi) || 0).toLocaleString('id-ID') %></strong></td>
          </tr>
        <% }); %>
        <tr style="background-color: #e8f5e9; font-weight: bold;">
          <td colspan="5" style="text-align: right; color: #0f5132;">TOTAL ESTIMASI KESELURUHAN BIAYA:</td>
          <td style="text-align: right; color: #0f5132; font-size: 11.5px;">Rp <%= Number(ba.total_estimasi || 0).toLocaleString('id-ID') %></td>
        </tr>
      </tbody>
    </table>
  <% } else { %>
    <!-- Fallback Legacy Single Item Table -->
    <table class="content-table">
      <tr>
        <td class="label">Nama Barang / Equipment</td>
        <td class="value"><strong><%= ba.nama_barang || '-' %></strong></td>
      </tr>
      <tr>
        <td class="label">Kategori Barang</td>
        <td class="value"><%= ba.kategori_barang || '-' %></td>
      </tr>
      <tr>
        <td class="label">Merk / Tipe / Model</td>
        <td class="value"><%= ba.merk_tipe_model || '-' %></td>
      </tr>
      <tr>
        <td class="label">Spesifikasi</td>
        <td class="value"><%= ba.spesifikasi || '-' %></td>
      </tr>
      <tr>
        <td class="label">Jumlah & Satuan</td>
        <td class="value"><%= ba.jumlah || 1 %> <%= ba.satuan || 'Pcs' %></td>
      </tr>
      <tr>
        <td class="label">Harga Satuan Estimasi</td>
        <td class="value">Rp <%= Number(ba.harga_satuan_estimasi || 0).toLocaleString('id-ID') %></td>
      </tr>
      <tr>
        <td class="label">Total Estimasi Biaya</td>
        <td class="value"><strong>Rp <%= Number(ba.total_estimasi || 0).toLocaleString('id-ID') %></strong></td>
      </tr>
    </table>
  <% } %>

  <!-- C. KEBUTUHAN & JUSTIFIKASI PENGAJUAN -->
  <div class="section-header">C. KEBUTUHAN & JUSTIFIKASI PENGAJUAN</div>
  <table class="content-table">
    <tr>
      <td class="label">Tujuan / Kebutuhan Barang</td>
      <td class="value"><%= ba.tujuan_kebutuhan || '-' %></td>
    </tr>
    <tr>
      <td class="label">Alasan Pengajuan</td>
      <td class="value"><%= ba.alasan_pengajuan || '-' %></td>
    </tr>
    <tr>
      <td class="label">Dampak Operasional Apabila Tidak Dipenuhi</td>
      <td class="value"><%= ba.dampak_operasional || '-' %></td>
    </tr>
    <tr>
      <td class="label">Alternatif yang Sudah Dipertimbangkan</td>
      <td class="value"><%= ba.alternatif_dipertimbangkan || '-' %></td>
    </tr>
  </table>

  <!-- D. KHUSUS BARANG RUSAK -->
  <% if (ba.status_barang === 'Kerusakan' || ba.kronologi_kerusakan) { %>
  <div class="section-header">D. KHUSUS BARANG RUSAK</div>
  <table class="content-table">
    <tr>
      <td class="label">Kronologi Kerusakan</td>
      <td class="value"><%= ba.kronologi_kerusakan || '-' %></td>
    </tr>
    <tr>
      <td class="label">Waktu Kerusakan & Diketahui Oleh</td>
      <td class="value">Tgl: <%= ba.tgl_kerusakan || '-' %> Jam: <%= ba.jam_kerusakan || '-' %> | Diketahui Oleh: <%= ba.diketahui_oleh || '-' %></td>
    </tr>
    <tr>
      <td class="label">Kondisi Barang & Dampak</td>
      <td class="value">Kondisi: <%= ba.kondisi_barang_saat_ini || '-' %> | Dampak: <%= ba.dampak_kerusakan || '-' %></td>
    </tr>
    <tr>
      <td class="label">Tindakan Awal & Analisa Penyebab</td>
      <td class="value">
        Tindakan: <%= ba.tindakan_awal || '-' %><br>
        Analisa Penyebab: 
        <span class="checkbox-item"><span class="checkbox-box <%= ba.analisa_penyebab === 'Kelalaian (Human Error)' ? 'checked' : '' %>"><%= ba.analisa_penyebab === 'Kelalaian (Human Error)' ? '✓' : '' %></span> Kelalaian (Human Error)</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.analisa_penyebab === 'Normal Wear & Tear' ? 'checked' : '' %>"><%= ba.analisa_penyebab === 'Normal Wear & Tear' ? '✓' : '' %></span> Normal Wear & Tear</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.analisa_penyebab === 'Belum Diketahui' ? 'checked' : '' %>"><%= ba.analisa_penyebab === 'Belum Diketahui' ? '✓' : '' %></span> Belum Diketahui</span>
      </td>
    </tr>
  </table>
  <% } %>

  <!-- E. EVALUASI REPAIR VS REPLACEMENT -->
  <div class="section-header">E. EVALUASI REPAIR VS REPLACEMENT</div>
  <table class="content-table">
    <tr>
      <td class="label">Riwayat Repair</td>
      <td class="value"><%= ba.riwayat_repair_status || 'Tidak Pernah' %> <%= ba.riwayat_repair_kali ? ('(' + ba.riwayat_repair_kali + ' kali)') : '' %></td>
    </tr>
    <tr>
      <td class="label">Estimasi Biaya Repair vs Replacement</td>
      <td class="value">Repair: Rp <%= Number(ba.estimasi_biaya_repair || 0).toLocaleString('id-ID') %> | Replacement: Rp <%= Number(ba.estimasi_biaya_replacement || 0).toLocaleString('id-ID') %></td>
    </tr>
    <tr>
      <td class="label">Rekomendasi</td>
      <td class="value">
        <span class="checkbox-item"><span class="checkbox-box <%= ba.rekomendasi === 'Repair' ? 'checked' : '' %>"><%= ba.rekomendasi === 'Repair' ? '✓' : '' %></span> Repair</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.rekomendasi === 'Replacement' ? 'checked' : '' %>"><%= ba.rekomendasi === 'Replacement' ? '✓' : '' %></span> Replacement</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.rekomendasi === 'Warranty / Retur' ? 'checked' : '' %>"><%= ba.rekomendasi === 'Warranty / Retur' ? '✓' : '' %></span> Warranty / Retur</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.rekomendasi === 'Disposal' ? 'checked' : '' %>"><%= ba.rekomendasi === 'Disposal' ? '✓' : '' %></span> Disposal</span>
      </td>
    </tr>
    <tr>
      <td class="label">Alasan Rekomendasi</td>
      <td class="value"><%= ba.alasan_rekomendasi || '-' %></td>
    </tr>
  </table>

  <!-- F. INFORMASI VENDOR & ANGGARAN -->
  <div class="section-header">F. INFORMASI VENDOR & ANGGARAN</div>
  <table class="content-table">
    <tr>
      <td class="label">Vendor Pembelian / Service</td>
      <td class="value"><%= ba.vendor_pembelian || '-' %> (PIC: <%= ba.pic_vendor || '-' %>)</td>
    </tr>
    <tr>
      <td class="label">No Quotation & Sumber Budget</td>
      <td class="value">No. Quotation: <%= ba.no_quotation || '-' %> | Cost Center: <%= ba.sumber_budget || '-' %></td>
    </tr>
    <tr>
      <td class="label">Ketersediaan Budget</td>
      <td class="value">
        <span class="checkbox-item"><span class="checkbox-box <%= ba.ketersediaan_budget === 'Tersedia' ? 'checked' : '' %>"><%= ba.ketersediaan_budget === 'Tersedia' ? '✓' : '' %></span> Tersedia</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.ketersediaan_budget === 'Tidak Tersedia' ? 'checked' : '' %>"><%= ba.ketersediaan_budget === 'Tidak Tersedia' ? '✓' : '' %></span> Tidak Tersedia</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.ketersediaan_budget === 'Perlu Konfirmasi' ? 'checked' : '' %>"><%= ba.ketersediaan_budget === 'Perlu Konfirmasi' ? '✓' : '' %></span> Perlu Konfirmasi</span>
      </td>
    </tr>
  </table>

  <!-- G. TREATMENT / TINDAK LANJUT -->
  <div class="section-header">G. TREATMENT / TINDAK LANJUT</div>
  <table class="content-table">
    <tr>
      <td class="label">Treatment Status</td>
      <td class="value"><strong><%= ba.treatment || ba.status_approval || 'Menunggu Approval' %></strong></td>
    </tr>
    <tr>
      <td class="label">Vendor Service & Estimasi Harga</td>
      <td class="value">Vendor: <%= ba.vendor_service || '-' %> | Biaya: Rp <%= Number(ba.estimasi_harga_service || 0).toLocaleString('id-ID') %></td>
    </tr>
    <tr>
      <td class="label">Target Penyelesaian & Catatan</td>
      <td class="value">Target: <%= ba.target_penyelesaian || '-' %> | Keterangan: <%= ba.keterangan_tindak_lanjut || '-' %></td>
    </tr>
  </table>

  <!-- H. DOKUMENTASI PENDUKUNG (MULTI-FOTO SUPPORT) -->
  <div class="section-header">H. DOKUMENTASI & DOKUMEN PENDUKUNG</div>
  <table class="content-table">
    <tr>
      <td class="label">Lampiran Dokumen</td>
      <td class="value">
        <span class="checkbox-item"><span class="checkbox-box <%= (ba.lampiran_foto || ba.foto_list) ? 'checked' : '' %>"><%= (ba.lampiran_foto || ba.foto_list) ? '✓' : '' %></span> Foto Barang/Kerusakan</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.lampiran_quotation ? 'checked' : '' %>"><%= ba.lampiran_quotation ? '✓' : '' %></span> Quotation/Penawaran</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.lampiran_spesifikasi ? 'checked' : '' %>"><%= ba.lampiran_spesifikasi ? '✓' : '' %></span> Spesifikasi Barang</span>
        <span class="checkbox-item"><span class="checkbox-box <%= ba.lampiran_dokumen_lain ? 'checked' : '' %>"><%= ba.lampiran_dokumen_lain ? '✓' : '' %></span> Pendukung Lainnya</span>
      </td>
    </tr>
    <% if (ba.link_dokumen_pendukung || ba.catatan_dokumentasi) { %>
    <tr>
      <td class="label">Link / Catatan Dokumentasi</td>
      <td class="value">
        Link: <%= ba.link_dokumen_pendukung || '-' %><br>
        Catatan: <%= ba.catatan_dokumentasi || '-' %>
      </td>
    </tr>
    <% } %>
  </table>

  <% 
    let fotos = [];
    if (ba.foto_list) {
      try {
        fotos = typeof ba.foto_list === 'string' ? JSON.parse(ba.foto_list) : ba.foto_list;
      } catch(e) { fotos = []; }
    }
  %>

  <% if (fotos && fotos.length > 0) { %>
    <div style="margin-top: 8px; margin-bottom: 12px;">
      <div style="font-weight: bold; font-size: 10px; color: #0f5132; margin-bottom: 4px; text-transform: uppercase;">
        Lampiran Foto Barang / Kerusakan (<%= fotos.length %> Foto):
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 8px;">
        <% fotos.forEach((foto, i) => { %>
          <div style="border: 1px solid #ccc; padding: 4px; border-radius: 4px; text-align: center; background: #fafafa;">
            <img src="<%= foto %>" style="max-width: 180px; max-height: 130px; object-fit: contain;">
            <div style="font-size: 8.5px; color: #555; margin-top: 2px;">Foto #<%= i + 1 %></div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- I. PERSETUJUAN & OTORISASI (4 OTORISATOR) -->
  <div class="section-header">I. PERSETUJUAN & LEMBAR OTORISASI</div>
  <table class="signature-table" style="font-size: 9.5px;">
    <tr>
      <th style="width: 20%;">Dibuat Oleh</th>
      <th style="width: 20%;">Mengetahui (1)</th>
      <th style="width: 20%;">Mengetahui (2)</th>
      <th style="width: 20%;">Mengetahui (3)</th>
      <th style="width: 20%;">Menyetujui</th>
    </tr>
    <tr>
      <!-- Dibuat Oleh -->
      <td>
        <div class="signature-box">
          <% if (ba.signature_dibuat) { %>
            <img src="<%= ba.signature_dibuat %>" class="signature-img" alt="TTD Dibuat">
          <% } else { %>
            <span style="color: #0f5132; font-weight: bold; font-size: 11px;">[ SUBMITTED ]</span>
          <% } %>
        </div>
        <strong><%= ba.pic_pengajuan || ba.dibuat_oleh || 'PIC Pengajuan' %></strong><br>
        <small style="color: #666;">PIC Pengajuan / Outlet</small>
      </td>
      <!-- Mengetahui 1 -->
      <td>
        <div class="signature-box">
          <% if (ba.status_mengetahui_1 === 'Disetujui' || ba.status_approval === 'Disetujui' || ba.status_approval === 'Selesai') { %>
            <span style="color: #0f5132; font-weight: bold; font-size: 12px;">[ CONFIRMED ]</span>
          <% } else if (ba.status_mengetahui_1 === 'Ditolak' || ba.status_approval === 'Ditolak') { %>
            <span style="color: #dc3545; font-weight: bold; font-size: 12px;">[ REJECTED ]</span>
          <% } else { %>
            <span style="color: #888; font-style: italic;">[ Pending ]</span>
          <% } %>
        </div>
        <strong><%= ba.mengetahui_1 || 'Andre Antariza' %></strong><br>
        <small style="color: #666;">Mengetahui</small>
      </td>
      <!-- Mengetahui 2 -->
      <td>
        <div class="signature-box">
          <% if (ba.status_mengetahui_2 === 'Disetujui' || ba.status_approval === 'Disetujui' || ba.status_approval === 'Selesai') { %>
            <span style="color: #0f5132; font-weight: bold; font-size: 12px;">[ CONFIRMED ]</span>
          <% } else if (ba.status_mengetahui_2 === 'Ditolak' || ba.status_approval === 'Ditolak') { %>
            <span style="color: #dc3545; font-weight: bold; font-size: 12px;">[ REJECTED ]</span>
          <% } else { %>
            <span style="color: #888; font-style: italic;">[ Pending ]</span>
          <% } %>
        </div>
        <strong><%= ba.mengetahui_2 || 'Chusnaeni M' %></strong><br>
        <small style="color: #666;">Mengetahui</small>
      </td>
      <!-- Mengetahui 3 -->
      <td>
        <div class="signature-box">
          <% if (ba.status_mengetahui_3 === 'Disetujui' || ba.status_approval === 'Disetujui' || ba.status_approval === 'Selesai') { %>
            <span style="color: #0f5132; font-weight: bold; font-size: 12px;">[ CONFIRMED ]</span>
          <% } else if (ba.status_mengetahui_3 === 'Ditolak' || ba.status_approval === 'Ditolak') { %>
            <span style="color: #dc3545; font-weight: bold; font-size: 12px;">[ REJECTED ]</span>
          <% } else { %>
            <span style="color: #888; font-style: italic;">[ Pending ]</span>
          <% } %>
        </div>
        <strong><%= ba.mengetahui_3 || 'Setyo Adhi P' %></strong><br>
        <small style="color: #666;">Mengetahui</small>
      </td>
      <!-- Menyetujui (Owner) -->
      <td>
        <div class="signature-box">
          <% if (ba.status_menyetujui_owner === 'Disetujui' || ba.status_approval === 'Disetujui' || ba.status_approval === 'Selesai') { %>
            <span style="color: #0f5132; font-weight: bold; font-size: 12px;">[ APPROVED ]</span>
          <% } else if (ba.status_menyetujui_owner === 'Ditolak' || ba.status_approval === 'Ditolak') { %>
            <span style="color: #dc3545; font-weight: bold; font-size: 12px;">[ REJECTED ]</span>
          <% } else { %>
            <span style="color: #888; font-style: italic;">[ Pending Approval ]</span>
          <% } %>
        </div>
        <strong><%= ba.menyetujui_owner || 'Owner' %></strong><br>
        <small style="color: #666;">Menyetujui / Owner</small>
      </td>
    </tr>
  </table>

  <div class="footer-note">
    * Catatan: Berita Acara ini menjadi dokumen resmi pendukung pengajuan pembelian, repair, replacement, warranty/retur, atau tindakan operasional lain sesuai hasil evaluasi dan persetujuan manajemen KOV.
  </div>

</body>
</html>
