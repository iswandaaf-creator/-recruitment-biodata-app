<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Purchase Order (PO) - Operasional KOV</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --kov-emerald: #059669;
      --kov-slate-900: #0f172a;
      --kov-slate-800: #1e293b;
      --kov-border: #e2e8f0;
    }
    * {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    body { background-color: #f8fafc; color: #1e293b; }
    .top-navbar-operasional {
      background: #064e3b;
      border-bottom: 1px solid #065f46;
      padding: 0.75rem 1.5rem;
    }
    .card {
      border: 1px solid var(--kov-border);
      border-radius: 14px;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
      background: #ffffff;
    }
    .nav-btn {
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
  </style>
</head>
<body>

  <!-- Navbar -->
  <header class="top-navbar-operasional shadow-sm">
    <div class="container-fluid px-2 d-flex flex-wrap align-items-center justify-content-between gap-3">
      <a class="d-flex align-items-center text-decoration-none text-white" href="/admin/operasional/po">
        <div class="bg-white p-1 rounded-3 me-2 d-flex align-items-center justify-content-center" style="height: 38px; width: 38px;">
          <img src="/logo_kov_hijau.png" alt="KOV Logo" style="height: 28px; width: auto; object-fit: contain;">
        </div>
        <div>
          <div class="fw-bold fs-6">Dashboard Operasional - Purchase Order (PO)</div>
          <div class="text-white-50" style="font-size: 0.75rem;">Sistem Pengadaan & Penerbitan PO</div>
        </div>
      </a>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% if (typeof user !== 'undefined' && user) { %>
          <span class="text-white px-2 py-1 rounded small" style="background: rgba(255,255,255,0.12);">
            <i class="fas fa-circle-user me-1 text-light"></i><%= user.nama || user.username %> (<%= user.role %>)
          </span>
          <% if (user.role === 'superadmin') { %>
            <a href="/admin" class="btn btn-outline-light nav-btn">
              <i class="fas fa-user-tie"></i> Switch to HR
            </a>
          <% } %>
        <% } %>
        <a href="/admin/operasional/po/create" class="btn btn-warning nav-btn text-dark fw-bold">
          <i class="fas fa-plus"></i> Buat PO Baru
        </a>
        <a href="/api/operasional/po/export/excel" class="btn btn-success nav-btn" style="background-color: #10b981; border-color: #10b981;">
          <i class="fas fa-file-excel"></i> Export Excel
        </a>
        <a href="/admin/logout" class="btn btn-outline-danger nav-btn text-white border-light border-opacity-25 ms-2">
          <i class="fas fa-arrow-right-from-bracket"></i> Logout
        </a>
      </div>
    </div>
  </header>

  <div class="container-fluid px-4 py-4">

    <!-- Sub-menu Tabs Operasional -->
    <ul class="nav nav-tabs mb-4 border-bottom">
      <li class="nav-item">
        <a class="nav-link" href="/admin/operasional">
          <i class="fas fa-boxes-packing me-2"></i>Berita Acara Pengajuan Barang
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link active" href="/admin/operasional/po">
          <i class="fas fa-file-invoice-dollar me-2"></i>Purchase Order (PO) Pengadaan
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link" href="/admin/operasional/surat-tugas">
          <i class="fas fa-file-signature me-2"></i>Surat Tugas & LPJ Perjalanan Dinas
        </a>
      </li>
    </ul>

    <!-- Metrics Cards -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="card metric-card bg-primary text-white p-3 text-center">
          <div class="fs-4 fw-bold"><%= records.length %></div>
          <div class="small">Total Purchase Order</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card metric-card bg-success text-white p-3 text-center">
          <div class="fs-4 fw-bold">
            <%= records.filter(r => (r.status_po || '').includes('Approved')).length %>
          </div>
          <div class="small">PO Disetujui / Approved</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card metric-card bg-warning text-dark p-3 text-center">
          <div class="fs-4 fw-bold">
            <%= records.filter(r => (r.status_po || '').includes('Pending')).length %>
          </div>
          <div class="small">PO Pending</div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="card metric-card bg-dark text-white p-3 text-center">
          <div class="fs-5 fw-bold">
            Rp <%= records.reduce((acc, r) => acc + (r.total_netto || 0), 0).toLocaleString('id-ID') %>
          </div>
          <div class="small">Total Nilai Netto PO</div>
        </div>
      </div>
    </div>

    <!-- Main Table Card -->
    <div class="card shadow-sm">
      <div class="card-header bg-white py-3">
        <div class="row align-items-center g-2">
          <div class="col-md-6">
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="fas fa-search text-secondary"></i></span>
              <input type="text" id="searchInput" class="form-control" placeholder="Cari No PO, Nama Vendor, Perihal, Unit Kerja...">
            </div>
          </div>
          <div class="col-md-6 text-end">
            <a href="/admin/operasional/po/create" class="btn btn-success fw-bold px-3">
              <i class="fas fa-plus me-1"></i>Buat Purchase Order Baru
            </a>
          </div>
        </div>
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" id="poTable">
            <thead class="table-light text-secondary small text-uppercase">
              <tr>
                <th class="ps-3">No. PO</th>
                <th>Tanggal PO</th>
                <th>Penyedia / Vendor (TO)</th>
                <th>Perihal & Unit Kerja</th>
                <th class="text-end">Total Netto (Rp)</th>
                <th class="text-center">Status PO</th>
                <th class="text-end pe-3">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% if (records.length === 0) { %>
                <tr>
                  <td colspan="7" class="text-center py-5 text-muted">
                    <i class="fas fa-file-invoice-dollar fs-1 mb-2 d-block text-secondary"></i>
                    Belum ada Purchase Order (PO) yang diterbitkan.
                  </td>
                </tr>
              <% } else { %>
                <% records.forEach(item => { %>
                  <tr>
                    <td class="ps-3 fw-bold text-dark">
                      <%= item.no_po || ('PO/KOV/' + item.id) %>
                    </td>
                    <td class="small text-secondary"><%= formatDate(item.tanggal_po) %></td>
                    <td>
                      <div class="fw-bold text-dark"><%= item.vendor_nama || '-' %></div>
                      <div class="small text-muted"><%= item.vendor_nama_dagang || '' %></div>
                    </td>
                    <td>
                      <div class="fw-semibold text-dark"><%= item.perihal || '-' %></div>
                      <span class="badge bg-light text-dark border small"><%= item.unit_kerja || '-' %></span>
                    </td>
                    <td class="text-end fw-bold text-success">
                      Rp <%= Number(item.total_netto || item.subtotal || 0).toLocaleString('id-ID') %>
                    </td>
                    <td class="text-center">
                      <span class="badge bg-success px-2 py-1"><%= item.status_po || 'Approved' %></span>
                    </td>
                    <td class="text-end pe-3">
                      <div class="btn-group btn-group-sm">
                        <a href="/admin/operasional/po/detail/<%= item.id %>" class="btn btn-outline-primary" title="Lihat Detail PO">
                          <i class="fas fa-eye me-1"></i>Detail
                        </a>
                        <a href="/api/operasional/po/export/pdf/<%= item.id %>" target="_blank" class="btn btn-outline-danger" title="Download Official PDF PO">
                          <i class="fas fa-file-pdf"></i>
                        </a>
                        <% if (typeof user !== 'undefined' && user && user.role === 'superadmin') { %>
                          <button class="btn btn-outline-danger" onclick="deletePo(<%= item.id %>, '<%= item.no_po %>')" title="Hapus PO">
                            <i class="fas fa-trash-can"></i>
                          </button>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

  </div>

  <form id="deleteForm" method="POST" style="display: none;"></form>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const searchInput = document.getElementById('searchInput');
    const tableRows = document.querySelectorAll('#poTable tbody tr');

    searchInput.addEventListener('keyup', function() {
      const searchVal = this.value.toLowerCase();
      tableRows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(searchVal) ? '' : 'none';
      });
    });

    function deletePo(id, label) {
      if (confirm(`Apakah Anda yakin ingin menghapus Purchase Order: "${label}"?`)) {
        const form = document.getElementById('deleteForm');
        form.action = `/admin/operasional/po/delete/${id}`;
        form.submit();
      }
    }
  </script>
</body>
</html>
