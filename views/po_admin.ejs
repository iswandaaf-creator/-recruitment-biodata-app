<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Purchase Order (PO) - Operasional KOV</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261029b" rel="stylesheet">
</head>
<body>

  <div class="dd-layout-root kov-app-shell">
    <%- include('partials/sidebar', { active: 'po', user: typeof user !== 'undefined' ? user : null }) %>

    <main class="dd-main-canvas kov-main-content dd-theme">
      <!-- Top Search & View Action Bar (Dribbble Signature - Symmetrical 46px Row) -->
      <div class="dd-topbar kov-topbar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="dd-search-container">
            <i class="fas fa-magnifying-glass dd-search-icon"></i>
            <input type="text" class="dd-search-input" id="searchInput" placeholder="Cari nomor PO, vendor/supplier, perihal pengadaan..." aria-label="Cari Purchase Order">
          </div>
        </div>

        <div class="dd-topbar-actions">
          <a href="/admin/it" class="btn-topbar-action d-none d-md-inline-flex" title="Buka Rekap Pengeluaran IT">
            <i class="fas fa-laptop-code text-primary"></i>
            <span>Rekap IT</span>
          </a>
          <a href="/api/operasional/po/export/excel" class="btn-topbar-action d-none d-sm-inline-flex" title="Export Rekap PO ke Excel">
            <i class="fas fa-file-excel text-success"></i>
            <span>Export Excel</span>
          </a>
          <a href="/admin/operasional/po/create" class="btn-drive-upload" title="Buat Purchase Order Baru">
            <i class="fas fa-plus"></i>
            <span>Buat PO Baru</span>
          </a>
        </div>
      </div>

      <!-- Sub-menu Navigation Tabs -->
      <div class="d-flex gap-2 overflow-x-auto pb-1 mt-2 mb-2">
        <a class="nav-link-modern" href="/admin/operasional">
          <i class="fas fa-boxes-packing text-success"></i> Berita Acara Pengajuan Barang
        </a>
        <a class="nav-link-modern active" href="/admin/operasional/po">
          <i class="fas fa-file-invoice-dollar"></i> Purchase Order (PO) Pengadaan
        </a>
        <a class="nav-link-modern" href="/admin/operasional/surat-tugas">
          <i class="fas fa-file-signature text-warning"></i> Surat Tugas &amp; Perjalanan Dinas
        </a>
      </div>

      <!-- Executive PO Header (Taste-Skill Framed Sheet) -->
      <div class="dd-hero-banner mb-3">
        <div class="dd-hero-content">
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge py-1 px-2" style="background: rgba(22, 101, 52, 0.1); color: #166534; border: 1px solid rgba(22, 101, 52, 0.22); border-radius: 6px; font-weight: 700; font-size: 11px;">
              PENGADAAN &amp; PURCHASING
            </span>
            <span class="text-muted small">&bull;</span>
            <span class="text-muted small">Purchase Order (PO)</span>
          </div>
          <h2 class="dd-hero-title">
            Pusat Otorisasi Purchase Order &amp; Pengadaan
          </h2>
          <p class="dd-hero-subtitle">
            Verifikasi pesanan supplier, alur persetujuan direksi, sinkronisasi otomatis ke rekap IT, dan faktur resmi KOV Management.
          </p>
          <div class="d-flex align-items-center gap-2 flex-nowrap overflow-x-auto pt-1">
            <a href="/admin/operasional/po/create" class="btn-dd-hero text-nowrap">
              <i class="fas fa-plus me-1.5"></i> Buat PO Baru
            </a>
            <a href="/api/operasional/po/export/excel" class="btn-kov-outline btn-sm text-nowrap" style="font-size: 0.82rem; padding: 7px 14px;">
              <i class="fas fa-file-excel text-success me-1.5"></i> Export Rekap Excel
            </a>
          </div>
        </div>
        <div class="dd-hero-illustration d-none d-lg-flex align-items-center justify-content-center pe-3" style="opacity: 0.9;">
          <svg width="140" height="110" viewBox="0 0 140 110" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect x="20" y="18" width="88" height="82" rx="6" fill="#f8fafc" stroke="#cbd5e1" stroke-width="1.5" />
            <rect x="32" y="8" width="88" height="82" rx="6" fill="#ffffff" stroke="#166534" stroke-width="1.5" />
            <line x1="45" y1="22" x2="88" y2="22" stroke="#166534" stroke-width="2" stroke-linecap="round" />
            <line x1="45" y1="32" x2="105" y2="32" stroke="#94a3b8" stroke-width="1.5" stroke-linecap="round" />
            <line x1="45" y1="42" x2="95" y2="42" stroke="#cbd5e1" stroke-width="1.5" stroke-linecap="round" />
            <circle cx="50" cy="62" r="6" fill="#f0fdf4" stroke="#166534" stroke-width="1.5" />
            <path d="M48 62 L50 64 L53 60" stroke="#166534" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            <line x1="64" y1="62" x2="105" y2="62" stroke="#475569" stroke-width="1.5" stroke-linecap="round" />
            <line x1="45" y1="76" x2="105" y2="76" stroke="#e2e8f0" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </div>
      </div>

      <!-- Kategori Status Purchase Order (4 Symmetrical Framed-Sheet Cards) -->
      <div class="dd-section-header mb-3">
        <div class="d-flex align-items-center gap-2">
          <h3 class="dd-section-title">Status Dokumen Purchase Order</h3>
          <span class="badge" style="background: rgba(22, 101, 52, 0.1); color: #166534; border: 1px solid rgba(22, 101, 52, 0.2); font-size: 0.74rem; font-weight: 600; padding: 3px 8px; border-radius: 6px;">
            <%= records.length %> Dokumen
          </span>
        </div>
        <a href="javascript:void(0)" onclick="quickFilterPO('')" class="dd-view-all-link" title="Reset filter dan tampilkan seluruh PO">
          <span>Tampilkan Semua</span> <i class="fas fa-rotate-left ms-1" style="font-size: 0.72rem;"></i>
        </a>
      </div>

    <div class="dd-folders-grid mb-4" style="grid-template-columns: repeat(4, 1fr);">
      <!-- 1. PO Pending (Coral Red) -->
      <div class="dd-folder-card dd-folder-coral folder-coral" onclick="quickFilterPO('Pending')" role="button" tabindex="0" title="Filter PO Pending">
        <div class="dd-folder-top">
          <div class="dd-folder-icon"><i class="fas fa-clock"></i></div>
          <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
        </div>
        <div class="dd-folder-body">
          <h4 class="dd-folder-name">PO Pending</h4>
          <div class="dd-avatar-group">
            <span class="dd-avatar-chip">PO</span>
            <span class="dd-avatar-chip">PD</span>
            <span class="dd-avatar-chip dd-avatar-chip-more">+<%= records.filter(r => (r.status_po || '').includes('Pending')).length %></span>
          </div>
        </div>
        <div class="dd-folder-footer">
          <span class="dd-file-count"><i class="far fa-folder"></i> <%= records.filter(r => (r.status_po || '').includes('Pending')).length %> Dokumen</span>
          <span class="dd-file-weight"><i class="fas fa-clock"></i> Menunggu</span>
        </div>
      </div>

      <!-- 2. PO Approved (Emerald Mint) -->
      <div class="dd-folder-card dd-folder-emerald folder-emerald" onclick="quickFilterPO('Approved')" role="button" tabindex="0" title="Filter PO Approved">
        <div class="dd-folder-top">
          <div class="dd-folder-icon"><i class="fas fa-circle-check"></i></div>
          <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
        </div>
        <div class="dd-folder-body">
          <h4 class="dd-folder-name">PO Approved</h4>
          <div class="dd-avatar-group">
            <span class="dd-avatar-chip">OK</span>
            <span class="dd-avatar-chip">AP</span>
            <span class="dd-avatar-chip dd-avatar-chip-more">+<%= records.filter(r => (r.status_po || '').includes('Approved')).length %></span>
          </div>
        </div>
        <div class="dd-folder-footer">
          <span class="dd-file-count"><i class="far fa-folder"></i> <%= records.filter(r => (r.status_po || '').includes('Approved')).length %> Dokumen</span>
          <span class="dd-file-weight"><i class="fas fa-check"></i> Disetujui</span>
        </div>
      </div>

      <!-- 3. Nilai Netto Akumulasi (Royal Sky) -->
      <div class="dd-folder-card dd-folder-royal folder-blue" onclick="quickFilterPO('')" role="button" tabindex="0" title="Lihat Nilai Netto PO">
        <div class="dd-folder-top">
          <div class="dd-folder-icon"><i class="fas fa-wallet"></i></div>
          <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
        </div>
        <div class="dd-folder-body">
          <h4 class="dd-folder-name">Akumulasi Nilai PO</h4>
          <div class="dd-avatar-group">
            <span class="dd-avatar-chip">RP</span>
            <span class="dd-avatar-chip">NT</span>
            <span class="dd-avatar-chip dd-avatar-chip-more">+<%= records.length %></span>
          </div>
        </div>
        <div class="dd-folder-footer">
          <span class="dd-file-count"><i class="far fa-folder"></i> <%= records.length %> Faktur</span>
          <span class="dd-file-weight"><i class="fas fa-receipt"></i> Rp <%= (Math.round(records.reduce((acc, r) => acc + (r.total_netto || 0), 0) / 1000000)).toLocaleString('id-ID') %> Jt</span>
        </div>
      </div>

      <!-- 4. Total Arsip PO (Midnight Indigo) -->
      <div class="dd-folder-card dd-folder-indigo folder-indigo active" onclick="quickFilterPO('')" role="button" tabindex="0" title="Tampilkan Semua PO">
        <div class="dd-folder-top">
          <div class="dd-folder-icon"><i class="fas fa-file-invoice-dollar"></i></div>
          <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
        </div>
        <div class="dd-folder-body">
          <h4 class="dd-folder-name">Semua Dokumen PO</h4>
          <div class="dd-avatar-group">
            <span class="dd-avatar-chip">PO</span>
            <span class="dd-avatar-chip">ALL</span>
            <span class="dd-avatar-chip dd-avatar-chip-more">+<%= records.length %></span>
          </div>
        </div>
        <div class="dd-folder-footer">
          <span class="dd-file-count"><i class="far fa-folder-open"></i> <%= records.length %> Dokumen</span>
          <span class="dd-file-weight"><i class="fas fa-layer-group"></i> Total</span>
        </div>
      </div>
    </div>
    <div class="bento-grid">
      <div class="coinbase-kpi-card">
        <div class="w-100">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="bento-metric-title">Total PO Diterbitkan</span>
            <div class="kov-metric-icon-box text-primary"><i class="fas fa-file-invoice-dollar"></i></div>
          </div>
          <div class="bento-metric-value text-primary"><%= records.length %></div>
          <div class="bento-metric-sub">Seluruh berkas PO resmi</div>
        </div>
      </div>

      <div class="coinbase-kpi-card">
        <div class="w-100">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="bento-metric-title text-success">PO Approved</span>
            <div class="kov-metric-icon-box text-success" style="color: var(--kov-primary-600) !important;"><i class="fas fa-circle-check"></i></div>
          </div>
          <div class="bento-metric-value" style="color: var(--kov-primary-600);">
            <%= records.filter(r => (r.status_po || '').includes('Approved')).length %>
          </div>
          <div class="bento-metric-sub">Sudah diverifikasi direksi</div>
        </div>
      </div>

      <div class="coinbase-kpi-card">
        <div class="w-100">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="bento-metric-title text-warning">PO Pending</span>
            <div class="kov-metric-icon-box text-warning" style="color: var(--kov-amber) !important;"><i class="fas fa-clock"></i></div>
          </div>
          <div class="bento-metric-value text-warning" style="color: var(--kov-amber) !important;">
            <%= records.filter(r => (r.status_po || '').includes('Pending')).length %>
          </div>
          <div class="bento-metric-sub">Menunggu konfirmasi final</div>
        </div>
      </div>

      <div class="coinbase-kpi-card">
        <div class="w-100">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <span class="bento-metric-title">Total Nilai Netto PO</span>
            <div class="kov-metric-icon-box text-secondary"><i class="fas fa-wallet"></i></div>
          </div>
          <div class="bento-metric-value text-dark" style="font-size: 1.35rem;">
            Rp <%= records.reduce((acc, r) => acc + (r.total_netto || 0), 0).toLocaleString('id-ID') %>
          </div>
          <div class="bento-metric-sub">Akumulasi pengadaan barang</div>
        </div>
      </div>
    </div>

    <!-- Main Table Card -->
    <div class="kov-card">
      <div class="kov-card-header">
        <div class="d-flex flex-wrap align-items-center gap-2 mobile-w-100">
          <div class="input-group input-group-sm" style="min-width: 280px;">
            <span class="input-group-text bg-light"><i class="fas fa-search text-secondary"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="Cari No PO, Nama Vendor, Perihal, Unit Kerja...">
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/admin/operasional/po/create" class="btn-kov-primary btn-kov-sm">
            <i class="fas fa-plus"></i> Buat PO Baru
          </a>
        </div>
      </div>

      <div class="table-responsive-modern">
        <table class="kov-table" id="poTable">
          <thead>
            <tr>
              <th class="ps-3">No. PO</th>
              <th>Tanggal PO</th>
              <th>Penyedia / Vendor (TO)</th>
              <th>Perihal &amp; Unit Kerja</th>
              <th class="text-end">Total Netto (Rp)</th>
              <th class="text-center">Status PO</th>
              <th class="text-end pe-3">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (records.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <div class="py-4">
                    <i class="fas fa-file-invoice-dollar fa-3x mb-2 text-secondary opacity-50"></i>
                    <h6 class="fw-bold text-dark">Belum Ada Purchase Order</h6>
                    <p class="small text-muted mb-0">Klik tombol "Buat PO Baru" di atas untuk menerbitkan PO pertama.</p>
                  </div>
                </td>
              </tr>
            <% } else { %>
              <% records.forEach(item => { %>
                <tr>
                  <td class="ps-3 fw-bold text-dark">
                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                      <span><%= item.no_po || ('PO/KOV/' + item.id) %></span>
                      <a href="/admin/it?highlight=<%= encodeURIComponent(item.no_po || '') %>" class="badge bg-emerald-subtle text-emerald-dark border border-emerald-subtle rounded-pill text-decoration-none px-2 py-0.5" title="Buka data di Rekap Belanja IT" style="font-size: 0.72rem;">
                        <i class="fas fa-check-circle me-1 text-success"></i>Rekap IT
                      </a>
                    </div>
                  </td>
                  <td class="small text-secondary"><%= formatDate(item.tanggal_po) %></td>
                  <td>
                    <div class="fw-bold text-dark"><%= item.vendor_nama || '-' %></div>
                    <div class="small text-muted"><%= item.vendor_nama_dagang || '' %></div>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= item.perihal || '-' %></div>
                    <span class="badge bg-light text-dark border small"><%= item.unit_kerja || '-' %></span>
                  </td>
                  <td class="text-end fw-bold text-success">
                    Rp <%= Number(item.total_netto || item.subtotal || 0).toLocaleString('id-ID') %>
                  </td>
                  <td class="text-center">
                    <% 
                      const stPo = item.status_po || 'Approved';
                      let stPoPill = 'pill-success';
                      if (stPo.includes('Pending')) stPoPill = 'pill-warning';
                      else if (stPo.includes('Ditolak')) stPoPill = 'pill-danger';
                    %>
                    <span class="status-pill-modern <%= stPoPill %>">
                      <span class="status-dot-pulse"></span> <%= stPo %>
                    </span>
                  </td>
                  <td class="text-end pe-3">
                    <div class="d-inline-flex gap-1.5">
                      <a href="/admin/operasional/po/detail/<%= item.id %>" class="btn-kov-outline btn-kov-sm" title="Lihat Detail PO">
                        <i class="fas fa-eye"></i> Detail
                      </a>
                      <a href="/admin/operasional/po/create?copy_from=<%= item.id %>" class="btn-kov-secondary btn-kov-sm text-primary" title="Duplikat PO Ini">
                        <i class="fas fa-copy"></i>
                      </a>
                      <a href="/api/operasional/po/export/pdf/<%= item.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-secondary btn-kov-sm text-danger" title="Download Official PDF PO">
                        <i class="fas fa-file-pdf"></i>
                      </a>
                      <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                        <button class="btn-kov-secondary btn-kov-sm text-danger" onclick="deletePo(<%= item.id %>, '<%= item.no_po %>')" title="Hapus PO">
                          <i class="fas fa-trash-can"></i>
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

  <form id="deleteForm" method="POST" style="display: none;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  </form>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    const searchInput = document.getElementById('searchInput');
    const tableRows = document.querySelectorAll('#poTable tbody tr');

    function quickFilterPO(status) {
      const searchVal = (status || '').toLowerCase();
      tableRows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = (!searchVal || text.includes(searchVal)) ? '' : 'none';
      });
      document.querySelectorAll('.dd-folder-card').forEach(card => {
        if (!status && card.getAttribute('onclick') && card.getAttribute('onclick').includes("''")) {
          card.classList.add('active');
        } else if (status && card.getAttribute('onclick') && card.getAttribute('onclick').includes(status)) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }
    window.quickFilterPO = quickFilterPO;

    searchInput.addEventListener('keyup', function() {
      const searchVal = this.value.toLowerCase();
      tableRows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(searchVal) ? '' : 'none';
      });
    });

    function deletePo(id, label) {
      if (confirm(`Apakah Anda yakin ingin menghapus Purchase Order: "${label}"?`)) {
        const form = document.getElementById('deleteForm');
        form.action = `/admin/operasional/po/delete/${id}`;
        form.submit();
      }
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
 </body>
 </html>
