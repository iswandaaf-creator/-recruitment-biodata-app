<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Purchase Order (PO) - Operasional KOV</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/figma-ui.css" rel="stylesheet">
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'po', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Minimalist Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Purchase Order (PO)</h1>
          </div>
        </div>
        <div class="kov-topbar-right">
          <a href="/admin/operasional/po/create" class="btn-kov-outline btn-kov-sm">
            <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">Buat PO Baru</span>
          </a>
          <a href="/api/operasional/po/export/excel" class="btn-kov-primary btn-kov-sm">
            <i class="fas fa-file-excel"></i> <span class="d-none d-sm-inline">Export Excel</span>
          </a>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

    <!-- Sub-menu Navigation Tabs -->
    <div class="d-flex gap-2 overflow-x-auto pb-2 mb-4">
      <a class="nav-link-modern" style="background: white; color: var(--kov-slate-700); border: 1px solid var(--kov-border);" href="/admin/operasional">
        <i class="fas fa-boxes-packing text-success"></i> Berita Acara Pengajuan Barang
      </a>
      <a class="nav-link-modern active" href="/admin/operasional/po">
        <i class="fas fa-file-invoice-dollar"></i> Purchase Order (PO) Pengadaan
      </a>
      <a class="nav-link-modern" style="background: white; color: var(--kov-slate-700); border: 1px solid var(--kov-border);" href="/admin/operasional/surat-tugas">
        <i class="fas fa-file-signature text-warning"></i> Surat Tugas &amp; Perjalanan Dinas
      </a>
    </div>

    <!-- Bento Metric Cards -->
    <div class="bento-grid">
      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title">Total PO Diterbitkan</div>
          <div class="bento-metric-value text-primary"><%= records.length %></div>
          <div class="bento-metric-sub">Seluruh berkas PO resmi</div>
        </div>
        <div class="coinbase-ring coinbase-ring-blue">
          <div class="coinbase-ring-inner">
            <i class="fas fa-file-invoice-dollar"></i>
          </div>
        </div>
      </div>

      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title text-success">PO Approved</div>
          <div class="bento-metric-value" style="color: var(--kov-primary-600);">
            <%= records.filter(r => (r.status_po || '').includes('Approved')).length %>
          </div>
          <div class="bento-metric-sub">Sudah diverifikasi direksi</div>
        </div>
        <div class="coinbase-ring coinbase-ring-emerald">
          <div class="coinbase-ring-inner">
            <i class="fas fa-circle-check"></i>
          </div>
        </div>
      </div>

      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title text-warning">PO Pending</div>
          <div class="bento-metric-value text-warning" style="color: var(--kov-amber) !important;">
            <%= records.filter(r => (r.status_po || '').includes('Pending')).length %>
          </div>
          <div class="bento-metric-sub">Menunggu konfirmasi final</div>
        </div>
        <div class="coinbase-ring coinbase-ring-amber">
          <div class="coinbase-ring-inner">
            <i class="fas fa-clock"></i>
          </div>
        </div>
      </div>

      <div class="coinbase-kpi-card">
        <div>
          <div class="bento-metric-title">Total Nilai Netto PO</div>
          <div class="bento-metric-value text-dark" style="font-size: 1.35rem;">
            Rp <%= records.reduce((acc, r) => acc + (r.total_netto || 0), 0).toLocaleString('id-ID') %>
          </div>
          <div class="bento-metric-sub">Akumulasi pengadaan barang</div>
        </div>
        <div class="coinbase-ring coinbase-ring-purple">
          <div class="coinbase-ring-inner">
            <i class="fas fa-wallet"></i>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Table Card -->
    <div class="kov-card">
      <div class="kov-card-header">
        <div class="d-flex flex-wrap align-items-center gap-2 mobile-w-100">
          <div class="input-group input-group-sm" style="min-width: 280px;">
            <span class="input-group-text bg-light"><i class="fas fa-search text-secondary"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="Cari No PO, Nama Vendor, Perihal, Unit Kerja...">
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/admin/operasional/po/create" class="btn-kov-primary btn-kov-sm">
            <i class="fas fa-plus"></i> Buat PO Baru
          </a>
        </div>
      </div>

      <div class="table-responsive-modern">
        <table class="kov-table" id="poTable">
          <thead>
            <tr>
              <th class="ps-3">No. PO</th>
              <th>Tanggal PO</th>
              <th>Penyedia / Vendor (TO)</th>
              <th>Perihal &amp; Unit Kerja</th>
              <th class="text-end">Total Netto (Rp)</th>
              <th class="text-center">Status PO</th>
              <th class="text-end pe-3">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (records.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <div class="py-4">
                    <i class="fas fa-file-invoice-dollar fa-3x mb-2 text-secondary opacity-50"></i>
                    <h6 class="fw-bold text-dark">Belum Ada Purchase Order</h6>
                    <p class="small text-muted mb-0">Klik tombol "Buat PO Baru" di atas untuk menerbitkan PO pertama.</p>
                  </div>
                </td>
              </tr>
            <% } else { %>
              <% records.forEach(item => { %>
                <tr>
                  <td class="ps-3 fw-bold text-dark">
                    <%= item.no_po || ('PO/KOV/' + item.id) %>
                  </td>
                  <td class="small text-secondary"><%= formatDate(item.tanggal_po) %></td>
                  <td>
                    <div class="fw-bold text-dark"><%= item.vendor_nama || '-' %></div>
                    <div class="small text-muted"><%= item.vendor_nama_dagang || '' %></div>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= item.perihal || '-' %></div>
                    <span class="badge bg-light text-dark border small"><%= item.unit_kerja || '-' %></span>
                  </td>
                  <td class="text-end fw-bold text-success">
                    Rp <%= Number(item.total_netto || item.subtotal || 0).toLocaleString('id-ID') %>
                  </td>
                  <td class="text-center">
                    <span class="status-pill-modern pill-success">
                      <span class="status-dot-pulse"></span> <%= item.status_po || 'Approved' %>
                    </span>
                  </td>
                  <td class="text-end pe-3">
                    <div class="d-inline-flex gap-1.5">
                      <a href="/admin/operasional/po/detail/<%= item.id %>" class="btn-kov-outline btn-kov-sm" title="Lihat Detail PO">
                        <i class="fas fa-eye"></i> Detail
                      </a>
                      <a href="/api/operasional/po/export/pdf/<%= item.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-secondary btn-kov-sm text-danger" title="Download Official PDF PO">
                        <i class="fas fa-file-pdf"></i>
                      </a>
                      <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                        <button class="btn-kov-secondary btn-kov-sm text-danger" onclick="deletePo(<%= item.id %>, '<%= item.no_po %>')" title="Hapus PO">
                          <i class="fas fa-trash-can"></i>
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
      </main>
    </div>
  </div>

  <form id="deleteForm" method="POST" style="display: none;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  </form>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const searchInput = document.getElementById('searchInput');
    const tableRows = document.querySelectorAll('#poTable tbody tr');

    searchInput.addEventListener('keyup', function() {
      const searchVal = this.value.toLowerCase();
      tableRows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(searchVal) ? '' : 'none';
      });
    });

    function deletePo(id, label) {
      if (confirm(`Apakah Anda yakin ingin menghapus Purchase Order: "${label}"?`)) {
        const form = document.getElementById('deleteForm');
        form.action = `/admin/operasional/po/delete/${id}`;
        form.submit();
      }
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
 </body>
 </html>
