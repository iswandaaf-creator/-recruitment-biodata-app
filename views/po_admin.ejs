<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Purchase Order (PO) - Operasional KOV</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261029_cila_v6" rel="stylesheet">
</head>
<body>

  <div class="dd-layout-root kov-app-shell">
    <%- include('partials/sidebar', { active: 'po', user: typeof user !== 'undefined' ? user : null }) %>

    <main class="dd-main-canvas kov-main-content dd-theme">
      <!-- Top Search & View Action Bar (Dribbble Signature - Symmetrical 46px Row) -->
      <div class="dd-topbar kov-topbar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="dd-search-container">
            <i class="fas fa-magnifying-glass dd-search-icon"></i>
            <input type="text" class="dd-search-input" id="searchInput" placeholder="Cari nomor PO, vendor/supplier, perihal pengadaan..." aria-label="Cari Purchase Order">
          </div>
        </div>

        <div class="dd-topbar-actions">
          <a href="/admin/it" class="btn-topbar-action d-none d-md-inline-flex" title="Buka Rekap Pengeluaran IT">
            <i class="fas fa-laptop-code text-primary"></i>
            <span>Rekap IT</span>
          </a>
          <a href="/api/operasional/po/export/excel" class="btn-topbar-action d-none d-sm-inline-flex" title="Export Rekap PO ke Excel">
            <i class="fas fa-file-excel text-success"></i>
            <span>Export Excel</span>
          </a>
          <a href="/admin/operasional/po/create" class="btn-drive-upload" title="Buat Purchase Order Baru">
            <i class="fas fa-plus"></i>
            <span>Buat PO Baru</span>
          </a>
        </div>
      </div>

      <!-- Sub-menu Navigation Tabs -->
      <div class="d-flex gap-2 overflow-x-auto pb-1 mt-2 mb-2">
        <a class="nav-link-modern" href="/admin/operasional">
          <i class="fas fa-boxes-packing text-success"></i> Berita Acara Pengajuan Barang
        </a>
        <a class="nav-link-modern active" href="/admin/operasional/po">
          <i class="fas fa-file-invoice-dollar"></i> Purchase Order (PO) Pengadaan
        </a>
        <a class="nav-link-modern" href="/admin/operasional/surat-tugas">
          <i class="fas fa-file-signature text-warning"></i> Surat Tugas &amp; Perjalanan Dinas
        </a>
      </div>

      <!-- Executive PO Header (Taste-Skill Framed Sheet) -->
      <!-- Executive Header (Anti-Slop Framed Sheet) -->
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pt-1">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge py-1 px-2" style="background: rgba(22, 101, 52, 0.08); color: #166534; border: 1px solid rgba(22, 101, 52, 0.2); border-radius: 4px; font-weight: 700; font-size: 10.5px; letter-spacing: 0.04em;">
              PENGADAAN &amp; PURCHASING
            </span>
            <span class="text-muted" style="font-size: 12px;">&bull;</span>
            <span class="text-muted" style="font-size: 12px;"><%= records.length %> Dokumen PO Resmi</span>
          </div>
          <h1 class="h4 mb-0 fw-bold" style="color: var(--dd-text-primary, #0f172a); letter-spacing: -0.015em;">
            Purchase Order (PO) Pengadaan
          </h1>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/api/operasional/po/export/excel" class="btn-kov-outline" title="Export Rekap PO ke Excel">
            <i class="fas fa-file-excel text-success"></i>
            <span>Export Excel</span>
          </a>
          <a href="/admin/operasional/po/create" class="btn-dd-hero" title="Buat Purchase Order Baru">
            <i class="fas fa-plus"></i>
            <span>Buat PO Baru</span>
          </a>
        </div>
      </div>

      <!-- Executive KPI Metric Strip as Primary Interactive Filters -->
      <div class="kov-kpi-strip mb-3">
        <div class="kov-kpi-cell" onclick="quickFilterPO('')" role="button" title="Tampilkan semua PO">
          <div class="kov-kpi-cell-label">Total Dokumen PO <i class="fas fa-file-invoice-dollar opacity-50"></i></div>
          <div class="kov-kpi-cell-val text-primary"><%= records.length %></div>
          <div class="kov-kpi-cell-sub">Semua berkas PO resmi</div>
        </div>
        <div class="kov-kpi-cell" onclick="quickFilterPO('Pending')" role="button" title="Filter PO Pending">
          <div class="kov-kpi-cell-label">PO Pending <i class="fas fa-clock opacity-50"></i></div>
          <div class="kov-kpi-cell-val text-warning"><%= records.filter(r => (r.status_po || '').includes('Pending')).length %></div>
          <div class="kov-kpi-cell-sub">Menunggu verifikasi direksi</div>
        </div>
        <div class="kov-kpi-cell" onclick="quickFilterPO('Approved')" role="button" title="Filter PO Approved">
          <div class="kov-kpi-cell-label">PO Disetujui <i class="fas fa-circle-check opacity-50"></i></div>
          <div class="kov-kpi-cell-val" style="color: var(--dd-primary, #166534);"><%= records.filter(r => (r.status_po || '').includes('Approved')).length %></div>
          <div class="kov-kpi-cell-sub">Siap diteruskan ke supplier</div>
        </div>
        <div class="kov-kpi-cell" onclick="quickFilterPO('')" role="button" title="Total Nilai Netto PO">
          <div class="kov-kpi-cell-label">Total Nilai Netto <i class="fas fa-wallet opacity-50"></i></div>
          <div class="kov-kpi-cell-val">Rp <%= (Math.round(records.reduce((acc, r) => acc + (r.total_netto || 0), 0) / 1000000)).toLocaleString('id-ID') %> <span style="font-size: 0.95rem; font-weight: 500; color: #64748b;">Jt</span></div>
          <div class="kov-kpi-cell-sub">Akumulasi pengadaan barang</div>
        </div>
      </div>

    <!-- Main Table Card -->
    <div class="kov-card">
      <div class="kov-card-header">
        <div class="d-flex flex-wrap align-items-center gap-2 mobile-w-100">
          <div class="input-group input-group-sm" style="min-width: 280px;">
            <span class="input-group-text bg-light"><i class="fas fa-search text-secondary"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="Cari No PO, Nama Vendor, Perihal, Unit Kerja...">
          </div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/admin/operasional/po/create" class="btn-kov-primary btn-kov-sm">
            <i class="fas fa-plus"></i> Buat PO Baru
          </a>
        </div>
      </div>

      <div class="table-responsive-modern">
        <table class="kov-table" id="poTable">
          <thead>
            <tr>
              <th class="ps-3">No. PO</th>
              <th>Tanggal PO</th>
              <th>Penyedia / Vendor (TO)</th>
              <th>Perihal &amp; Unit Kerja</th>
              <th class="text-end">Total Netto (Rp)</th>
              <th class="text-center">Status PO</th>
              <th class="text-end pe-3">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (records.length === 0) { %>
              <tr>
                <td colspan="7" class="text-center py-5 text-muted">
                  <div class="py-4">
                    <i class="fas fa-file-invoice-dollar fa-3x mb-2 text-secondary opacity-50"></i>
                    <h6 class="fw-bold text-dark">Belum Ada Purchase Order</h6>
                    <p class="small text-muted mb-0">Klik tombol "Buat PO Baru" di atas untuk menerbitkan PO pertama.</p>
                  </div>
                </td>
              </tr>
            <% } else { %>
              <% records.forEach(item => { %>
                <tr>
                  <td class="ps-3 fw-bold text-dark">
                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                      <span><%= item.no_po || ('PO/KOV/' + item.id) %></span>
                      <a href="/admin/it?highlight=<%= encodeURIComponent(item.no_po || '') %>" class="badge bg-emerald-subtle text-emerald-dark border border-emerald-subtle rounded-pill text-decoration-none px-2 py-0.5" title="Buka data di Rekap Belanja IT" style="font-size: 0.72rem;">
                        <i class="fas fa-check-circle me-1 text-success"></i>Rekap IT
                      </a>
                    </div>
                  </td>
                  <td class="small text-secondary"><%= formatDate(item.tanggal_po) %></td>
                  <td>
                    <div class="fw-bold text-dark"><%= item.vendor_nama || '-' %></div>
                    <div class="small text-muted"><%= item.vendor_nama_dagang || '' %></div>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= item.perihal || '-' %></div>
                    <span class="badge bg-light text-dark border small"><%= item.unit_kerja || '-' %></span>
                  </td>
                  <td class="text-end fw-bold text-success">
                    Rp <%= Number(item.total_netto || item.subtotal || 0).toLocaleString('id-ID') %>
                  </td>
                  <td class="text-center">
                    <% 
                      const stPo = item.status_po || 'Approved';
                      let stPoPill = 'pill-success';
                      if (stPo.includes('Pending')) stPoPill = 'pill-warning';
                      else if (stPo.includes('Ditolak')) stPoPill = 'pill-danger';
                    %>
                    <span class="status-pill-modern <%= stPoPill %>">
                      <span class="status-dot-pulse"></span> <%= stPo %>
                    </span>
                  </td>
                  <td class="text-end pe-3">
                    <div class="d-inline-flex gap-1.5">
                      <a href="/admin/operasional/po/detail/<%= item.id %>" class="btn-kov-outline btn-kov-sm" title="Lihat Detail PO">
                        <i class="fas fa-eye"></i> Detail
                      </a>
                      <a href="/admin/operasional/po/create?copy_from=<%= item.id %>" class="btn-kov-secondary btn-kov-sm text-primary" title="Duplikat PO Ini">
                        <i class="fas fa-copy"></i>
                      </a>
                      <a href="/api/operasional/po/export/pdf/<%= item.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-secondary btn-kov-sm text-danger" title="Download Official PDF PO">
                        <i class="fas fa-file-pdf"></i>
                      </a>
                      <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                        <button class="btn-kov-secondary btn-kov-sm text-danger" onclick="deletePo(<%= item.id %>, '<%= item.no_po %>')" title="Hapus PO">
                          <i class="fas fa-trash-can"></i>
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

  <form id="deleteForm" method="POST" style="display: none;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  </form>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    const searchInput = document.getElementById('searchInput');
    const tableRows = document.querySelectorAll('#poTable tbody tr');

    function quickFilterPO(status) {
      const searchVal = (status || '').toLowerCase();
      tableRows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = (!searchVal || text.includes(searchVal)) ? '' : 'none';
      });
      document.querySelectorAll('.dd-folder-card').forEach(card => {
        if (!status && card.getAttribute('onclick') && card.getAttribute('onclick').includes("''")) {
          card.classList.add('active');
        } else if (status && card.getAttribute('onclick') && card.getAttribute('onclick').includes(status)) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }
    window.quickFilterPO = quickFilterPO;

    searchInput.addEventListener('keyup', function() {
      const searchVal = this.value.toLowerCase();
      tableRows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(searchVal) ? '' : 'none';
      });
    });

    function deletePo(id, label) {
      if (confirm(`Apakah Anda yakin ingin menghapus Purchase Order: "${label}"?`)) {
        const form = document.getElementById('deleteForm');
        form.action = `/admin/operasional/po/delete/${id}`;
        form.submit();
      }
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
 </body>
 </html>
