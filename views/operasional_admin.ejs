<!DOCTYPE html>
<html lang="id">
<head>
  <!-- Security: Masking Address Bar agar direktori internal tidak terekspos -->
  <script>
    (function() {
      try {
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, document.title, '/');
        }
      } catch (e) {}
    })();
  </script>


  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Operasional - Berita Acara Pengajuan Barang</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --kov-emerald: #059669;
      --kov-slate-900: #0f172a;
      --kov-slate-800: #1e293b;
      --kov-border: #e2e8f0;
    }
    * {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    body { background-color: #f8fafc; color: #1e293b; }
    
    .top-navbar-operasional {
      background: #064e3b;
      border-bottom: 1px solid #065f46;
      padding: 0.75rem 1.5rem;
    }
    
    .nav-btn {
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.45rem 0.9rem;
      border-radius: 8px;
      transition: all 0.15s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .card {
      border: 1px solid var(--kov-border);
      border-radius: 14px;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
      background: #ffffff;
    }

    .metric-card-modern {
      background: #ffffff;
      border: 1px solid var(--kov-border);
      border-radius: 14px;
      padding: 1.2rem;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.04);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .metric-card-modern:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 16px -2px rgba(0, 0, 0, 0.06);
    }
    .metric-icon-box {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }
    
    .badge-status-Menunggu { background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a; }
    .badge-status-Disetujui { background-color: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
    .badge-status-Ditolak { background-color: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    .badge-status-Proses { background-color: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }
    .badge-status-Selesai { background-color: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
    
    .sortable-header { cursor: pointer; user-select: none; }
    .sortable-header:hover { background-color: #e2e8f0; }
  </style>
</head>
<body>

  <!-- Navbar -->
  <header class="top-navbar-operasional shadow-sm">
    <div class="container-fluid px-2 d-flex flex-wrap align-items-center justify-content-between gap-3">
      <a class="d-flex align-items-center text-decoration-none text-white" href="/admin/operasional">
        <div class="bg-white p-1 rounded-3 me-2 d-flex align-items-center justify-content-center" style="height: 38px; width: 38px;">
          <img src="/logo_kov_hijau.png" alt="KOV Logo" style="height: 28px; width: auto; object-fit: contain;">
        </div>
        <div>
          <div class="fw-bold fs-6">Dashboard Operasional</div>
          <div class="text-white-50" style="font-size: 0.75rem;">Berita Acara Pengadaan & Surat Tugas</div>
        </div>
      </a>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% if (typeof user !== 'undefined' && user) { %>
          <span class="text-white px-2 py-1 rounded small" style="background: rgba(255,255,255,0.12);">
            <i class="fas fa-circle-user me-1 text-light"></i><%= user.nama || user.username %> (<%= user.role %>)
          </span>
          <% if (user.role === 'superadmin' || user.role === 'admin') { %>
            <a href="/admin" class="btn btn-outline-light nav-btn">
              <i class="fas fa-user-tie"></i> Switch to HR
            </a>
            <a href="/admin/users" class="btn btn-warning nav-btn text-dark">
              <i class="fas fa-users-gear"></i> Kelola User
            </a>
          <% } %>
        <% } %>
        <button class="btn btn-light nav-btn" onclick="generateAndCopyShareLink()">
          <i class="fas fa-shuffle text-success"></i> Salin Link Acak
        </button>
        <a href="/api/operasional/export/excel" class="btn btn-success nav-btn" style="background-color: #10b981; border-color: #10b981;">
          <i class="fas fa-file-excel"></i> Export Excel
        </a>
        <a href="/admin/logout" onclick="sessionStorage.clear();" class="btn btn-outline-danger nav-btn text-white border-light border-opacity-25 ms-2">
          <i class="fas fa-arrow-right-from-bracket"></i> Logout
        </a>
      </div>
    </div>
  </header>

  <div class="container-fluid px-4 py-4">

    <!-- Sub-menu Tabs Operasional -->
    <ul class="nav nav-pills mb-4 gap-2 bg-white p-2 rounded-3 border">
      <li class="nav-item">
        <a class="nav-link active fw-bold bg-success" style="background-color: #059669 !important;" href="/admin/operasional">
          <i class="fas fa-boxes-packing me-2"></i>Berita Acara Pengajuan Barang
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-secondary fw-semibold" href="/admin/operasional/po">
          <i class="fas fa-file-invoice-dollar me-2"></i>Purchase Order (PO) Pengadaan
        </a>
      </li>
      <li class="nav-item">
        <a class="nav-link text-secondary fw-semibold" href="/admin/operasional/surat-tugas">
          <i class="fas fa-file-signature me-2"></i>Surat Tugas & LPJ Perjalanan Dinas
        </a>
      </li>
    </ul>

    <!-- Share Link Alert Banner -->
    <div class="alert alert-success d-flex align-items-center justify-content-between rounded-3 mb-4 shadow-sm bg-white border border-success-subtle" role="alert">
      <div>
        <i class="fas fa-share-nodes text-success me-2 fs-5"></i>
        <strong>Link Form Unik Operasional (Acak):</strong> 
        <span id="shareUrl" class="user-select-all fw-mono bg-light text-dark px-2 py-1 rounded border ms-1"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/pengajuan-barang?ref=c-8f3a921d</span>
      </div>
      <button class="btn btn-success btn-sm px-3 fw-bold" style="background-color: #059669; border-color: #059669;" onclick="copyShareUrl()">
        <i class="fas fa-copy me-1"></i>Salin Link
      </button>
    </div>

    <!-- Summary Metrics Cards (Bento Style) -->
    <div class="row g-3 mb-4">
      <div class="col-md-2">
        <div class="metric-card-modern">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="text-muted small fw-bold text-uppercase">Total Pengajuan</div>
              <div class="fs-4 fw-bold text-dark"><%= records.length %></div>
            </div>
            <div class="metric-icon-box" style="background: #eff6ff; color: #2563eb;">
              <i class="fas fa-boxes-stacked"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="metric-card-modern">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="text-muted small fw-bold text-uppercase">Menunggu</div>
              <div class="fs-4 fw-bold text-warning" style="color: #d97706 !important;">
                <%= records.filter(r => (r.status_approval || '').includes('Menunggu')).length %>
              </div>
            </div>
            <div class="metric-icon-box" style="background: #fffbeb; color: #d97706;">
              <i class="fas fa-clock"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="metric-card-modern">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="text-muted small fw-bold text-uppercase">Disetujui</div>
              <div class="fs-4 fw-bold text-success" style="color: #059669 !important;">
                <%= records.filter(r => (r.status_approval || '') === 'Disetujui').length %>
              </div>
            </div>
            <div class="metric-icon-box" style="background: #ecfdf5; color: #059669;">
              <i class="fas fa-circle-check"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="metric-card-modern">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="text-muted small fw-bold text-uppercase">Dalam Proses</div>
              <div class="fs-4 fw-bold text-primary">
                <%= records.filter(r => (r.status_approval || '').includes('Proses')).length %>
              </div>
            </div>
            <div class="metric-icon-box" style="background: #eff6ff; color: #3b82f6;">
              <i class="fas fa-spinner"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="metric-card-modern">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="text-muted small fw-bold text-uppercase">Ditolak</div>
              <div class="fs-4 fw-bold text-danger">
                <%= records.filter(r => (r.status_approval || '') === 'Ditolak').length %>
              </div>
            </div>
            <div class="metric-icon-box" style="background: #fef2f2; color: #ef4444;">
              <i class="fas fa-circle-xmark"></i>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-2">
        <div class="metric-card-modern">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="text-muted small fw-bold text-uppercase">Estimasi Biaya</div>
              <div class="fs-6 fw-bold text-dark mt-1">
                Rp <%= records.reduce((acc, r) => acc + (r.total_estimasi || 0), 0).toLocaleString('id-ID') %>
              </div>
            </div>
            <div class="metric-icon-box" style="background: #f8fafc; color: #0f172a; border: 1px solid #e2e8f0;">
              <i class="fas fa-wallet"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
          <div class="small">Total Biaya Estimasi</div>
        </div>
      </div>
    </div>

    <!-- Main Data Table Card -->
    <div class="card shadow-sm">
      <div class="card-header bg-white py-3">
        <div class="row align-items-center g-2">
          <div class="col-md-4">
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="fas fa-search text-secondary"></i></span>
              <input type="text" id="searchInput" class="form-control" placeholder="Cari No BA, Nama Barang, Outlet, PIC...">
            </div>
          </div>
          <div class="col-md-3">
            <select id="filterStatus" class="form-select">
              <option value="">-- Semua Status Approval --</option>
              <option value="Menunggu Approval">Menunggu Approval</option>
              <option value="Disetujui">Disetujui</option>
              <option value="Dalam Proses">Dalam Proses</option>
              <option value="Selesai">Selesai</option>
              <option value="Ditolak">Ditolak</option>
            </select>
          </div>
          <div class="col-md-3">
            <select id="filterPrioritas" class="form-select">
              <option value="">-- Semua Prioritas --</option>
              <option value="Normal">Normal</option>
              <option value="Urgent">Urgent</option>
              <option value="Critical">Critical</option>
            </select>
          </div>
          <div class="col-md-2 text-end">
            <a href="/pengajuan-barang?ref=admin" target="_blank" class="btn btn-outline-success btn-sm fw-bold">
              <i class="fas fa-external-link-alt me-1"></i>Buka Form Public
            </a>
          </div>
        </div>
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" id="recordsTable">
            <thead class="table-light text-secondary small text-uppercase">
              <tr>
                <th class="ps-3 sortable-header" onclick="sortTable(0)">No. BA <i class="fas fa-sort text-muted ms-1"></i></th>
                <th class="sortable-header" onclick="sortTable(1)">Tgl Pengajuan <i class="fas fa-sort text-muted ms-1"></i></th>
                <th class="sortable-header" onclick="sortTable(2)">Outlet / Divisi <i class="fas fa-sort text-muted ms-1"></i></th>
                <th class="sortable-header" onclick="sortTable(3)">PIC Pengajuan <i class="fas fa-sort text-muted ms-1"></i></th>
                <th class="sortable-header" onclick="sortTable(4)">Nama Barang <i class="fas fa-sort text-muted ms-1"></i></th>
                <th class="sortable-header text-end" onclick="sortTable(5)">Total Estimasi <i class="fas fa-sort text-muted ms-1"></i></th>
                <th class="text-center sortable-header" onclick="sortTable(6)">Prioritas <i class="fas fa-sort text-muted ms-1"></i></th>
                <th class="text-center sortable-header" onclick="sortTable(7)">Status Approval <i class="fas fa-sort text-muted ms-1"></i></th>
                <th class="text-end pe-3">Aksi</th>
              </tr>
            </thead>
            <tbody>
              <% if (records.length === 0) { %>
                <tr>
                  <td colspan="9" class="text-center py-5 text-muted">
                    <i class="fas fa-box-open fs-1 mb-2 d-block text-secondary"></i>
                    Belum ada Berita Acara Pengajuan Barang yang tercatat.
                  </td>
                </tr>
              <% } else { %>
                <% records.forEach(item => { %>
                  <tr>
                    <td class="ps-3 fw-bold text-dark">
                      <%= item.no_ba || ('BA/OPS/' + item.id) %>
                    </td>
                    <td class="small text-secondary"><%= formatDate(item.tanggal_pengajuan) %></td>
                    <td>
                      <div class="fw-semibold text-dark"><%= item.outlet_divisi || '-' %></div>
                      <div class="small text-muted"><%= item.departemen || '-' %></div>
                    </td>
                    <td>
                      <span class="fw-semibold text-dark"><%= item.pic_pengajuan || '-' %></span>
                    </td>
                    <td>
                      <div class="fw-bold text-dark"><%= item.nama_barang || '-' %></div>
                      <span class="badge bg-light text-dark border small"><%= item.status_barang || 'Barang Baru' %></span>
                    </td>
                    <td class="text-end fw-bold text-dark">
                      Rp <%= Number(item.total_estimasi || 0).toLocaleString('id-ID') %>
                    </td>
                    <td class="text-center">
                      <% const p = item.prioritas || 'Normal'; %>
                      <span class="badge badge-priority-<%= p %> px-2 py-1"><%= p %></span>
                    </td>
                    <td class="text-center">
                      <% 
                        const st = item.status_approval || 'Menunggu Approval';
                        let stClass = 'Menunggu';
                        if (st === 'Disetujui') stClass = 'Disetujui';
                        else if (st === 'Ditolak') stClass = 'Ditolak';
                        else if (st.includes('Proses')) stClass = 'Proses';
                        else if (st === 'Selesai') stClass = 'Selesai';
                      %>
                      <span class="badge badge-status-<%= stClass %> px-2 py-1"><%= st %></span>
                    </td>
                    <td class="text-end pe-3">
                      <div class="btn-group btn-group-sm">
                        <a href="/admin/operasional/detail/<%= item.id %>" class="btn btn-outline-primary" title="Detail & Otorisasi BA">
                          <i class="fas fa-eye me-1"></i>Detail
                        </a>
                        <a href="/api/operasional/export/pdf/<%= item.id %>" target="_blank" class="btn btn-outline-danger" title="Download Official PDF BA">
                          <i class="fas fa-file-pdf"></i>
                        </a>
                        <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                          <button class="btn btn-outline-danger" onclick="deleteRecord(<%= item.id %>, '<%= item.no_ba || item.nama_barang %>')" title="Hapus BA">
                            <i class="fas fa-trash-can"></i>
                          </button>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Form -->
  <form id="deleteForm" method="POST" style="display: none;"></form>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Copy Share Link Functionality
    window.addEventListener('DOMContentLoaded', () => {
      const initialUrl = `${window.location.origin}/pengajuan-barang?ref=${generateRandomToken()}`;
      document.getElementById('shareUrl').innerText = initialUrl;
    });

    function generateRandomToken() {
      return 'c-' + Math.random().toString(36).substring(2, 10);
    }
    function generateAndCopyShareLink() {
      const newToken = generateRandomToken();
      const newUrl = `${window.location.origin}/pengajuan-barang?ref=${newToken}`;
      document.getElementById('shareUrl').innerText = newUrl;
      navigator.clipboard.writeText(newUrl).then(() => {
        alert('Link Form Unik Operasional berhasil disalin:\n' + newUrl);
      });
    }
    function copyShareUrl() {
      const text = document.getElementById('shareUrl').innerText;
      navigator.clipboard.writeText(text).then(() => {
        alert('Link disalin ke clipboard:\n' + text);
      });
    }

    // Live Filtering
    const searchInput = document.getElementById('searchInput');
    const filterStatus = document.getElementById('filterStatus');
    const filterPrioritas = document.getElementById('filterPrioritas');
    const tableRows = document.querySelectorAll('#recordsTable tbody tr');

    function applyFilters() {
      const searchVal = searchInput.value.toLowerCase();
      const statusVal = filterStatus.value.toLowerCase();
      const prioritasVal = filterPrioritas.value.toLowerCase();

      tableRows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const matchSearch = !searchVal || text.includes(searchVal);
        const matchStatus = !statusVal || text.includes(statusVal);
        const matchPrioritas = !prioritasVal || text.includes(prioritasVal);

        if (matchSearch && matchStatus && matchPrioritas) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    searchInput.addEventListener('keyup', applyFilters);
    filterStatus.addEventListener('change', applyFilters);
    filterPrioritas.addEventListener('change', applyFilters);

    // Delete Record Confirmation
    function deleteRecord(id, label) {
      if (confirm(`Apakah Anda yakin ingin menghapus Berita Acara: "${label}"?`)) {
        const form = document.getElementById('deleteForm');
        form.action = `/admin/operasional/delete/${id}`;
        form.submit();
      }
    }

    // Simple Table Sorting
    let sortDirections = {};
    function sortTable(colIdx) {
      const table = document.getElementById('recordsTable');
      const tbody = table.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      
      sortDirections[colIdx] = !sortDirections[colIdx];
      const dir = sortDirections[colIdx] ? 1 : -1;

      rows.sort((a, b) => {
        const aText = a.children[colIdx] ? a.children[colIdx].innerText.trim() : '';
        const bText = b.children[colIdx] ? b.children[colIdx].innerText.trim() : '';
        return aText.localeCompare(bText, undefined, { numeric: true }) * dir;
      });

      rows.forEach(r => tbody.appendChild(r));
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
