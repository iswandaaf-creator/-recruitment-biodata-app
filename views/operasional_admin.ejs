<!DOCTYPE html>
<html lang="id">
<head>
  <!-- Security: Masking Address Bar agar direktori internal tidak terekspos -->
  <script>
    (function() {
      try {
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, document.title, '/');
        }
      } catch (e) {}
    })();
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Operasional - Berita Acara Pengajuan Barang</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/figma-ui.css" rel="stylesheet">
  <style>
    .sortable-header { cursor: pointer; user-select: none; transition: var(--kov-transition); }
    .sortable-header:hover { background-color: var(--kov-slate-100); }
  </style>
</head>
<body>

  <!-- Modern Top Navigation Bar -->
  <header class="top-navbar-modern">
    <div class="container-fluid d-flex flex-wrap align-items-center justify-content-between gap-3">
      <a href="/admin/operasional" class="navbar-brand-wrap">
        <div class="brand-badge-logo">
          <img src="/logo_kov_hijau.png" alt="KOV Logo">
        </div>
        <div>
          <div class="d-flex align-items-center gap-2">
            <span class="nav-brand-text">Dashboard Operasional</span>
            <span class="status-pill-modern pill-success" style="padding: 2px 8px; font-size: 0.7rem;">
              <span class="status-dot-pulse"></span> BA &amp; Procurement
            </span>
          </div>
          <div class="nav-brand-sub">Berita Acara Pengadaan, PO &amp; Surat Tugas KOV Group</div>
        </div>
      </a>

      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% if (typeof user !== 'undefined' && user) { %>
          <div class="d-flex align-items-center text-white px-2.5 py-1 rounded-3 me-1" style="background: rgba(255,255,255,0.08); font-size: 0.825rem;">
            <i class="fas fa-circle-user me-2 text-emerald-400" style="color: #34d399;"></i>
            <span class="fw-bold"><%= user.nama || user.username %></span>
            <span class="text-white-50 ms-1">(<%= user.role %>)</span>
          </div>
          <% if (user.role === 'superadmin' || user.role === 'admin') { %>
            <a href="/admin" class="nav-link-modern">
              <i class="fas fa-user-tie"></i> Switch to HR
            </a>
            <a href="/admin/users" class="nav-link-modern" style="color: #fde047;">
              <i class="fas fa-users-gear"></i> Kelola User
            </a>
          <% } %>
        <% } %>

        <a href="/pengajuan-barang" target="_blank" class="btn-kov-outline btn-kov-sm" style="border-color: #fde047; color: #fde047 !important;">
          <i class="fas fa-plus"></i> Buat Form BA
        </a>

        <a href="/api/operasional/export/excel" class="btn-kov-primary btn-kov-sm">
          <i class="fas fa-file-excel"></i> Export Excel
        </a>

        <a href="/admin/logout" onclick="sessionStorage.clear();" class="btn-kov-secondary btn-kov-sm text-danger" style="border-color: rgba(239, 68, 68, 0.3);">
          <i class="fas fa-arrow-right-from-bracket"></i> Keluar
        </a>
      </div>
    </div>
  </header>

  <div class="container-fluid px-3 px-md-4 py-4">

    <!-- Sub-menu Navigation Tabs -->
    <div class="d-flex gap-2 overflow-x-auto pb-2 mb-4">
      <a class="nav-link-modern active" href="/admin/operasional">
        <i class="fas fa-boxes-packing"></i> Berita Acara Pengajuan Barang
      </a>
      <a class="nav-link-modern" style="background: white; color: var(--kov-slate-700); border: 1px solid var(--kov-border);" href="/admin/operasional/po">
        <i class="fas fa-file-invoice-dollar text-primary"></i> Purchase Order (PO)
      </a>
      <a class="nav-link-modern" style="background: white; color: var(--kov-slate-700); border: 1px solid var(--kov-border);" href="/admin/operasional/surat-tugas">
        <i class="fas fa-file-signature text-warning"></i> Surat Tugas &amp; Perjalanan Dinas
      </a>
    </div>

    <!-- Share Link Alert Banner -->
    <div class="kov-card mb-4" style="border-left: 4px solid var(--kov-primary-500);">
      <div class="kov-card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="bento-icon-box bento-icon-emerald" style="width: 40px; height: 40px;">
            <i class="fas fa-share-nodes"></i>
          </div>
          <div>
            <div class="fw-bold text-dark" style="font-size: 0.925rem;">
              Link Formulir Publik Berita Acara (Untuk Karyawan / PIC Outlet)
            </div>
            <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
              <span id="shareUrl" class="user-select-all font-monospace bg-light text-dark px-2.5 py-1 rounded-2 border small"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/pengajuan-barang</span>
              <span class="status-pill-modern pill-success" style="font-size: 0.72rem;">
                <span class="status-dot-pulse"></span> Tanpa Perlu Login
              </span>
            </div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button class="btn-kov-secondary btn-kov-sm" onclick="generateAndCopyShareLink()">
            <i class="fas fa-shuffle text-success"></i> Acak Link
          </button>
          <button class="btn-kov-primary btn-kov-sm" onclick="copyShareUrl()">
            <i class="fas fa-copy"></i> Salin Link Form
          </button>
          <a href="/pengajuan-barang" id="openFormBtn" target="_blank" class="btn-kov-outline btn-kov-sm">
            <i class="fas fa-arrow-up-right-from-square"></i> Buka Form
          </a>
        </div>
      </div>
    </div>

    <!-- Bento Metric Cards -->
    <div class="bento-grid">
      <div class="bento-card bento-card-blue">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="bento-metric-title">Total Pengajuan</div>
            <div class="bento-metric-value text-primary"><%= records.length %></div>
          </div>
          <div class="bento-icon-box bento-icon-blue">
            <i class="fas fa-boxes-stacked"></i>
          </div>
        </div>
        <div class="bento-metric-sub">Seluruh berkas BA tercatat</div>
      </div>

      <div class="bento-card bento-card-amber">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="bento-metric-title text-warning">Menunggu Approval</div>
            <div class="bento-metric-value text-warning" style="color: var(--kov-amber) !important;">
              <%= records.filter(r => (r.status_approval || '').includes('Menunggu')).length %>
            </div>
          </div>
          <div class="bento-icon-box bento-icon-amber">
            <i class="fas fa-clock"></i>
          </div>
        </div>
        <div class="bento-metric-sub">Perlu otorisasi manajemen</div>
      </div>

      <div class="bento-card bento-card-emerald">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="bento-metric-title text-success">Disetujui</div>
            <div class="bento-metric-value" style="color: var(--kov-primary-600);"><%= records.filter(r => (r.status_approval || '') === 'Disetujui').length %></div>
          </div>
          <div class="bento-icon-box bento-icon-emerald">
            <i class="fas fa-circle-check"></i>
          </div>
        </div>
        <div class="bento-metric-sub">Siap diproses pengadaan/PO</div>
      </div>

      <div class="bento-card bento-card-blue">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="bento-metric-title text-info">Dalam Proses</div>
            <div class="bento-metric-value text-info" style="color: #0284c7 !important;">
              <%= records.filter(r => (r.status_approval || '').includes('Proses')).length %>
            </div>
          </div>
          <div class="bento-icon-box" style="background: #e0f2fe; color: #0284c7;">
            <i class="fas fa-spinner"></i>
          </div>
        </div>
        <div class="bento-metric-sub">Sedang tahap pembelian/kirim</div>
      </div>

      <div class="bento-card bento-card-rose">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="bento-metric-title text-danger">Ditolak</div>
            <div class="bento-metric-value text-danger">
              <%= records.filter(r => (r.status_approval || '') === 'Ditolak').length %>
            </div>
          </div>
          <div class="bento-icon-box bento-icon-rose">
            <i class="fas fa-circle-xmark"></i>
          </div>
        </div>
        <div class="bento-metric-sub">Pengajuan tidak disetujui</div>
      </div>

      <div class="bento-card">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="bento-metric-title">Total Estimasi</div>
            <div class="bento-metric-value text-dark" style="font-size: 1.35rem;">
              Rp <%= records.reduce((acc, r) => acc + (r.total_estimasi || 0), 0).toLocaleString('id-ID') %>
            </div>
          </div>
          <div class="bento-icon-box" style="background: var(--kov-slate-100); color: var(--kov-slate-700);">
            <i class="fas fa-wallet"></i>
          </div>
        </div>
        <div class="bento-metric-sub">Akumulasi estimasi biaya BA</div>
      </div>
    </div>

    <!-- Main Data Table Card -->
    <div class="kov-card">
      <div class="kov-card-header">
        <div class="d-flex flex-wrap align-items-center gap-2 mobile-w-100">
          <div class="input-group input-group-sm" style="min-width: 240px;">
            <span class="input-group-text bg-light"><i class="fas fa-search text-secondary"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="Cari No BA, Nama Barang, Outlet, PIC...">
          </div>

          <select id="filterStatus" class="form-select form-select-sm" style="min-width: 170px;">
            <option value="">Semua Status Approval</option>
            <option value="Menunggu Approval">Menunggu Approval</option>
            <option value="Disetujui">Disetujui</option>
            <option value="Dalam Proses">Dalam Proses</option>
            <option value="Selesai">Selesai</option>
            <option value="Ditolak">Ditolak</option>
          </select>

          <select id="filterPrioritas" class="form-select form-select-sm" style="min-width: 150px;">
            <option value="">Semua Prioritas</option>
            <option value="Normal">Normal</option>
            <option value="Urgent">Urgent</option>
            <option value="Critical">Critical</option>
          </select>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/pengajuan-barang" target="_blank" class="btn-kov-primary btn-kov-sm">
            <i class="fas fa-plus"></i> Buat Form BA
          </a>
        </div>
      </div>

      <div class="table-responsive-modern">
        <table class="kov-table" id="recordsTable">
          <thead>
            <tr>
              <th class="ps-3 sortable-header" onclick="sortTable(0)">No. BA <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="sortable-header" onclick="sortTable(1)">Tgl Pengajuan <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="sortable-header" onclick="sortTable(2)">Outlet / Divisi <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="sortable-header" onclick="sortTable(3)">PIC Pengajuan <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="sortable-header" onclick="sortTable(4)">Nama Barang <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="sortable-header text-end" onclick="sortTable(5)">Total Estimasi <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="text-center sortable-header" onclick="sortTable(6)">Prioritas <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="text-center sortable-header" onclick="sortTable(7)">Status Approval <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="text-end pe-3">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (records.length === 0) { %>
              <tr>
                <td colspan="9" class="text-center py-5 text-muted">
                  <div class="py-4">
                    <i class="fas fa-box-open fa-3x mb-2 text-secondary opacity-50"></i>
                    <h6 class="fw-bold text-dark">Belum Ada Pengajuan</h6>
                    <p class="small text-muted mb-0">Belum ada Berita Acara Pengajuan Barang yang tercatat.</p>
                  </div>
                </td>
              </tr>
            <% } else { %>
              <% records.forEach(item => { %>
                <tr>
                  <td class="ps-3 fw-bold text-dark">
                    <%= item.no_ba || ('BA/OPS/' + item.id) %>
                  </td>
                  <td class="small text-secondary"><%= formatDate(item.tanggal_pengajuan) %></td>
                  <td>
                    <div class="fw-semibold text-dark"><%= item.outlet_divisi || '-' %></div>
                    <div class="small text-muted"><%= item.departemen || '-' %></div>
                  </td>
                  <td>
                    <span class="fw-semibold text-dark"><%= item.pic_pengajuan || '-' %></span>
                  </td>
                  <td>
                    <div class="fw-bold text-dark"><%= item.nama_barang || '-' %></div>
                    <span class="badge bg-light text-dark border small"><%= item.status_barang || 'Barang Baru' %></span>
                  </td>
                  <td class="text-end fw-bold text-dark">
                    Rp <%= Number(item.total_estimasi || 0).toLocaleString('id-ID') %>
                  </td>
                  <td class="text-center">
                    <% const p = item.prioritas || 'Normal'; 
                       let priClass = 'bg-light text-secondary border';
                       if (p === 'Critical') priClass = 'bg-danger text-white';
                       else if (p === 'Urgent') priClass = 'bg-warning-subtle text-warning-emphasis border border-warning';
                    %>
                    <span class="badge <%= priClass %> px-2 py-1"><%= p %></span>
                  </td>
                  <td class="text-center">
                    <% 
                      const st = item.status_approval || 'Menunggu Approval';
                      let stPill = 'pill-warning';
                      if (st === 'Disetujui') stPill = 'pill-success';
                      else if (st === 'Ditolak') stPill = 'pill-danger';
                      else if (st.includes('Proses')) stPill = 'pill-info';
                      else if (st === 'Selesai') stPill = 'pill-success';
                    %>
                    <span class="status-pill-modern <%= stPill %>">
                      <span class="status-dot-pulse"></span> <%= st %>
                    </span>
                  </td>
                  <td class="text-end pe-3">
                    <div class="d-inline-flex gap-1">
                      <a href="/admin/operasional/detail/<%= item.id %>" class="btn-kov-outline btn-kov-sm" title="Detail & Otorisasi BA">
                        <i class="fas fa-eye"></i> Detail
                      </a>
                      <a href="/api/operasional/export/pdf/<%= item.id %>" target="_blank" class="btn-kov-secondary btn-kov-sm text-danger" title="Download Official PDF BA">
                        <i class="fas fa-file-pdf"></i>
                      </a>
                      <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                        <button class="btn-kov-secondary btn-kov-sm text-danger" onclick="deleteRecord(<%= item.id %>, '<%= item.no_ba || item.nama_barang %>')" title="Hapus BA">
                          <i class="fas fa-trash-can"></i>
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Delete Form -->
  <form id="deleteForm" method="POST" style="display: none;"></form>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Copy Share Link Functionality
    window.addEventListener('DOMContentLoaded', () => {
      const initialUrl = `${window.location.origin}/pengajuan-barang?ref=${generateRandomToken()}`;
      document.getElementById('shareUrl').innerText = initialUrl;
      const openBtn = document.getElementById('openFormBtn');
      if (openBtn) openBtn.href = initialUrl;
    });

    function generateRandomToken() {
      return 'ops-' + Math.random().toString(36).substring(2, 10);
    }
    function generateAndCopyShareLink() {
      const newToken = generateRandomToken();
      const newUrl = `${window.location.origin}/pengajuan-barang?ref=${newToken}`;
      document.getElementById('shareUrl').innerText = newUrl;
      const openBtn = document.getElementById('openFormBtn');
      if (openBtn) openBtn.href = newUrl;
      navigator.clipboard.writeText(newUrl).then(() => {
        alert('Link Form Berita Acara untuk Karyawan/PIC berhasil disalin:\n' + newUrl);
      });
    }
    function copyShareUrl() {
      const text = document.getElementById('shareUrl').innerText;
      navigator.clipboard.writeText(text).then(() => {
        alert('Link Form berhasil disalin ke clipboard:\n' + text + '\n\nSilakan kirimkan ke Karyawan / PIC Outlet terkait (Dapat diisi langsung tanpa perlu akun login).');
      });
    }

    // Live Filtering
    const searchInput = document.getElementById('searchInput');
    const filterStatus = document.getElementById('filterStatus');
    const filterPrioritas = document.getElementById('filterPrioritas');
    const tableRows = document.querySelectorAll('#recordsTable tbody tr');

    function applyFilters() {
      const searchVal = searchInput.value.toLowerCase();
      const statusVal = filterStatus.value.toLowerCase();
      const prioritasVal = filterPrioritas.value.toLowerCase();

      tableRows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const matchSearch = !searchVal || text.includes(searchVal);
        const matchStatus = !statusVal || text.includes(statusVal);
        const matchPrioritas = !prioritasVal || text.includes(prioritasVal);

        if (matchSearch && matchStatus && matchPrioritas) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    searchInput.addEventListener('keyup', applyFilters);
    filterStatus.addEventListener('change', applyFilters);
    filterPrioritas.addEventListener('change', applyFilters);

    // Delete Record Confirmation
    function deleteRecord(id, label) {
      if (confirm(`Apakah Anda yakin ingin menghapus Berita Acara: "${label}"?`)) {
        const form = document.getElementById('deleteForm');
        form.action = `/admin/operasional/delete/${id}`;
        form.submit();
      }
    }

    // Simple Table Sorting
    let sortDirections = {};
    function sortTable(colIdx) {
      const table = document.getElementById('recordsTable');
      const tbody = table.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      
      sortDirections[colIdx] = !sortDirections[colIdx];
      const dir = sortDirections[colIdx] ? 1 : -1;

      rows.sort((a, b) => {
        const aText = a.children[colIdx] ? a.children[colIdx].innerText.trim() : '';
        const bText = b.children[colIdx] ? b.children[colIdx].innerText.trim() : '';
        return aText.localeCompare(bText, undefined, { numeric: true }) * dir;
      });

      rows.forEach(r => tbody.appendChild(r));
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
