<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Operasional - Berita Acara Pengajuan Barang</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261029g" rel="stylesheet">
  <style>
    .sortable-header { cursor: pointer; user-select: none; transition: var(--kov-transition); }
    .sortable-header:hover { background-color: var(--kov-slate-100); }
  </style>
</head>
<body>

  <div class="dd-layout-root kov-app-shell">
    <%- include('partials/sidebar', { active: 'operasional', user: typeof user !== 'undefined' ? user : null }) %>

    <main class="dd-main-canvas kov-main-content dd-theme">
      <!-- Top Search & View Action Bar (Dribbble Signature - Symmetrical 46px Row) -->
      <div class="dd-topbar kov-topbar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="dd-search-container">
            <i class="fas fa-magnifying-glass dd-search-icon"></i>
            <input type="text" class="dd-search-input" id="searchInput" placeholder="Cari nomor BA, nama pemohon, outlet, atau keperluan..." aria-label="Cari Berita Acara">
          </div>
        </div>

        <div class="dd-topbar-actions">
          <button type="button" class="btn-topbar-action d-none d-sm-inline-flex" onclick="copyShareUrl()" title="Salin Tautan Form BA untuk Karyawan/PIC">
            <i class="fas fa-copy" style="color: var(--dd-primary, #5a60ea);"></i>
            <span>Salin Form</span>
          </button>
          <button type="button" class="btn-topbar-action d-none d-md-inline-flex" onclick="generateAndCopyShareLink()" title="Acak & Salin Link Formulir Publik BA">
            <i class="fas fa-shuffle" style="color: var(--dd-primary, #5a60ea);"></i>
            <span>Acak Link</span>
          </button>
          <a href="/api/operasional/export/excel" class="btn-topbar-action d-none d-sm-inline-flex" title="Export Seluruh Rekap BA ke Excel">
            <i class="fas fa-file-excel text-success"></i>
            <span>Export Excel</span>
          </a>
          <a href="/pengajuan-barang" id="openFormBtn" target="_blank" rel="noopener noreferrer" class="btn-drive-upload" title="Buka Form Publik Berita Acara">
            <i class="fas fa-plus"></i>
            <span>Buka Form</span>
          </a>
          <span id="shareUrl" class="d-none"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/pengajuan-barang</span>
        </div>
      </div>

      <!-- Sub-menu Navigation Tabs -->
      <div class="d-flex gap-2 overflow-x-auto pb-1 mt-2 mb-2">
        <a class="nav-link-modern active" href="/admin/operasional">
          <i class="fas fa-boxes-packing text-primary"></i> Berita Acara Pengajuan Barang
        </a>
        <a class="nav-link-modern" href="/admin/operasional/po">
          <i class="fas fa-file-invoice-dollar"></i> Purchase Order (PO)
        </a>
        <a class="nav-link-modern" href="/admin/operasional/surat-tugas">
          <i class="fas fa-file-signature"></i> Surat Tugas &amp; Perjalanan Dinas
        </a>
      </div>

      <!-- Executive Header (Anti-Slop Framed Sheet) -->
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pt-1">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge py-1 px-2" style="background: rgba(22, 101, 52, 0.08); color: #166534; border: 1px solid rgba(22, 101, 52, 0.2); border-radius: 4px; font-weight: 700; font-size: 10.5px; letter-spacing: 0.04em;">
              LOGISTIK &amp; INVENTARIS OUTLET
            </span>
            <span class="text-muted" style="font-size: 12px;">&bull;</span>
            <span class="text-muted" style="font-size: 12px;"><%= records.length %> Berkas Tercatat</span>
          </div>
          <h1 class="h4 mb-0 fw-bold" style="color: var(--dd-text-primary, #0f172a); letter-spacing: -0.015em;">
            Berita Acara Pengajuan Barang
          </h1>
        </div>

        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn-kov-outline" onclick="copyShareUrl()" title="Salin tautan formulir untuk PIC">
            <i class="fas fa-link" style="color: var(--dd-primary, #166534);"></i>
            <span>Salin Form</span>
          </button>
          <a href="/api/operasional/export/excel" class="btn-kov-outline" title="Export Rekap ke Excel">
            <i class="fas fa-file-excel text-success"></i>
            <span>Export Excel</span>
          </a>
          <a href="/pengajuan-barang" target="_blank" rel="noopener noreferrer" class="btn-dd-hero" title="Buka Formulir Publik Baru">
            <i class="fas fa-plus"></i>
            <span>Buat Pengajuan</span>
          </a>
        </div>
      </div>

      <!-- Executive KPI Metric Strip as Primary Interactive Filters -->
      <div class="kov-kpi-strip mb-3">
        <div class="kov-kpi-cell" onclick="quickFilterStatus('')" role="button" title="Tampilkan semua pengajuan">
          <div class="kov-kpi-cell-label">Total Pengajuan <i class="fas fa-boxes-stacked opacity-50"></i></div>
          <div class="kov-kpi-cell-val text-primary"><%= records.length %></div>
          <div class="kov-kpi-cell-sub">Semua berkas tercatat</div>
        </div>
        <div class="kov-kpi-cell" onclick="quickFilterStatus('Menunggu Approval')" role="button" title="Filter BA Menunggu Approval">
          <div class="kov-kpi-cell-label">Menunggu Approval <i class="fas fa-clock opacity-50"></i></div>
          <div class="kov-kpi-cell-val text-warning"><%= records.filter(r => (r.status_approval || '').includes('Menunggu')).length %></div>
          <div class="kov-kpi-cell-sub">Perlu otorisasi manajemen</div>
        </div>
        <div class="kov-kpi-cell" onclick="quickFilterStatus('Disetujui')" role="button" title="Filter BA Disetujui">
          <div class="kov-kpi-cell-label">Disetujui <i class="fas fa-circle-check opacity-50"></i></div>
          <div class="kov-kpi-cell-val" style="color: var(--dd-primary, #166534);"><%= records.filter(r => (r.status_approval || '') === 'Disetujui').length %></div>
          <div class="kov-kpi-cell-sub">Siap diproses PO / pembelian</div>
        </div>
        <div class="kov-kpi-cell" onclick="quickFilterStatus('')" role="button" title="Total Nilai Estimasi">
          <div class="kov-kpi-cell-label">Estimasi Nilai <i class="fas fa-wallet opacity-50"></i></div>
          <div class="kov-kpi-cell-val">Rp <%= (Math.round(records.reduce((acc, r) => acc + (r.total_estimasi || 0), 0) / 1000000)).toLocaleString('id-ID') %> <span style="font-size: 0.95rem; font-weight: 500; color: #64748b;">Jt</span></div>
          <div class="kov-kpi-cell-sub">Akumulasi estimasi anggaran</div>
        </div>
      </div>

    <!-- Main Data Table Card -->
    <div class="kov-card">
      <div class="kov-card-header">
        <div class="d-flex flex-wrap align-items-center gap-2 mobile-w-100">
          <div class="input-group input-group-sm" style="min-width: 240px;">
            <span class="input-group-text bg-light"><i class="fas fa-search text-secondary"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="Cari No BA, Nama Barang, Outlet, PIC..." aria-label="Cari No BA, Nama Barang, Outlet, atau PIC">
          </div>

          <select id="filterStatus" class="form-select form-select-sm" style="min-width: 170px;" aria-label="Filter berdasarkan Status Approval">
            <option value="">Semua Status Approval</option>
            <option value="Menunggu Approval">Menunggu Approval</option>
            <option value="Disetujui">Disetujui</option>
            <option value="Dalam Proses">Dalam Proses</option>
            <option value="Selesai">Selesai</option>
            <option value="Ditolak">Ditolak</option>
          </select>

          <select id="filterPrioritas" class="form-select form-select-sm" style="min-width: 150px;" aria-label="Filter berdasarkan Prioritas">
            <option value="">Semua Prioritas</option>
            <option value="Normal">Normal</option>
            <option value="Urgent">Urgent</option>
            <option value="Critical">Critical</option>
          </select>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/pengajuan-barang" target="_blank" rel="noopener noreferrer" class="btn-kov-primary btn-kov-sm">
            <i class="fas fa-plus"></i> Buat Form BA
          </a>
        </div>
      </div>

      <div class="table-responsive-modern">
        <table class="kov-table" id="recordsTable">
          <thead>
            <tr>
              <th class="ps-3 sortable-header" role="button" tabindex="0" aria-sort="none" onclick="sortTable(0)" onkeydown="if(event.key==='Enter'||event.key===' '){sortTable(0);event.preventDefault();}">No. BA <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="sortable-header" role="button" tabindex="0" aria-sort="none" onclick="sortTable(1)" onkeydown="if(event.key==='Enter'||event.key===' '){sortTable(1);event.preventDefault();}">Tgl Pengajuan <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="sortable-header" role="button" tabindex="0" aria-sort="none" onclick="sortTable(2)" onkeydown="if(event.key==='Enter'||event.key===' '){sortTable(2);event.preventDefault();}">Outlet / Divisi <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="sortable-header" role="button" tabindex="0" aria-sort="none" onclick="sortTable(3)" onkeydown="if(event.key==='Enter'||event.key===' '){sortTable(3);event.preventDefault();}">PIC Pengajuan <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="sortable-header" role="button" tabindex="0" aria-sort="none" onclick="sortTable(4)" onkeydown="if(event.key==='Enter'||event.key===' '){sortTable(4);event.preventDefault();}">Nama Barang <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="sortable-header text-end" role="button" tabindex="0" aria-sort="none" onclick="sortTable(5)" onkeydown="if(event.key==='Enter'||event.key===' '){sortTable(5);event.preventDefault();}">Total Estimasi <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="text-center sortable-header" role="button" tabindex="0" aria-sort="none" onclick="sortTable(6)" onkeydown="if(event.key==='Enter'||event.key===' '){sortTable(6);event.preventDefault();}">Prioritas <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="text-center sortable-header" role="button" tabindex="0" aria-sort="none" onclick="sortTable(7)" onkeydown="if(event.key==='Enter'||event.key===' '){sortTable(7);event.preventDefault();}">Status Approval <i class="fas fa-sort text-muted ms-1"></i></th>
              <th class="text-end pe-3">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (records.length === 0) { %>
              <tr>
                <td colspan="9" class="text-center py-5 text-muted">
                  <div class="py-4">
                    <i class="fas fa-box-open fa-3x mb-2 text-secondary opacity-50"></i>
                    <h6 class="fw-bold text-dark">Belum Ada Pengajuan</h6>
                    <p class="small text-muted mb-0">Belum ada Berita Acara Pengajuan Barang yang tercatat.</p>
                  </div>
                </td>
              </tr>
            <% } else { %>
              <% records.forEach(item => { %>
                <tr>
                  <td class="ps-3 fw-bold text-dark">
                    <%= item.no_ba || ('BA/OPS/' + item.id) %>
                  </td>
                  <td class="small text-secondary"><%= formatDate(item.tanggal_pengajuan) %></td>
                  <td>
                    <div class="fw-semibold text-dark"><%= item.outlet_divisi || '-' %></div>
                    <div class="small text-muted"><%= item.departemen || '-' %></div>
                  </td>
                  <td>
                    <span class="fw-semibold text-dark"><%= item.pic_pengajuan || '-' %></span>
                  </td>
                  <td>
                    <div class="fw-bold text-dark"><%= item.nama_barang || '-' %></div>
                    <span class="badge bg-light text-dark border small"><%= item.status_barang || 'Barang Baru' %></span>
                  </td>
                  <td class="text-end fw-bold text-dark">
                    Rp <%= Number(item.total_estimasi || 0).toLocaleString('id-ID') %>
                  </td>
                  <td class="text-center">
                    <% const p = item.prioritas || 'Normal'; 
                       let priClass = 'bg-light text-secondary border';
                       if (p === 'Critical') priClass = 'bg-danger text-white';
                       else if (p === 'Urgent') priClass = 'bg-warning-subtle text-warning-emphasis border border-warning';
                    %>
                    <span class="badge <%= priClass %> px-2 py-1"><%= p %></span>
                  </td>
                  <td class="text-center">
                    <% 
                      const st = item.status_approval || 'Menunggu Approval';
                      let stPill = 'pill-warning';
                      if (st === 'Disetujui') stPill = 'pill-success';
                      else if (st === 'Ditolak') stPill = 'pill-danger';
                      else if (st.includes('Proses')) stPill = 'pill-info';
                      else if (st === 'Selesai') stPill = 'pill-success';
                    %>
                    <span class="status-pill-modern <%= stPill %>">
                      <span class="status-dot-pulse"></span> <%= st %>
                    </span>
                  </td>
                  <td class="text-end pe-3">
                    <div class="d-inline-flex gap-1">
                      <a href="/admin/operasional/detail/<%= item.id %>" class="btn-kov-outline btn-kov-sm" title="Detail & Otorisasi BA">
                        <i class="fas fa-eye"></i> Detail
                      </a>
                      <a href="/api/operasional/export/pdf/<%= item.id %>" target="_blank" rel="noopener noreferrer" class="btn-kov-secondary btn-kov-sm text-danger" title="Download Official PDF BA">
                        <i class="fas fa-file-pdf"></i>
                      </a>
                      <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                        <button class="btn-kov-secondary btn-kov-sm text-danger" onclick="deleteRecord(<%= item.id %>, '<%= item.no_ba || item.nama_barang %>')" title="Hapus BA">
                          <i class="fas fa-trash-can"></i>
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

  <!-- Delete Form -->
  <form id="deleteForm" method="POST" style="display: none;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  </form>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    // Copy Share Link Functionality
    window.addEventListener('DOMContentLoaded', () => {
      const initialUrl = `${window.location.origin}/pengajuan-barang?ref=${generateRandomToken()}`;
      document.getElementById('shareUrl').innerText = initialUrl;
      const openBtn = document.getElementById('openFormBtn');
      if (openBtn) openBtn.href = initialUrl;
    });

    function generateRandomToken() {
      return 'ops-' + Math.random().toString(36).substring(2, 10);
    }
    function generateAndCopyShareLink() {
      const newToken = generateRandomToken();
      const newUrl = `${window.location.origin}/pengajuan-barang?ref=${newToken}`;
      document.getElementById('shareUrl').innerText = newUrl;
      const openBtn = document.getElementById('openFormBtn');
      if (openBtn) openBtn.href = newUrl;
      navigator.clipboard.writeText(newUrl).then(() => {
        KovToast.success('Tautan Form Berita Acara berhasil disalin ke clipboard:\n' + newUrl, 'Link Form Disalin');
      }).catch(() => {
        KovToast.info('Tautan: ' + newUrl, 'Link Formulir');
      });
    }
    function copyShareUrl() {
      const text = document.getElementById('shareUrl').innerText;
      navigator.clipboard.writeText(text).then(() => {
        KovToast.success('Tautan Berita Acara disalin. Silakan kirimkan ke Karyawan / PIC Outlet terkait.', 'Tautan Disalin');
      }).catch(() => {
        KovToast.info('Tautan: ' + text, 'Link Formulir');
      });
    }

    // Live Filtering
    const searchInput = document.getElementById('searchInput');
    const filterStatus = document.getElementById('filterStatus');
    const filterPrioritas = document.getElementById('filterPrioritas');
    const tableRows = document.querySelectorAll('#recordsTable tbody tr');

    function quickFilterStatus(status) {
      if (filterStatus) {
        filterStatus.value = status;
        applyFilters();
      }
      document.querySelectorAll('.dd-folder-card').forEach(card => {
        if (!status && card.getAttribute('onclick') && card.getAttribute('onclick').includes("''")) {
          card.classList.add('active');
        } else if (status && card.getAttribute('onclick') && card.getAttribute('onclick').includes(status)) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }
    window.quickFilterStatus = quickFilterStatus;

    function applyFilters() {
      const searchVal = searchInput.value.toLowerCase();
      const statusVal = filterStatus.value.toLowerCase();
      const prioritasVal = filterPrioritas.value.toLowerCase();

      tableRows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const matchSearch = !searchVal || text.includes(searchVal);
        const matchStatus = !statusVal || text.includes(statusVal);
        const matchPrioritas = !prioritasVal || text.includes(prioritasVal);

        if (matchSearch && matchStatus && matchPrioritas) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    searchInput.addEventListener('keyup', applyFilters);
    filterStatus.addEventListener('change', applyFilters);
    filterPrioritas.addEventListener('change', applyFilters);

    // Delete Record Confirmation
    function deleteRecord(id, label) {
      if (confirm(`Apakah Anda yakin ingin menghapus Berita Acara: "${label}"?`)) {
        const form = document.getElementById('deleteForm');
        form.action = `/admin/operasional/delete/${id}`;
        form.submit();
      }
    }

    // Simple Table Sorting
    let sortDirections = {};
    function sortTable(colIdx) {
      const table = document.getElementById('recordsTable');
      const tbody = table.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      
      sortDirections[colIdx] = !sortDirections[colIdx];
      const dir = sortDirections[colIdx] ? 1 : -1;

      rows.sort((a, b) => {
        const aText = a.children[colIdx] ? a.children[colIdx].innerText.trim() : '';
        const bText = b.children[colIdx] ? b.children[colIdx].innerText.trim() : '';
        return aText.localeCompare(bText, undefined, { numeric: true }) * dir;
      });

      rows.forEach(r => tbody.appendChild(r));
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
