<!DOCTYPE html>
<html lang="id">
<head>
  <!-- Security: Masking Address Bar agar direktori internal tidak terekspos -->
  <script>
    (function() {
      try {
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, document.title, '/');
        }
      } catch (e) {}
    })();
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Surat Tugas &amp; LPJ - Operasional KOV</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/figma-ui.css" rel="stylesheet">
</head>
<body>

  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'surat_tugas', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Minimalist Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Surat Tugas &amp; LPJ</h1>
            <span class="status-pill-modern pill-warning d-none d-sm-inline-flex" style="padding: 2px 8px; font-size: 0.7rem;">
              <span class="status-dot-pulse"></span> Dinas Operasional
            </span>
          </div>
        </div>
        <div class="kov-topbar-right">
          <a href="/admin/operasional/surat-tugas/create" class="btn-kov-outline btn-kov-sm">
            <i class="fas fa-plus"></i> <span class="d-none d-sm-inline">Buat Surat Tugas</span>
          </a>
          <a href="/api/operasional/surat-tugas/export/excel" class="btn-kov-primary btn-kov-sm">
            <i class="fas fa-file-excel"></i> <span class="d-none d-sm-inline">Export Excel</span>
          </a>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

    <!-- Sub-menu Navigation Tabs -->
    <div class="d-flex gap-2 overflow-x-auto pb-2 mb-4">
      <a class="nav-link-modern" style="background: white; color: var(--kov-slate-700); border: 1px solid var(--kov-border);" href="/admin/operasional">
        <i class="fas fa-boxes-packing text-success"></i> Berita Acara Pengajuan Barang
      </a>
      <a class="nav-link-modern" style="background: white; color: var(--kov-slate-700); border: 1px solid var(--kov-border);" href="/admin/operasional/po">
        <i class="fas fa-file-invoice-dollar text-primary"></i> Purchase Order (PO)
      </a>
      <a class="nav-link-modern active" href="/admin/operasional/surat-tugas">
        <i class="fas fa-file-signature"></i> Surat Tugas &amp; Perjalanan Dinas
      </a>
    </div>

    <!-- Share Link Alert Banner -->
    <div class="kov-card mb-4" style="border-left: 4px solid var(--kov-primary-500);">
      <div class="kov-card-body p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="bento-icon-box bento-icon-emerald" style="width: 40px; height: 40px;">
            <i class="fas fa-share-nodes"></i>
          </div>
          <div>
            <div class="fw-bold text-dark" style="font-size: 0.925rem;">
              Link Formulir Publik Surat Tugas (Untuk KA Outlet / Karyawan)
            </div>
            <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
              <span id="shareUrl" class="user-select-all font-monospace bg-light text-dark px-2.5 py-1 rounded-2 border small"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/surat-tugas</span>
              <span class="status-pill-modern pill-success" style="font-size: 0.72rem;">
                <span class="status-dot-pulse"></span> Publik Tanpa Login
              </span>
            </div>
          </div>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button class="btn-kov-primary btn-kov-sm" onclick="copyShareUrl()">
            <i class="fas fa-copy"></i> Salin Link Form
          </button>
          <a href="/surat-tugas" target="_blank" class="btn-kov-outline btn-kov-sm">
            <i class="fas fa-arrow-up-right-from-square"></i> Buka Form
          </a>
        </div>
      </div>
    </div>

    <!-- Bento Metric Cards -->
    <div class="bento-grid">
      <div class="bento-card bento-card-blue">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="bento-metric-title">Total Surat Tugas</div>
            <div class="bento-metric-value text-primary"><%= records.length %></div>
          </div>
          <div class="bento-icon-box bento-icon-blue">
            <i class="fas fa-file-signature"></i>
          </div>
        </div>
        <div class="bento-metric-sub">Diterbitkan oleh KA Outlet/Staf</div>
      </div>

      <div class="bento-card bento-card-amber">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="bento-metric-title text-warning">Menunggu Approval</div>
            <div class="bento-metric-value text-warning" style="color: var(--kov-amber) !important;">
              <%= records.filter(r => (r.status_surat || '').includes('Menunggu')).length %>
            </div>
          </div>
          <div class="bento-icon-box bento-icon-amber">
            <i class="fas fa-clock"></i>
          </div>
        </div>
        <div class="bento-metric-sub">Persetujuan KA Divisi &amp; GM</div>
      </div>

      <div class="bento-card bento-card-emerald">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="bento-metric-title text-success">Surat Disetujui</div>
            <div class="bento-metric-value" style="color: var(--kov-primary-600);">
              <%= records.filter(r => (r.status_surat || '').includes('Disetujui')).length %>
            </div>
          </div>
          <div class="bento-icon-box bento-icon-emerald">
            <i class="fas fa-circle-check"></i>
          </div>
        </div>
        <div class="bento-metric-sub">Otorisasi dinas sah</div>
      </div>

      <div class="bento-card bento-card-blue">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="bento-metric-title text-info">LPJ Terisi</div>
            <div class="bento-metric-value text-info" style="color: #0284c7 !important;">
              <%= records.filter(r => r.lpj_diisi === 1).length %>
            </div>
          </div>
          <div class="bento-icon-box" style="background: #e0f2fe; color: #0284c7;">
            <i class="fas fa-receipt"></i>
          </div>
        </div>
        <div class="bento-metric-sub">Realisasi dinas dilaporkan</div>
      </div>

      <div class="bento-card">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <div class="bento-metric-title">Total Biaya LPJ</div>
            <div class="bento-metric-value text-dark" style="font-size: 1.35rem;">
              Rp <%= records.reduce((acc, r) => acc + (r.total_biaya || 0), 0).toLocaleString('id-ID') %>
            </div>
          </div>
          <div class="bento-icon-box" style="background: var(--kov-slate-100); color: var(--kov-slate-700);">
            <i class="fas fa-wallet"></i>
          </div>
        </div>
        <div class="bento-metric-sub">Realisasi anggaran perjalanan</div>
      </div>
    </div>

    <!-- Main Table Card -->
    <div class="kov-card">
      <div class="kov-card-header">
        <div class="d-flex flex-wrap align-items-center gap-2 mobile-w-100">
          <div class="input-group input-group-sm" style="min-width: 240px;">
            <span class="input-group-text bg-light"><i class="fas fa-search text-secondary"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="Cari No Surat, Pembuat, Divisi, Tujuan...">
          </div>

          <select id="filterDivisi" class="form-select form-select-sm" style="min-width: 150px;">
            <option value="">Semua Divisi</option>
            <option value="Barista">Barista</option>
            <option value="Kitchen">Kitchen</option>
            <option value="Pastry">Pastry</option>
            <option value="Operasional">Operasional</option>
            <option value="ME">ME / Proyek</option>
            <option value="HRD">HRD / Marketing</option>
            <option value="Finance">Finance / FAT</option>
          </select>

          <select id="filterStatus" class="form-select form-select-sm" style="min-width: 160px;">
            <option value="">Semua Status Approval</option>
            <option value="Menunggu">Menunggu Approval</option>
            <option value="Disetujui">Disetujui</option>
            <option value="Ditolak">Ditolak</option>
          </select>

          <button class="btn-kov-secondary btn-kov-sm" onclick="resetFilters()">
            <i class="fas fa-rotate-right"></i> Reset
          </button>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/admin/operasional/surat-tugas/create" class="btn-kov-primary btn-kov-sm">
            <i class="fas fa-plus"></i> Buat Surat Tugas
          </a>
        </div>
      </div>

      <div class="table-responsive-modern">
        <table class="kov-table" id="recordsTable">
          <thead>
            <tr>
              <th class="ps-3" style="width: 140px;">No. Surat</th>
              <th>Tanggal</th>
              <th>Pembuat (KA Outlet)</th>
              <th>Divisi &amp; Menyetujui</th>
              <th>Tujuan &amp; Kota</th>
              <th>Jadwal Dinas</th>
              <th>Status Surat</th>
              <th>LPJ &amp; Biaya</th>
              <th class="text-center pe-3" style="width: 130px;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (records && records.length > 0) { %>
              <% records.forEach(st => { %>
                <tr>
                  <td class="ps-3">
                    <a href="/admin/operasional/surat-tugas/detail/<%= st.id %>" class="fw-bold text-success text-decoration-none">
                      <%= st.no_surat || ('ST/KOV/' + st.id) %>
                    </a>
                  </td>
                  <td class="small text-muted"><%= formatDate(st.tanggal_surat) %></td>
                  <td>
                    <div class="fw-bold text-dark"><%= st.user_pembuat_nama || '-' %></div>
                    <div class="small text-muted"><%= st.user_pembuat_jabatan || 'KA Outlet' %></div>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border mb-1"><%= st.divisi_terkait || 'Operasional' %></span>
                    <div class="small text-muted">Menyetujui: <strong class="text-success"><%= st.ka_divisi_nama || '-' %></strong></div>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= st.lokasi_tujuan || '-' %></div>
                    <div class="small text-muted"><i class="fas fa-map-marker-alt me-1 text-danger"></i><%= st.kota_tujuan || '-' %></div>
                  </td>
                  <td class="small">
                    <div><%= formatDate(st.tanggal_berangkat) %></div>
                    <div class="text-muted">s/d <%= formatDate(st.tanggal_kembali) %></div>
                  </td>
                  <td>
                    <% 
                      let stPill = 'pill-warning';
                      if ((st.status_surat || '').includes('Disetujui')) stPill = 'pill-success';
                      else if ((st.status_surat || '').includes('Ditolak')) stPill = 'pill-danger';
                    %>
                    <span class="status-pill-modern <%= stPill %>">
                      <span class="status-dot-pulse"></span> <%= st.status_surat || 'Menunggu' %>
                    </span>
                    <div class="small text-muted mt-1" style="font-size: 0.7rem;">
                      KA: <%= st.status_ka_divisi || 'Pending' %> &bull; GM: <%= st.status_gm || 'Pending' %>
                    </div>
                  </td>
                  <td>
                    <% if (st.lpj_diisi === 1) { %>
                      <span class="status-pill-modern pill-info mb-1" style="font-size: 0.72rem;">
                        <span class="status-dot-pulse"></span> LPJ Terisi
                      </span>
                      <div class="fw-bold text-success small">Rp <%= (st.total_biaya || 0).toLocaleString('id-ID') %></div>
                    <% } else { %>
                      <span class="badge bg-light text-muted border">Belum Ada LPJ</span>
                    <% } %>
                  </td>
                  <td class="text-center pe-3">
                    <div class="d-inline-flex gap-1">
                      <a href="/admin/operasional/surat-tugas/detail/<%= st.id %>" class="btn-kov-outline btn-kov-sm" title="Lihat Detail & Approval">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/api/operasional/surat-tugas/export/pdf/<%= st.id %>" class="btn-kov-secondary btn-kov-sm text-danger" title="Download PDF Resmi" target="_blank">
                        <i class="fas fa-file-pdf"></i>
                      </a>
                      <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                        <form action="/admin/operasional/surat-tugas/delete/<%= st.id %>" method="POST" onsubmit="return confirm('Hapus Surat Tugas ini secara permanen?');" class="d-inline">
                          <button type="submit" class="btn-kov-secondary btn-kov-sm text-danger" title="Hapus">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="9" class="text-center py-5 text-muted">
                  <div class="py-4">
                    <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                    <h6 class="fw-bold text-dark">Belum Ada Surat Tugas</h6>
                    <p class="small text-muted mb-0">Klik tombol "Buat Surat Tugas" di atas untuk memulai penugasan dinas.</p>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
      </main>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    function copyShareUrl() {
      const urlText = document.getElementById('shareUrl').innerText.trim();
      navigator.clipboard.writeText(urlText).then(() => {
        alert('Link Form Publik berhasil disalin:\n' + urlText);
      });
    }

    const searchInput = document.getElementById('searchInput');
    const filterDivisi = document.getElementById('filterDivisi');
    const filterStatus = document.getElementById('filterStatus');

    function applyFilters() {
      const search = searchInput.value.toLowerCase();
      const divVal = filterDivisi.value.toLowerCase();
      const statVal = filterStatus.value.toLowerCase();
      const rows = document.querySelectorAll('#recordsTable tbody tr');

      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const matchSearch = !search || text.includes(search);
        const matchDiv = !divVal || text.includes(divVal);
        const matchStat = !statVal || text.includes(statVal);
        row.style.display = (matchSearch && matchDiv && matchStat) ? '' : 'none';
      });
    }

    searchInput.addEventListener('input', applyFilters);
    filterDivisi.addEventListener('change', applyFilters);
    filterStatus.addEventListener('change', applyFilters);

    function resetFilters() {
      searchInput.value = '';
      filterDivisi.value = '';
      filterStatus.value = '';
      applyFilters();
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
