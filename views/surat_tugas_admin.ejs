<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard Surat Tugas &amp; LPJ - Operasional KOV</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261029f" rel="stylesheet">
</head>
<body>

  <div class="dd-layout-root kov-app-shell">
    <%- include('partials/sidebar', { active: 'surat_tugas', user: typeof user !== 'undefined' ? user : null }) %>

    <main class="dd-main-canvas kov-main-content dd-theme">
      <!-- Top Search & View Action Bar (Dribbble Signature - Symmetrical 46px Row) -->
      <div class="dd-topbar kov-topbar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="dd-search-container">
            <i class="fas fa-magnifying-glass dd-search-icon"></i>
            <input type="text" class="dd-search-input" id="searchInput" placeholder="Cari nomor surat, penerima tugas, tujuan dinas..." aria-label="Cari Surat Tugas">
          </div>
        </div>

        <div class="dd-topbar-actions">
          <button type="button" class="btn-topbar-action d-none d-sm-inline-flex" onclick="copyShareUrl()" title="Salin Link Form Surat Tugas">
            <i class="fas fa-copy" style="color: var(--dd-primary, #5a60ea);"></i>
            <span>Salin Link Form</span>
          </button>
          <a href="/surat-tugas" target="_blank" rel="noopener noreferrer" class="btn-topbar-action d-none d-md-inline-flex" title="Buka Form Publik Surat Tugas">
            <i class="fas fa-arrow-up-right-from-square" style="color: var(--dd-primary, #5a60ea);"></i>
            <span>Buka Form</span>
          </a>
          <a href="/api/operasional/surat-tugas/export/excel" class="btn-topbar-action d-none d-sm-inline-flex" title="Export Rekap Surat Tugas ke Excel">
            <i class="fas fa-file-excel text-success"></i>
            <span>Export Excel</span>
          </a>
          <a href="/admin/operasional/surat-tugas/create" class="btn-drive-upload" title="Buat Surat Tugas Baru">
            <i class="fas fa-plus"></i>
            <span>Buat Surat Tugas</span>
          </a>
          <span id="shareUrl" class="d-none"><%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/surat-tugas</span>
        </div>
      </div>

      <!-- Sub-menu Navigation Tabs -->
      <div class="d-flex gap-2 overflow-x-auto pb-1 mt-2 mb-2">
        <a class="nav-link-modern" href="/admin/operasional">
          <i class="fas fa-boxes-packing"></i> Berita Acara Pengajuan Barang
        </a>
        <a class="nav-link-modern" href="/admin/operasional/po">
          <i class="fas fa-file-invoice-dollar"></i> Purchase Order (PO)
        </a>
        <a class="nav-link-modern active" href="/admin/operasional/surat-tugas">
          <i class="fas fa-file-signature text-primary"></i> Surat Tugas &amp; Perjalanan Dinas
        </a>
      </div>

      <!-- Executive Header (Anti-Slop Framed Sheet) -->
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pt-1">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge py-1 px-2" style="background: rgba(22, 101, 52, 0.08); color: #166534; border: 1px solid rgba(22, 101, 52, 0.2); border-radius: 4px; font-weight: 700; font-size: 10.5px; letter-spacing: 0.04em;">
              ADMINISTRASI OPERASIONAL
            </span>
            <span class="text-muted" style="font-size: 12px;">&bull;</span>
            <span class="text-muted" style="font-size: 12px;"><%= records.length %> Surat Tugas Resmi</span>
          </div>
          <h1 class="h4 mb-0 fw-bold" style="color: var(--dd-text-primary, #0f172a); letter-spacing: -0.015em;">
            Surat Tugas &amp; Perjalanan Dinas
          </h1>
        </div>

        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn-kov-outline" onclick="copyShareUrl()" title="Salin tautan formulir dinas">
            <i class="fas fa-link" style="color: var(--dd-primary, #166534);"></i>
            <span>Salin Link Form</span>
          </button>
          <a href="/api/operasional/surat-tugas/export/excel" class="btn-kov-outline" title="Export Rekap Surat Tugas ke Excel">
            <i class="fas fa-file-excel text-success"></i>
            <span>Export Excel</span>
          </a>
          <a href="/admin/operasional/surat-tugas/create" class="btn-dd-hero" title="Buat Surat Tugas Baru">
            <i class="fas fa-plus"></i>
            <span>Buat Surat Tugas</span>
          </a>
        </div>
      </div>

      <!-- Executive KPI Metric Strip as Primary Interactive Filters -->
      <div class="kov-kpi-strip mb-3">
        <div class="kov-kpi-cell" onclick="quickFilterSurat('')" role="button" title="Tampilkan semua surat tugas">
          <div class="kov-kpi-cell-label">Total Surat Tugas <i class="fas fa-file-signature opacity-50"></i></div>
          <div class="kov-kpi-cell-val text-primary"><%= records.length %></div>
          <div class="kov-kpi-cell-sub">Diterbitkan KA Outlet / Staf</div>
        </div>
        <div class="kov-kpi-cell" onclick="quickFilterSurat('Menunggu Approval')" role="button" title="Filter Menunggu Approval">
          <div class="kov-kpi-cell-label">Menunggu Approval <i class="fas fa-clock opacity-50"></i></div>
          <div class="kov-kpi-cell-val text-warning"><%= records.filter(r => (r.status_surat || '').includes('Menunggu')).length %></div>
          <div class="kov-kpi-cell-sub">Persetujuan KA Divisi &amp; GM</div>
        </div>
        <div class="kov-kpi-cell" onclick="quickFilterSurat('Disetujui')" role="button" title="Filter Surat Disetujui">
          <div class="kov-kpi-cell-label">Surat Disetujui <i class="fas fa-circle-check opacity-50"></i></div>
          <div class="kov-kpi-cell-val" style="color: var(--dd-primary, #166534);"><%= records.filter(r => (r.status_surat || '').includes('Disetujui')).length %></div>
          <div class="kov-kpi-cell-sub">Otorisasi dinas sah</div>
        </div>
        <div class="kov-kpi-cell" onclick="quickFilterSurat('LPJ')" role="button" title="Filter LPJ Terlapor">
          <div class="kov-kpi-cell-label">LPJ Terlapor <i class="fas fa-receipt opacity-50"></i></div>
          <div class="kov-kpi-cell-val"><%= records.filter(r => r.lpj_diisi === 1).length %> <span style="font-size: 0.95rem; font-weight: 500; color: #64748b;">Berkas</span></div>
          <div class="kov-kpi-cell-sub">Realisasi anggaran dilaporkan</div>
        </div>
      </div>

    <!-- Main Table Card -->
    <div class="kov-card">
      <div class="kov-card-header">
        <div class="d-flex flex-wrap align-items-center gap-2 mobile-w-100">
          <div class="input-group input-group-sm" style="min-width: 240px;">
            <span class="input-group-text bg-light"><i class="fas fa-search text-secondary"></i></span>
            <input type="text" id="searchInput" class="form-control" placeholder="Cari No Surat, Pembuat, Divisi, Tujuan...">
          </div>

          <select id="filterDivisi" class="form-select form-select-sm" style="min-width: 150px;">
            <option value="">Semua Divisi</option>
            <option value="Barista">Barista</option>
            <option value="Kitchen">Kitchen</option>
            <option value="Pastry">Pastry</option>
            <option value="Operasional">Operasional</option>
            <option value="ME">ME / Proyek</option>
            <option value="HRD">HRD / Marketing</option>
            <option value="Finance">Finance / FAT</option>
          </select>

          <select id="filterStatus" class="form-select form-select-sm" style="min-width: 160px;">
            <option value="">Semua Status Approval</option>
            <option value="Menunggu">Menunggu Approval</option>
            <option value="Disetujui">Disetujui</option>
            <option value="Ditolak">Ditolak</option>
          </select>

          <button class="btn-kov-secondary btn-kov-sm" onclick="resetFilters()">
            <i class="fas fa-rotate-right"></i> Reset
          </button>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a href="/admin/operasional/surat-tugas/create" class="btn-kov-primary btn-kov-sm">
            <i class="fas fa-plus"></i> Buat Surat Tugas
          </a>
        </div>
      </div>

      <div class="table-responsive-modern">
        <table class="kov-table" id="recordsTable">
          <thead>
            <tr>
              <th class="ps-3" style="width: 140px;">No. Surat</th>
              <th>Tanggal</th>
              <th>Pembuat (KA Outlet)</th>
              <th>Divisi &amp; Menyetujui</th>
              <th>Tujuan &amp; Kota</th>
              <th>Jadwal Dinas</th>
              <th>Status Surat</th>
              <th>LPJ &amp; Biaya</th>
              <th class="text-center pe-3" style="width: 130px;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (records && records.length > 0) { %>
              <% records.forEach(st => { %>
                <tr>
                  <td class="ps-3">
                    <a href="/admin/operasional/surat-tugas/detail/<%= st.id %>" class="fw-bold text-success text-decoration-none">
                      <%= st.no_surat || ('ST/KOV/' + st.id) %>
                    </a>
                  </td>
                  <td class="small text-muted"><%= formatDate(st.tanggal_surat) %></td>
                  <td>
                    <div class="fw-bold text-dark"><%= st.user_pembuat_nama || '-' %></div>
                    <div class="small text-muted"><%= st.user_pembuat_jabatan || 'KA Outlet' %></div>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border mb-1"><%= st.divisi_terkait || 'Operasional' %></span>
                    <div class="small text-muted">Menyetujui: <strong class="text-success"><%= st.ka_divisi_nama || '-' %></strong></div>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= st.lokasi_tujuan || '-' %></div>
                    <div class="small text-muted"><i class="fas fa-map-marker-alt me-1 text-danger"></i><%= st.kota_tujuan || '-' %></div>
                  </td>
                  <td class="small">
                    <div><%= formatDate(st.tanggal_berangkat) %></div>
                    <div class="text-muted">s/d <%= formatDate(st.tanggal_kembali) %></div>
                  </td>
                  <td>
                    <% 
                      let stPill = 'pill-warning';
                      if ((st.status_surat || '').includes('Disetujui')) stPill = 'pill-success';
                      else if ((st.status_surat || '').includes('Ditolak')) stPill = 'pill-danger';
                    %>
                    <span class="status-pill-modern <%= stPill %>">
                      <span class="status-dot-pulse"></span> <%= st.status_surat || 'Menunggu' %>
                    </span>
                    <div class="small text-muted mt-1" style="font-size: 0.7rem;">
                      KA: <%= st.status_ka_divisi || 'Pending' %> &bull; GM: <%= st.status_gm || 'Pending' %>
                    </div>
                  </td>
                  <td>
                    <% if (st.lpj_diisi === 1) { %>
                      <span class="status-pill-modern pill-info mb-1" style="font-size: 0.72rem;">
                        <span class="status-dot-pulse"></span> LPJ Terisi
                      </span>
                      <div class="fw-bold text-success small">Rp <%= (st.total_biaya || 0).toLocaleString('id-ID') %></div>
                    <% } else { %>
                      <span class="badge bg-light text-muted border">Belum Ada LPJ</span>
                    <% } %>
                  </td>
                  <td class="text-center pe-3">
                    <div class="d-inline-flex gap-1">
                      <a href="/admin/operasional/surat-tugas/detail/<%= st.id %>" class="btn-kov-outline btn-kov-sm" title="Lihat Detail & Approval">
                        <i class="fas fa-eye"></i>
                      </a>
                      <a href="/api/operasional/surat-tugas/export/pdf/<%= st.id %>" class="btn-kov-secondary btn-kov-sm text-danger" title="Download PDF Resmi" target="_blank" rel="noopener noreferrer">
                        <i class="fas fa-file-pdf"></i>
                      </a>
                      <% if (typeof user !== 'undefined' && user && (user.role === 'superadmin' || user.role === 'admin')) { %>
                        <form action="/admin/operasional/surat-tugas/delete/<%= st.id %>" method="POST" onsubmit="return confirm('Hapus Surat Tugas ini secara permanen?');" class="d-inline">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="btn-kov-secondary btn-kov-sm text-danger" title="Hapus">
                            <i class="fas fa-trash"></i>
                          </button>
                        </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="9" class="text-center py-5 text-muted">
                  <div class="py-4">
                    <i class="fas fa-folder-open fa-3x mb-3 text-secondary opacity-50"></i>
                    <h6 class="fw-bold text-dark">Belum Ada Surat Tugas</h6>
                    <p class="small text-muted mb-0">Klik tombol "Buat Surat Tugas" di atas untuk memulai penugasan dinas.</p>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    function copyShareUrl() {
      const urlText = document.getElementById('shareUrl').innerText.trim();
      navigator.clipboard.writeText(urlText).then(() => {
        KovToast.success('Tautan Form Surat Tugas berhasil disalin ke clipboard:\n' + urlText, 'Link Form Disalin');
      }).catch(() => {
        KovToast.info('Tautan: ' + urlText, 'Link Formulir');
      });
    }

    const searchInput = document.getElementById('searchInput');
    const filterDivisi = document.getElementById('filterDivisi');
    const filterStatus = document.getElementById('filterStatus');

    function quickFilterSurat(status) {
      if (filterStatus) {
        filterStatus.value = status;
        applyFilters();
      }
      document.querySelectorAll('.dd-folder-card').forEach(card => {
        if (!status && card.getAttribute('onclick') && card.getAttribute('onclick').includes("''")) {
          card.classList.add('active');
        } else if (status && card.getAttribute('onclick') && card.getAttribute('onclick').includes(status)) {
          card.classList.add('active');
        } else {
          card.classList.remove('active');
        }
      });
    }
    window.quickFilterSurat = quickFilterSurat;

    function applyFilters() {
      const search = searchInput.value.toLowerCase();
      const divVal = filterDivisi.value.toLowerCase();
      const statVal = filterStatus.value.toLowerCase();
      const rows = document.querySelectorAll('#recordsTable tbody tr');

      rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        const matchSearch = !search || text.includes(search);
        const matchDiv = !divVal || text.includes(divVal);
        const matchStat = !statVal || text.includes(statVal);
        row.style.display = (matchSearch && matchDiv && matchStat) ? '' : 'none';
      });
    }

    searchInput.addEventListener('input', applyFilters);
    filterDivisi.addEventListener('change', applyFilters);
    filterStatus.addEventListener('change', applyFilters);

    function resetFilters() {
      searchInput.value = '';
      filterDivisi.value = '';
      filterStatus.value = '';
      applyFilters();
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
