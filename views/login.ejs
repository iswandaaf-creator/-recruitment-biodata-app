<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login HR Admin - Rekrutmen Candidates</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    body {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .login-card {
      width: 100%;
      max-width: 420px;
      border: none;
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
      overflow: hidden;
    }
    .login-header {
      background: linear-gradient(135deg, #1f4e78 0%, #2f5597 100%);
      color: white;
      padding: 30px 20px;
      text-align: center;
    }
    .login-header i {
      font-size: 2.5rem;
      margin-bottom: 10px;
    }
    .btn-login {
      background: linear-gradient(135deg, #1f4e78 0%, #2f5597 100%);
      border: none;
      padding: 12px;
      font-weight: 600;
      transition: all 0.3s ease;
    }
    .btn-login:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }
  </style>
</head>
<body>

  <div class="card login-card">
    <div class="login-header">
      <i class="fas fa-user-shield"></i>
      <h4 class="fw-bold mb-1">HR Admin Portal</h4>
      <p class="small text-white-50 mb-0">Masuk untuk mengakses dashboard rekrutmen</p>
    </div>
    <div class="card-body p-4 bg-white">
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show text-center py-2 small mb-4" role="alert">
          <i class="fas fa-exclamation-circle me-1"></i> <%= error %>
          <button type="button" class="btn-close py-2" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <form action="/admin/login" method="POST">
        <div class="mb-3">
          <label for="username" class="form-label text-secondary fw-semibold small">Username</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="fas fa-user text-muted"></i></span>
            <input type="text" class="form-control" id="username" name="username" placeholder="Masukkan username" required autofocus>
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label text-secondary fw-semibold small">Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="fas fa-lock text-muted"></i></span>
            <input type="password" class="form-control" id="password" name="password" placeholder="Masukkan password" required>
            <button class="btn btn-outline-secondary" type="button" id="togglePassword">
              <i class="fas fa-eye" id="eyeIcon"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-login w-100 mb-3">
          <i class="fas fa-sign-in-alt me-2"></i>Masuk Ke Dashboard
        </button>
      </form>

      <div class="alert alert-info py-2 px-3 small text-center mb-0 border-0 bg-light text-muted">
        <i class="fas fa-info-circle me-1 text-primary"></i> Default Login: <br>
        <strong>Username:</strong> <code>admin</code> | <strong>Password:</strong> <code>admin123</code>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');
    const eyeIcon = document.getElementById('eyeIcon');

    togglePassword.addEventListener('click', function () {
      const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
      passwordInput.setAttribute('type', type);
      eyeIcon.classList.toggle('fa-eye');
      eyeIcon.classList.toggle('fa-eye-slash');
    });
  </script>
</body>
</html>
