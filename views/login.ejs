<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — KOV Management Portal</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  
  <!-- Google Fonts: Plus Jakarta Sans & IBM Plex Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261029e" rel="stylesheet">

  <style>
    :root {
      --kov-pine: #166534;
      --kov-pine-dark: #14532d;
      --kov-pine-light: #f0fdf4;
    }
    * {
      box-sizing: border-box;
    }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: #0b0f19;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1rem;
      margin: 0;
      color: #334155;
      -webkit-font-smoothing: antialiased;
    }

    [data-theme="light"] body {
      background-color: #f1f5f9;
    }

    .login-wrapper {
      width: 100%;
      max-width: 920px;
      background: #ffffff;
      border-radius: 14px;
      border: 1px solid #e2e8f0;
      overflow: hidden;
      box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.25);
      display: flex;
      flex-direction: column;
    }

    @media (min-width: 820px) {
      .login-wrapper {
        flex-direction: row;
        min-height: 540px;
      }
    }

    /* Left Brand Column (Editorial Showcase) */
    .brand-pane {
      background: #04100c;
      background-image: radial-gradient(circle at 10% 20%, rgba(22, 101, 52, 0.4) 0%, transparent 60%), linear-gradient(180deg, #071e16 0%, #030c09 100%);
      color: #ffffff;
      padding: 3rem 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    @media (min-width: 820px) {
      .brand-pane {
        width: 44%;
        border-bottom: none;
        border-right: 1px solid rgba(255, 255, 255, 0.08);
      }
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 6px;
      background: rgba(22, 101, 52, 0.3);
      border: 1px solid rgba(34, 197, 94, 0.35);
      color: #86efac;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      width: fit-content;
    }

    .brand-mark {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      background: #ffffff;
      padding: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    }

    .brand-mark img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 6px;
    }

    .brand-headline {
      font-size: 1.65rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      line-height: 1.25;
      margin-bottom: 0.75rem;
      color: #ffffff;
    }

    .brand-desc {
      font-size: 0.86rem;
      color: #94a3b8;
      line-height: 1.55;
      margin-bottom: 2rem;
    }

    .brand-feature-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .brand-feature-item {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.82rem;
      color: #cbd5e1;
    }

    .brand-feature-item i {
      color: #4ade80;
      font-size: 0.78rem;
    }

    .brand-footer {
      font-size: 0.74rem;
      color: #64748b;
      margin-top: 2rem;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 1rem;
    }

    /* Right Form Pane */
    .form-pane {
      background: #ffffff;
      padding: 3rem 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
      position: relative;
      flex: 1;
    }

    [data-theme="dark"] .form-pane {
      background: #101726;
      color: #f8fafc;
    }

    .form-header-title {
      font-size: 1.45rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      color: #0f172a;
      margin-bottom: 0.35rem;
    }

    [data-theme="dark"] .form-header-title {
      color: #f8fafc;
    }

    .form-header-sub {
      font-size: 0.85rem;
      color: #64748b;
      margin-bottom: 1.75rem;
    }

    [data-theme="dark"] .form-header-sub {
      color: #94a3b8;
    }

    .form-label {
      font-size: 0.8rem;
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 0.35rem;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    [data-theme="dark"] .form-label {
      color: #cbd5e1;
    }

    .form-control {
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 0.7rem 0.9rem;
      font-size: 0.9rem;
      color: #0f172a;
      transition: all 0.15s ease;
    }

    [data-theme="dark"] .form-control {
      background: #1e293b;
      border-color: #334155;
      color: #f8fafc;
    }

    .form-control:focus {
      border-color: #166534;
      box-shadow: 0 0 0 3px rgba(22, 101, 52, 0.12);
      outline: none;
    }

    .input-group-text {
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-right: none;
      color: #64748b;
      border-radius: 8px 0 0 8px;
      font-size: 0.85rem;
      padding: 0.7rem 0.9rem;
    }

    [data-theme="dark"] .input-group-text {
      background: #1e293b;
      border-color: #334155;
      color: #94a3b8;
    }

    .input-group .form-control {
      border-radius: 0 8px 8px 0;
    }

    .input-group .form-control.with-toggle {
      border-radius: 0;
      border-right: none;
    }

    .btn-toggle-pw {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-left: none;
      border-radius: 0 8px 8px 0;
      color: #94a3b8;
      padding: 0 0.9rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      transition: color 0.15s ease;
    }

    [data-theme="dark"] .btn-toggle-pw {
      background: #1e293b;
      border-color: #334155;
    }

    .btn-toggle-pw:hover {
      color: #0f172a;
    }

    .btn-submit-kov {
      background: #166534;
      color: #ffffff !important;
      border: 1px solid #14532d;
      border-radius: 8px;
      padding: 0.75rem 1.25rem;
      font-weight: 700;
      font-size: 0.92rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.16s ease;
      cursor: pointer;
    }

    .btn-submit-kov:hover {
      background: #14532d;
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(22, 101, 52, 0.25);
    }

    .security-notice {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-size: 0.75rem;
      color: #94a3b8;
      margin-top: 1.5rem;
    }
  </style>
</head>
<body>

  <div class="login-wrapper">
    <!-- Left Editorial Brand Pane -->
    <div class="brand-pane">
      <div>
        <div class="brand-badge mb-3">
          <i class="fas fa-shield-halved"></i> Internal Workspace
        </div>
        <div class="brand-mark">
          <img src="/logo_kov_2.jpg" alt="KOV Koffie Logo" onerror="this.onerror=null; this.src='data:image/svg+xml,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 40 40\'%3E%3Crect width=\'40\' height=\'40\' fill=\'%23166534\' rx=\'8\'/%3E%3Ctext x=\'50%25\' y=\'55%25\' dominant-baseline=\'middle\' text-anchor=\'middle\' fill=\'white\' font-weight=\'bold\' font-family=\'sans-serif\' font-size=\'14\'%3EKOV%3C/text%3E%3C/svg%3E';">
        </div>
        <h1 class="brand-headline">KOV Koffie<br>Management Portal</h1>
        <p class="brand-desc">
          Platform terpadu seleksi rekrutmen pelamar, otorisasi berita acara, pengadaan purchase order, dan belanja infrastruktur IT seluruh outlet.
        </p>
        <ul class="brand-feature-list">
          <li class="brand-feature-item">
            <i class="fas fa-check-circle"></i> Pipeline Rekrutmen &amp; Reviewer Divisi
          </li>
          <li class="brand-feature-item">
            <i class="fas fa-check-circle"></i> Otorisasi Berita Acara &amp; Purchase Order (PO)
          </li>
          <li class="brand-feature-item">
            <i class="fas fa-check-circle"></i> Monitoring Operasional &amp; Surat Tugas
          </li>
        </ul>
      </div>

      <div class="brand-footer">
        <div><strong>KOV Koffie Semarang</strong> &bull; Jl. Sultan Agung No.135, Kaliwiru</div>
        <div class="opacity-75 mt-0.5">&copy; <%= new Date().getFullYear() %> PT KOV Manajemen Group. Hak cipta dilindungi.</div>
      </div>
    </div>

    <!-- Right Form Pane -->
    <div class="form-pane">
      <div class="mb-4">
        <h2 class="form-header-title">Masuk ke Portal</h2>
        <p class="form-header-sub">Gunakan kredensial akun staf internal yang berwenang.</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger py-2 px-3 small rounded-2 mb-3" role="alert">
          <i class="fas fa-circle-exclamation me-1"></i> <%= error %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" data-kov-loading>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-user"></i></span>
            <input type="text" class="form-control" id="username" name="username" placeholder="Masukkan username" required autofocus autocomplete="username">
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label">Kata Sandi</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <input type="password" class="form-control with-toggle" id="password" name="password" placeholder="Masukkan kata sandi" required autocomplete="current-password">
            <button class="btn-toggle-pw" type="button" id="togglePassword" aria-label="Lihat Password">
              <i class="fas fa-eye" id="eyeIcon"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-submit-kov" data-loading-text="Memverifikasi Kredensial...">
          <i class="fas fa-arrow-right-to-bracket"></i> Masuk ke Portal
        </button>
      </form>

      <div class="security-notice">
        <i class="fas fa-lock text-success"></i> <span>Koneksi terenkripsi SSL 256-bit &bull; Sesi diaudit</span>
      </div>
    </div>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/assets/js/kov-toast.js"></script>
  <script src="/assets/js/kov-theme.js"></script>
  <script>
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');
    const eyeIcon = document.getElementById('eyeIcon');

    if (togglePassword && passwordInput && eyeIcon) {
      togglePassword.addEventListener('click', function () {
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
        eyeIcon.classList.toggle('fa-eye');
        eyeIcon.classList.toggle('fa-eye-slash');
      });
    }
  </script>
</body>
</html>
