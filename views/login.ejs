<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — KOV Management Portal</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/figma-ui.css" rel="stylesheet">
  <link href="/assets/css/dribbble-drive.css" rel="stylesheet">

  <style>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: #131429;
      background-image: radial-gradient(circle 800px at 50% 0%, rgba(90, 96, 234, 0.25) 0%, rgba(19, 20, 41, 0) 70%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1rem;
      margin: 0;
      color: #334155;
      -webkit-font-smoothing: antialiased;
    }

    .login-container {
      width: 100%;
      max-width: 410px;
    }

    .auth-card {
      background: #ffffff;
      border-radius: 14px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.4);
      padding: 2.25rem 2rem;
    }

    .brand-logo {
      width: 58px;
      height: 58px;
      border-radius: 14px;
      border: 2px solid rgba(90, 96, 234, 0.35);
      padding: 5px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.15rem;
      background: #ffffff;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .brand-logo:hover {
      transform: scale(1.06);
    }

    .brand-logo img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      image-rendering: -webkit-optimize-contrast;
    }

    .auth-title {
      font-size: 1.35rem;
      font-weight: 700;
      color: #0f172a;
      letter-spacing: -0.02em;
      margin-bottom: 0.35rem;
    }

    .auth-subtitle {
      font-size: 0.85rem;
      color: #64748b;
      margin-bottom: 1.5rem;
      line-height: 1.4;
    }

    .form-label {
      font-size: 0.82rem;
      font-weight: 650;
      color: #0f172a;
      margin-bottom: 0.35rem;
    }

    .form-control {
      border: 1px solid #cbd5e1;
      border-radius: 8px;
      padding: 0.65rem 0.85rem;
      font-size: 0.9rem;
      color: #0f172a;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .form-control:focus {
      border-color: #5a60ea;
      box-shadow: 0 0 0 3px rgba(90, 96, 234, 0.25);
      outline: none;
    }

    .input-group-text {
      background: #f8fafc;
      border: 1px solid #cbd5e1;
      border-right: none;
      color: #64748b;
      border-radius: 8px 0 0 8px;
      font-size: 0.85rem;
      padding: 0.65rem 0.85rem;
    }

    .input-group .form-control {
      border-radius: 0 8px 8px 0;
    }

    .input-group .form-control.with-toggle {
      border-radius: 0;
      border-right: none;
    }

    .btn-toggle-pw {
      background: #ffffff;
      border: 1px solid #cbd5e1;
      border-left: none;
      border-radius: 0 8px 8px 0;
      color: #94a3b8;
      padding: 0 0.85rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      transition: color 0.15s ease;
    }

    .btn-toggle-pw:hover {
      color: #0f172a;
    }

    .btn-primary-kov {
      background: linear-gradient(180deg, #7b80fa 0%, #5a60ea 100%);
      color: #ffffff !important;
      border: 1px solid #4a50d8;
      border-radius: 8px;
      font-size: 0.92rem;
      font-weight: 650;
      padding: 0.72rem 1.25rem;
      width: 100%;
      cursor: pointer;
      transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      box-shadow: 0 4px 14px var(--dd-primary-glow);
    }

    .btn-primary-kov:hover {
      background: linear-gradient(180deg, #5a60ea 0%, #3c42c4 100%);
      box-shadow: 0 8px 20px var(--dd-primary-glow);
      transform: translateY(-1px);
    }

    .btn-primary-kov:active {
      transform: translateY(1px);
    }

    .footer-text {
      margin-top: 1.75rem;
      text-align: center;
      font-size: 0.78rem;
      color: #94a3b8;
      line-height: 1.5;
    }

    .footer-text strong {
      color: #cbd5e1;
    }
  </style>
</head>
<body>

  <div class="login-container">
    <div class="auth-card">
      <div class="text-center">
        <div class="brand-logo">
          <img src="/logo_kov_2.jpg" alt="KOV Koffie Logo">
        </div>
        <h1 class="auth-title">Portal Manajemen KOV</h1>
        <p class="auth-subtitle">Masuk untuk mengelola Rekrutmen, Operasional, PO, dan IT</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger py-2 px-3 small rounded-2 mb-3" role="alert">
          <i class="fas fa-circle-exclamation me-1"></i> <%= error %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" data-kov-loading>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-user"></i></span>
            <input type="text" class="form-control" id="username" name="username" placeholder="Masukkan username" required autofocus autocomplete="username">
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label">Kata Sandi</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <input type="password" class="form-control with-toggle" id="password" name="password" placeholder="Masukkan kata sandi" required autocomplete="current-password">
            <button class="btn-toggle-pw" type="button" id="togglePassword" aria-label="Lihat Password">
              <i class="fas fa-eye" id="eyeIcon"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn-primary-kov" data-loading-text="Memverifikasi Kredensial...">
          <i class="fas fa-arrow-right-to-bracket"></i> Masuk ke Portal
        </button>
      </form>
    </div>

    <div class="footer-text">
      <div><strong>KOV Koffie Semarang</strong></div>
      <div>Jl. Sultan Agung No.135, Kaliwiru, Kec. Candisari, Kota Semarang 50232 &bull; IG: @kovkoffie</div>
      <div class="mt-1" style="font-size: 0.72rem; color: #64748b;">&copy; <%= new Date().getFullYear() %> Akses terbatas khusus staf internal berwenang.</div>
    </div>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <!-- Bespoke Toast & Micro-Interaction System -->
  <script src="/assets/js/kov-toast.js"></script>
  <!-- Coinbase Dual-Theme Engine -->
  <script src="/assets/js/kov-theme.js"></script>
  <script>
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');
    const eyeIcon = document.getElementById('eyeIcon');

    if (togglePassword && passwordInput && eyeIcon) {
      togglePassword.addEventListener('click', function () {
        const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        passwordInput.setAttribute('type', type);
        eyeIcon.classList.toggle('fa-eye');
        eyeIcon.classList.toggle('fa-eye-slash');
      });
    }
  </script>
</body>
</html>
