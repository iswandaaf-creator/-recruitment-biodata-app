<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Masuk — KOV Management Portal</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  
  <!-- Typography: Plus Jakarta Sans & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css?v=20261102_cila_overhaul" rel="stylesheet">

  <script src="/assets/js/kov-toast.js"></script>
  <script src="/assets/js/kov-theme.js"></script>

  <style>
    body {
      background-color: var(--kov-canvas, #f8fafc);
      color: var(--kov-text-primary, #0f172a);
      font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 24px 16px;
      margin: 0;
      -webkit-font-smoothing: antialiased;
    }

    .kov-login-corner {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 50;
    }

    .kov-login-wrapper {
      width: 100%;
      max-width: 420px;
    }

    .kov-login-card {
      background: var(--kov-surface, #ffffff);
      border: 1px solid var(--kov-border, #e2e8f0);
      border-radius: var(--kov-radius-card, 18px);
      padding: 36px 32px;
      box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
    }

    .kov-login-brand {
      width: 52px;
      height: 52px;
      margin: 0 auto 16px;
      border-radius: 12px;
      border: 1px solid var(--kov-border, #e2e8f0);
      padding: 3px;
      background: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .kov-login-brand img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 9px;
    }

    .kov-login-title {
      font-size: 20px;
      font-weight: 700;
      color: var(--kov-text-primary, #0f172a);
      margin: 0 0 6px;
      text-align: center;
      letter-spacing: -0.02em;
    }

    .kov-login-subtitle {
      font-size: 13px;
      color: var(--kov-text-muted, #64748b);
      margin: 0 0 24px;
      text-align: center;
      line-height: 1.5;
    }

    .kov-form-group {
      margin-bottom: 18px;
    }

    .kov-form-label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: var(--kov-text-secondary, #334155);
      margin-bottom: 6px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .kov-input-wrap {
      position: relative;
      display: flex;
      align-items: center;
    }

    .kov-input-icon {
      position: absolute;
      left: 14px;
      color: var(--kov-text-muted, #94a3b8);
      font-size: 14px;
      pointer-events: none;
    }

    .kov-input-control {
      width: 100%;
      height: 44px;
      padding: 0 14px 0 40px;
      font-size: 14px;
      color: var(--kov-text-primary, #0f172a);
      background: var(--kov-surface, #ffffff);
      border: 1px solid var(--kov-border, #cbd5e1);
      border-radius: var(--kov-radius-btn, 10px);
      outline: none;
      transition: all 0.2s ease;
      font-family: inherit;
    }

    [data-theme="dark"] .kov-input-control {
      border-color: #334155;
      background: #0f172a;
      color: #f8fafc;
    }

    .kov-input-control:focus {
      border-color: var(--kov-pine, #166534);
      box-shadow: 0 0 0 3px rgba(22, 101, 52, 0.12);
    }

    .kov-pw-toggle {
      position: absolute;
      right: 12px;
      background: transparent;
      border: none;
      color: var(--kov-text-muted, #94a3b8);
      font-size: 14px;
      cursor: pointer;
      padding: 4px;
    }

    .kov-pw-toggle:hover {
      color: var(--kov-text-primary, #0f172a);
    }

    .kov-btn-login {
      width: 100%;
      height: 44px;
      background: var(--kov-pine, #166534);
      color: #ffffff;
      border: 1px solid var(--kov-pine, #166534);
      border-radius: var(--kov-radius-btn, 10px);
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 24px;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(22, 101, 52, 0.2);
    }

    .kov-btn-login:hover {
      background: var(--kov-pine-hover, #14532d);
      border-color: var(--kov-pine-hover, #14532d);
    }

    .kov-alert-error {
      background: #fff1f2;
      border: 1px solid #fecdd3;
      border-radius: 8px;
      padding: 12px 14px;
      font-size: 13px;
      font-weight: 500;
      color: #be123c;
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 20px;
    }

    .kov-login-footer {
      text-align: center;
      margin-top: 24px;
      font-size: 12px;
      color: var(--kov-text-muted, #64748b);
    }
  </style>
</head>
<body>

  <!-- Theme Toggle Corner Button -->
  <div class="kov-login-corner">
    <button type="button" class="btn btn-sm btn-outline-secondary px-2.5 py-1.5" onclick="toggleKovTheme()" title="Ganti Mode Gelap / Terang">
      <i class="fas fa-moon kov-theme-icon"></i>
    </button>
  </div>

  <div class="kov-login-wrapper">
    <div class="kov-login-card">
      <div class="kov-login-brand">
        <img src="/logo_kov_2.jpg" alt="KOV Logo" onerror="this.onerror=null; this.src='data:image/svg+xml,%3Csvg xmlns=\'http://www.w3.org/2000/svg\' viewBox=\'0 0 40 40\'%3E%3Crect width=\'40\' height=\'40\' fill=\'%23166534\' rx=\'8\'/%3E%3Ctext x=\'50%25\' y=\'55%25\' dominant-baseline=\'middle\' text-anchor=\'middle\' fill=\'white\' font-weight=\'bold\' font-family=\'sans-serif\' font-size=\'14\'%3EKOV%3C/text%3E%3C/svg%3E';">
      </div>
      <h1 class="kov-login-title">Masuk ke Portal</h1>
      <p class="kov-login-subtitle">Sistem terpadu manajemen rekrutmen HR, operasional &amp; IT.</p>

      <% if (error) { %>
        <div class="kov-alert-error" role="alert">
          <i class="fas fa-circle-exclamation flex-shrink-0"></i>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" data-kov-loading>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="kov-form-group">
          <label for="username" class="kov-form-label">Username</label>
          <div class="kov-input-wrap">
            <i class="fas fa-user kov-input-icon"></i>
            <input type="text" class="kov-input-control" id="username" name="username" placeholder="Masukkan username Anda" required autofocus autocomplete="username">
          </div>
        </div>

        <div class="kov-form-group">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label for="password" class="kov-form-label mb-0">Password</label>
          </div>
          <div class="kov-input-wrap">
            <i class="fas fa-lock kov-input-icon"></i>
            <input type="password" class="kov-input-control" id="password" name="password" placeholder="Masukkan password Anda" required autocomplete="current-password">
            <button type="button" class="kov-pw-toggle" id="togglePasswordBtn" aria-label="Tampilkan / Sembunyikan Password">
              <i class="fas fa-eye" id="togglePasswordIcon"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="kov-btn-login" id="submitBtn">
          <span>Masuk ke Akun</span>
          <i class="fas fa-arrow-right"></i>
        </button>
      </form>

      <div class="kov-login-footer">
        <span>&copy; 2026 KOV Group. All rights reserved.</span>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const toggleBtn = document.getElementById('togglePasswordBtn');
      const passwordInput = document.getElementById('password');
      const toggleIcon = document.getElementById('togglePasswordIcon');

      if (toggleBtn && passwordInput && toggleIcon) {
        toggleBtn.addEventListener('click', function () {
          const isPassword = passwordInput.getAttribute('type') === 'password';
          passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
          toggleIcon.classList.toggle('fa-eye', !isPassword);
          toggleIcon.classList.toggle('fa-eye-slash', isPassword);
        });
      }
    });
  </script>
</body>
</html>
