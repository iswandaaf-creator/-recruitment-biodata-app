<!DOCTYPE html>
<html lang="id">
<head>
  <!-- Security: Masking Address Bar agar direktori internal tidak terekspos -->
  <script>
    (function() {
      try {
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, document.title, '/');
        }
      } catch (e) {}
    })();
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - KOV Management Portal</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/figma-ui.css" rel="stylesheet">
  <style>
    body {
      background: radial-gradient(circle at 10% 20%, rgba(5, 150, 105, 0.16) 0%, transparent 45%),
                  radial-gradient(circle at 90% 80%, rgba(15, 23, 42, 0.12) 0%, transparent 45%),
                  #090d16;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
      color: var(--kov-slate-700);
    }

    .auth-card {
      width: 100%;
      max-width: 440px;
      background: #ffffff;
      border-radius: var(--kov-radius-xl);
      border: 1px solid rgba(255, 255, 255, 0.25);
      box-shadow: 0 24px 60px -12px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.12);
      overflow: hidden;
      animation: kovFadeIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .auth-header {
      padding: 2.5rem 2rem 1.5rem;
      text-align: center;
      background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
      border-bottom: 1px solid var(--kov-border);
    }

    .brand-logo-wrap {
      width: 78px;
      height: 78px;
      background: #ffffff;
      border-radius: 20px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 24px rgba(5, 150, 105, 0.15), 0 0 0 1px rgba(226, 232, 240, 0.9);
      margin-bottom: 1.15rem;
      padding: 10px;
      transition: var(--kov-transition);
    }

    .brand-logo-wrap:hover {
      transform: translateY(-2px) scale(1.03);
    }

    .brand-logo-wrap img {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
    }

    .auth-body {
      padding: 2rem;
    }

    .form-control-modern {
      font-size: 0.925rem;
      padding: 0.75rem 1rem;
      border-radius: var(--kov-radius-md);
      border: 1px solid var(--kov-slate-300);
      color: var(--kov-slate-800);
      transition: var(--kov-transition);
    }

    .form-control-modern:focus {
      border-color: var(--kov-primary-500);
      box-shadow: 0 0 0 3.5px rgba(16, 185, 129, 0.18);
      outline: none;
    }

    .input-group-modern .input-group-text {
      background-color: var(--kov-slate-50);
      border-color: var(--kov-slate-300);
      border-radius: var(--kov-radius-md) 0 0 var(--kov-radius-md);
      color: var(--kov-slate-500);
      padding: 0 1rem;
      display: flex;
      align-items: center;
    }

    .input-group-modern .form-control-modern {
      border-radius: 0 var(--kov-radius-md) var(--kov-radius-md) 0;
      border-left: none;
    }

    .input-group-modern:focus-within .input-group-text {
      border-color: var(--kov-primary-500);
      color: var(--kov-primary-600);
    }

    .input-group-modern:focus-within .form-control-modern {
      border-color: var(--kov-primary-500);
    }

    .btn-login-modern {
      background: linear-gradient(135deg, var(--kov-primary-600) 0%, var(--kov-primary-700) 100%);
      border: 1px solid var(--kov-primary-800);
      color: #ffffff;
      font-weight: 700;
      font-size: 0.95rem;
      padding: 0.85rem 1.5rem;
      border-radius: var(--kov-radius-md);
      box-shadow: 0 4px 16px rgba(5, 150, 105, 0.28);
      transition: var(--kov-transition);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
    }

    .btn-login-modern:hover {
      background: linear-gradient(135deg, var(--kov-primary-700) 0%, var(--kov-primary-800) 100%);
      transform: translateY(-1.5px);
      box-shadow: 0 8px 24px rgba(5, 150, 105, 0.4);
      color: #ffffff;
    }

    .footer-note {
      font-size: 0.78rem;
      color: var(--kov-slate-400);
      text-align: center;
      margin-top: 1.5rem;
      line-height: 1.5;
    }

    @media (max-width: 576px) {
      .auth-card {
        border-radius: 18px;
      }
      .auth-header {
        padding: 2rem 1.25rem 1.25rem;
      }
      .auth-body {
        padding: 1.5rem 1.25rem;
      }
    }
  </style>
</head>
<body>

  <div class="auth-card">
    <div class="auth-header">
      <div class="brand-logo-wrap">
        <img src="/logo_kov_2.jpg" alt="KOV Koffie Logo">
      </div>
      <div>
        <span class="status-pill-modern pill-success mb-2">
          <span class="status-dot-pulse"></span> Internal Management System
        </span>
      </div>
      <h4 class="fw-bold text-dark mb-1">KOV Management Portal</h4>
      <p class="text-muted small mb-0">Masuk untuk mengelola HR, Operasional, PO &amp; Rekap IT</p>
    </div>

    <div class="auth-body">
      <% if (error) { %>
        <div class="alert alert-danger d-flex align-items-center rounded-3 py-2 px-3 small mb-4" role="alert">
          <i class="fas fa-circle-exclamation me-2 fs-6"></i>
          <div><%= error %></div>
          <button type="button" class="btn-close ms-auto py-1" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <form action="/admin/login" method="POST">
        <div class="mb-3">
          <label for="username" class="kov-label">Username</label>
          <div class="input-group input-group-modern">
            <span class="input-group-text">
              <i class="fas fa-user-shield"></i>
            </span>
            <input type="text" class="form-control form-control-modern" id="username" name="username" placeholder="Masukkan username akun" required autofocus>
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="kov-label">Password</label>
          <div class="input-group input-group-modern">
            <span class="input-group-text">
              <i class="fas fa-lock"></i>
            </span>
            <input type="password" class="form-control form-control-modern" id="password" name="password" placeholder="Masukkan kata sandi" required>
            <button class="btn btn-outline-secondary" type="button" id="togglePassword" style="border-color: #cbd5e1; border-left: none; background: #fff; border-radius: 0 12px 12px 0;">
              <i class="fas fa-eye text-muted" id="eyeIcon"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="btn btn-login-modern">
          <i class="fas fa-arrow-right-to-bracket"></i> Masuk ke Portal
        </button>

        <div class="footer-note">
          <div class="fw-semibold text-secondary mb-1">KOV GROUP / KOV KOFFIE</div>
          <div style="font-size: 0.72rem; color: #64748b; line-height: 1.4;">Jl. Sultan Agung No.135, Kaliwiru, Kec. Candisari, Kota Semarang, Jawa Tengah 50232</div>
          <div style="font-size: 0.72rem; color: #059669; font-weight: 600; margin-top: 2px;">IG : KOV KOFFIE</div>
          <div class="text-muted mt-2" style="font-size: 0.7rem;">&copy; <%= new Date().getFullYear() %> Akses terbatas untuk staf internal berwenang.</div>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('password');
    const eyeIcon = document.getElementById('eyeIcon');

    togglePassword.addEventListener('click', function () {
      const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
      passwordInput.setAttribute('type', type);
      eyeIcon.classList.toggle('fa-eye');
      eyeIcon.classList.toggle('fa-eye-slash');
    });
  </script>
</body>
</html>
