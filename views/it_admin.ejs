  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
    // Master categories options
    const KAT_OPTIONS = `
      <option value="Jaringan & Network">Jaringan & Network</option>
      <option value="Hardware & Komputer">Hardware & Komputer</option>
      <option value="CCTV & Keamanan">CCTV & Keamanan</option>
      <option value="Software & Lisensi">Software & Lisensi</option>
      <option value="Perawatan & Service">Perawatan & Service</option>
      <option value="Aksesoris & Peripheral">Aksesoris & Peripheral</option>
      <option value="Operasional & Lainnya">Operasional & Lainnya</option>
    `;

    const SATUAN_OPTIONS = `
      <option value="Unit">Unit</option>
      <option value="Pcs">Pcs</option>
      <option value="Roll">Roll</option>
      <option value="Box">Box</option>
      <option value="Meter">Meter</option>
      <option value="Paket">Paket</option>
      <option value="Lisensi">Lisensi</option>
      <option value="Bulan">Bulan</option>
    `;

    // Dynamic Row Generation
    function addDynamicItemRow(mode, itemData = null) {
      const tbody = document.getElementById(mode === 'tambah' ? 'tbodyItemsTambah' : 'tbodyItemsEdit');
      const tr = document.createElement('tr');
      const rowIndex = tbody.children.length + 1;

      const nama = itemData ? (itemData.nama || itemData.nama_barang || '') : '';
      const kat = itemData ? itemData.kategori : 'Jaringan & Network';
      const qty = itemData ? (itemData.qty || 1) : 1;
      const satuan = itemData ? (itemData.satuan || 'Unit') : 'Unit';
      const harga = itemData ? (itemData.harga || itemData.harga_satuan || 0) : '';
      const subtotal = itemData ? (itemData.subtotal || (qty * harga)) : 0;

      tr.innerHTML = `
        <td class="text-center text-muted small row-num font-monospace">${rowIndex}</td>
        <td>
          <input type="text" class="form-control form-control-sm item-name" value="${nama}" placeholder="Contoh: Kabel LAN Cat6 / SSD 512GB" required>
        </td>
        <td>
          <select class="form-select form-select-sm item-kat">
            ${KAT_OPTIONS}
          </select>
        </td>
        <td>
          <input type="number" class="form-control form-control-sm item-qty text-center" value="${qty}" min="1" required>
        </td>
        <td>
          <select class="form-select form-select-sm item-satuan">
            ${SATUAN_OPTIONS}
          </select>
        </td>
        <td>
          <input type="number" class="form-control form-control-sm item-harga text-end" value="${harga}" min="0" placeholder="0" required>
        </td>
        <td class="text-end fw-bold text-success item-subtotal font-monospace">
          ${Number(subtotal).toLocaleString('id-ID')}
        </td>
        <td class="text-center">
          <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2 rounded-circle" onclick="removeDynamicItemRow(this, '${mode}')">
            &times;
          </button>
        </td>
      `;

      tbody.appendChild(tr);

      // Set selected values
      tr.querySelector('.item-kat').value = kat || 'Jaringan & Network';
      tr.querySelector('.item-satuan').value = satuan || 'Unit';

      // Event listener for calculation
      const qtyInput = tr.querySelector('.item-qty');
      const hargaInput = tr.querySelector('.item-harga');
      const calcRow = () => {
        const q = parseFloat(qtyInput.value) || 0;
        const h = parseFloat(hargaInput.value) || 0;
        const subt = q * h;
        tr.querySelector('.item-subtotal').innerText = Math.round(subt).toLocaleString('id-ID');
        calcTotalNota(mode);
      };
      qtyInput.addEventListener('input', calcRow);
      hargaInput.addEventListener('input', calcRow);

      calcTotalNota(mode);
    }

    function removeDynamicItemRow(btn, mode) {
      const tbody = document.getElementById(mode === 'tambah' ? 'tbodyItemsTambah' : 'tbodyItemsEdit');
      if (tbody.children.length <= 1) {
        alert('Minimal harus ada 1 barang dalam catatan belanja!');
        return;
      }
      btn.closest('tr').remove();
      // Renumber
      Array.from(tbody.children).forEach((r, idx) => {
        r.querySelector('.row-num').innerText = idx + 1;
      });
      calcTotalNota(mode);
    }

    function calcTotalNota(mode) {
      const tbody = document.getElementById(mode === 'tambah' ? 'tbodyItemsTambah' : 'tbodyItemsEdit');
      let grandTotal = 0;
      Array.from(tbody.children).forEach(tr => {
        const q = parseFloat(tr.querySelector('.item-qty').value) || 0;
        const h = parseFloat(tr.querySelector('.item-harga').value) || 0;
        grandTotal += (q * h);
      });
      document.getElementById(mode === 'tambah' ? 'labelTotalTambah' : 'labelTotalEdit').innerText = Math.round(grandTotal).toLocaleString('id-ID');
    }

    // Prepare JSON payload before submitting form
    function prepareSubmitItems(mode) {
      const tbody = document.getElementById(mode === 'tambah' ? 'tbodyItemsTambah' : 'tbodyItemsEdit');
      const items = [];
      const rows = tbody.querySelectorAll('tr');

      if (rows.length === 0) {
        alert('Tambahkan minimal 1 barang belanja!');
        return false;
      }

      for (const tr of rows) {
        const nama = tr.querySelector('.item-name').value.trim();
        const kat = tr.querySelector('.item-kat').value;
        const qty = parseInt(tr.querySelector('.item-qty').value, 10) || 1;
        const satuan = tr.querySelector('.item-satuan').value;
        const harga = parseFloat(tr.querySelector('.item-harga').value) || 0;
        if (!nama) {
          alert('Nama barang wajib diisi!');
          return false;
        }
        items.push({
          nama,
          kategori: kat,
          qty,
          satuan,
          harga,
          subtotal: qty * harga
        });
      }

      document.getElementById(mode === 'tambah' ? 'hiddenItemsJsonTambah' : 'hiddenItemsJsonEdit').value = JSON.stringify(items);
      return true;
    }

    // Initialize 3 default rows for Modal Tambah
    window.addEventListener('DOMContentLoaded', () => {
      addDynamicItemRow('tambah');
      addDynamicItemRow('tambah');
      addDynamicItemRow('tambah');
    });

    // Populate Edit Modal
    function openEditModal(nota) {
      document.getElementById('formEditExpense').action = '/api/it/expenses/update/' + nota.id;
      document.getElementById('editNoTransaksi').value = nota.no_transaksi || '';
      document.getElementById('editOutlet').value = nota.unit_outlet || 'Kantor Pusat Semarang';
      document.getElementById('editVendor').value = nota.vendor_toko || '';
      document.getElementById('editTanggal').value = nota.tanggal || '';
      document.getElementById('editMetode').value = nota.metode_bayar || 'Transfer Bank';
      document.getElementById('editStatus').value = nota.status_bayar || 'Lunas';
      document.getElementById('editBukti').value = nota.bukti_transaksi || '';
      document.getElementById('editKeterangan').value = nota.keterangan || '';

      const tbodyEdit = document.getElementById('tbodyItemsEdit');
      tbodyEdit.innerHTML = '';

      let items = nota.parsedItems || [];
      if (!items || items.length === 0) {
        items = [{
          nama: nota.nama_barang || '',
          kategori: nota.kategori || 'Jaringan & Network',
          qty: nota.qty || 1,
          satuan: nota.satuan || 'Unit',
          harga: nota.harga_satuan || 0,
          subtotal: nota.total_biaya || 0
        }];
      }

      items.forEach(it => {
        addDynamicItemRow('edit', it);
      });

      const modal = new bootstrap.Modal(document.getElementById('modalEdit'));
      modal.show();
    }

    // Filter Logic by Outlet Tabs, Vendor, Dates, Items & Categories
    let currentSelectedOutlet = 'ALL';
    const searchInput = document.getElementById('searchInput');
    const filterVendor = document.getElementById('filterVendor');
    const filterStartDate = document.getElementById('filterStartDate');
    const filterEndDate = document.getElementById('filterEndDate');
    const filterStat = document.getElementById('filterStatus');
    const filterKat = document.getElementById('filterKategori');
    const btnReset = document.getElementById('btnResetFilter');
    const rows = document.querySelectorAll('.expense-row');

    function selectOutletFilter(outletName, element) {
      currentSelectedOutlet = outletName;
      document.querySelectorAll('.btn-outlet').forEach(p => p.classList.remove('active'));
      if (element) element.classList.add('active');

      const shortName = (outletName === 'ALL' || !outletName) ? 'Semua' : outletName.replace('Outlet ', '');
      const excelBtnText = document.getElementById('btnTextExportExcel');
      const pdfBtnText = document.getElementById('btnTextExportPdf');
      
      if (excelBtnText) excelBtnText.innerText = `Excel (${shortName})`;
      if (pdfBtnText) pdfBtnText.innerText = `PDF (${shortName})`;

      applyAllFilters();
    }

    function exportReport(format) {
      const params = new URLSearchParams();
      if (currentSelectedOutlet && currentSelectedOutlet !== 'ALL' && currentSelectedOutlet !== 'Semua Outlet') {
        params.set('outlet', currentSelectedOutlet);
      }
      const vendor = filterVendor ? filterVendor.value.trim() : '';
      const sDate = filterStartDate ? filterStartDate.value : '';
      const eDate = filterEndDate ? filterEndDate.value : '';
      const kw = searchInput ? searchInput.value.trim() : '';
      const kat = filterKat ? filterKat.value : '';

      if (vendor) params.set('vendor', vendor);
      if (sDate) params.set('start_date', sDate);
      if (eDate) params.set('end_date', eDate);
      if (kw) params.set('keyword', kw);
      if (kat) params.set('kategori', kat);

      const qs = params.toString();
      const url = '/api/it/export/' + format + (qs ? ('?' + qs) : '');
      window.open(url, '_blank');
    }

    function setExportDatePreset(preset) {
      const sInput = document.getElementById('modalExportStartDate');
      const eInput = document.getElementById('modalExportEndDate');
      const today = new Date();
      if (preset === 'all') {
        sInput.value = '';
        eInput.value = '';
      } else if (preset === 'this_month') {
        const y = today.getFullYear();
        const m = String(today.getMonth() + 1).padStart(2, '0');
        const lastDay = new Date(y, today.getMonth() + 1, 0).getDate();
        sInput.value = `${y}-${m}-01`;
        eInput.value = `${y}-${m}-${String(lastDay).padStart(2, '0')}`;
      } else if (preset === 'last_month') {
        const prevMonthDate = new Date(today.getFullYear(), today.getMonth() - 1, 1);
        const y = prevMonthDate.getFullYear();
        const m = String(prevMonthDate.getMonth() + 1).padStart(2, '0');
        const lastDay = new Date(y, prevMonthDate.getMonth() + 1, 0).getDate();
        sInput.value = `${y}-${m}-01`;
        eInput.value = `${y}-${m}-${String(lastDay).padStart(2, '0')}`;
      }
    }

    function runExportFromModal(format) {
      const outlet = document.getElementById('modalExportOutlet').value;
      const vendor = document.getElementById('modalExportVendor').value.trim();
      const sDate = document.getElementById('modalExportStartDate').value;
      const eDate = document.getElementById('modalExportEndDate').value;
      const keyword = document.getElementById('modalExportKeyword').value.trim();
      const kategori = document.getElementById('modalExportKategori').value;

      const params = new URLSearchParams();
      if (outlet && outlet !== 'ALL') params.set('outlet', outlet);
      if (vendor) params.set('vendor', vendor);
      if (sDate) params.set('start_date', sDate);
      if (eDate) params.set('end_date', eDate);
      if (keyword) params.set('keyword', keyword);
      if (kategori) params.set('kategori', kategori);

      const qs = params.toString();
      const url = '/api/it/export/' + format + (qs ? ('?' + qs) : '');
      window.open(url, '_blank');
    }

    function applyAllFilters() {
      const query = (searchInput.value || '').trim().toLowerCase();
      const vendorVal = (filterVendor ? filterVendor.value : '').trim().toLowerCase();
      const statVal = filterStat.value;
      const katVal = filterKat.value;
      const sDate = filterStartDate ? filterStartDate.value : '';
      const eDate = filterEndDate ? filterEndDate.value : '';

      rows.forEach(row => {
        const rowOutlet = row.getAttribute('data-outlet') || '';
        const rowVendor = row.getAttribute('data-vendor') || '';
        const rowStat = row.getAttribute('data-status') || '';
        const rowSearch = row.getAttribute('data-search') || '';
        const rowDate = row.getAttribute('data-tanggal') || '';

        const matchOutlet = (currentSelectedOutlet === 'ALL') || (rowOutlet === currentSelectedOutlet);
        const matchVendor = !vendorVal || rowVendor.includes(vendorVal);
        const matchStatus = !statVal || (rowStat === statVal);
        const matchSearch = !query || rowSearch.includes(query);
        const matchKat = !katVal || rowSearch.includes(katVal.toLowerCase());
        const matchStart = !sDate || (rowDate >= sDate);
        const matchEnd = !eDate || (rowDate <= eDate);

        if (matchOutlet && matchVendor && matchStatus && matchSearch && matchKat && matchStart && matchEnd) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    searchInput.addEventListener('input', applyAllFilters);
    if (filterVendor) filterVendor.addEventListener('change', applyAllFilters);
    if (filterStartDate) filterStartDate.addEventListener('change', applyAllFilters);
    if (filterEndDate) filterEndDate.addEventListener('change', applyAllFilters);
    filterStat.addEventListener('change', applyAllFilters);
    filterKat.addEventListener('change', applyAllFilters);

    btnReset.addEventListener('click', () => {
      searchInput.value = '';
      if (filterVendor) filterVendor.value = '';
      if (filterStartDate) filterStartDate.value = '';
      if (filterEndDate) filterEndDate.value = '';
      filterStat.value = '';
      filterKat.value = '';
      selectOutletFilter('ALL', document.querySelector('.btn-outlet'));
    });

    // ==========================================
    // GOOGLE GEMINI AI - INVOICE SCANNER
    // ==========================================
    
    function openGeminiScanner() {
      const modalTambahEl = document.getElementById('modalTambah');
      const modal = bootstrap.Modal.getInstance(modalTambahEl) || new bootstrap.Modal(modalTambahEl);
      modal.show();

      setTimeout(() => {
        const box = document.getElementById('aiScannerBox');
        if (box) {
          box.scrollIntoView({ behavior: 'smooth', block: 'center' });
          box.classList.add('border-warning');
          setTimeout(() => box.classList.remove('border-warning'), 1500);
        }
        const fileInp = document.getElementById('aiInvoiceFileInput');
        if (fileInp) fileInp.focus();
      }, 350);
    }

    function openAiScanner() {
      openGeminiScanner();
    }

    async function processInvoiceWithAI() {
      const fileInput = document.getElementById('aiInvoiceFileInput');
      const loadingEl = document.getElementById('aiScanLoading');
      const successEl = document.getElementById('aiScanSuccess');
      const errorEl = document.getElementById('aiScanError');
      const btnScan = document.getElementById('btnRunAiScan');

      successEl.classList.add('d-none');
      errorEl.classList.add('d-none');

      if (!fileInput.files || fileInput.files.length === 0) {
        document.getElementById('aiErrorMessage').innerText = 'Pilih file foto atau PDF invoice terlebih dahulu!';
        errorEl.classList.remove('d-none');
        return;
      }

      const file = fileInput.files[0];
      const formData = new FormData();
      formData.append('invoice_file', file);

      btnScan.disabled = true;
      btnScan.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Memproses...';
      loadingEl.classList.remove('d-none');

      try {
        const response = await fetch('/api/it/ai/scan-invoice', {
          method: 'POST',
          body: formData
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.error || 'Gagal menganalisis invoice.');
        }

        const data = result.data || {};

        if (data.unit_outlet) {
          const outletSelect = document.getElementById('tambahOutlet');
          if (outletSelect) {
            Array.from(outletSelect.options).forEach(opt => {
              if (opt.value.toLowerCase().includes(data.unit_outlet.toLowerCase()) || 
                  data.unit_outlet.toLowerCase().includes(opt.value.toLowerCase())) {
                outletSelect.value = opt.value;
              }
            });
          }
        }

        if (data.vendor_toko) {
          const vInput = document.getElementById('tambahVendor');
          if (vInput) vInput.value = data.vendor_toko;
        }

        if (data.tanggal) {
          const tInput = document.getElementById('tambahTanggal');
          if (tInput) tInput.value = data.tanggal;
        }

        if (data.metode_bayar) {
          const mSelect = document.getElementById('tambahMetode');
          if (mSelect) {
            Array.from(mSelect.options).forEach(opt => {
              if (opt.value.toLowerCase() === data.metode_bayar.toLowerCase()) {
                mSelect.value = opt.value;
              }
            });
          }
        }

        if (data.status_bayar) {
          const sSelect = document.getElementById('tambahStatus');
          if (sSelect) {
            if (data.status_bayar.toLowerCase().includes('lunas')) sSelect.value = 'Lunas';
            else if (data.status_bayar.toLowerCase().includes('reimburse')) sSelect.value = 'Reimburse';
            else sSelect.value = 'Pending';
          }
        }

        const bInput = document.getElementById('tambahBukti');
        if (bInput) {
          bInput.value = result.fileUrl || (data.no_transaksi || '');
        }

        if (data.keterangan) {
          const kInput = document.getElementById('tambahKeterangan');
          if (kInput) kInput.value = data.keterangan;
        }

        const tbody = document.getElementById('tbodyItemsTambah');
        if (tbody) {
          tbody.innerHTML = '';

          const items = Array.isArray(data.items) && data.items.length > 0
            ? data.items
            : [{
                nama: data.nama_barang || 'Item Belanja IT',
                kategori: 'Jaringan & Network',
                qty: 1,
                satuan: 'Unit',
                harga: Number(data.total_biaya || 0),
                subtotal: Number(data.total_biaya || 0)
              }];

          items.forEach(it => {
            addDynamicItemRow('tambah', {
              nama: it.nama || '',
              kategori: it.kategori || 'Jaringan & Network',
              qty: it.qty || 1,
              satuan: it.satuan || 'Unit',
              harga: it.harga || 0,
              subtotal: it.subtotal || (Number(it.qty || 1) * Number(it.harga || 0))
            });
          });

          calcTotalNota('tambah');
        }

        const countItems = (data.items || []).length;
        const totalRp = Number(data.total_biaya || 0).toLocaleString('id-ID');
        document.getElementById('aiSuccessMessage').innerHTML = 
          `Berhasil mengekstrak <strong>${countItems} item</strong> dari invoice <em>${data.vendor_toko || 'Vendor'}</em> (Total: Rp ${totalRp}). Formulir telah terisi otomatis!`;
        successEl.classList.remove('d-none');

      } catch (err) {
        console.error('Invoice AI Error:', err);
        document.getElementById('aiErrorMessage').innerText = err.message || 'Terjadi kesalahan saat memproses invoice.';
        errorEl.classList.remove('d-none');
      } finally {
        loadingEl.classList.add('d-none');
        btnScan.disabled = false;
        btnScan.innerHTML = '<i class="fas fa-robot me-1"></i>Scan & Ekstrak Data';
      }
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
