<!DOCTYPE html>
<html lang="id">
<head>
  <!-- Security: Masking Address Bar agar direktori internal tidak terekspos -->
  <script>
    (function() {
      try {
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, document.title, '/');
        }
      } catch (e) {}
    })();
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rekap Pembelanjaan IT per Outlet — KOV Group</title>
  
  <!-- Google Fonts: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS & FontAwesome -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  
  <!-- Figma Design Token System -->
  <link href="/assets/css/figma-ui.css" rel="stylesheet">
  
  <style>
    body {
      background-color: var(--figma-canvas, #f8fafc);
      color: var(--figma-neutral-800, #1e293b);
      font-family: var(--figma-font-sans, 'Plus Jakarta Sans', sans-serif);
      -webkit-font-smoothing: antialiased;
    }

    /* Top Navbar Glass */
    .navbar-it-admin {
      background: rgba(15, 23, 42, 0.94);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: sticky;
      top: 0;
      z-index: 1020;
    }

    /* Bento Cards */
    .bento-card-it {
      background: #ffffff;
      border: 1px solid var(--figma-neutral-200, #e2e8f0);
      border-radius: var(--figma-radius-xl, 16px);
      box-shadow: 0 4px 16px -2px rgba(15, 23, 42, 0.04);
      padding: 1.25rem 1.4rem;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }
    .bento-card-it:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.08);
      border-color: rgba(5, 150, 105, 0.3);
    }
    .bento-card-it::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: transparent;
      transition: background 0.2s ease;
    }
    .bento-card-it.card-emerald::before { background: linear-gradient(90deg, #059669, #10b981); }
    .bento-card-it.card-blue::before { background: linear-gradient(90deg, #2563eb, #38bdf8); }
    .bento-card-it.card-purple::before { background: linear-gradient(90deg, #7c3aed, #a855f7); }
    .bento-card-it.card-amber::before { background: linear-gradient(90deg, #d97706, #f59e0b); }

    .bento-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }

    /* Modern Segmented Outlet Filter */
    .outlet-filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }
    .btn-outlet {
      border: 1px solid var(--figma-neutral-200, #e2e8f0);
      background-color: #ffffff;
      color: var(--figma-neutral-600, #475569);
      font-weight: 500;
      font-size: 0.8rem;
      padding: 5px 12px;
      border-radius: 9999px;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      cursor: pointer;
    }
    .btn-outlet:hover {
      background-color: #f0fdf4;
      color: #064e3b;
      border-color: #a7f3d0;
    }
    .btn-outlet.active {
      background: linear-gradient(135deg, #064e3b 0%, #059669 100%) !important;
      color: #ffffff !important;
      border-color: #064e3b !important;
      font-weight: 600;
      box-shadow: 0 4px 10px rgba(5, 150, 105, 0.25);
    }
    .btn-outlet.active .badge-count {
      background-color: rgba(255, 255, 255, 0.25) !important;
      color: #ffffff !important;
    }
    .badge-count {
      background-color: #f1f5f9;
      color: #475569;
      font-size: 0.72rem;
      padding: 2px 7px;
      border-radius: 9999px;
      font-weight: 600;
    }

    /* Multi-Item Box in Table */
    .item-pill-row {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 7px 11px;
      margin-bottom: 5px;
      font-size: 0.825rem;
      transition: all 0.15s ease;
    }
    .item-pill-row:hover {
      background-color: #f1f5f9;
      border-color: #cbd5e1;
    }
    .item-pill-row:last-child {
      margin-bottom: 0;
    }

    /* Soft Category Badges */
    .badge-kat-jaringan { background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-hardware { background-color: #e0e7ff; color: #3730a3; border: 1px solid #c7d2fe; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-cctv { background-color: #f3e8ff; color: #6b21a8; border: 1px solid #e9d5ff; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-software { background-color: #fce7f3; color: #9d174d; border: 1px solid #fbcfe8; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-service { background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-aksesoris { background-color: #dcfce7; color: #166534; border: 1px solid #bbf7d0; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-lainnya { background-color: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; font-weight: 600; font-size: 0.72rem; }

    /* AI Scanner Banner */
    .ai-scanner-panel {
      background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 50%, #f7fee7 100%);
      border: 1.5px dashed #059669;
      border-radius: var(--figma-radius-lg, 12px);
    }
  </style>
</head>
<body>
  <div class="kov-app-shell">
    <%- include('partials/sidebar', { active: 'it', user: typeof user !== 'undefined' ? user : null }) %>

    <div class="kov-main-content">
      <!-- Modern Minimalist Topbar -->
      <header class="kov-topbar">
        <div class="kov-topbar-left">
          <button type="button" class="kov-mobile-toggle" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="kov-topbar-breadcrumb">
            <h1 class="kov-topbar-title">Rekap Belanja IT</h1>
            <span class="status-pill-modern pill-info d-none d-sm-inline-flex" style="padding: 2px 8px; font-size: 0.7rem;">
              <span class="status-dot-pulse"></span> Infrastructure &amp; IT
            </span>
          </div>
        </div>
        <div class="kov-topbar-right">
          <button class="btn btn-warning btn-sm fw-bold text-dark rounded-pill shadow-sm px-3" onclick="openGeminiScanner()">
            <i class="fas fa-magic me-1"></i><span class="d-none d-sm-inline">Scan AI</span>
          </button>
          <button class="btn btn-success btn-sm fw-semibold rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalTambah">
            <i class="fas fa-plus me-1"></i><span class="d-none d-sm-inline">Catat Belanja</span>
          </button>
          <button class="btn btn-outline-secondary btn-sm fw-semibold rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalExportKustom">
            <i class="fas fa-file-export me-1 text-primary"></i><span class="d-none d-sm-inline">Export</span>
          </button>
        </div>
      </header>

      <!-- Main Content Area -->
      <main class="kov-content-body">

    <!-- Flash Alerts -->
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #ecfdf5; color: #065f46; border-left: 4px solid #059669 !important;">
        <i class="fas fa-check-circle fs-5"></i>
        <div class="flex-grow-1"><%= success %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 d-flex align-items-center gap-2 mb-4" role="alert" style="background-color: #fef2f2; color: #991b1b; border-left: 4px solid #dc2626 !important;">
        <i class="fas fa-exclamation-triangle fs-5"></i>
        <div class="flex-grow-1"><%= error %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <!-- Bento Metric Cards (KOV Emerald & Slate Palette) -->
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3">
        <div class="bento-card-it card-emerald">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted small fw-semibold text-uppercase tracking-wider" style="font-size: 0.72rem;">Total Pengeluaran IT</div>
              <div class="fs-4 fw-bold text-success mt-1">Rp <%= totalPengeluaran.toLocaleString('id-ID') %></div>
              <div class="text-secondary small mt-1" style="font-size: 11px;">Akumulasi seluruh outlet</div>
            </div>
            <div class="bento-icon-box bg-success bg-opacity-10 text-success">
              <i class="fas fa-wallet"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="bento-card-it card-blue">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted small fw-semibold text-uppercase tracking-wider" style="font-size: 0.72rem;">Bulan Ini</div>
              <div class="fs-4 fw-bold text-primary mt-1">Rp <%= pengeluaranBulanIni.toLocaleString('id-ID') %></div>
              <div class="text-secondary small mt-1" style="font-size: 11px;"><%= new Date().toLocaleString('id-ID', { month: 'long', year: 'numeric' }) %></div>
            </div>
            <div class="bento-icon-box bg-primary bg-opacity-10 text-primary">
              <i class="fas fa-calendar-check"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="bento-card-it card-purple">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted small fw-semibold text-uppercase tracking-wider" style="font-size: 0.72rem;">Total Nota / Resi</div>
              <div class="fs-4 fw-bold text-dark mt-1"><%= expenses.length %> <span class="fs-6 fw-normal text-muted">Nota</span></div>
              <div class="text-secondary small mt-1" style="font-size: 11px;">Belanja vendor IT</div>
            </div>
            <div class="bento-icon-box bg-secondary bg-opacity-10 text-secondary">
              <i class="fas fa-receipt"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="bento-card-it card-amber">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <div class="text-muted small fw-semibold text-uppercase tracking-wider" style="font-size: 0.72rem;">Pending / Reimburse</div>
              <div class="fs-4 fw-bold text-warning mt-1"><%= totalPending %> <span class="fs-6 fw-normal text-muted">Nota</span></div>
              <div class="text-secondary small mt-1" style="font-size: 11px;">Perlu verifikasi bayar</div>
            </div>
            <div class="bento-icon-box bg-warning bg-opacity-10 text-warning">
              <i class="fas fa-clock"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% 
      const defaultOutlets = ['Kantor Pusat Semarang', 'Outlet Pekalongan', 'Outlet Rinjani', 'Outlet Semarang', 'Outlet Ngaliyan', 'Outlet Purwokerto', 'Outlet Solo'];
      const allOutletKeys = Array.from(new Set([...defaultOutlets, ...(outletList || [])]));
    %>

    <!-- Unified Filter, Outlet Tabs & Action Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
      <div class="p-3 border-bottom">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
          
          <!-- Baris 1: Segmented Outlet Pills -->
          <div class="outlet-filter-bar">
            <span class="small fw-bold text-muted me-1"><i class="fas fa-store text-success me-1"></i>Outlet:</span>
            <button type="button" class="btn-outlet active" onclick="selectOutletFilter('ALL', this)">
              <span>Semua</span>
              <span class="badge-count"><%= expenses.length %></span>
            </button>
            <% allOutletKeys.forEach(outletName => { 
                 const oStat = outletStats[outletName] || { count: 0, total: 0 };
                 const shortName = outletName.replace('Outlet ', '');
            %>
              <button type="button" class="btn-outlet" onclick="selectOutletFilter('<%= outletName %>', this)">
                <span><%= shortName %></span>
                <% if (oStat.count > 0) { %>
                  <span class="badge-count"><%= oStat.count %></span>
                <% } %>
              </button>
            <% }); %>
          </div>

          <!-- Quick Export Buttons -->
          <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-success fw-semibold" onclick="exportReport('excel')" title="Export Excel sesuai filter">
              <i class="fas fa-file-excel me-1"></i><span id="btnTextExportExcel">Excel (Semua)</span>
            </button>
            <button type="button" class="btn btn-outline-danger fw-semibold" onclick="exportReport('pdf')" title="Cetak PDF sesuai filter">
              <i class="fas fa-file-pdf me-1"></i><span id="btnTextExportPdf">PDF (Semua)</span>
            </button>
            <button type="button" class="btn btn-outline-secondary fw-semibold" data-bs-toggle="modal" data-bs-target="#modalExportKustom">
              <i class="fas fa-sliders-h me-1"></i>Opsi
            </button>
          </div>
        </div>
      </div>

      <!-- Baris 2: Search, Date, Vendor, Category & Status Inputs -->
      <div class="p-3 bg-light bg-opacity-50">
        <div class="row g-2 align-items-center">
          <div class="col-12 col-md-3">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-search"></i></span>
              <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Cari barang, nota, vendor...">
            </div>
          </div>
          <div class="col-6 col-md-2">
            <select id="filterVendor" class="form-select form-select-sm">
              <option value="">Semua Vendor</option>
              <% if (typeof vendorList !== 'undefined') { %>
                <% vendorList.forEach(v => { %>
                  <option value="<%= v %>"><%= v %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="col-6 col-md-2">
            <input type="date" id="filterStartDate" class="form-control form-control-sm" title="Dari Tanggal">
          </div>
          <div class="col-6 col-md-2">
            <input type="date" id="filterEndDate" class="form-control form-control-sm" title="Sampai Tanggal">
          </div>
          <div class="col-6 col-md-2">
            <select id="filterKategori" class="form-select form-select-sm">
              <option value="">Semua Kategori</option>
              <option value="Jaringan & Network">Jaringan & Network</option>
              <option value="Hardware & Komputer">Hardware & Komputer</option>
              <option value="CCTV & Keamanan">CCTV & Keamanan</option>
              <option value="Software & Lisensi">Software & Lisensi</option>
              <option value="Perawatan & Service">Perawatan & Service</option>
              <option value="Aksesoris & Peripheral">Aksesoris & Peripheral</option>
              <option value="Operasional & Lainnya">Operasional & Lainnya</option>
            </select>
          </div>
          <div class="col-6 col-md-1">
            <select id="filterStatus" class="form-select form-select-sm" title="Status Pembayaran">
              <option value="">Status</option>
              <option value="Lunas">Lunas</option>
              <option value="Pending">Pending</option>
              <option value="Reimburse">Reimb.</option>
            </select>
          </div>
          <div class="col-6 col-md-12 col-lg-auto text-end ms-auto">
            <button id="btnResetFilter" class="btn btn-outline-secondary btn-sm px-3" title="Reset filter">
              <i class="fas fa-undo me-1"></i>Reset
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Modern Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
      <div class="table-responsive">
        <table class="table kov-table align-middle mb-0" id="expensesTable">
          <thead>
            <tr>
              <th class="ps-4" style="width: 45px;">No</th>
              <th style="width: 150px;">No Transaksi & Tgl</th>
              <th style="width: 180px;">Outlet / Unit</th>
              <th style="width: 180px;">Vendor & Metode</th>
              <th>Rincian Barang Belanjaan (Multi-Item)</th>
              <th class="text-end" style="width: 150px;">Total (Rp)</th>
              <th class="text-center" style="width: 120px;">Status</th>
              <th class="text-center pe-4" style="width: 90px;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (expenses.length === 0) { %>
              <tr>
                <td colspan="8" class="text-center py-5 text-muted">
                  <div class="bg-light p-3 rounded-circle d-inline-flex mb-3">
                    <i class="fas fa-shopping-bag fa-2x text-muted opacity-50"></i>
                  </div>
                  <h6 class="fw-bold text-dark">Belum ada catatan belanja IT yang tersimpan</h6>
                  <p class="small text-muted mb-3">Mulai catat pembelanjaan infrastruktur, software, atau service outlet.</p>
                  <button class="btn btn-success btn-sm fw-semibold rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalTambah">
                    <i class="fas fa-plus me-1"></i>Catat Belanja Sekarang
                  </button>
                </td>
              </tr>
            <% } %>

            <% expenses.forEach((nota, index) => { %>
              <tr class="expense-row" 
                  data-outlet="<%= nota.unit_outlet %>" 
                  data-status="<%= nota.status_bayar %>" 
                  data-tanggal="<%= nota.tanggal %>"
                  data-vendor="<%= (nota.vendor_toko || '').toLowerCase() %>"
                  data-search="<%= (nota.no_transaksi + ' ' + nota.unit_outlet + ' ' + (nota.vendor_toko || '') + ' ' + (nota.bukti_transaksi || '') + ' ' + nota.parsedItems.map(i => i.nama + ' ' + i.kategori).join(' ')).toLowerCase() %>">
                <td class="ps-4 text-muted small fw-bold"><%= index + 1 %></td>
                <td>
                  <span class="fw-bold text-success font-monospace small"><%= nota.no_transaksi %></span>
                  <div class="text-muted small mt-1"><i class="fas fa-calendar-alt me-1 text-secondary"></i><%= formatDate(nota.tanggal) %></div>
                  <% if (nota.bukti_transaksi) { %>
                    <div class="mt-1">
                      <% if (nota.bukti_transaksi.startsWith('http://') || nota.bukti_transaksi.startsWith('https://')) { %>
                        <a href="<%= nota.bukti_transaksi %>" target="_blank" class="badge bg-light text-primary border small text-decoration-none">
                          <i class="fas fa-external-link-alt me-1"></i>Bukti Nota
                        </a>
                      <% } else { %>
                        <span class="badge bg-light text-secondary border small" title="<%= nota.bukti_transaksi %>">
                          <i class="fas fa-receipt me-1"></i><%= nota.bukti_transaksi %>
                        </span>
                      <% } %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <span class="badge bg-emerald-subtle text-emerald-dark px-2 py-1 rounded-pill fw-semibold" style="font-size: 0.8rem;">
                    <i class="fas fa-store me-1"></i><%= nota.unit_outlet %>
                  </span>
                  <% if (nota.keterangan) { %>
                    <div class="small text-muted mt-1 fst-italic">
                      <i class="fas fa-info-circle me-1 text-secondary"></i><%= nota.keterangan %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <div class="fw-bold text-dark"><i class="fas fa-shop text-success me-1"></i><%= nota.vendor_toko || '-' %></div>
                  <div class="small text-muted mt-1"><%= nota.metode_bayar || 'Transfer Bank' %></div>
                </td>
                <td>
                  <!-- Multi-Item List -->
                  <div class="mb-1 d-flex justify-content-between align-items-center">
                    <span class="badge bg-light text-dark border small fw-semibold">
                      <i class="fas fa-boxes-stacked me-1 text-success"></i><%= nota.parsedItems.length %> Item Belanja
                    </span>
                  </div>

                  <% nota.parsedItems.forEach((it, itIdx) => { %>
                    <div class="item-pill-row d-flex justify-content-between align-items-center">
                      <div>
                        <strong class="text-dark"><%= itIdx + 1 %>. <%= it.nama %></strong>
                        <span class="badge <%= getBadgeKat(it.kategori) %> ms-1 py-0 px-2">
                          <%= it.kategori %>
                        </span>
                      </div>
                      <div class="text-end ps-2">
                        <span class="text-muted small"><%= it.qty %> <%= it.satuan || 'Unit' %> &times; <%= Number(it.harga || 0).toLocaleString('id-ID') %> = </span>
                        <span class="text-success fw-bold font-monospace">Rp <%= Number(it.subtotal || (it.qty * it.harga)).toLocaleString('id-ID') %></span>
                      </div>
                    </div>
                  <% }); %>
                </td>
                <td class="text-end">
                  <div class="fs-6 fw-bold text-success font-monospace">
                    Rp <%= Number(nota.total_biaya).toLocaleString('id-ID') %>
                  </div>
                </td>
                <td class="text-center">
                  <% if (nota.status_bayar === 'Lunas') { %>
                    <span class="status-pill-modern status-approved"><span class="status-dot-pulse"></span>Lunas</span>
                  <% } else if (nota.status_bayar === 'Reimburse') { %>
                    <span class="status-pill-modern" style="background:#ede9fe; color:#6d28d9;"><span class="status-dot-pulse" style="background:#8b5cf6;"></span>Reimburse</span>
                  <% } else { %>
                    <span class="status-pill-modern status-pending"><span class="status-dot-pulse"></span>Pending</span>
                  <% } %>
                </td>
