              </div>
            </div>

            <!-- SECTION DAFTAR ITEM BARANG DINAMIS -->
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h6 class="fw-bold text-dark mb-0">
                <i class="fas fa-list-check text-success me-2"></i>Daftar Barang Belanjaan (Dapat Lebih Dari 3 Item)
              </h6>
              <button type="button" class="btn btn-success btn-sm fw-bold shadow-sm" onclick="addDynamicItemRow('tambah')">
                <i class="fas fa-plus me-1"></i>+ Tambah Baris Barang
              </button>
            </div>

            <div class="table-responsive">
              <table class="table table-bordered align-middle mb-2 bg-white" id="tableItemsTambah">
