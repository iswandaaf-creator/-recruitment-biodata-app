<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Rekap Pembelanjaan IT per Outlet — KOV Group</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  
  <!-- Google Fonts: Plus Jakarta Sans & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- Bootstrap 5 CSS & FontAwesome -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  
  <!-- Figma Design Token System -->
  <link href="/assets/css/kov-portal.css?v=20261029_cila_v6" rel="stylesheet">
  
  <style>
    body {
      background-color: var(--figma-canvas, #f8fafc);
      color: var(--figma-neutral-800, #1e293b);
      font-family: var(--figma-font-sans, 'Plus Jakarta Sans', sans-serif);
      -webkit-font-smoothing: antialiased;
    }

    /* Top Navbar Glass */
    .navbar-it-admin {
      background: rgba(15, 23, 42, 0.94);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      position: sticky;
      top: 0;
      z-index: 1020;
    }

    /* Bento Cards - Tactile human card */
    .bento-card-it {
      background: #ffffff;
      border: 1px solid var(--kov-border, #e2e8f0);
      border-radius: 14px;
      box-shadow: 0 1px 3px rgba(24, 24, 27, 0.04);
      padding: 1.25rem 1.4rem;
      transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
    }
    .bento-card-it:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.08);
      border-color: var(--kov-slate-300, #cbd5e1);
    }

    .bento-icon-box {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }

    /* Modern Segmented Outlet Filter */
    .outlet-filter-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }
    .btn-outlet {
      border: 1px solid var(--figma-neutral-200, #e2e8f0);
      background-color: #ffffff;
      color: var(--figma-neutral-600, #475569);
      font-weight: 500;
      font-size: 0.8rem;
      padding: 5px 12px;
      border-radius: 9999px;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      cursor: pointer;
    }
    .btn-outlet:hover {
      background-color: rgba(90, 96, 234, 0.08);
      color: var(--dd-primary, #166534);
      border-color: rgba(90, 96, 234, 0.3);
    }
    .btn-outlet.active {
      background: var(--dd-primary, #166534) !important;
      color: #ffffff !important;
      border-color: var(--dd-primary, #166534) !important;
      font-weight: 700;
      box-shadow: 0 4px 14px var(--dd-primary-glow, rgba(90, 96, 234, 0.35));
    }
    .btn-outlet.active .badge-count {
      background-color: rgba(255, 255, 255, 0.25) !important;
      color: #ffffff !important;
    }
    .badge-count {
      background-color: #f1f5f9;
      color: #475569;
      font-size: 0.72rem;
      padding: 2px 7px;
      border-radius: 9999px;
      font-weight: 600;
    }

    /* Multi-Item Box in Table */
    .item-pill-row {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      padding: 7px 11px;
      margin-bottom: 5px;
      font-size: 0.825rem;
      transition: all 0.15s ease;
    }
    .item-pill-row:hover {
      background-color: #f1f5f9;
      border-color: #cbd5e1;
    }
    .item-pill-row:last-child {
      margin-bottom: 0;
    }

    /* Soft Category Badges */
    .badge-kat-jaringan { background-color: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-hardware { background-color: #e0e7ff; color: #3730a3; border: 1px solid #c7d2fe; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-cctv { background-color: #f3e8ff; color: #6b21a8; border: 1px solid #e9d5ff; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-software { background-color: #fce7f3; color: #9d174d; border: 1px solid #fbcfe8; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-service { background-color: #fef3c7; color: #92400e; border: 1px solid #fde68a; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-aksesoris { background-color: #dcfce7; color: #166534; border: 1px solid #bbf7d0; font-weight: 600; font-size: 0.72rem; }
    .badge-kat-lainnya { background-color: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; font-weight: 600; font-size: 0.72rem; }

    /* AI Scanner Banner */
    .ai-scanner-panel {
      background: #f8fafc;
      border: 1.5px dashed var(--dd-primary, #166534);
      border-radius: var(--figma-radius-lg, 12px);
    }

    /* Dark Mode Anti-Leak Overrides */
    [data-theme="dark"] .item-pill-row {
      background-color: rgba(255, 255, 255, 0.05);
      border-color: rgba(255, 255, 255, 0.1);
      color: #e2e8f0;
    }
    [data-theme="dark"] .item-pill-row:hover {
      background-color: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.2);
    }
    [data-theme="dark"] .btn-outlet {
      background-color: rgba(255, 255, 255, 0.05);
      border-color: rgba(255, 255, 255, 0.12);
      color: #cbd5e1;
    }
    [data-theme="dark"] .btn-outlet:hover {
      background-color: rgba(5, 150, 105, 0.15);
      color: #34d399;
      border-color: rgba(5, 150, 105, 0.3);
    }
    [data-theme="dark"] .badge-count {
      background-color: rgba(255, 255, 255, 0.1);
      color: #cbd5e1;
    }
    [data-theme="dark"] .card.bg-white,
    [data-theme="dark"] .card {
      background-color: var(--kov-surface, #240b3b) !important;
      color: var(--kov-text, #f1f5f9) !important;
      border-color: var(--kov-border, rgba(255, 255, 255, 0.1)) !important;
    }
    [data-theme="dark"] .card .border-bottom {
      border-color: var(--kov-border, rgba(255, 255, 255, 0.1)) !important;
    }
    [data-theme="dark"] .modal-content {
      background-color: var(--kov-surface, #240b3b);
      color: var(--kov-text, #f1f5f9);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    [data-theme="dark"] .modal-footer {
      background-color: rgba(0, 0, 0, 0.2) !important;
      border-top-color: rgba(255, 255, 255, 0.1) !important;
    }
    [data-theme="dark"] .bento-metric-value.text-warning {
      color: #fbbf24 !important;
    }
    /* PO / Target Row Pulsing Glow */
    @keyframes poRowGlow {
      0% {
        background-color: rgba(16, 185, 129, 0.22);
        box-shadow: inset 0 0 0 2px #10b981;
      }
      50% {
        background-color: rgba(90, 96, 234, 0.25);
        box-shadow: inset 0 0 0 3px #166534;
      }
      100% {
        background-color: rgba(16, 185, 129, 0.22);
        box-shadow: inset 0 0 0 2px #10b981;
      }
    }
    .row-highlight-pulse {
      animation: poRowGlow 1.8s ease-in-out infinite;
      position: relative;
      z-index: 2;
    }
    .row-highlight-pulse td {
      background-color: transparent !important;
    }
  </style>
</head>
<body>
  <div class="dd-layout-root kov-app-shell">
    <%- include('partials/sidebar', { active: 'it', user: typeof user !== 'undefined' ? user : null }) %>

    <main class="dd-main-canvas kov-main-content dd-theme">
      <!-- Top Search & View Action Bar (Dribbble Signature - Symmetrical 46px Row) -->
      <div class="dd-topbar kov-topbar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="dd-search-container">
            <i class="fas fa-magnifying-glass dd-search-icon"></i>
            <input type="text" class="dd-search-input" id="itSearchInput" placeholder="Cari nama barang IT, vendor, outlet, spesifikasi..." aria-label="Cari Belanja IT" onkeyup="filterITTable()">
          </div>
        </div>

        <div class="dd-topbar-actions">
          <button type="button" class="btn-topbar-action d-none d-sm-inline-flex" onclick="openGeminiScanner()" title="Scan Bukti Invoice dengan AI">
            <i class="fas fa-magic text-warning"></i>
            <span>Scan AI</span>
          </button>
          <button type="button" class="btn-topbar-action d-none d-md-inline-flex" data-bs-toggle="modal" data-bs-target="#modalGeminiKey" title="Konfigurasi Gemini API Key">
            <i class="fas fa-key text-warning"></i>
            <span>API Key</span>
          </button>
          <button type="button" class="btn-topbar-action d-none d-lg-inline-flex" data-bs-toggle="modal" data-bs-target="#modalExportKustom" title="Export Rekap Belanja">
            <i class="fas fa-file-export text-primary"></i>
            <span>Export</span>
          </button>
          <button type="button" class="btn-drive-upload" data-bs-toggle="modal" data-bs-target="#modalTambah" title="Catat Pengeluaran Belanja IT">
            <i class="fas fa-plus"></i>
            <span>Catat Belanja</span>
          </button>
        </div>
      </div>

      <!-- Executive Header (Anti-Slop Framed Sheet) -->
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3 pt-1">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge py-1 px-2" style="background: rgba(22, 101, 52, 0.08); color: #166534; border: 1px solid rgba(22, 101, 52, 0.2); border-radius: 4px; font-weight: 700; font-size: 10.5px; letter-spacing: 0.04em;">
              INFRASTRUKTUR &amp; DIGITAL
            </span>
            <span class="text-muted" style="font-size: 12px;">&bull;</span>
            <span class="text-muted" style="font-size: 12px;"><%= expenses.length %> Nota Pembelian IT</span>
          </div>
          <h1 class="h4 mb-0 fw-bold" style="color: var(--dd-text-primary, #0f172a); letter-spacing: -0.015em;">
            Sentral Anggaran &amp; Pemeliharaan IT Outlet
          </h1>
        </div>

        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn-kov-outline" onclick="openGeminiScanner()" title="Scan Bukti Invoice dengan AI">
            <i class="fas fa-magic text-warning"></i>
            <span>Scan AI</span>
          </button>
          <button type="button" class="btn-kov-outline" data-bs-toggle="modal" data-bs-target="#modalExportKustom" title="Export Rekap Belanja">
            <i class="fas fa-file-export text-primary"></i>
            <span>Export Rekap</span>
          </button>
          <button type="button" class="btn-dd-hero" data-bs-toggle="modal" data-bs-target="#modalTambah" title="Catat Pengeluaran Belanja IT">
            <i class="fas fa-plus"></i>
            <span>Catat Belanja</span>
          </button>
        </div>
      </div>

      <!-- Executive KPI Metric Strip (Taste-Skill Framed Sheet) -->
      <div class="kov-kpi-strip mb-3">
        <div class="kov-kpi-cell" role="button" title="Total Seluruh Belanja IT">
          <div class="kov-kpi-cell-label">Total Belanja IT <i class="fas fa-wallet opacity-50"></i></div>
          <div class="kov-kpi-cell-val" style="color: var(--dd-primary, #166534);">Rp <%= totalPengeluaran.toLocaleString('id-ID') %></div>
          <div class="kov-kpi-cell-sub">Seluruh outlet KOV</div>
        </div>
        <div class="kov-kpi-cell" role="button" title="Pengeluaran Bulan Ini">
          <div class="kov-kpi-cell-label">Bulan Ini <i class="fas fa-calendar-check opacity-50"></i></div>
          <div class="kov-kpi-cell-val text-primary">Rp <%= pengeluaranBulanIni.toLocaleString('id-ID') %></div>
          <div class="kov-kpi-cell-sub"><%= new Date().toLocaleString('id-ID', { month: 'short', year: 'numeric' }) %></div>
        </div>
        <div class="kov-kpi-cell" role="button" title="Total Seluruh Nota IT">
          <div class="kov-kpi-cell-label">Total Nota <i class="fas fa-receipt opacity-50"></i></div>
          <div class="kov-kpi-cell-val"><%= expenses.length %> <span style="font-size: 0.95rem; font-weight: 500; color: #64748b;">Nota</span></div>
          <div class="kov-kpi-cell-sub">Belanja vendor IT tercatat</div>
        </div>
        <div class="kov-kpi-cell" role="button" title="Nota Pending Verifikasi">
          <div class="kov-kpi-cell-label">Pending Verifikasi <i class="fas fa-clock opacity-50"></i></div>
          <div class="kov-kpi-cell-val text-warning"><%= totalPending %> <span style="font-size: 0.95rem; font-weight: 500; color: #64748b;">Nota</span></div>
          <div class="kov-kpi-cell-sub">Perlu audit berkas</div>
        </div>
      </div>

    <% 
      const defaultOutlets = ['Kantor Pusat Semarang', 'KOV Lab Semarang', 'Outlet Pekalongan', 'Outlet Rinjani', 'Outlet Semarang', 'Outlet Ngaliyan', 'Outlet Purwokerto', 'Outlet Solo'];
      const allOutletKeys = Array.from(new Set([...defaultOutlets, ...(outletList || [])]));
    %>

    <!-- Unified Filter, Outlet Tabs & Action Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
      <div class="p-3 border-bottom">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
          
          <!-- Baris 1: Segmented Outlet Pills -->
          <div class="outlet-filter-bar">
            <span class="small fw-bold text-muted me-1"><i class="fas fa-store text-success me-1"></i>Outlet:</span>
            <button type="button" class="btn-outlet active" onclick="selectOutletFilter('ALL', this)">
              <span>Semua</span>
              <span class="badge-count"><%= expenses.length %></span>
            </button>
            <% allOutletKeys.forEach(outletName => { 
                 const oStat = outletStats[outletName] || { count: 0, total: 0 };
                 const shortName = outletName.replace('Outlet ', '');
            %>
              <button type="button" class="btn-outlet" onclick="selectOutletFilter('<%= outletName %>', this)">
                <span><%= shortName %></span>
                <% if (oStat.count > 0) { %>
                  <span class="badge-count"><%= oStat.count %></span>
                <% } %>
              </button>
            <% }); %>
          </div>

          <!-- Quick Export Buttons -->
          <div class="btn-group btn-group-sm">
            <button type="button" class="btn btn-outline-success fw-semibold" onclick="exportReport('excel')" title="Export Excel sesuai filter">
              <i class="fas fa-file-excel me-1"></i><span id="btnTextExportExcel">Excel (Semua)</span>
            </button>
            <button type="button" class="btn btn-outline-danger fw-semibold" onclick="exportReport('pdf')" title="Cetak PDF sesuai filter">
              <i class="fas fa-file-pdf me-1"></i><span id="btnTextExportPdf">PDF (Semua)</span>
            </button>
            <button type="button" class="btn btn-outline-secondary fw-semibold" data-bs-toggle="modal" data-bs-target="#modalExportKustom">
              <i class="fas fa-sliders-h me-1"></i>Opsi
            </button>
          </div>
        </div>
      </div>

      <!-- Baris 2: Search, Date, Vendor, Category & Status Inputs -->
      <div class="p-3 bg-light bg-opacity-50">
        <div class="row g-2 align-items-center">
          <div class="col-12 col-md-3">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-search"></i></span>
              <input type="text" id="searchInput" class="form-control border-start-0 ps-0" placeholder="Cari barang, nota, vendor..." aria-label="Cari barang, nomor nota, atau vendor">
            </div>
          </div>
          <div class="col-6 col-md-2">
            <select id="filterVendor" class="form-select form-select-sm" aria-label="Filter berdasarkan Vendor">
              <option value="">Semua Vendor</option>
              <% if (typeof vendorList !== 'undefined') { %>
                <% vendorList.forEach(v => { %>
                  <option value="<%= v %>"><%= v %></option>
                <% }); %>
              <% } %>
            </select>
          </div>
          <div class="col-6 col-md-2">
            <input type="date" id="filterStartDate" class="form-control form-control-sm" title="Dari Tanggal" aria-label="Filter mulai dari tanggal">
          </div>
          <div class="col-6 col-md-2">
            <input type="date" id="filterEndDate" class="form-control form-control-sm" title="Sampai Tanggal" aria-label="Filter sampai dengan tanggal">
          </div>
          <div class="col-6 col-md-2">
            <select id="filterKategori" class="form-select form-select-sm" aria-label="Filter berdasarkan Kategori Belanja IT">
              <option value="">Semua Kategori</option>
              <option value="Jaringan & Network">Jaringan & Network</option>
              <option value="Hardware & Komputer">Hardware & Komputer</option>
              <option value="CCTV & Keamanan">CCTV & Keamanan</option>
              <option value="Software & Lisensi">Software & Lisensi</option>
              <option value="Perawatan & Service">Perawatan & Service</option>
              <option value="Aksesoris & Peripheral">Aksesoris & Peripheral</option>
              <option value="Operasional & Lainnya">Operasional & Lainnya</option>
            </select>
          </div>
          <div class="col-6 col-md-1">
            <select id="filterStatus" class="form-select form-select-sm" title="Status Pembayaran" aria-label="Filter berdasarkan Status Pembayaran">
              <option value="">Status</option>
              <option value="Lunas">Lunas</option>
              <option value="Pending">Pending</option>
              <option value="Reimburse">Reimb.</option>
            </select>
          </div>
          <div class="col-6 col-md-12 col-lg-auto text-end ms-auto">
            <button id="btnResetFilter" class="btn btn-outline-secondary btn-sm px-3" title="Reset filter">
              <i class="fas fa-undo me-1"></i>Reset
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Filter Banner (Provides instant clarity & 1-click restore) -->
    <div id="itFilterAlert" class="alert alert-warning border-0 shadow-sm rounded-4 py-2 px-3 mb-3 d-none align-items-center justify-content-between flex-wrap gap-2">
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-warning text-dark"><i class="fas fa-filter me-1"></i>Filter Aktif</span>
        <span id="itFilterAlertText" class="small fw-semibold text-dark"></span>
      </div>
      <button type="button" class="btn btn-sm btn-dark rounded-pill px-3 py-1 shadow-none" onclick="resetAllITFilters()">
        <i class="fas fa-rotate-left me-1"></i>Tampilkan Semua Data (<span id="itFilterTotalBadge"><%= expenses.length %></span>)
      </button>
    </div>

    <!-- PO Highlight Info Banner -->
    <div id="itHighlightAlert" class="alert alert-emerald border-0 shadow-sm rounded-4 py-2.5 px-3 mb-3 d-none align-items-center justify-content-between flex-wrap gap-2" style="background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); border: 1px solid #a7f3d0 !important;">
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success text-white rounded-pill px-2.5 py-1"><i class="fas fa-check-circle me-1"></i>PO Terpilih</span>
        <span id="itHighlightAlertText" class="small fw-semibold text-emerald-dark"></span>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 shadow-none" onclick="dismissHighlightAlert()">
          <i class="fas fa-check me-1"></i>Selesai Dilihat
        </button>
      </div>
    </div>

    <!-- Modern Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-5">
      <div class="table-responsive">
        <table class="table kov-table align-middle mb-0" id="expensesTable">
          <thead>
            <tr>
              <th class="ps-4" style="width: 45px;">No</th>
              <th style="width: 150px;">No Transaksi & Tgl</th>
              <th style="width: 180px;">Outlet / Unit</th>
              <th style="width: 180px;">Vendor & Metode</th>
              <th>Rincian Barang Belanjaan (Multi-Item)</th>
              <th class="text-end" style="width: 150px;">Total (Rp)</th>
              <th class="text-center" style="width: 120px;">Status</th>
              <th class="text-center pe-4" style="width: 90px;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (expenses.length === 0) { %>
              <tr>
                <td colspan="8" class="text-center py-5 text-muted">
                  <div class="bg-light p-3 rounded-circle d-inline-flex mb-3">
                    <i class="fas fa-shopping-bag fa-2x text-muted opacity-50"></i>
                  </div>
                  <h6 class="fw-bold text-dark">Belum ada catatan belanja IT yang tersimpan</h6>
                  <p class="small text-muted mb-3">Mulai catat pembelanjaan infrastruktur, software, atau service outlet.</p>
                  <button class="btn btn-success btn-sm fw-semibold rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalTambah">
                    <i class="fas fa-plus me-1"></i>Catat Belanja Sekarang
                  </button>
                </td>
              </tr>
            <% } %>

            <% expenses.forEach((nota, index) => { %>
              <tr class="expense-row" 
                  id="expense-row-<%= nota.id %>"
                  data-id="<%= nota.id %>"
                  data-no-transaksi="<%= (nota.no_transaksi || '').trim() %>"
                  data-outlet="<%= nota.unit_outlet %>" 
                  data-status="<%= nota.status_bayar %>" 
                  data-tanggal="<%= nota.tanggal %>"
                  data-vendor="<%= (nota.vendor_toko || '').toLowerCase() %>"
                  data-search="<%= (nota.no_transaksi + ' ' + nota.unit_outlet + ' ' + (nota.vendor_toko || '') + ' ' + (nota.bukti_transaksi || '') + ' ' + nota.parsedItems.map(i => i.nama + ' ' + i.kategori).join(' ')).toLowerCase() %>">
                <td class="ps-4 text-muted small fw-bold"><%= index + 1 %></td>
                <td>
                  <div class="d-flex align-items-center gap-1 flex-wrap mb-1">
                    <% if (nota.no_transaksi && (nota.no_transaksi.startsWith('PO/') || (nota.bukti_transaksi && nota.bukti_transaksi.includes('/po/detail/')))) { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-0.5 fw-semibold" style="font-size: 0.72rem;">
                        <i class="fas fa-file-invoice-dollar me-1"></i>PO
                      </span>
                    <% } %>
                    <span class="fw-bold text-success font-monospace small"><%= nota.no_transaksi %></span>
                  </div>
                  <div class="text-muted small"><i class="fas fa-calendar-alt me-1 text-secondary"></i><%= formatDate(nota.tanggal) %></div>
                  <% if (nota.bukti_transaksi) { %>
                    <div class="mt-1">
                      <% 
                        const bt = (nota.bukti_transaksi || '').trim();
                        let targetLink = '';
                        let isPO = bt.includes('/po/detail/') || (nota.no_transaksi && nota.no_transaksi.startsWith('PO/'));
                        if (bt.startsWith('http://') || bt.startsWith('https://')) {
                          targetLink = bt;
                        } else if (bt.includes('inv-')) {
                          const safeFile = bt.split(/[\\/]/).pop();
                          targetLink = '/api/it/invoices/download/' + encodeURIComponent(safeFile);
                        } else if (bt.startsWith('/')) {
                          targetLink = bt;
                        }
                      %>
                      <% if (targetLink) { %>
                        <a href="<%= targetLink %>" target="_blank" rel="noopener noreferrer" class="badge <%= isPO ? 'bg-primary-subtle text-primary border border-primary-subtle' : 'bg-light text-primary border' %> small text-decoration-none" title="Lihat <%= isPO ? 'Dokumen PO' : 'Bukti Transaksi' %>">
                          <i class="fas <%= isPO ? 'fa-external-link-alt' : 'fa-file-invoice' %> <%= isPO ? 'text-primary' : 'text-success' %> me-1"></i><%= isPO ? 'Buka PO' : 'Bukti Nota' %>
                        </a>
                      <% } else { %>
                        <span class="badge bg-light text-secondary border small" title="<%= bt %>">
                          <i class="fas fa-receipt me-1"></i><%= bt %>
                        </span>
                      <% } %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <span class="badge bg-emerald-subtle text-emerald-dark px-2 py-1 rounded-pill fw-semibold" style="font-size: 0.8rem;">
                    <i class="fas fa-store me-1"></i><%= nota.unit_outlet %>
                  </span>
                  <% if (nota.keterangan) { %>
                    <div class="small text-muted mt-1 fst-italic">
                      <i class="fas fa-info-circle me-1 text-secondary"></i><%= nota.keterangan %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <div class="fw-bold text-dark"><i class="fas fa-shop text-success me-1"></i><%= nota.vendor_toko || '-' %></div>
                  <div class="small text-muted mt-1"><%= nota.metode_bayar || 'Transfer Bank' %></div>
                </td>
                <td>
                  <!-- Multi-Item List -->
                  <div class="mb-1 d-flex justify-content-between align-items-center">
                    <span class="badge bg-light text-dark border small fw-semibold">
                      <i class="fas fa-boxes-stacked me-1 text-success"></i><%= nota.parsedItems.length %> Item Belanja
                    </span>
                  </div>

                  <% nota.parsedItems.forEach((it, itIdx) => { %>
                    <div class="item-pill-row d-flex justify-content-between align-items-center">
                      <div>
                        <strong class="text-dark"><%= itIdx + 1 %>. <%= it.nama %></strong>
                        <span class="badge <%= getBadgeKat(it.kategori) %> ms-1 py-0 px-2">
                          <%= it.kategori %>
                        </span>
                      </div>
                      <div class="text-end ps-2">
                        <span class="text-muted small"><%= it.qty %> <%= it.satuan || 'Unit' %> &times; <%= Number(it.harga || 0).toLocaleString('id-ID') %> = </span>
                        <span class="text-success fw-bold font-monospace">Rp <%= Number(it.subtotal || (it.qty * it.harga)).toLocaleString('id-ID') %></span>
                      </div>
                    </div>
                  <% }); %>
                </td>
                <td class="text-end">
                  <div class="fs-6 fw-bold text-success font-monospace">
                    Rp <%= Number(nota.total_biaya).toLocaleString('id-ID') %>
                  </div>
                </td>
                <td class="text-center">
                  <% if (nota.status_bayar === 'Lunas') { %>
                    <span class="status-pill-modern pill-success"><span class="status-dot-pulse"></span>Lunas</span>
                  <% } else if (nota.status_bayar === 'Reimburse') { %>
                    <span class="status-pill-modern pill-purple"><span class="status-dot-pulse"></span>Reimburse</span>
                  <% } else { %>
                    <span class="status-pill-modern pill-warning"><span class="status-dot-pulse"></span>Pending</span>
                  <% } %>
                </td>
                <td class="text-center pe-4">
                  <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-primary btn-sm rounded-start-pill py-1 px-2" title="Edit Transaksi" onclick="openEditModal(<%= nota.id %>)">
                      <i class="fas fa-edit"></i>
                    </button>
                    <form action="/api/it/expenses/delete/<%= nota.id %>" method="POST" class="d-inline" onsubmit="return confirm('Yakin hapus transaksi <%= nota.no_transaksi %>?');">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-outline-danger btn-sm rounded-end-pill py-1 px-2" title="Hapus">
                        <i class="fas fa-trash-alt"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

  <!-- MODAL 1: CATAT BELANJA BARU (MULTI-ITEM) -->
  <div class="modal fade" id="modalTambah" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
      <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
        <form action="/api/it/expenses" method="POST" onsubmit="return prepareSubmitItems('tambah')">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="modal-header bg-dark text-white py-3 px-4">
            <h5 class="modal-title fw-bold fs-6 text-white d-flex align-items-center gap-2">
              <i class="fas fa-cart-plus text-success"></i>Catat Belanja Baru (Multi-Item per Outlet)
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body p-4">
            
            <!-- AI INVOICE SCANNER BOX -->
            <div id="aiScannerBox" class="ai-scanner-panel p-3 mb-4 shadow-sm">
              <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <div class="d-flex align-items-center gap-2">
                  <span class="badge rounded-pill text-white px-2 py-1 shadow-sm" style="background-color: #064e3b;">
                    <i class="fas fa-magic me-1 text-warning"></i>Smart AI Scanner
                  </span>
                  <strong class="text-success small"><i class="fas fa-file-invoice me-1"></i>Input Otomatis via Foto Struk / Nota PDF</strong>
                </div>
                <span class="badge bg-success bg-opacity-20 text-success border border-success border-opacity-25 small">
                  <i class="fas fa-check-circle me-1"></i>Ekstraksi Cepat &bull; Auto Item
                </span>
              </div>

              <p class="text-muted small mb-2" style="font-size: 11px;">
                Unggah foto struk belanja, nota toko, atau faktur PDF. AI akan memindai secara otomatis: No Nota, Tanggal, Vendor, dan rincian multi-item ke tabel di bawah ini.
              </p>

              <div class="row g-2 align-items-center">
                <div class="col-md-9">
                  <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white text-muted"><i class="fas fa-upload text-success"></i></span>
                    <input type="file" id="aiInvoiceFileInput" class="form-control" accept="image/*,application/pdf">
                  </div>
                </div>
                <div class="col-md-3">
                  <button type="button" id="btnRunAiScan" class="btn btn-success btn-sm w-100 fw-bold shadow-sm rounded-pill" onclick="processInvoiceWithAI()">
                    <i class="fas fa-robot me-1"></i>Scan & Ekstrak Data
                  </button>
                </div>
              </div>

              <!-- Scanning Progress -->
              <div id="aiScanLoading" class="mt-2 p-2 rounded bg-white border small text-success fw-semibold d-none">
                <div class="d-flex align-items-center">
                  <div class="spinner-border spinner-border-sm text-success me-2" role="status"></div>
                  <div>
                    <span>AI Scanner sedang membaca & menganalisis dokumen nota...</span>
                    <div class="text-muted fw-normal small" style="font-size: 10.5px;">Mengekstrak rincian barang, harga, vendor, dan metode bayar. Mohon tunggu...</div>
                  </div>
                </div>
              </div>

              <!-- Result Alerts -->
              <div id="aiScanSuccess" class="alert alert-success border-0 py-2 px-3 mt-2 mb-0 small d-none shadow-sm">
                <i class="fas fa-check-circle me-1"></i><span id="aiSuccessMessage"></span>
              </div>
              <div id="aiScanError" class="alert alert-danger border-0 py-2 px-3 mt-2 mb-0 small d-none shadow-sm">
                <i class="fas fa-exclamation-triangle me-1"></i><span id="aiErrorMessage"></span>
              </div>
            </div>

            <!-- Header Nota Form -->
            <div class="row g-3 mb-4 p-3 rounded-3 bg-light border">
              <div class="col-md-4">
                <label class="form-label small fw-bold text-dark"><i class="fas fa-store text-success me-1"></i>Outlet / Unit Tujuan <span class="text-danger">*</span></label>
                <select name="unit_outlet" id="tambahOutlet" class="form-select form-select-sm" required>
                  <option value="Kantor Pusat Semarang">Kantor Pusat Semarang</option>
                  <option value="KOV Lab Semarang">KOV Lab Semarang</option>
                  <option value="Outlet Pekalongan">Outlet Pekalongan</option>
                  <option value="Outlet Rinjani">Outlet Rinjani</option>
                  <option value="Outlet Semarang">Outlet Semarang</option>
                  <option value="Outlet Ngaliyan">Outlet Ngaliyan</option>
                  <option value="Outlet Purwokerto">Outlet Purwokerto</option>
                  <option value="Outlet Solo">Outlet Solo</option>
                  <option value="All Outlet / Umum">All Outlet / Umum</option>
                </select>
              </div>

              <div class="col-md-4">
                <label class="form-label small fw-bold text-dark"><i class="fas fa-shop text-success me-1"></i>Nama Vendor / Toko <span class="text-danger">*</span></label>
                <input type="text" name="vendor_toko" id="tambahVendor" class="form-control form-control-sm" placeholder="Tokopedia, Shopee, Agres Komputer..." required>
              </div>

              <div class="col-md-4">
                <label class="form-label small fw-semibold text-secondary"><i class="fas fa-calendar me-1"></i>Tanggal Belanja</label>
                <input type="date" name="tanggal" id="tambahTanggal" class="form-control form-control-sm" value="<%= new Date().toISOString().slice(0, 10) %>" required>
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Metode Bayar</label>
                <select name="metode_bayar" id="tambahMetode" class="form-select form-select-sm">
                  <option value="Transfer Bank" selected>Transfer Bank</option>
                  <option value="Petty Cash / Tunai">Petty Cash / Tunai</option>
                  <option value="Reimburse">Reimburse (Dana Talangan)</option>
                  <option value="Kartu Kredit">Kartu Kredit Perusahaan</option>
                  <option value="Tempo / Invoice">Tempo / Invoice</option>
                </select>
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Status Pembayaran</label>
                <select name="status_bayar" id="tambahStatus" class="form-select form-select-sm">
                  <option value="Lunas" selected>Lunas</option>
                  <option value="Pending">Pending / Proses</option>
                  <option value="Reimburse">Reimburse</option>
                </select>
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">No. Nota / Bukti Transaksi</label>
                <input type="text" name="bukti_transaksi" id="tambahBukti" class="form-control form-control-sm" placeholder="INV-202610-XXX / Link Bukti">
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-secondary">Keterangan / Keperluan</label>
                <input type="text" name="keterangan" id="tambahKeterangan" class="form-control form-control-sm" placeholder="Peremajaan IT, kasir, dll">
              </div>
            </div>

            <!-- Dynamic Multi-Item Section -->
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h6 class="fw-bold text-dark mb-0 fs-6">
                <i class="fas fa-list-check text-success me-2"></i>Daftar Barang Belanjaan
              </h6>
              <button type="button" class="btn btn-outline-success btn-sm fw-bold rounded-pill" onclick="addDynamicItemRow('tambah')">
                <i class="fas fa-plus me-1"></i>Tambah Baris
              </button>
            </div>

            <div class="table-responsive">
              <table class="table table-bordered align-middle mb-2 bg-white" id="tableItemsTambah">
                <thead class="table-light small text-secondary text-uppercase">
                  <tr>
                    <th style="width: 4%;">No</th>
                    <th style="width: 38%;">Nama Barang / Kebutuhan IT <span class="text-danger">*</span></th>
                    <th style="width: 18%;">Kategori</th>
                    <th style="width: 8%;">Qty</th>
                    <th style="width: 9%;">Satuan</th>
                    <th style="width: 15%;">Harga Satuan (Rp)</th>
                    <th style="width: 15%;">Subtotal (Rp)</th>
                    <th style="width: 4%;" class="text-center">Hapus</th>
                  </tr>
                </thead>
                <tbody id="tbodyItemsTambah">
