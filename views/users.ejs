<head>
  <!-- Security: Masking Address Bar agar direktori internal tidak terekspos -->
  <script>
    (function() {
      try {
        if (window.history && window.history.replaceState) {
          window.history.replaceState(null, document.title, '/');
        }
      } catch (e) {}
    })();
  </script>


  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kelola User - KOV Portal</title>
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
  <style>
    :root {
      --kov-emerald: #059669;
      --kov-slate-900: #0f172a;
      --kov-slate-800: #1e293b;
      --kov-border: #e2e8f0;
    }
    * {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    body { background-color: #f8fafc; color: #1e293b; }
    .top-navbar {
      background: #0f172a;
      border-bottom: 1px solid #1e293b;
      padding: 0.75rem 1.5rem;
    }
    .card {
      border: 1px solid var(--kov-border);
      border-radius: 14px;
      box-shadow: 0 1px 3px 0 rgba(0,0,0,0.04);
      background: #ffffff;
    }
    .badge-superadmin { background-color: #7c3aed; color: white; }
    .badge-admin { background-color: #0284c7; color: white; }
    .badge-operasional { background-color: #059669; color: white; }
    .badge-it { background-color: #0891b2; color: white; }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="top-navbar shadow-sm">
    <div class="container-fluid px-2 d-flex flex-wrap align-items-center justify-content-between gap-2">
      <div class="d-flex align-items-center gap-2">
        <a href="/admin" class="btn btn-outline-light btn-sm fw-semibold">
          <i class="fas fa-arrow-left me-1"></i> Dashboard HR
        </a>
        <span class="text-white fw-bold fs-6 ms-2">
          <i class="fas fa-users-gear text-warning me-2"></i>Kelola User & Hak Akses
        </span>
      </div>
      <div class="d-flex align-items-center gap-2">
        <% if (typeof user !== 'undefined' && user) { %>
          <span class="text-white-50 me-2 small">
            <i class="fas fa-circle-user me-1 text-light"></i><%= user.nama || user.username %> (<%= user.role %>)
          </span>
        <% } %>
        <a href="/admin/logout" onclick="sessionStorage.clear();" class="btn btn-outline-danger btn-sm fw-semibold text-white border-secondary">
          <i class="fas fa-arrow-right-from-bracket me-1"></i>Logout
        </a>
      </div>
    </div>
  </nav>

  <div class="container py-4">

    <!-- Alert Messages -->
    <% if (success) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i> <%= success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4 shadow-sm" role="alert">
        <i class="fas fa-exclamation-circle me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% } %>

    <div class="row g-4">
      <!-- Create User Card -->
      <div class="col-lg-4">
        <div class="card h-100">
          <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-bold text-primary">
              <i class="fas fa-user-plus me-2"></i>Tambah User Baru
            </h5>
          </div>
          <div class="card-body p-4">
            <form action="/admin/users/create" method="POST">
              <div class="mb-3">
                <label for="username" class="form-label fw-semibold small">Username</label>
                <input type="text" class="form-control" id="username" name="username" placeholder="Masukkan username" required>
              </div>

              <div class="mb-3">
                <label for="nama" class="form-label fw-semibold small">Nama Lengkap</label>
                <input type="text" class="form-control" id="nama" name="nama" placeholder="Masukkan nama pengguna" required>
              </div>

              <div class="mb-3">
                <label for="password" class="form-label fw-semibold small">Password</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="Masukkan password" required>
              </div>

              <div class="mb-4">
                <label for="role" class="form-label fw-semibold small">Role / Hak Akses</label>
                <select class="form-select" id="role" name="role" required>
                  <option value="admin" selected>Admin HR (Kelola Candidates)</option>
                  <option value="operasional">Admin Operasional (BA, PO & Surat Tugas)</option>
                  <option value="it">Khusus IT (Rekap Pembelanjaan - Maks 1 Akun)</option>
                  <option value="superadmin">Super Admin (Kelola Seluruh Sistem & Users)</option>
                </select>
              </div>

              <button type="submit" class="btn btn-primary w-100 fw-semibold">
                <i class="fas fa-save me-2"></i>Simpan User Baru
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Users List Table Card -->
      <div class="col-lg-8">
        <div class="card h-100">
          <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-secondary">
              <i class="fas fa-users me-2"></i>Daftar Pengguna Sistem (<%= users.length %>)
            </h5>
          </div>
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="ps-4">ID</th>
                    <th>Username</th>
                    <th>Nama Lengkap</th>
                    <th>Role</th>
                    <th>Tgl Dibuat</th>
                    <th class="text-center pe-4">Aksi</th>
                  </tr>
                </thead>
                <tbody>
                  <% users.forEach(u => { %>
                    <tr>
                      <td class="ps-4 fw-bold">#<%= u.id %></td>
                      <td class="fw-semibold text-dark">@<%= u.username %></td>
                      <td><%= u.nama || '-' %></td>
                      <td>
                        <% if (u.role === 'superadmin') { %>
                          <span class="badge badge-superadmin px-2 py-1"><i class="fas fa-crown me-1"></i>Super Admin</span>
                        <% } else if (u.role === 'operasional' || u.role === 'admin_operasional') { %>
                          <span class="badge bg-success px-2 py-1"><i class="fas fa-truck-ramp-box me-1"></i>Operasional</span>
                        <% } else if (u.role === 'it') { %>
                          <span class="badge bg-dark border border-info text-info px-2 py-1"><i class="fas fa-laptop-code me-1"></i>Khusus IT (1 Akun)</span>
                        <% } else { %>
                          <span class="badge badge-admin px-2 py-1"><i class="fas fa-user-tag me-1"></i>Admin HR</span>
                        <% } %>
                      </td>
                      <td class="small text-muted"><%= formatDate(u.created_at, true) %></td>
                      <td class="text-center pe-4">
                        <% if (u.id === user.id) { %>
                          <span class="badge bg-light text-muted border px-2 py-1 small">Akun Anda</span>
                        <% } else { %>
                          <form action="/admin/users/delete/<%= u.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus user @<%= u.username %>?')" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Hapus User">
                              <i class="fas fa-trash-alt me-1"></i>Hapus
                            </button>
                          </form>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
