<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kelola User &amp; Hak Akses Reviewer - KOV Portal</title>
  <link rel="icon" type="image/jpeg" href="/logo_kov_2.jpg">
  <!-- Google Fonts: Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets/vendor/fontawesome/css/all.min.css" rel="stylesheet">
  <link href="/assets/css/kov-portal.css" rel="stylesheet">
</head>
<body>

  <div class="dd-layout-root kov-app-shell">
    <%- include('partials/sidebar', { active: 'users', user: typeof user !== 'undefined' ? user : null }) %>

    <main class="dd-main-canvas kov-main-content dd-theme">
      <!-- Top Search & View Action Bar (Dribbble Signature - Symmetrical 46px Row) -->
      <div class="dd-topbar kov-topbar">
        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
          <button type="button" class="kov-mobile-toggle-btn d-lg-none" onclick="toggleKovSidebar()" aria-label="Buka Menu">
            <i class="fas fa-bars"></i>
          </button>
          <div class="dd-search-container">
            <i class="fas fa-magnifying-glass dd-search-icon"></i>
            <input type="text" class="dd-search-input" id="userSearchInput" placeholder="Cari username, nama lengkap, atau role pengguna..." aria-label="Cari Pengguna" onkeyup="filterUserTable()">
          </div>
        </div>

        <div class="dd-topbar-actions">
          <a href="#createForm" class="btn-drive-upload" title="Tambah Pengguna Baru">
            <i class="fas fa-user-plus"></i>
            <span>Tambah Pengguna</span>
          </a>
        </div>
      </div>

      <!-- Alert Messages -->
      <% if (success) { %>
        <div class="alert alert-success alert-dismissible fade show mb-3 rounded-3 shadow-xs" role="alert">
          <i class="fas fa-circle-check me-2"></i> <%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>
      <% if (error) { %>
        <div class="alert alert-danger alert-dismissible fade show mb-3 rounded-3 shadow-xs" role="alert">
          <i class="fas fa-circle-exclamation me-2"></i> <%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <!-- Welcome Hero Banner (Dribbble Signature) -->
      <div class="dd-hero-banner mb-3">
        <div class="dd-hero-content">
          <h2 class="dd-hero-title">
            Welcome Back, <%= (typeof user !== 'undefined' && user && (user.nama || user.username)) ? (user.nama || user.username) : 'Super Admin' %>! 👋
          </h2>
          <p class="dd-hero-subtitle">
            Pusat Manajemen Akun, Hak Akses &amp; Penugasan Reviewer Divisi KOV Management. Konfigurasikan otorisasi modul dan wewenang pengguna.
          </p>
          <div class="d-flex align-items-center gap-2 flex-nowrap overflow-x-auto">
            <a href="#createForm" class="btn-dd-hero text-nowrap">
              <i class="fas fa-user-plus me-1"></i> Tambah Pengguna Baru
            </a>
            <span class="badge rounded-pill bg-white text-dark border px-3 py-1.5 fw-bold shadow-xs text-nowrap" style="font-size: 0.8rem;">
              <i class="fas fa-users text-primary me-1"></i> <%= (users || []).length %> Total Akun Aktif
            </span>
          </div>
        </div>
      <div class="dd-hero-illustration d-none d-lg-flex">
        <svg width="220" height="140" viewBox="0 0 240 160" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="20" y="20" width="160" height="110" rx="14" fill="#5a60ea" fill-opacity="0.08" stroke="#5a60ea" stroke-width="2" stroke-dasharray="4 4"/>
          <rect x="36" y="36" width="128" height="78" rx="10" fill="#ffffff" stroke="#5a60ea" stroke-width="1.5"/>
          <path d="M100 60 L100 86 M90 70 L100 60 L110 70" stroke="#059669" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="170" cy="46" r="14" fill="#f6941e"/>
          <circle cx="176" cy="116" r="24" fill="#5a60ea"/>
          <rect x="154" y="96" width="36" height="36" rx="8" fill="#ee474e" transform="rotate(12 154 96)"/>
        </svg>
      </div>
    </div>

    <!-- Kategori Role Pengguna (4 Symmetrical Dribbble Folder Cards) -->
    <div class="dd-section-header mb-3">
      <div class="d-flex align-items-center gap-2">
        <h3 class="dd-section-title">Distribusi Role &amp; Wewenang Akun</h3>
        <span class="badge rounded-pill" style="background: rgba(90, 96, 234, 0.12); color: var(--dd-primary, #5a60ea); font-size: 0.76rem; font-weight: 700; padding: 4px 10px;">
          <%= (users || []).length %> Pengguna
        </span>
      </div>
    </div>

    <div class="dd-folders-grid mb-4" style="grid-template-columns: repeat(4, 1fr);">
      <!-- 1. Super Admin (Rose Crimson) -->
      <div class="dd-folder-card dd-folder-rose folder-rose">
        <div class="dd-folder-top">
          <div class="dd-folder-icon"><i class="fas fa-shield-halved"></i></div>
          <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
        </div>
        <div class="dd-folder-body">
          <h4 class="dd-folder-name">Super Admin</h4>
          <div class="dd-avatar-group">
            <span class="dd-avatar-chip">SA</span>
            <span class="dd-avatar-chip dd-avatar-chip-more">+<%= (users || []).filter(u => (u.role || '').toLowerCase().includes('superadmin')).length %></span>
          </div>
        </div>
        <div class="dd-folder-footer">
          <span class="dd-file-count"><i class="far fa-user"></i> <%= (users || []).filter(u => (u.role || '').toLowerCase().includes('superadmin')).length %> Akun</span>
          <span class="dd-file-weight"><i class="fas fa-lock"></i> Full Akses</span>
        </div>
      </div>

      <!-- 2. Admin HR (Violet Purple) -->
      <div class="dd-folder-card dd-folder-violet folder-violet">
        <div class="dd-folder-top">
          <div class="dd-folder-icon"><i class="fas fa-user-tie"></i></div>
          <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
        </div>
        <div class="dd-folder-body">
          <h4 class="dd-folder-name">Admin HR</h4>
          <div class="dd-avatar-group">
            <span class="dd-avatar-chip">HR</span>
            <span class="dd-avatar-chip dd-avatar-chip-more">+<%= (users || []).filter(u => (u.role || '').toLowerCase() === 'admin').length %></span>
          </div>
        </div>
        <div class="dd-folder-footer">
          <span class="dd-file-count"><i class="far fa-user"></i> <%= (users || []).filter(u => (u.role || '').toLowerCase() === 'admin').length %> Akun</span>
          <span class="dd-file-weight"><i class="fas fa-users-gear"></i> Rekrutmen</span>
        </div>
      </div>

      <!-- 3. Reviewer Divisi (Amber Gold) -->
      <div class="dd-folder-card dd-folder-amber folder-amber">
        <div class="dd-folder-top">
          <div class="dd-folder-icon"><i class="fas fa-user-check"></i></div>
          <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
        </div>
        <div class="dd-folder-body">
          <h4 class="dd-folder-name">Reviewer Divisi</h4>
          <div class="dd-avatar-group">
            <span class="dd-avatar-chip">RV</span>
            <span class="dd-avatar-chip dd-avatar-chip-more">+<%= (users || []).filter(u => (u.role || '').toLowerCase().includes('user')).length %></span>
          </div>
        </div>
        <div class="dd-folder-footer">
          <span class="dd-file-count"><i class="far fa-user"></i> <%= (users || []).filter(u => (u.role || '').toLowerCase().includes('user')).length %> Akun</span>
          <span class="dd-file-weight"><i class="fas fa-pen-to-square"></i> Penilai</span>
        </div>
      </div>

      <!-- 4. Tim Operasional (Royal Sky) -->
      <div class="dd-folder-card dd-folder-royal folder-blue active">
        <div class="dd-folder-top">
          <div class="dd-folder-icon"><i class="fas fa-boxes-packing"></i></div>
          <button type="button" class="dd-folder-menu" aria-label="Menu Opsi"><i class="fas fa-ellipsis-vertical"></i></button>
        </div>
        <div class="dd-folder-body">
          <h4 class="dd-folder-name">Tim Operasional</h4>
          <div class="dd-avatar-group">
            <span class="dd-avatar-chip">OP</span>
            <span class="dd-avatar-chip dd-avatar-chip-more">+<%= (users || []).filter(u => (u.role || '').toLowerCase().includes('operasional')).length %></span>
          </div>
        </div>
        <div class="dd-folder-footer">
          <span class="dd-file-count"><i class="far fa-user"></i> <%= (users || []).filter(u => (u.role || '').toLowerCase().includes('operasional')).length %> Akun</span>
          <span class="dd-file-weight"><i class="fas fa-truck-fast"></i> BA &amp; PO</span>
        </div>
      </div>
    </div>
      <!-- Create User Card -->
      <div class="col-xl-4 col-lg-5">
        <div class="kov-card h-100" style="border-top: 3px solid var(--kov-primary-500);">
          <div class="kov-card-header">
            <div>
              <h5 class="kov-card-title">
                <i class="fas fa-user-plus text-success"></i>
                <span>Tambah Pengguna Baru</span>
              </h5>
              <div class="text-muted small mt-1">Buat akun staf, reviewer divisi, atau admin sistem</div>
            </div>
          </div>
          <div class="kov-card-body p-4">
            <form action="/admin/users/create" method="POST" id="createForm" data-kov-loading>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="mb-3">
                <label for="username" class="kov-label">Username <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-light"><i class="fas fa-at text-muted"></i></span>
                  <input type="text" class="form-control" id="username" name="username" placeholder="contoh: reviewer_kitchen" required>
                </div>
              </div>

              <div class="mb-3">
                <label for="nama" class="kov-label">Nama Lengkap &amp; Posisi <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="nama" name="nama" placeholder="contoh: Chef Budi Santoso (Head Kitchen)" required>
              </div>

              <div class="mb-3">
                <label for="password" class="kov-label">Password <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text bg-light"><i class="fas fa-key text-muted"></i></span>
                  <input type="password" class="form-control" id="password" name="password" placeholder="Masukkan password kuat" required>
                </div>
              </div>

              <div class="mb-3">
                <label for="role" class="kov-label">Role Akun Utama <span class="text-danger">*</span></label>
                <select class="form-select" id="role" name="role" required onchange="handleRoleChange(this.value, 'create')">
                  <option value="user" selected>USER (Reviewer Pelamar Sesuai Divisi)</option>
                  <option value="admin">Admin HR (Kelola Pelamar &amp; Rekrutmen Penuh)</option>
                  <option value="operasional">Admin Operasional (BA, PO &amp; Surat Tugas)</option>
                  <option value="it">Khusus IT (Rekap Pembelanjaan IT)</option>
                  <option value="superadmin">Super Admin (Kelola Seluruh Sistem)</option>
                </select>
                <div class="form-text small" id="roleHelpText">
                  <i class="fas fa-info-circle me-1"></i>Role USER hanya dapat mereview dan memberi catatan pada pelamar sesuai divisi yang dicentang di bawah.
                </div>
              </div>

              <!-- Division Access Checkboxes -->
              <div class="mb-4 p-3 bg-light rounded-3 border" id="divisionBoxCreate">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <label class="kov-label mb-0 text-dark">
                    <i class="fas fa-layer-group text-primary me-1"></i>Hak Akses Divisi Reviewer
                  </label>
                  <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" style="font-size: 0.75rem;" onclick="toggleAllDivisions('createForm')">
                    Pilih Semua / Batal
                  </button>
                </div>
                <div class="text-muted small mb-2" style="font-size: 0.76rem;">
                  Pilih divisi pelamar yang berhak direview oleh akun ini:
                </div>
                <div class="row g-2">
                  <% const standardDivs = ['Kitchen', 'Barista', 'Operasional', 'HR', 'Teknisi', 'FAT', 'IT']; %>
                  <% standardDivs.forEach(div => { %>
                    <div class="col-6">
                      <div class="form-check">
                        <input class="form-check-input div-check-create" type="checkbox" name="reviewer_divisions" value="<%= div %>" id="div_create_<%= div %>">
                        <label class="form-check-label small fw-semibold" for="div_create_<%= div %>">
                          <%= div === 'FAT' ? 'FAT (Finance)' : div %>
                        </label>
                      </div>
                    </div>
                  <% }); %>
                </div>
              </div>

              <button type="submit" class="btn-kov-primary w-100 py-2.5" data-loading-text="Menyimpan Pengguna...">
                <i class="fas fa-save me-1"></i> Simpan Pengguna Baru
              </button>
            </form>
          </div>
        </div>
      </div>

      <!-- Users List Table Card -->
      <div class="col-xl-8 col-lg-7">
        <div class="kov-card h-100">
          <div class="kov-card-header">
            <div>
              <h5 class="kov-card-title">
                <i class="fas fa-users-gear text-primary"></i>
                <span>Daftar Pengguna &amp; Hak Akses Reviewer (<%= users.length %>)</span>
              </h5>
              <div class="text-muted small mt-1">Kelola akun, tempelkan hak akses reviewer divisi, atau perbarui kredensial</div>
            </div>
          </div>
          <div class="table-responsive-modern">
            <table class="kov-table">
              <thead>
                <tr>
                  <th class="ps-3" style="width: 60px;">ID</th>
                  <th>User &amp; Identitas</th>
                  <th>Role Utama</th>
                  <th>Hak Reviewer Divisi</th>
                  <th>Tgl Dibuat</th>
                  <th class="text-center pe-3" style="min-width: 140px;">Aksi</th>
                </tr>
              </thead>
              <tbody>
                <% users.forEach(u => { 
                  const uDivs = (u.reviewer_divisions || '').split(',').map(s => s.trim()).filter(Boolean);
                %>
                  <tr>
                    <td class="ps-3 fw-bold text-muted">#<%= u.id %></td>
                    <td>
                      <div class="fw-bold text-dark">@<%= u.username %></div>
                      <div class="small text-muted"><%= u.nama || '-' %></div>
                    </td>
                    <td>
                      <% if (u.role === 'superadmin') { %>
                        <span class="status-pill-modern pill-danger"><span class="status-dot-pulse"></span> Super Admin</span>
                      <% } else if (u.role === 'operasional' || u.role === 'admin_operasional') { %>
                        <span class="status-pill-modern pill-success"><span class="status-dot-pulse"></span> Operasional</span>
                      <% } else if (u.role === 'it') { %>
                        <span class="status-pill-modern pill-info"><span class="status-dot-pulse"></span> Khusus IT</span>
                      <% } else if (u.role === 'user') { %>
                        <span class="status-pill-modern pill-warning"><span class="status-dot-pulse"></span> Reviewer USER</span>
                      <% } else { %>
                        <span class="status-pill-modern pill-purple"><span class="status-dot-pulse"></span> Admin HR</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (u.role === 'superadmin') { %>
                        <span class="badge bg-purple-subtle text-dark border px-2 py-1 small">
                          <i class="fas fa-shield-halved text-primary me-1"></i>Akses Semua Divisi
                        </span>
                      <% } else if (uDivs.length > 0) { %>
                        <div class="d-flex flex-wrap gap-1">
                          <% uDivs.forEach(d => { 
                            const dLow = d.toLowerCase();
                            let cls = 'bg-light text-dark border';
                            if (dLow.includes('kitchen')) cls = 'bg-warning-subtle text-warning-emphasis border border-warning';
                            else if (dLow.includes('barista')) cls = 'bg-amber-subtle text-amber-emphasis border';
                            else if (dLow.includes('hr')) cls = 'bg-primary-subtle text-primary border';
                            else if (dLow.includes('teknisi')) cls = 'bg-info-subtle text-info border';
                            else if (dLow.includes('fat') || dLow.includes('finance')) cls = 'bg-success-subtle text-success border';
                            else if (dLow.includes('it')) cls = 'bg-dark text-info border border-info';
                          %>
                            <span class="badge <%= cls %>" style="font-size: 0.72rem;"><%= d %></span>
                          <% }); %>
                        </div>
                      <% } else { %>
                        <span class="text-muted small fst-italic">Belum ditempelkan</span>
                      <% } %>
                    </td>
                    <td class="small text-muted"><%= formatDate(u.created_at, true) %></td>
                    <td class="text-center pe-3">
                      <div class="d-inline-flex gap-1.5">
                        <!-- Edit Modal Trigger Button -->
                        <button type="button" class="btn-kov-outline btn-kov-sm" data-bs-toggle="modal" data-bs-target="#editModal<%= u.id %>" title="Edit Pengguna & Hak Akses">
                          <i class="fas fa-pen-to-square"></i> Edit
                        </button>

                        <% if (u.id === user.id) { %>
                          <span class="badge bg-light text-muted border px-2 py-1 small align-self-center">Anda</span>
                        <% } else { %>
                          <form action="/admin/users/delete/<%= u.id %>" method="POST" onsubmit="return confirm('Yakin ingin menghapus pengguna @<%= u.username %>?')" class="d-inline">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="btn-kov-secondary btn-kov-sm text-danger" title="Hapus User">
                              <i class="fas fa-trash-alt"></i>
                            </button>
                          </form>
                        <% } %>
                      </div>
                    </td>
                  </tr>

                  
                          <div class="modal-footer bg-light py-2">
                            <button type="button" class="btn-kov-secondary btn-kov-sm" data-bs-dismiss="modal">Batal</button>
                            <button type="submit" class="btn-kov-primary btn-kov-sm" data-loading-text="Menyimpan...">
                              <i class="fas fa-save me-1"></i> Simpan Perubahan
                            </button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>

                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

  <!-- EDIT USER MODALS (Rendered outside table for valid DOM hierarchy & Bootstrap 5 compliance) -->
  <% users.forEach(u => { 
    const uDivs = (u.reviewer_divisions || '').split(',').map(d => d.trim()).filter(Boolean);
  %>
  <!-- EDIT USER MODAL -->
                  <div class="modal fade text-start" id="editModal<%= u.id %>" tabindex="-1" aria-labelledby="editModalLabel<%= u.id %>" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                      <div class="modal-content border-0 shadow-lg rounded-4">
                        <form action="/admin/users/edit/<%= u.id %>" method="POST" id="editForm<%= u.id %>" data-kov-loading>
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <div class="modal-header bg-slate-900 text-white rounded-top-4" style="background-color: var(--kov-slate-900);">
                            <h5 class="modal-title fw-bold" id="editModalLabel<%= u.id %>">
                              <i class="fas fa-user-pen text-warning me-2"></i>Edit: @<%= u.username %>
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                          </div>
                          <div class="modal-body p-4">
                            <div class="mb-3">
                              <label class="kov-label">Username</label>
                              <input type="text" class="form-control bg-light" value="@<%= u.username %>" disabled>
                              <div class="form-text small">Username permanen tidak dapat diubah.</div>
                            </div>

                            <div class="mb-3">
                              <label class="kov-label">Nama Lengkap &amp; Jabatan <span class="text-danger">*</span></label>
                              <input type="text" class="form-control" name="nama" value="<%= u.nama || '' %>" required>
                            </div>

                            <div class="mb-3">
                              <label class="kov-label">Role Utama Sistem <span class="text-danger">*</span></label>
                              <select class="form-select" name="role" required>
                                <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>USER: Reviewer Pelamar Sesuai Divisi</option>
                                <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin HR (Kelola Pelamar Penuh)</option>
                                <option value="operasional" <%= (u.role === 'operasional' || u.role === 'admin_operasional') ? 'selected' : '' %>>Admin Operasional</option>
                                <option value="it" <%= u.role === 'it' ? 'selected' : '' %>>Khusus IT</option>
                                <option value="superadmin" <%= u.role === 'superadmin' ? 'selected' : '' %>>Super Admin</option>
                              </select>
                            </div>

                            <div class="mb-3">
                              <label class="kov-label">Password Baru (Opsional)</label>
                              <input type="password" class="form-control" name="password" placeholder="Biarkan kosong jika tidak diubah">
                            </div>

                            <!-- Hak Akses Divisi Reviewer -->
                            <div class="p-3 bg-light rounded-3 border mb-2">
                              <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="kov-label mb-0 text-dark">
                                  <i class="fas fa-layer-group text-primary me-1"></i>Hak Reviewer Divisi
                                </label>
                                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none" style="font-size: 0.75rem;" onclick="toggleAllDivisions('editForm<%= u.id %>')">
                                  Pilih Semua / Batal
                                </button>
                              </div>
                              <div class="row g-2">
                                <% standardDivs.forEach(div => { 
                                  const isChecked = uDivs.some(d => d.toLowerCase() === div.toLowerCase());
                                %>
                                  <div class="col-6">
                                    <div class="form-check">
                                      <input class="form-check-input div-check-editForm<%= u.id %>" type="checkbox" name="reviewer_divisions" value="<%= div %>" id="div_edit_<%= u.id %>_<%= div %>" <%= isChecked ? 'checked' : '' %>>
                                      <label class="form-check-label small fw-semibold" for="div_edit_<%= u.id %>_<%= div %>">
                                        <%= div === 'FAT' ? 'FAT (Finance)' : div %>
                                      </label>
                                    </div>
                                  </div>
                                <% }); %>
                              </div>
                            </div>

                          </div>
  <% }); %>

    </main>
  </div>

  <script src="/assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script>
    function filterUserTable() {
      const q = (document.getElementById('userSearchInput')?.value || '').toLowerCase();
      document.querySelectorAll('.table tbody tr').forEach(tr => {
        tr.style.display = (!q || tr.innerText.toLowerCase().includes(q)) ? '' : 'none';
      });
    }
    function toggleAllDivisions(formId) {
      const form = document.getElementById(formId);
      if (!form) return;
      const checkboxes = form.querySelectorAll('input[name="reviewer_divisions"]');
      const allChecked = Array.from(checkboxes).every(cb => cb.checked);
      checkboxes.forEach(cb => { cb.checked = !allChecked; });
    }

    function handleRoleChange(roleVal, prefix) {
      const help = document.getElementById('roleHelpText');
      if (roleVal === 'user') {
        help.innerHTML = '<i class="fas fa-info-circle me-1 text-warning"></i>Role USER hanya dapat mereview dan memberi catatan pada pelamar sesuai divisi yang dicentang di bawah.';
      } else if (roleVal === 'admin') {
        help.innerHTML = '<i class="fas fa-info-circle me-1 text-info"></i>Admin HR memiliki akses penuh rekrutmen, dan juga dapat diberikan divisi review khusus di bawah.';
      } else if (roleVal === 'superadmin') {
        help.innerHTML = '<i class="fas fa-info-circle me-1 text-purple"></i>Super Admin dapat mengelola seluruh menu, setting user, dan mereview seluruh divisi.';
      } else {
        help.innerHTML = '<i class="fas fa-info-circle me-1"></i>Akses menu operasional/IT dan dapat ditempelkan hak reviewer pelamar jika diperlukan.';
      }
    }
  </script>
  <!-- Inactivity Auto-Logout (2 Jam) -->
  <script src="/idle-timer.js"></script>
</body>
</html>
