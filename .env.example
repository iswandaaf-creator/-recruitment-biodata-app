# KOV Management Portal - Environment Configuration Template
PORT=3000
NODE_ENV=production

# Cryptographically Secure Session Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_secure_random_session_secret_here

# CORS Whitelist (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=https://internal.kovgroups.com,http://localhost:3000,http://127.0.0.1:3000

# Cookie Security
COOKIE_SECURE=auto
